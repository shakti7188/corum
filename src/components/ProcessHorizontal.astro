---
// ProcessHorizontal — 4-step engagement journey rendered as a CENTRED
// horizontal sequence. Each step is a circular gold-ringed badge with
// the numeral inside; below the badge sits the title and body, centred
// in its own column. A thin horizontal gold thread runs between each
// pair of badges so the row reads as one continuous flow.
//
// Strategy → Build → Launch → Scale. No timeline commitments per
// CLAUDE.md (we describe the phase, not the duration).

const steps = [
  {
    num: '01',
    title: 'Strategy',
    body: 'Audit, positioning and a clear plan to win — sharpened with founders, signed off as one document.',
  },
  {
    num: '02',
    title: 'Build',
    body: 'Brand, product, content, contracts — built by the same team that runs the launch.',
  },
  {
    num: '03',
    title: 'Launch',
    body: 'Press, KOL, community and paid coordinated to a single moment. Momentum, not a press release.',
  },
  {
    num: '04',
    title: 'Scale',
    body: 'Compounding monthly — paid scaling, narrative refresh, ongoing PR and community ops.',
  },
];
---

<section class="c8-process">
  <div class="c8-process__inner">
    <header class="c8-process__head" data-reveal-stagger="100">
      <p class="c8-process__eyebrow" data-reveal="up">How we work</p>
      <h2 class="c8-process__heading" data-reveal="up">
        Four steps. <span class="c8-process__heading-accent">One team.</span>
      </h2>
      <p class="c8-process__sub" data-reveal="up">
        One team carries you from the first whiteboard sketch to the second-year retainer. No handoffs. No relays.
      </p>
    </header>

    <ol class="c8-process__chain" data-reveal-stagger="120">
      {steps.map((s, i) => (
        <li class="c8-process__step" data-reveal="up" style={`--step-i: ${i};`}>
          <div class="c8-process__node">
            {i > 0 && <span class="c8-process__thread c8-process__thread--left" aria-hidden="true"></span>}
            {i < steps.length - 1 && <span class="c8-process__thread c8-process__thread--right" aria-hidden="true"></span>}
            <div class="c8-process__badge">
              <span class="c8-process__badge-ring" aria-hidden="true"></span>
              <span class="c8-process__badge-num">{s.num}</span>
            </div>
          </div>
          <h3 class="c8-process__step-title">{s.title}</h3>
          <p class="c8-process__step-body">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style is:global>
  .c8-process {
    background: var(--color-bg);
    color: #0a0a0a;
    padding: clamp(5rem, 10vh, 8rem) clamp(1.5rem, 5vw, 5rem);
    position: relative;
    overflow: hidden;
  }
  /* Subtle dotted grid backdrop — gives depth without stealing focus
     from the chain. */
  .c8-process::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at center, rgba(0,0,0,0.06) 1px, transparent 1.5px);
    background-size: 26px 26px;
    mask-image: radial-gradient(ellipse 70% 80% at 50% 50%, #000 25%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 80% at 50% 50%, #000 25%, transparent 75%);
    opacity: 0.65;
    pointer-events: none;
  }
  .c8-process__inner {
    position: relative;
    max-width: var(--c8-section-max, 1320px);
    margin: 0 auto;
  }

  /* ── Header (centred) ── */
  .c8-process__head {
    max-width: 38rem;
    margin: 0 auto clamp(3rem, 6vh, 4.5rem);
    text-align: center;
  }
  .c8-process__eyebrow {
    margin: 0 0 1rem;
    font-family: var(--montreal);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c8-gold-dark);
  }
  .c8-process__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    font-weight: 350;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .c8-process__heading-accent {
    color: var(--c8-gold-dark);
    font-weight: 350;
  }
  .c8-process__sub {
    margin: 1rem auto 0;
    max-width: 30rem;
    font-family: var(--montreal);
    font-size: clamp(0.95rem, 1.1vw, 1.05rem);
    line-height: 1.55;
    color: rgba(0,0,0,0.6);
  }

  /* ── Horizontal chain — 4 columns ── */
  .c8-process__chain {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1.5rem, 2.5vw, 2.5rem);
    max-width: 64rem;
    position: relative;
  }

  .c8-process__step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Wraps badge + horizontal threads on either side */
  .c8-process__node {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 86px;
    margin-bottom: 1.4rem;
  }

  /* Threads run from each badge edge toward the column edge so two
     adjacent steps' threads meet in the gutter and read as one
     continuous gold line. */
  .c8-process__thread {
    position: absolute;
    top: 50%;
    height: 1.5px;
    background: linear-gradient(to right,
      rgba(242,191,34,0) 0%,
      rgba(242,191,34,0.7) 30%,
      rgba(242,191,34,0.85) 100%);
    border-radius: 2px;
    transform: translateY(-50%);
  }
  .c8-process__thread--left {
    left: 0;
    width: calc(50% - 50px);
    background: linear-gradient(to left,
      rgba(242,191,34,0) 0%,
      rgba(242,191,34,0.7) 30%,
      rgba(242,191,34,0.85) 100%);
  }
  .c8-process__thread--right {
    right: 0;
    width: calc(50% - 50px);
  }

  /* ── Badge ── */
  .c8-process__badge {
    position: relative;
    z-index: 2;
    width: 86px;
    height: 86px;
    border-radius: 50%;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 18px 36px -22px rgba(0,0,0,0.22),
      0 0 0 1px rgba(0,0,0,0.04);
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.5s ease;
  }
  .c8-process__badge-ring {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    background:
      conic-gradient(from 0deg,
        var(--c8-gold) 0deg,
        var(--c8-gold-glow, rgba(242,191,34,0.5)) 60deg,
        transparent 60deg 360deg
      );
    opacity: 0.85;
    transition: opacity 0.5s ease, transform 0.8s cubic-bezier(0.2,0.8,0.2,1);
    z-index: -1;
    -webkit-mask: radial-gradient(circle, transparent 56%, #000 57%);
            mask: radial-gradient(circle, transparent 56%, #000 57%);
  }
  .c8-process__step:hover .c8-process__badge {
    transform: translateY(-3px);
    box-shadow:
      0 24px 50px -22px rgba(0,0,0,0.32),
      0 0 0 1px rgba(0,0,0,0.04),
      0 0 36px -10px rgba(242,191,34,0.5);
  }
  .c8-process__step:hover .c8-process__badge-ring {
    transform: rotate(120deg);
    opacity: 1;
  }
  .c8-process__badge-num {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--c8-gold-dark);
  }

  /* ── Step content ── */
  .c8-process__step-title {
    margin: 0 0 0.55rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.9vw, 1.55rem);
    font-weight: 350;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #0a0a0a;
  }
  .c8-process__step-body {
    margin: 0;
    font-family: var(--montreal);
    font-size: 0.95rem;
    line-height: 1.55;
    color: #555;
    max-width: 16rem;
  }

  /* ── Tablet: 2x2 grid, each row keeps the connecting thread ── */
  @media (max-width: 900px) {
    .c8-process__chain {
      grid-template-columns: repeat(2, 1fr);
      gap: clamp(2rem, 4vh, 3rem) clamp(1.5rem, 3vw, 2.5rem);
      max-width: 32rem;
    }
    /* On the wrapped row, threads on far-left of step 0 and far-right
       of step 1's pair don't have a partner; CSS keeps them but they
       still anchor visually as gold accents leading into / out of the
       row. */
  }

  /* ── Mobile: single column, vertical thread between steps ── */
  @media (max-width: 600px) {
    .c8-process__chain {
      grid-template-columns: 1fr;
      gap: clamp(2.5rem, 5vh, 3.5rem);
      max-width: 22rem;
    }
    .c8-process__node { height: 74px; }
    .c8-process__badge { width: 74px; height: 74px; }
    .c8-process__badge-num { font-size: 1.35rem; }
    /* Hide horizontal threads on mobile and add a vertical one
       between consecutive steps so the chain still reads as a
       continuous flow. */
    .c8-process__thread { display: none; }
    .c8-process__step:not(:first-child) .c8-process__node::before {
      content: '';
      position: absolute;
      bottom: 100%;
      left: 50%;
      transform: translateX(-50%);
      width: 1.5px;
      height: clamp(2.5rem, 5vh, 3.5rem);
      background: linear-gradient(to bottom,
        rgba(242,191,34,0) 0%,
        rgba(242,191,34,0.7) 40%,
        rgba(242,191,34,0.85) 100%);
      border-radius: 2px;
    }
    .c8-process__step-title { font-size: 1.3rem; }
    .c8-process__step-body { font-size: 0.95rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .c8-process__badge,
    .c8-process__badge-ring { transition: none; }
  }
</style>
