      background: linear-gradient(135deg, rgba(255,255,255,0.04) 0%, rgba(255,255,255,0.01) 100%);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 16px;
      display: flex; flex-direction: column; gap: 0.75rem;
      overflow: hidden;
      transition: transform 0.5s cubic-bezier(0.2,0.8,0.2,1), border-color 0.5s ease, background 0.5s ease;
    }
    .lp-volume-card:hover {
      transform: translateY(-4px);
      border-color: rgba(242,191,34,0.5);
      background: linear-gradient(135deg, rgba(242,191,34,0.05) 0%, rgba(255,255,255,0.02) 100%);
    }
    .lp-volume-card__bar {
      position: absolute; top: 0; bottom: 0; left: 0; width: 3px;
      background: linear-gradient(to bottom, var(--c8-gold) 0%, transparent 100%);
      opacity: 0.85;
      transition: opacity 0.4s ease, width 0.4s ease;
    }
    .lp-volume-card:hover .lp-volume-card__bar { opacity: 1; width: 5px; }
    .lp-volume-card--lg .lp-volume-card__bar {
      background: linear-gradient(to bottom, var(--c8-gold) 0%, var(--c8-gold-dark) 100%);
      width: 4px;
    }
    .lp-volume-card__top {
      display: flex; align-items: baseline; flex-wrap: wrap;
      gap: 0.7rem;
    }
    .lp-volume-card__num {
      font-family: var(--font-display);
      font-size: clamp(2.2rem, 4.2vw, 3.4rem);
      font-weight: 350;
      letter-spacing: -0.04em;
      line-height: 0.9;
      color: var(--c8-gold);
    }
    .lp-volume-card--lg .lp-volume-card__num {
      font-size: clamp(3rem, 6.2vw, 5.4rem);
    }
    .lp-volume-card__period {
      font-family: var(--montreal);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.5);
    }
    .lp-volume-card--lg .lp-volume-card__period { font-size: 0.85rem; }
    .lp-volume-card__label {
      margin: 0;
      font-family: var(--font-display);
      font-size: clamp(1.05rem, 1.4vw, 1.2rem);
      font-weight: 350;
      letter-spacing: -0.01em;
      line-height: 1.2;
      color: #fff;
    }
    .lp-volume-card--lg .lp-volume-card__label {
      font-size: clamp(1.4rem, 2.2vw, 1.8rem);
    }
    .lp-volume-card__note {
      margin: 0;
      font-family: var(--montreal);
      font-size: 0.86rem;
      line-height: 1.55;
      color: rgba(255,255,255,0.62);
      max-width: 30rem;
    }
    .lp-volume-card--lg .lp-volume-card__note {
      font-size: clamp(0.95rem, 1.1vw, 1.05rem);
      max-width: 28rem;
    }

    .lp-volume-card__deco {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      overflow: hidden;
      opacity: 0.55;
      transition: opacity 0.5s ease;
    }
    .lp-volume-card:hover .lp-volume-card__deco { opacity: 0.85; }
    .lp-volume-card__deco svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }
    .lp-volume-card > *:not(.lp-volume-card__deco):not(.lp-volume-card__bar) {
      position: relative;
      z-index: 1;
    }

    .lp-deco-wave {
      fill: none;
      stroke: var(--c8-gold);
      stroke-width: 1.4;
      transform-origin: 160px 40px;
      animation: lp-wave 4s ease-out infinite;
    }
    .lp-deco-wave--1 { animation-delay: 0s; }
    .lp-deco-wave--2 { animation-delay: 1s; }
    .lp-deco-wave--3 { animation-delay: 2s; }
    .lp-deco-wave--4 { animation-delay: 3s; }
    @keyframes lp-wave {
      0%   { transform: scale(0.4); opacity: 0.9; }
      100% { transform: scale(1.5); opacity: 0; }
    }

    .lp-deco-node {
      fill: var(--c8-gold);
      animation: lp-node-pulse 3s ease-in-out infinite;
    }
    .lp-deco-node--1 { animation-delay: 0s; }
    .lp-deco-node--2 { animation-delay: 0.5s; }
    .lp-deco-node--3 { animation-delay: 1s; }
    .lp-deco-node--4 { animation-delay: 1.5s; }
    .lp-deco-node--5 { animation-delay: 2s; }
    .lp-deco-node-link {
      stroke: var(--c8-gold);
      stroke-width: 1;
      stroke-dasharray: 2 4;
      opacity: 0.4;
      animation: lp-node-flow 6s linear infinite;
    }
    @keyframes lp-node-pulse {
      0%, 100% { transform: scale(1); transform-origin: center; opacity: 0.6; }
      50%      { transform: scale(1.5); opacity: 1; }
    }
    @keyframes lp-node-flow {
      from { stroke-dashoffset: 0; }
      to   { stroke-dashoffset: -24; }
    }

    .lp-deco-bar {
      fill: var(--c8-gold);
      transform-origin: bottom;
      animation: lp-bar-rise 2.4s ease-in-out infinite alternate;
    }
    .lp-deco-bar--1 { animation-delay: 0s;    fill-opacity: 0.4; }
    .lp-deco-bar--2 { animation-delay: 0.15s; fill-opacity: 0.55; }
    .lp-deco-bar--3 { animation-delay: 0.3s;  fill-opacity: 0.7; }
    .lp-deco-bar--4 { animation-delay: 0.45s; fill-opacity: 0.85; }
    .lp-deco-bar--5 { animation-delay: 0.6s;  fill-opacity: 1; fill: var(--c8-gold-dark); }
    @keyframes lp-bar-rise {
      0%   { transform: scaleY(0.7); }
      100% { transform: scaleY(1); }
    }

    .lp-deco-doc {
      fill: none;
      stroke: var(--c8-gold);
      stroke-width: 1.5;
    }
    .lp-deco-doc--1 {
      fill: rgba(242,191,34,0.08);
      animation: lp-doc-drift-a 5s ease-in-out infinite alternate;
    }
    .lp-deco-doc--2 {
      fill: rgba(242,191,34,0.05);
      animation: lp-doc-drift-b 6s ease-in-out infinite alternate;
    }
    .lp-deco-doc--3 {
      fill: rgba(242,191,34,0.03);
      animation: lp-doc-drift-c 7s ease-in-out infinite alternate;
    }
    .lp-deco-doc-line {
      stroke: var(--c8-gold);
      stroke-width: 1.2;
      opacity: 0.55;
    }
    @keyframes lp-doc-drift-a { from { transform: translate(0, 0); } to { transform: translate(2px, -3px); } }
    @keyframes lp-doc-drift-b { from { transform: translate(0, 0); } to { transform: translate(-2px, -2px); } }
    @keyframes lp-doc-drift-c { from { transform: translate(0, 0); } to { transform: translate(-3px, 1px); } }

    .lp-deco-pulse-ring {
      fill: none;
      stroke: var(--c8-gold);
      stroke-width: 1.6;
      transform-origin: 100px 100px;
      animation: lp-ring-pulse 3.6s ease-out infinite;
    }
    .lp-deco-pulse-ring--1 { animation-delay: 0s; }
    .lp-deco-pulse-ring--2 { animation-delay: 1.2s; }
    .lp-deco-pulse-ring--3 { animation-delay: 2.4s; }
    .lp-deco-pulse-core {
      fill: var(--c8-gold-dark);
      animation: lp-core-glow 2s ease-in-out infinite alternate;
    }
    .lp-deco-pulse-dot {
      fill: var(--c8-gold);
      opacity: 0.6;
      animation: lp-core-glow 2.4s ease-in-out infinite alternate;
    }
    @keyframes lp-ring-pulse {
      0%   { transform: scale(0.5); opacity: 0.85; }
      100% { transform: scale(2.4); opacity: 0; }
    }
    @keyframes lp-core-glow {
      0%, 100% { opacity: 0.6; }
      50%      { opacity: 1; }
    }

    @media (prefers-reduced-motion: reduce) {
      .lp-deco-wave, .lp-deco-node, .lp-deco-node-link,
      .lp-deco-bar, .lp-deco-doc--1, .lp-deco-doc--2, .lp-deco-doc--3,
      .lp-deco-pulse-ring, .lp-deco-pulse-core, .lp-deco-pulse-dot {
        animation: none !important;
      }
    }

    .lp-volume__trust {
      margin: clamp(2.5rem, 5vh, 3.5rem) auto 0;
      padding: 1.4rem clamp(1rem, 2vw, 1.5rem);
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 999px;
      display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
      gap: 0.85rem 1.4rem;
    }
    .lp-volume__trust-label {
      font-family: var(--montreal); font-size: 0.72rem; font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.55);
    }
    .lp-volume__trust-list {
      list-style: none; margin: 0; padding: 0;
      display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem;
      font-family: var(--montreal); font-size: 0.88rem; color: rgba(255,255,255,0.85);
    }
    .lp-volume__trust-dot { color: var(--c8-gold-dark); font-size: 0.5rem; opacity: 0.7; }
    @media (max-width: 800px) {
      .lp-volume__trust { border-radius: 18px; padding: 1.4rem 1.2rem; }
    }

    /* BIG NUMBERS */
    .lp-bignumbers {
      background: #0a0a0a; color: #fff;
      padding: clamp(5rem, 10vh, 8rem) var(--lp-pad-x);
    }
    .lp-bignumbers__inner {
      max-width: var(--lp-max); margin: 0 auto;
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: clamp(0.85rem, 1.4vw, 1.4rem);
    }
    @media (max-width: 1000px) { .lp-bignumbers__inner { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 540px)  { .lp-bignumbers__inner { grid-template-columns: 1fr; } }
    .lp-bignum {
      display: flex; flex-direction: column; gap: 1rem;
      padding: clamp(1.4rem, 2.4vw, 1.85rem);
      background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);
      border-radius: 16px;
      transition: transform 0.4s cubic-bezier(0.2,0.8,0.2,1), border-color 0.4s ease, background 0.4s ease;
    }
    .lp-bignum:hover {
      transform: translateY(-4px); border-color: rgba(242,191,34,0.4);
      background: rgba(255,255,255,0.05);
    }
    .lp-bignum__top {
      display: flex; align-items: flex-end; justify-content: space-between; gap: 0.85rem;
    }
    .lp-bignum__val {
      font-family: var(--font-display); font-size: clamp(2.4rem, 4.2vw, 3.4rem);
      font-weight: 350; letter-spacing: -0.04em; line-height: 0.9;
      color: var(--c8-gold);
    }
    .lp-bignum__spark { width: 84px; height: 30px; flex: 0 0 auto; opacity: 0.85; }
    .lp-bignum__label {
      font-family: var(--montreal); font-size: 0.92rem; line-height: 1.5;
      color: rgba(255,255,255,0.72);
    }

    /* SECTION HEADING HELPER */
    .lp-h-head {
      max-width: 56rem; margin: 0 auto clamp(3rem, 6vh, 4.5rem); text-align: center;
    }
    .lp-h-head--left { text-align: left; margin-left: 0; }
    .lp-h-eyebrow {
      margin: 0 0 1.1rem;
      font-family: var(--montreal); font-size: 0.72rem; font-weight: 600;
      letter-spacing: 0.28em; text-transform: uppercase; color: var(--c8-gold-dark);
    }
    .lp-h-title {
      margin: 0;
      font-family: var(--font-display); font-size: clamp(1.75rem, 3.8vw, 2.85rem);
      font-weight: 350; line-height: 1.08; letter-spacing: -0.025em;
    }
    .lp-h-sub {
      margin: 1rem auto 0; max-width: 44rem;
      font-family: var(--montreal); font-size: clamp(0.96rem, 1.1vw, 1.04rem);
      line-height: 1.55; color: #555;
    }
    .lp-h-head--left .lp-h-sub { margin-left: 0; }
    .lp-accent { color: var(--c8-gold-dark); font-weight: 350; }

    /* DISCIPLINES BENTO */
    .lp-channels-sect { padding: clamp(5rem, 10vh, 8rem) var(--lp-pad-x); }
    .lp-channels-grid {
      max-width: var(--lp-max); margin: 0 auto;
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: clamp(0.85rem, 1.4vw, 1.4rem);
    }
    @media (max-width: 900px) { .lp-channels-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 540px) { .lp-channels-grid { grid-template-columns: 1fr; } }
    .lp-ch-tile {
      position: relative; display: flex; flex-direction: column;
      aspect-ratio: 4 / 3; border-radius: 14px; overflow: hidden;
      background: #111; color: #fff; text-decoration: none;
      transition: transform 0.5s cubic-bezier(0.2,0.8,0.2,1), box-shadow 0.5s ease;
    }
    .lp-ch-tile:hover {
      transform: translateY(-6px);
      box-shadow: 0 32px 64px -22px rgba(0,0,0,0.4);
    }
    .lp-ch-tile__img { position: absolute; inset: 0; z-index: 0; }
    .lp-ch-tile__img img {
      width: 100%; height: 100%; object-fit: cover;
      transition: transform 0.7s cubic-bezier(0.2,0.8,0.2,1);
    }
    .lp-ch-tile:hover .lp-ch-tile__img img { transform: scale(1.07); }
    .lp-ch-tile__veil {
      position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.85) 100%);
    }
    .lp-ch-tile__body {
      position: relative; z-index: 1; margin-top: auto;
      padding: clamp(1.4rem, 2.4vw, 2rem);
    }
    .lp-ch-tile__name {
      margin: 0 0 0.55rem;
      font-family: var(--font-display); font-size: clamp(1.4rem, 2.2vw, 1.85rem);
      font-weight: 350; letter-spacing: -0.02em;
    }
    .lp-ch-tile__pitch {
      margin: 0;
      font-family: var(--montreal); font-size: 0.95rem; line-height: 1.45;
      color: rgba(255,255,255,0.78); max-width: 22rem;
    }
    .lp-ch-tile__arrow {
      position: absolute;
      top: clamp(1.2rem, 2.4vw, 1.85rem); right: clamp(1.2rem, 2.4vw, 1.85rem);
      z-index: 1;
      width: 38px; height: 38px;
      display: flex; align-items: center; justify-content: center;
      border-radius: 50%; background: rgba(255,255,255,0.12);
      backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
      border: 1px solid rgba(255,255,255,0.18);
      font-family: var(--montreal); font-size: 1.1rem;
      transition: background 0.3s ease, transform 0.3s ease;
    }
    .lp-ch-tile:hover .lp-ch-tile__arrow {
      background: var(--c8-gold); color: #111; transform: rotate(-45deg);
      border-color: var(--c8-gold);
    }

    /* TABS */
    .lp-tabs-sect {
      padding: clamp(5rem, 10vh, 8rem) var(--lp-pad-x); background: #f7f6f3;
    }
    .lp-tabs { max-width: var(--lp-max); margin: 0 auto; }
    .lp-tabs__nav {
      display: flex; flex-wrap: wrap; justify-content: center; gap: 0.4rem;
      margin: 0 auto clamp(2.5rem, 5vh, 3.5rem);
      padding: 0.4rem;
      background: #fff; border: 1px solid rgba(0,0,0,0.06); border-radius: 999px;
      box-shadow: 0 18px 36px -22px rgba(0,0,0,0.12);
      width: fit-content;
    }
    .lp-tab {
      appearance: none; background: transparent; border: 0; cursor: pointer;
      padding: 0.7rem 1.25rem; border-radius: 999px;
      display: inline-flex; align-items: center; gap: 0.55rem;
      font-family: var(--montreal); font-size: 0.92rem; font-weight: 600;
      letter-spacing: -0.005em; color: #555; white-space: nowrap;
      transition: background 0.3s ease, color 0.3s ease;
    }
    .lp-tab:hover { color: #0a0a0a; }
    .lp-tab.is-active { background: #0a0a0a; color: #fff; }
    .lp-tab__num {
      font-family: var(--font-display); font-size: 0.75rem;
      letter-spacing: 0.12em; color: var(--c8-gold-dark); opacity: 0.85;
    }
    .lp-tab.is-active .lp-tab__num { color: var(--c8-gold); opacity: 1; }
    .lp-tab__label {
      /* Cocogoose display face for the phase tab labels — matches the
         section heading rhythm (Architecture / Build / Audit / Operate
         read as titled chapters, not utility nav). */
      font-family: var(--font-display);
      font-weight: 350;
      font-size: 0.96rem;
      letter-spacing: -0.01em;
    }
    .lp-tabs__stage { position: relative; display: grid; }
    .lp-tabs__panel {
      grid-column: 1 / 2; grid-row: 1 / 2;
      display: grid; grid-template-columns: 1.05fr 1fr;
      gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center;
      opacity: 0; transform: translateY(8px); pointer-events: none;
      transition: opacity 0.45s cubic-bezier(0.22,1,0.36,1), transform 0.45s cubic-bezier(0.22,1,0.36,1);
    }
    .lp-tabs__panel.is-active {
      opacity: 1; transform: translateY(0); pointer-events: auto;
    }
    @media (max-width: 900px) { .lp-tabs__panel { grid-template-columns: 1fr; } }
    .lp-tabs__media {
      position: relative; margin: 0; aspect-ratio: 4 / 3;
      border-radius: 16px; overflow: hidden; background: #111;
    }
    .lp-tabs__media img {
      width: 100%; height: 100%; object-fit: cover;
      transition: transform 0.7s cubic-bezier(0.2,0.8,0.2,1);
    }
    .lp-tabs__panel.is-active .lp-tabs__media img { transform: scale(1.04); }
    .lp-tabs__claim {
      position: absolute; bottom: 1rem; left: 1rem;
      padding: 0.5rem 1rem;
      background: rgba(10,10,10,0.85);
      backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
      border: 1px solid rgba(255,255,255,0.18); border-radius: 999px;
      color: var(--c8-gold);
      font-family: var(--montreal); font-size: 0.78rem; font-weight: 600;
      letter-spacing: 0.02em;
    }
    .lp-tabs__pillar-num {
      display: inline-block; margin: 0 0 1rem;
      font-family: var(--montreal); font-size: 0.72rem; font-weight: 600;
      letter-spacing: 0.22em; text-transform: uppercase; color: var(--c8-gold-dark);
    }
    .lp-tabs__headline {
      margin: 0 0 1.4rem;
      font-family: var(--font-display); font-size: clamp(1.5rem, 2.6vw, 2.1rem);
      font-weight: 350; line-height: 1.1; letter-spacing: -0.02em;
      color: #0a0a0a; max-width: 28ch;
    }
    .lp-tabs__points {
      list-style: none; margin: 0; padding: 0;
      display: flex; flex-direction: column; gap: 0.7rem;
    }
    .lp-tabs__points li {
      display: flex; align-items: flex-start; gap: 0.65rem;
      font-family: var(--montreal); font-size: clamp(0.95rem, 1.1vw, 1.05rem);
      line-height: 1.5; color: #2a2a2a;
    }
    .lp-tabs__check {
      display: inline-flex; align-items: center; justify-content: center;
      width: 22px; height: 22px; border-radius: 50%;
      background: rgba(242,191,34,0.18); color: var(--c8-gold-dark);
      flex: 0 0 auto; margin-top: 0.1rem;
    }

    /* PROOF */
    .lp-proof { padding: clamp(5rem, 10vh, 8rem) var(--lp-pad-x); background: #fff; }
    .lp-proof-grid {
      max-width: var(--lp-max); margin: 0 auto;
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: clamp(1rem, 1.6vw, 1.6rem);
    }
    @media (max-width: 1100px) { .lp-proof-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 600px)  { .lp-proof-grid { grid-template-columns: 1fr; } }
    .lp-case {
      display: flex; flex-direction: column; background: #fff;
      border-radius: 20px; overflow: hidden;
      box-shadow: 0 22px 44px -22px rgba(0,0,0,0.18);
      transition: transform 0.5s cubic-bezier(0.2,0.8,0.2,1), box-shadow 0.5s ease;
    }
    .lp-case:hover {
      transform: translateY(-6px);
      box-shadow: 0 36px 64px -24px rgba(0,0,0,0.28);
    }
    .lp-case__media {
      position: relative; margin: 0; aspect-ratio: 4 / 3;
      overflow: hidden; background: #111;
    }
    .lp-case__media img {
      width: 100%; height: 100%; object-fit: cover;
      transition: transform 0.7s cubic-bezier(0.2,0.8,0.2,1);
    }
    .lp-case:hover .lp-case__media img { transform: scale(1.05); }
    .lp-case__chip {
      position: absolute; top: 1rem; left: 1rem;
      padding: 0.4rem 0.85rem; background: rgba(0,0,0,0.65);
      backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
      border: 1px solid rgba(255,255,255,0.18); border-radius: 999px;
      color: #fff; font-family: var(--montreal); font-size: 0.7rem;
      font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase;
    }
    .lp-case__body { padding: clamp(1.2rem, 2vw, 1.7rem); }
    .lp-case__company {
      display: inline-block; margin: 0 0 0.7rem;
      font-family: var(--montreal); font-size: 0.72rem; font-weight: 600;
      letter-spacing: 0.18em; text-transform: uppercase; color: #888;
    }
    .lp-case__headline {
      margin: 0 0 0.85rem; display: flex; flex-direction: column; gap: 0.15rem;
    }
    .lp-case__h-main {
      font-family: var(--font-display); font-size: clamp(2rem, 3.6vw, 2.85rem);
      font-weight: 350; letter-spacing: -0.04em; line-height: 0.95;
      color: var(--c8-gold-dark);
    }
    .lp-case__h-sub {
      font-family: var(--montreal); font-size: 0.85rem; letter-spacing: 0.01em; color: #555;
    }
    .lp-case__body-text {
      margin: 0;
      font-family: var(--montreal); font-size: 0.88rem; line-height: 1.55; color: #444;
    }

    /* TESTIMONIAL CAROUSEL */
    .lp-testi-section {
