<style is:global>
  /* Tighten the runway BELOW the last service card. KOTA ships the Services
     panel stack with three 40vh spacers (one per card) + a 25vh bottom
     margin on the wrapper — great for an isolated services page, wasteful
     on the homepage where the Showcase video needs to come up immediately
     after the last card releases its pin.

     Leaving the intra-stack spacers alone (they gate the pinned-slide
     animation between cards); only killing the spacer that sits AFTER the
     final card, and collapsing the wrapper's bottom margin. */
  .c8-services-panels {
    margin-bottom: 3vh !important;
  }
  .c8-services-panels .AnimatedPanel_panel__eAXfR:last-child .AnimatedPanel_spacer__w4GTD {
    height: 0 !important;
    display: none !important;
  }
</style>

