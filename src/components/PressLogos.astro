---
// Client trust strip — three-row CSS marquee of normalized client
// wordmarks. All assets are .webp at 280x80 max, transparent canvas,
// trim-cropped so every logo lands at uniform optical weight inside
// a fixed-dimension tile wrapper. See scripts/normalize-logos.ts for
// the source pipeline (drop / color-invert / crop / trim / resize).
const clients = [
  // Row A — tier-1 brands + case-study clients
  { src: '/clients/binance.webp',         alt: 'Binance' },
  { src: '/clients/cashaa.webp',          alt: 'Cashaa' },
  { src: '/clients/kucoin.webp',          alt: 'KuCoin' },
  { src: '/clients/okx.webp',             alt: 'OKX' },
  { src: '/clients/metamask.webp',        alt: 'MetaMask' },
  { src: '/clients/tether.webp',          alt: 'Tether' },
  { src: '/clients/tron.webp',            alt: 'TRON' },
  { src: '/clients/etoro.webp',           alt: 'eToro' },
  { src: '/clients/gate-io.webp',         alt: 'Gate.io' },
  { src: '/clients/coinmarketcap.webp',   alt: 'CoinMarketCap' },
  { src: '/clients/wazirx.webp',          alt: 'WazirX' },
  { src: '/clients/kava.webp',            alt: 'Kava' },
  { src: '/clients/eos.webp',             alt: 'EOS Network' },
  { src: '/clients/dream11.webp',         alt: 'Dream11' },
  { src: '/clients/iotex.webp',           alt: 'IoTeX' },
  { src: '/clients/fanadise.webp',        alt: 'Fanadise' },
  // Row B — case-study + project clients
  { src: '/clients/salamantex.webp',      alt: 'Salamantex' },
  { src: '/clients/plasmapay.webp',       alt: 'PlasmaPay' },
  { src: '/clients/radar.webp',           alt: 'Radar' },
  { src: '/clients/lendefi.webp',         alt: 'Lendefi' },
  { src: '/clients/bfcl.webp',            alt: 'BFCL' },
  { src: '/clients/obortech.webp',        alt: 'OborTech' },
  { src: '/clients/cointelligence.webp',  alt: 'Cointelligence' },
  { src: '/clients/chingari.webp',        alt: 'Chingari' },
  { src: '/clients/433-token.webp',       alt: '433 Token' },
  // Row C — specialists + media partners
  { src: '/clients/ozonex.webp',          alt: 'Ozonex' },
  { src: '/clients/ambcrypto.webp',       alt: 'AMB Crypto' },
  { src: '/clients/beincrypto.webp',      alt: 'BeInCrypto' },
  { src: '/clients/coingape.webp',        alt: 'CoinGape' },
  { src: '/clients/coinfunda.webp',       alt: 'CoinFunda' },
  { src: '/clients/coinjournal.webp',     alt: 'CoinJournal' },
  { src: '/clients/crypto-briefing.webp', alt: 'Crypto Briefing' },
  { src: '/clients/zycrypto.webp',        alt: 'ZyCrypto' },
];

// Split across three rows. Row A gets tier-1 (16), Row B project
// clients (11), Row C specialists + media (9). Different lengths
// per row are fine — each row marquees independently.
const rowA = clients.slice(0, 16);
const rowB = clients.slice(16, 27);
const rowC = clients.slice(27);
---

<section class="c8-press">
  <p class="c8-press__label"><span>Trusted by 1,100+ brands</span></p>
  <div class="c8-press__rows">
    <div class="c8-press__logos c8-press__logos--a c8-marquee">
      <div class="c8-marquee__track">
        {rowA.map((m) => (
          <div class="c8-press__tile">
            <img src={m.src} alt={m.alt} loading="lazy" class="c8-press__img" />
          </div>
        ))}
        {rowA.map((m) => (
          <div class="c8-press__tile c8-marquee__clone" aria-hidden="true">
            <img src={m.src} alt="" loading="lazy" class="c8-press__img" />
          </div>
        ))}
      </div>
    </div>
    <div class="c8-press__logos c8-press__logos--b c8-marquee">
      <div class="c8-marquee__track">
        {rowB.map((m) => (
          <div class="c8-press__tile">
            <img src={m.src} alt={m.alt} loading="lazy" class="c8-press__img" />
          </div>
        ))}
        {rowB.map((m) => (
          <div class="c8-press__tile c8-marquee__clone" aria-hidden="true">
            <img src={m.src} alt="" loading="lazy" class="c8-press__img" />
          </div>
        ))}
      </div>
    </div>
    <div class="c8-press__logos c8-press__logos--c c8-marquee">
      <div class="c8-marquee__track">
        {rowC.map((m) => (
          <div class="c8-press__tile">
            <img src={m.src} alt={m.alt} loading="lazy" class="c8-press__img" />
          </div>
        ))}
        {rowC.map((m) => (
          <div class="c8-press__tile c8-marquee__clone" aria-hidden="true">
            <img src={m.src} alt="" loading="lazy" class="c8-press__img" />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
  .c8-press {
    width: 100%;
    background: #F7F6F3;
    padding: 1.75rem clamp(1.5rem, 5vw, 5rem) 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }
  .c8-press__label {
    margin: 0;
    font-family: var(--montreal);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #888;
  }
  .c8-press__label span::before {
    content: '';
    display: inline-block;
    width: 1.5rem;
    height: 1px;
    background: #ccc;
    vertical-align: middle;
    margin-right: 0.6rem;
  }
  .c8-press__label span::after {
    content: '';
    display: inline-block;
    width: 1.5rem;
    height: 1px;
    background: #ccc;
    vertical-align: middle;
    margin-left: 0.6rem;
  }

  .c8-press__rows {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  /* Desktop + tablet (>768px): STATIC centred rows, no scroll. Overflow
     clipped + faded at the edges. Mobile override re-enables the
     scrolling marquee. */
  .c8-press__logos {
    width: 100%;
    overflow: hidden;
    --c8-marquee-dur: 50s;
    mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
  }
  /* Durations picked so no row is the obvious "fastest" — middle row
     leads, bottom drags, top sits between. Wider spread also breaks
     any visual sync between rows. */
  .c8-press__logos--a { --c8-marquee-dur: 71s; }
  .c8-press__logos--b { --c8-marquee-dur: 47s; }
  .c8-press__logos--c { --c8-marquee-dur: 95s; }
  /* All three rows scroll continuously on every viewport — clones
     provide the seamless wrap, edge mask fades the cuts. Different
     durations per row so they don't echo. */
  .c8-press__logos .c8-marquee__track {
    display: flex;
    flex-wrap: nowrap;
    justify-content: flex-start;
    align-items: center;
    width: max-content;
    /* Tight gap — tile wrappers carry their own width slot, so the
       inter-tile space just needs to keep adjacent logos from kissing. */
    gap: 0.35rem;
    animation: c8-marquee-scroll var(--c8-marquee-dur, 60s) linear infinite;
  }
  /* All three rows scroll in the same direction; only the durations
     differ (set per row above), so the rows stay phase-offset and
     don't echo, but the eye reads a single unified motion. */
  .c8-press__logos .c8-marquee__track > * { flex: 0 0 auto; }
  .c8-press__logos:hover .c8-marquee__track { animation-play-state: paused; }

  /* Tile wrapper — FIXED-dimension flex slot. Width is fixed (not min)
     so every tile takes the same horizontal slot regardless of the
     logo's aspect ratio — the marquee reads as a uniform grid. Logos
     wider than the slot are scaled down via max-width: 100%. */
  .c8-press__tile {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 50px;
    width: 170px;
    padding: 0 0.5rem;
    flex: 0 0 170px;
  }
  .c8-press__img {
    /* Fixed visible height — all logos render at the same vertical
       size regardless of their source aspect ratio. Width adjusts
       proportionally; max-width caps at the tile so ultra-wide
       wordmarks scale down rather than overflow. */
    height: 28px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    /* Unified dark-grey treatment that still preserves each logo's
       internal tonal variation (MetaMask's fox, BFCL's lion etc. would
       collapse to solid blobs with brightness(0), so we use a softer
       chain): grayscale removes hue, brightness(0.45) pulls the whole
       tonal range down, contrast(1.55) re-stretches it so internals
       stay readable, drop-shadow adds a sub-pixel halo for sharpness
       on the light bg. Hover restores full colour. */
    filter: grayscale(1) brightness(0.45) contrast(1.55) drop-shadow(0 0 0.4px rgba(0,0,0,0.45));
    opacity: 0.85;
    transition: opacity 0.25s ease, filter 0.25s ease, transform 0.25s ease;
  }
  .c8-press__tile:hover .c8-press__img {
    filter: none;
    opacity: 1;
    transform: scale(1.04);
  }

  @media (max-width: 768px) {
    .c8-press { padding: 1.25rem 1rem 1.5rem; }
    .c8-press__tile { height: 36px; width: 130px; flex-basis: 130px; padding: 0 0.4rem; }
    .c8-press__img { height: 22px; }
    .c8-press__logos .c8-marquee__track { gap: 0.25rem; }
  }
</style>
