---
// ScrollReveal — Quad-style "render into view" effect.
//
// Rewritten after user feedback: earlier version used big translateX/Y
// offsets that felt like displacement ("items flying in from off-screen"),
// and only triggered once per element. This version:
//
//   • Uses opacity + filter:blur(12px → 0) as the primary motion so
//     elements look like they're loading/focusing into place, not sliding
//     across the screen. A tiny directional nudge (24–36px) still hints
//     at where the element is coming from, but the dominant signal is the
//     blur → sharp transition.
//   • Re-triggers on every viewport entry — scroll past an item and back,
//     you see the animation again. The observer toggles .is-revealed
//     based on isIntersecting; no unobserve.
//   • Zero flicker at the edge: a generous bottom rootMargin delays the
//     "leave" state until the element is clearly out of view.
//   • Still attribute-driven (data-reveal / data-reveal-delay /
//     data-reveal-stagger) so every existing call-site keeps working.
//   • Respects prefers-reduced-motion: everything instant, no blur, no
//     transform.
//
// Drop `<ScrollReveal />` once inside the page and every tagged element
// gets the effect.
---

<style is:global>
  /* ────────────────────────────────────────────────────────────────────
     Base item reveal — blur + fade + tiny directional nudge.
     The blur → focus transition is what sells the "loading in" feel.

     Fail-safe state: items are visible by default. Only the
     .c8-reveal-init class (added by JS at script-run time) hides them
     for the entry animation. If JS doesn't run, never runs, or errors
     out, nothing stays invisible — the user sees rendered content.
     ──────────────────────────────────────────────────────────────────── */
  [data-reveal] {
    transition:
      opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--c8-reveal-delay, 0ms);
  }
  [data-reveal].c8-reveal-init {
    opacity: 0;
  }
  [data-reveal].c8-reveal-init[data-reveal="up"]    { transform: translate3d(0, 80px, 0); }
  [data-reveal].c8-reveal-init[data-reveal="down"]  { transform: translate3d(0, -80px, 0); }
  [data-reveal].c8-reveal-init[data-reveal="left"]  { transform: translate3d(-110px, 0, 0); }
  [data-reveal].c8-reveal-init[data-reveal="right"] { transform: translate3d(110px, 0, 0); }
  [data-reveal].c8-reveal-init[data-reveal="scale"] { transform: scale(0.86); }
  [data-reveal].c8-reveal-init[data-reveal="fade"]  { transform: none; }
  [data-reveal].c8-reveal-init[data-reveal="tilt"]  { transform: translate3d(0, 70px, 0) rotate(-3deg); }

  /* will-change only during the active reveal — NOT permanent. Keeping it
     on thousands of elements forever hurts scroll perf more than it helps. */
  [data-reveal].c8-reveal-animating {
    will-change: opacity, transform;
  }

  /* !important here is deliberate. The reveal init rules (especially
     the per-direction transforms with two attribute selectors) have
     higher specificity than this single-class selector, so without
     !important the element stays translated/blurred even after we've
     added the .is-revealed class. The whole point of this safety net
     is "never let content stay invisible," so we win the cascade
     unconditionally. */
  [data-reveal].is-revealed {
    opacity: 1 !important;
    transform: translate3d(0, 0, 0) scale(1) rotate(0) !important;
  }

  /* ────────────────────────────────────────────────────────────────────
     Section-level auto-reveal — every main > * gets a subtle fade-in on
     scroll entry. Same fail-safe pattern as items: the .c8-reveal-init
     class is what hides the section, and JS adds it at script-run time.
     If JS never runs, sections stay visible.
     ──────────────────────────────────────────────────────────────────── */
  main > .c8-reveal-section {
    transition: opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1);
  }
  main > .c8-reveal-section.c8-reveal-init {
    opacity: 0;
    will-change: opacity;
  }
  main > .c8-reveal-section.is-revealed {
    opacity: 1 !important;
  }

  /* First section (Hero) paints immediately — never un-reveal the fold. */
  main > .c8-reveal-section:first-child {
    opacity: 1 !important;
    transition: none !important;
  }

  /* ────────────────────────────────────────────────────────────────────
     Perf hook — any element tagged data-pause-offscreen gets every
     CSS animation paused while it's outside the viewport. Dramatically
     cheaper than keeping orbital rings / floating avatars spinning on
     the GPU the entire time the user is elsewhere on the page.
     ──────────────────────────────────────────────────────────────────── */
  .c8-offscreen,
  .c8-offscreen *,
  .c8-offscreen *::before,
  .c8-offscreen *::after {
    animation-play-state: paused !important;
  }

  /* NOTE: an earlier version of this file used `content-visibility: auto`
     on below-the-fold sections as a perf shortcut. It interacted badly
     with our IntersectionObserver-based reveal: the browser skipped
     rendering of the section's children, the observer fired against an
     unrendered subtree, and absolutely-positioned overlays (Industries
     card text, etc.) ended up with the bg painted but the foreground
     content stuck at opacity:0 until a re-scroll forced a re-layout.
     Removed deliberately — keep the reveal animation, drop the perf hack. */

  /* ────────────────────────────────────────────────────────────────────
     Reduced motion — everything visible, no blur, no transform.
     ──────────────────────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    [data-reveal],
    main > .c8-reveal-section {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script is:inline>
  /* Global scroll-reveal controller.
     - Tags every main > * with .c8-reveal-section for the section fade.
     - Observer toggles .is-revealed based on isIntersecting — add when
       entering, REMOVE when leaving — so the reveal plays EVERY time
       the user scrolls the element back into view, not just once.
     - A generous negative bottom rootMargin keeps the "leave" state
       from flickering at the viewport edge.
     - First section (Hero) is never un-revealed — CSS guards that. */
  (function () {
    if (typeof window === 'undefined') return;

    var prefersReduced =
      window.matchMedia &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Tag direct main > * as reveal sections, and apply c8-reveal-init
    // to the sections + every [data-reveal] item so they start hidden.
    // We do this in JS rather than as the default CSS state so that if
    // JS never runs, nothing stays invisible.
    var mainEl = document.querySelector('main');
    if (mainEl) {
      Array.prototype.forEach.call(mainEl.children, function (child) {
        child.classList.add('c8-reveal-section');
        // Skip the first section (Hero) — it paints immediately and
        // never un-reveals.
        if (child !== mainEl.children[0]) {
          child.classList.add('c8-reveal-init');
        }
      });
    }
    Array.prototype.forEach.call(document.querySelectorAll('[data-reveal]'), function (el) {
      el.classList.add('c8-reveal-init');
    });

    // Auto-stagger: walk every data-reveal-stagger container and assign
    // sequential --c8-reveal-delay to each direct [data-reveal] child.
    var staggerContainers = document.querySelectorAll('[data-reveal-stagger]');
    Array.prototype.forEach.call(staggerContainers, function (container) {
      var step = parseInt(container.getAttribute('data-reveal-stagger'), 10) || 80;
      var base = parseInt(container.getAttribute('data-reveal-base'), 10) || 0;
      var kids = container.querySelectorAll(':scope > [data-reveal]');
      Array.prototype.forEach.call(kids, function (kid, i) {
        if (!kid.style.getPropertyValue('--c8-reveal-delay')) {
          kid.style.setProperty('--c8-reveal-delay', (base + i * step) + 'ms');
        }
      });
    });

    // Promote data-reveal-delay="n" → CSS var for the transition-delay.
    var delayed = document.querySelectorAll('[data-reveal-delay]');
    Array.prototype.forEach.call(delayed, function (el) {
      var d = parseInt(el.getAttribute('data-reveal-delay'), 10) || 0;
      el.style.setProperty('--c8-reveal-delay', d + 'ms');
    });

    // Reduced-motion path: reveal everything, don't attach an observer.
    if (prefersReduced || !('IntersectionObserver' in window)) {
      document
        .querySelectorAll('[data-reveal], .c8-reveal-section')
        .forEach(function (el) { el.classList.add('is-revealed'); });
      return;
    }

    // Single observer with TWO thresholds so the toggle is crisp at the
    // entry point and stable once off-screen.
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          var el = entry.target;
          if (entry.isIntersecting) {
            el.classList.add('is-revealed');
            el.classList.add('c8-reveal-animating');
            // Drop will-change once the transition is complete so we're
            // not promoting hundreds of layers for the lifetime of the
            // page. 1.1s covers the 0.8s transform + longest stagger.
            setTimeout(function () {
              el.classList.remove('c8-reveal-animating');
            }, 1100);
          } else {
            // Element has scrolled fully out — reset so it replays on
            // re-entry.
            el.classList.remove('is-revealed');
          }
        });
      },
      {
        // Negative bottom margin: element must be 12% into the viewport
        // before reveal fires. Top/side stay at 0 so the un-reveal only
        // fires once the element has cleared the viewport entirely,
        // avoiding edge flicker.
        rootMargin: '0px 0px -12% 0px',
        threshold: 0,
      }
    );

    document
      .querySelectorAll('[data-reveal], .c8-reveal-section')
      .forEach(function (el) { io.observe(el); });

    /* ────────────────────────────────────────────────────────────────
       Safety net — three layers of fallback so no element stays
       hidden when it shouldn't:

       1. Scroll-driven rescue (rAF-throttled) — every scroll input
          checks for [data-reveal] / sections currently in the
          viewport but missing .is-revealed, and adds it. Catches the
          IO timing edge cases where the observer was attached before
          the element was ready.

       2. Window load + 600ms scan — same logic, fires once after
          page settles.

       3. Hard cap at 3s after script run — any element STILL stuck
          at .c8-reveal-init regardless of viewport position gets
          force-revealed. The reveal animation is decoration; broken
          rendering is not acceptable. */

    function rescueVisible() {
      var vh = window.innerHeight || document.documentElement.clientHeight || 800;
      var hidden = document.querySelectorAll('[data-reveal]:not(.is-revealed), .c8-reveal-section:not(.is-revealed)');
      Array.prototype.forEach.call(hidden, function (el) {
        var r = el.getBoundingClientRect();
        if (r.top < vh && r.bottom > 0) {
          el.classList.add('is-revealed');
        }
      });
    }

    // Layer 1 — scroll-driven, throttled with rAF.
    var scrollPending = false;
    window.addEventListener('scroll', function () {
      if (scrollPending) return;
      scrollPending = true;
      requestAnimationFrame(function () {
        scrollPending = false;
        rescueVisible();
      });
    }, { passive: true });

    // Layer 2 — window load + 600ms.
    if (document.readyState === 'complete') {
      setTimeout(rescueVisible, 600);
    } else {
      window.addEventListener('load', function () {
        setTimeout(rescueVisible, 600);
      }, { once: true });
    }

    // Layer 3 — hard cap. After 3s, force-reveal anything still stuck
    // at the initial-hidden state. This is the "never let content stay
    // invisible because of a JS quirk" failsafe.
    setTimeout(function () {
      Array.prototype.forEach.call(
        document.querySelectorAll('.c8-reveal-init:not(.is-revealed)'),
        function (el) { el.classList.add('is-revealed'); }
      );
    }, 3000);

    /* ────────────────────────────────────────────────────────────────
       Perf observer #1 — pause every <video> when it scrolls off-screen
       and resume when it scrolls back. Big scroll-perf win when the
       page has 4+ autoplay videos (Hero, Awards, ServicesAlt panels).
       ──────────────────────────────────────────────────────────────── */
    var videos = document.querySelectorAll('video');
    if (videos.length) {
      var vio = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            var v = entry.target;
            // Skip videos whose parent explicitly opted out (e.g. the
            // ServicesAlt tab controller manages play/pause itself).
            if (v.hasAttribute('data-c8-no-auto-pause')) return;
            if (entry.isIntersecting) {
              if (v.autoplay || v.dataset.c8Autoplay === 'true') {
                var p = v.play();
                if (p && typeof p.catch === 'function') p.catch(function () {});
              }
            } else {
              try { v.pause(); } catch (e) {}
            }
          });
        },
        { rootMargin: '200px 0px', threshold: 0 }
      );
      Array.prototype.forEach.call(videos, function (v) { vio.observe(v); });
    }

    /* ────────────────────────────────────────────────────────────────
       Perf observer #2 — toggle .c8-offscreen on any element tagged
       data-pause-offscreen. CSS above freezes every child animation
       while the class is set. Used by the InfluencerReach orbital.
       ──────────────────────────────────────────────────────────────── */
    var pauseTargets = document.querySelectorAll('[data-pause-offscreen]');
    if (pauseTargets.length) {
      var pio = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            entry.target.classList.toggle('c8-offscreen', !entry.isIntersecting);
          });
        },
        { rootMargin: '150px 0px', threshold: 0 }
      );
      Array.prototype.forEach.call(pauseTargets, function (el) { pio.observe(el); });
    }
  })();
</script>
