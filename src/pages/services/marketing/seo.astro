.s-fc__row{display:flex;justify-content:space-between;font-size:.78rem;color:#555;padding:.25rem 0;}
.s-fc__row .green{font-weight:800;color:#22c55e;}
.s-fc--traffic{top:20px;right:-20px;width:200px;}
.s-sparkline{width:100%;height:50px;margin-bottom:.6rem;overflow:visible;}
.s-fc__stat{display:flex;align-items:baseline;gap:.4rem;}
.s-fc__big{font-size:1.6rem;font-weight:800;color:#22c55e;}
.s-fc__lbl{font-size:.72rem;color:#aaa;}

/* float animations */
@keyframes floatA{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
@keyframes floatB{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}
.float-a{animation:floatA 6s ease-in-out infinite;}
.float-b{animation:floatB 8s ease-in-out infinite;animation-delay:1.5s;}

/* ── LOGO STRIP ── */
.s-logos{padding:2rem;display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:1rem;border-top:1px solid rgba(0,0,0,.06);}
.s-logos span{font-size:1.05rem;font-weight:800;color:#ccc;letter-spacing:-.02em;transition:color .3s;}
.s-logos span:hover{color:#666;}
.sdot{color:#ddd!important;font-size:.4rem;vertical-align:middle;}

/* ── DISCIPLINE CARDS (image-topped) ── */
.s-disc-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.5rem;max-width:1200px;margin:0 auto;}
.s-disc-card{background:#fff;border:1px solid rgba(0,0,0,.07);border-radius:20px;overflow:hidden;transition:border-color .3s,transform .3s,box-shadow .3s;box-shadow:0 8px 28px -12px rgba(0,0,0,.08);}
.s-disc-card:hover{border-color:#f2bf22;transform:translateY(-4px);box-shadow:0 18px 50px -16px rgba(242,191,34,.25);}
.s-disc-card__img{position:relative;height:180px;overflow:hidden;}
.s-disc-card__img img{transition:transform .5s;}
.s-disc-card:hover .s-disc-card__img img{transform:scale(1.04);}
.s-disc-card__num{position:absolute;top:1rem;right:1rem;font-size:2.5rem;font-weight:800;color:rgba(255,255,255,.7);line-height:1;text-shadow:0 2px 8px rgba(0,0,0,.25);}
.s-disc-card__body{padding:1.5rem;}
.s-disc-card__body h3{font-size:1.15rem;font-weight:700;color:#0f0f0f;margin-bottom:.6rem;}
.s-disc-card__body p{font-size:.88rem;line-height:1.65;color:#555;margin-bottom:1rem;}
.s-disc-card__body ul{list-style:none;display:flex;flex-direction:column;gap:.35rem;padding:0;margin:0;}
.s-disc-card__body li{font-size:.8rem;color:#666;padding-left:.9rem;position:relative;}
.s-disc-card__body li::before{content:'—';position:absolute;left:0;color:#f2bf22;}

/* ── SPLIT PHOTO ── */
.s-split-photo{display:grid;grid-template-columns:1fr 1fr;max-width:1300px;margin:4rem auto;border-radius:32px;overflow:hidden;box-shadow:0 30px 80px -20px rgba(0,0,0,.12);}
@media(max-width:900px){.s-split-photo{grid-template-columns:1fr;margin:2rem 1.5rem;}}
.s-split-photo__img{position:relative;min-height:500px;}
.s-split-photo__badge{position:absolute;bottom:2rem;left:2rem;background:#fff;border-radius:16px;padding:1rem 1.4rem;box-shadow:0 10px 40px rgba(0,0,0,.12);}
.s-split-photo__badge-num{display:block;font-size:2rem;font-weight:800;color:#f2bf22;line-height:1;}
.s-split-photo__badge-lbl{font-size:.75rem;font-weight:600;color:#666;}
.s-split-photo__copy{background:#fff;padding:clamp(3rem,6vw,5rem);display:flex;flex-direction:column;justify-content:center;}
.s-split-photo__copy p{font-size:.95rem;line-height:1.75;color:#555;margin-bottom:1.2rem;}
.s-mini-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;margin:2rem 0;}
.s-mini-stat span{display:block;font-size:1.6rem;font-weight:800;color:#f2bf22;}
.s-mini-stat small{display:block;font-size:.75rem;color:#888;margin-top:.2rem;}

/* ── PROCESS GRID ── */
.s-process{padding:clamp(4rem,8vh,6rem) 2rem;}
.s-process-grid{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.5rem;}
.s-proc-card{background:#fff;border:1px solid rgba(0,0,0,.07);border-radius:20px;overflow:hidden;box-shadow:0 10px 40px -10px rgba(0,0,0,.08);transition:transform .3s,box-shadow .3s;}
.s-proc-card:hover{transform:translateY(-4px);box-shadow:0 20px 60px -15px rgba(0,0,0,.12);}
.s-proc-card__img{position:relative;height:200px;overflow:hidden;}
.s-proc-card__img img{transition:transform .5s;}
.s-proc-card:hover .s-proc-card__img img{transform:scale(1.05);}
.s-proc-num{position:absolute;top:1rem;left:1rem;background:#fff;border-radius:8px;padding:.25rem .6rem;font-size:.8rem;font-weight:800;color:#f2bf22;}
.s-proc-card h3{font-size:1rem;font-weight:700;padding:1.3rem 1.4rem .4rem;}
.s-proc-card p{font-size:.83rem;line-height:1.65;color:#666;padding:0 1.4rem 1.4rem;}

/* ── AEO SPLIT ── */
/* ── WHY US comparison — large, scannable ── */
.s-why{padding:clamp(4rem,8vh,6rem) 2rem;background:#f4f4f0;}
.s-why__inner{max-width:1180px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:2rem;align-items:stretch;}
@media(max-width:768px){.s-why__inner{grid-template-columns:1fr;gap:1.2rem;}}
.s-why__col{background:#fff;border-radius:28px;padding:2.6rem 2.4rem;border:1px solid rgba(0,0,0,.08);box-shadow:0 10px 30px -14px rgba(0,0,0,.08);}
