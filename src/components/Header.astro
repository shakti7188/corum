<style is:global>
  /* ─── CSS tokens scoped to navbar components ─── */
  :root {
    --nb-brand-gold:     #E8A817;
    --nb-brand-gold-rgb: 232, 168, 23;
    --nb-brand-gold-hover: #F0B429;
    --nb-brand-dark:     #222222;
    --nb-bg-elevated:    #FFFFFF;
    --nb-bg-glass:       rgba(247, 246, 243, 0.92);
    --nb-bg-dark:        #111111;
    --nb-text-primary:   #222222;
    --nb-text-secondary: #4A4A4A;
    --nb-text-muted:     #888888;
    --nb-text-on-dark:   #F0F0F0;
    --nb-text-on-dark-muted: #B0B0B0;
    --nb-border-subtle:  rgba(0,0,0,0.05);
    --nb-border-default: rgba(0,0,0,0.08);
    --nb-shadow-lg:      0 8px 40px rgba(0,0,0,0.08);
    --nb-shadow-glow:    0 0 40px rgba(232,168,23,0.15);
    --nb-ease-expo:      cubic-bezier(0.16,1,0.3,1);
    --nb-ease-quart:     cubic-bezier(0.76,0,0.24,1);
    --nb-radius-sm:      8px;
    --nb-radius-lg:      20px;
    --nb-radius-pill:    9999px;
  }

  @keyframes c8NavLineExpand {
    0%   { transform: scaleX(0); opacity: 0; }
    30%  { opacity: 1; }
    100% { transform: scaleX(1); opacity: 1; }
  }

  /* ─── Navbar shell ─── */
  .navbar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 200;
    padding: 16px 0;
    transition: all 0.4s var(--nb-ease-expo);
  }

  .navbar::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg,
      transparent,
      rgba(0,0,0,0.05) 20%,
      rgba(0,0,0,0.08) 50%,
      rgba(0,0,0,0.05) 80%,
      transparent
    );
    transform: scaleX(0);
    transform-origin: center;
    animation: c8NavLineExpand 1.2s cubic-bezier(0.16,1,0.3,1) 0.6s forwards;
  }

  .navbar--on-dark::after {
    background: linear-gradient(90deg,
      transparent,
      rgba(255,255,255,0.06) 20%,
      rgba(255,255,255,0.12) 50%,
      rgba(255,255,255,0.06) 80%,
      transparent
    );
  }

  .navbar--on-dark .nav-link { color: rgba(255,255,255,0.75); }
  .navbar--on-dark .nav-link:hover { color: #fff; }
  .navbar--on-dark .menu-toggle span { background: #fff; }

  .navbar.scrolled {
    background: var(--nb-bg-glass);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--nb-border-subtle);
    padding: 10px 0;
  }
  .navbar.scrolled .nav-link { color: var(--nb-text-secondary); }
  .navbar.scrolled .nav-link:hover { color: var(--nb-text-primary); }
  .navbar.scrolled .menu-toggle span { background: var(--nb-text-primary); }

  .navbar.mega-open,
  .navbar.navbar--on-dark.mega-open {
    background: var(--nb-bg-elevated) !important;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--nb-border-subtle);
  }
  .navbar.mega-open .nav-link,
  .navbar.navbar--on-dark.mega-open .nav-link {
    color: var(--nb-text-secondary) !important;
  }
  .navbar.mega-open .nav-link:hover,
  .navbar.navbar--on-dark.mega-open .nav-link:hover {
    color: var(--nb-text-primary) !important;
  }
  .navbar.mega-open .nav-cta,
  .navbar.navbar--on-dark.mega-open .nav-cta {
    background: var(--nb-brand-dark) !important;
    color: #fff !important;
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0 clamp(24px, 5vw, 80px);
  }

  /* ─── Logo ─── */
  .navbar-logo {
    display: flex; align-items: center;
    z-index: 60;
    text-decoration: none;
  }
  .navbar-logo img { height: 32px; width: auto; }
  .navbar-logo:hover { opacity: 0.9; }

  /* ─── Nav links row ─── */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-link {
    font-family: 'Inter', system-ui, sans-serif;
