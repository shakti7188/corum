    .lp-testi__inner {
      max-width: 980px; margin: 0 auto; text-align: center; position: relative;
    }
    .lp-testi__quote-mark {
      display: block;
      font-family: var(--font-display); font-size: clamp(6rem, 12vw, 10rem);
      line-height: 0.6; color: var(--c8-gold-dark); opacity: 0.4;
      margin-bottom: 1rem;
    }
    .lp-testi__stage { position: relative; min-height: 280px; display: grid; }
    .lp-testi__slide {
      grid-column: 1 / 2; grid-row: 1 / 2;
      opacity: 0; transform: translateY(8px); pointer-events: none;
      transition: opacity 0.55s cubic-bezier(0.22,1,0.36,1), transform 0.55s cubic-bezier(0.22,1,0.36,1);
    }
    .lp-testi__slide.is-active { opacity: 1; transform: translateY(0); pointer-events: auto; }
    .lp-testi__quote { margin: 0 0 2rem; }
    .lp-testi__quote p {
      margin: 0;
      font-family: var(--font-display); font-size: clamp(1.45rem, 2.8vw, 2.3rem);
      font-weight: 350; line-height: 1.3; letter-spacing: -0.015em; color: #fff;
    }
    .lp-testi__cite {
      display: flex; align-items: center; justify-content: center; gap: 0.85rem;
