---

<Layout title="Marketing Services — Six Disciplines, One Engine | Corum8">
  <Fragment slot="head">
    <meta name="description" content="PR, performance, influencer, community, SEO and social — run as one coordinated growth engine. $150M+ revenue driven for 1,100+ brands across 30+ markets." />
    <link rel="canonical" href="https://corum8.com/services/marketing" />
  </Fragment>

  <!-- ── HERO ── -->
  <section class="lp-hero">
    <img class="lp-hero__bg-img" src="/images/approach.webp" alt="" aria-hidden="true" />
    <div class="lp-hero__bg-veil" aria-hidden="true"></div>
    <div class="lp-hero__bg-grid" aria-hidden="true"></div>

    <div class="lp-hero__inner">
      <div class="lp-hero__copy">
        <span class="lp-hero__pillar-badge" aria-label="Service category">
          <span class="lp-hero__pillar-bar" aria-hidden="true"></span>
          Pillar service
        </span>
        <p class="lp-hero__eyebrow">Marketing · Growth</p>
        <h1 class="lp-hero__title lp-hero__title--xl">
          Marketing that <span class="lp-hero__title-accent">moves markets.</span>
        </h1>
        <a class="lp-cta lp-cta--primary lp-cta--lg" href="/contact">Book a strategy call →</a>
        <ul class="lp-hero__credibility" aria-label="Credibility signals">
          <li><strong>$150M+</strong> revenue driven</li>
          <li class="lp-hero__cred-dot" aria-hidden="true">●</li>
          <li><strong>1,100+</strong> brands scaled</li>
          <li class="lp-hero__cred-dot" aria-hidden="true">●</li>
          <li><strong>30+</strong> markets</li>
        </ul>
      </div>

      <div class="lp-hero__feature">
        <figure class="lp-hero__photo">
          <img src="/images/corum8-team.png" alt="The Corum8 team at work" loading="eager" />
          <span class="lp-hero__photo-corner" aria-hidden="true"></span>
        </figure>

        <div class="lp-hero__chip lp-hero__chip--outcome">
          <span class="lp-hero__chip-label">Earned placements</span>
          <span class="lp-hero__chip-value">8,250<span class="lp-hero__chip-unit">+</span></span>
        </div>

        <div class="lp-hero__chip lp-hero__chip--live">
          <span class="lp-hero__chip-pulse" aria-hidden="true"></span>
          Six disciplines · live
        </div>
      </div>
    </div>
  </section>

  <!-- ── MARQUEE ── -->
  <section class="lp-marquee" aria-hidden="true">
    <div class="lp-marquee__track">
      <span>Public Relations</span><span class="lp-marquee__dot">●</span>
      <span>Influencer &amp; KOL</span><span class="lp-marquee__dot">●</span>
      <span>Performance Marketing</span><span class="lp-marquee__dot">●</span>
      <span>Community</span><span class="lp-marquee__dot">●</span>
      <span>SEO · AEO · GEO</span><span class="lp-marquee__dot">●</span>
      <span>Social Media</span><span class="lp-marquee__dot">●</span>
      <span>Public Relations</span><span class="lp-marquee__dot">●</span>
      <span>Influencer &amp; KOL</span><span class="lp-marquee__dot">●</span>
      <span>Performance Marketing</span><span class="lp-marquee__dot">●</span>
      <span>Community</span><span class="lp-marquee__dot">●</span>
      <span>SEO · AEO · GEO</span><span class="lp-marquee__dot">●</span>
      <span>Social Media</span><span class="lp-marquee__dot">●</span>
    </div>
  </section>

  <!-- ── VOLUME — delivery scoreboard ── -->
  <section class="lp-volume">
    <div class="lp-volume__bg" aria-hidden="true"></div>
    <div class="lp-volume__inner">
      <header class="lp-volume__head">
        <h2 class="lp-volume__title">
          The volume tells the story. <span class="lp-volume__title-accent">Shipped work, not decks.</span>
        </h2>
      </header>

      <div class="lp-volume__grid">
        {outputs.map((o, i) => (
          <article class={`lp-volume-card lp-volume-card--${o.size} lp-volume-card--${o.kind}`} style={`--vol-i: ${i};`}>
            <span class="lp-volume-card__bar" aria-hidden="true"></span>

            <span class="lp-volume-card__deco" aria-hidden="true">
              {o.kind === 'waves' && (
                <svg viewBox="0 0 200 200" preserveAspectRatio="xMidYMid slice">
