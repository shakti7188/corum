        <ul class="lp-hero__credibility" aria-label="Credibility signals">
          <li><strong>$10M+</strong> managed spend</li>
          <li class="lp-hero__cred-dot" aria-hidden="true">●</li>
          <li><strong>30+</strong> markets</li>
          <li class="lp-hero__cred-dot" aria-hidden="true">●</li>
          <li><strong>~40%</strong> avg CAC drop</li>
        </ul>
      </div>

      <div class="lp-hero__feature">
        <figure class="lp-hero__photo">
          <img src="/images/gen/perf_hero_dash_1778018216511.png" alt="Analytics Dashboard" loading="eager" />
          <span class="lp-hero__photo-corner" aria-hidden="true"></span>
