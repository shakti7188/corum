      gap: clamp(0.85rem, 1.4vw, 1.4rem);
    }
    @media (max-width: 1100px) { .lp-inputs__grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 600px)  { .lp-inputs__grid { grid-template-columns: 1fr; } }
    .lp-inputs__card {
      position: relative;
      padding: clamp(1.4rem, 2.4vw, 1.85rem);
