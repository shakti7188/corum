---
// Awards.astro
// Ported from the localhost:8001 awards-showcase block, retuned for our
// light KOTA-themed homepage. Placed above <Ethos /> so the page reads:
// Showcase (dark video) → InfluencerReach (light) → Awards (light) →
// Ethos (light) → Work → …
// Per user instruction: NO "Our Awards" label on top — the headline
// carries the section on its own.

type Award = {
  title: string;
  issuer: string;
  year: string;
  logo: string;
  alt: string;
};

// Six awards mirroring the source block. Logos already live at
// /public/awards/*.png, so no new assets needed.
const awards: Award[] = [
  { title: 'Best Marketing Agency',    issuer: 'Blockchain Life', year: '2025', logo: '/awards/blockchain-life.png', alt: 'Blockchain Life' },
  { title: 'Best Development Agency',  issuer: 'Finext',          year: '2024', logo: '/awards/finext.png',          alt: 'Finext' },
  { title: 'Best Leadership Award',    issuer: 'Finext',          year: '2025', logo: '/awards/finext.png',          alt: 'Finext' },
  { title: 'Entrepreneur Award',       issuer: 'Emmi Empire',     year: '2024', logo: '/awards/emmi-empire.png',     alt: 'Emmi Empire' },
  { title: 'Industry Recognition',     issuer: 'IISA',            year: '2023', logo: '/awards/iisa.png',            alt: 'IISA' },
  { title: 'Dubai Expo 2020',          issuer: 'Dubai Expo',      year: '2020', logo: '/awards/dubai-expo.png',      alt: 'Dubai Expo' },
];
---

<section class="c8-awards">
  <div class="c8-awards__wash" aria-hidden="true"></div>
  <div class="c8-awards__inner">
    <header class="c8-awards__head">
      <h2 class="c8-awards__heading">
        Recognized across<br/><em>the industry</em>
      </h2>
      <p class="c8-awards__sub">
        50+ industry awards for excellence in development, marketing and creative execution — earned on results, not pitches.
      </p>
    </header>

    <div class="c8-awards__grid">
      {awards.map((a) => (
        <article class="c8-awards__card">
          <div class="c8-awards__logo">
            <img src={a.logo} alt={a.alt} loading="lazy" />
          </div>
          <h3 class="c8-awards__title">{a.title}</h3>
          <p class="c8-awards__issuer">{a.issuer}</p>
          <span class="c8-awards__year">{a.year}</span>
        </article>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .c8-awards {
    position: relative;
    padding: clamp(5rem, 10vw, 9rem) clamp(1.5rem, 5vw, 5rem);
    background: linear-gradient(180deg, #ffffff 0%, #faf7ef 55%, #f4efe2 100%);
    overflow: hidden;
    isolation: isolate;
  }

  /* Soft gold vignette — a very subtle radial glow behind the grid so the
     section has some warmth without going full dark-hero treatment. Kept
     light-touch on purpose; the page is predominantly cream. */
  .c8-awards__wash {
    position: absolute;
    inset: -10%;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 45% at 50% 35%, var(--c8-gold-soft, rgba(245, 166, 35, 0.12)) 0%, transparent 70%),
      radial-gradient(ellipse 40% 30% at 20% 80%, rgba(245, 166, 35, 0.06) 0%, transparent 70%),
      radial-gradient(ellipse 35% 30% at 85% 75%, rgba(245, 166, 35, 0.07) 0%, transparent 70%);
    filter: blur(8px);
  }

  .c8-awards__inner {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
  }

  .c8-awards__head {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto clamp(2.5rem, 5vh, 4rem);
  }
  .c8-awards__heading {
    font-family: var(--montreal, system-ui, sans-serif);
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: #0a0a0a;
    margin: 0 0 1rem;
  }
  .c8-awards__heading em {
    font-style: italic;
    font-family: var(--syne, var(--montreal));
    font-weight: 400;
    color: #0a0a0a;
  }
  .c8-awards__sub {
    font-family: var(--montreal, system-ui, sans-serif);
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.55;
    color: #555;
    margin: 0;
  }

  /* 6 cards across on wide screens, scaling down like the reference. */
  .c8-awards__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: clamp(0.75rem, 1.2vw, 1.25rem);
  }

  /* Cards sit on a very soft cream surface; border + shadow nudge up on
     hover, logo unmasks from grayscale. Same "premium quiet" treatment
     as the Services panels so the visual rhythm carries over. */
  .c8-awards__card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    padding: clamp(1.1rem, 1.8vw, 1.6rem) clamp(0.75rem, 1.2vw, 1.15rem);
    background: linear-gradient(180deg, #ffffff 0%, #fdfbf5 100%);
    border: 1px solid rgba(0, 0, 0, 0.05);
    border-radius: 16px;
    text-align: center;
    box-shadow:
      0 18px 38px -20px rgba(0, 0, 0, 0.1),
      0 0 0 1px rgba(255, 255, 255, 0.5) inset;
    transition:
      transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 0.4s ease,
      box-shadow 0.4s ease;
  }
  .c8-awards__card:hover {
    transform: translateY(-4px);
    border-color: var(--c8-gold-glow, rgba(245, 166, 35, 0.35));
    box-shadow:
      0 26px 52px -20px rgba(0, 0, 0, 0.14),
      0 0 50px -10px var(--c8-gold-soft, rgba(245, 166, 35, 0.12)),
      0 0 0 1px rgba(255, 255, 255, 0.5) inset;
  }

  .c8-awards__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 56px;
    width: 100%;
  }
  .c8-awards__logo img {
    height: 100%;
    max-height: 56px;
    max-width: 70%;
    width: auto;
    object-fit: contain;
    filter: grayscale(1) brightness(0.4);
    opacity: 0.75;
    transition: opacity 0.3s ease, filter 0.3s ease, transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .c8-awards__card:hover .c8-awards__logo img {
    filter: none;
    opacity: 1;
    transform: scale(1.04);
  }

  .c8-awards__title {
    font-family: var(--montreal, system-ui, sans-serif);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    line-height: 1.25;
    color: #0a0a0a;
    margin: 0.3rem 0 0;
  }
  .c8-awards__issuer {
    font-family: var(--montreal, system-ui, sans-serif);
    font-size: 0.78rem;
    color: #777;
    margin: 0;
    letter-spacing: 0.005em;
  }

  /* Gold year pill — mirrors the reference exactly, tinted to our gold. */
  .c8-awards__year {
    display: inline-block;
    margin-top: 0.3rem;
    padding: 0.22rem 0.7rem;
    border-radius: 999px;
    background: var(--c8-gold-soft, rgba(245, 166, 35, 0.12));
    border: 1px solid rgba(245, 166, 35, 0.3);
    color: var(--c8-gold-dark, #d48e1a);
    font-family: var(--montreal, monospace);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  @media (max-width: 1024px) {
    .c8-awards__grid { grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  }
  @media (max-width: 560px) {
    .c8-awards__grid { grid-template-columns: repeat(2, 1fr); gap: 0.85rem; }
    .c8-awards__card { padding: 1rem 0.75rem; }
    .c8-awards__logo { height: 48px; }
    .c8-awards__logo img { max-height: 48px; }
  }
</style>
