// Dynamic KOTA-Style Testimonials Carousel

export interface Testimonial {
  bg: string;
  logo: string;
  alt: string;
  quote: string;
  name: string;
  title: string;
  href: string;
}

export interface Props {
  testimonials?: Testimonial[];
}

const defaultTestis: Testimonial[] = [
  {
    bg: '#d7e1d3',
    logo: '/clients/metamask.png',
    alt: 'NexaChain',
    quote: 'Corum8 delivered our exchange platform two weeks ahead of schedule and ran a launch PR programme that landed us in Forbes and CoinTelegraph in the first month. The all-in-one approach saved us from coordinating between five different vendors.',
    name: 'Marcus Chen',
    title: 'CEO, NexaChain',
    href: '/work'
