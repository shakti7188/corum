---
// Industries — vertical title carousel.
// LEFT: stacked industry titles. The active one is highlighted with
//   a gold rail, white-on-gold treatment, and a thin progress bar
//   underneath that fills as the auto-advance timer ticks.
// RIGHT: a thematic *photo collage* per industry — three Unsplash
//   images placed around the stage with subtle float animations.
//   Crossfades on industry rotation; each image floats independently
//   so the stage feels alive without distracting motion.
//
// Interaction: auto-advances top→bottom every 6s, restarts on every
// title click, and pauses while the user hovers the panel.

type Image = {
  src: string;
  alt: string;
};
type Industry = {
  num: string;
  name: string;
  tagline: string;
  blurb: string;
  bullets: string[];
  cta: string;
  href: string;
  accent: string;
  images: [Image, Image, Image];
};

// Unsplash hot-linked images. The query suffix (?w=900&q=80…)
// requests a sized + format-optimised version directly from
// Unsplash's CDN — no local copy needed.
const u = (id: string, w = 900) =>
  `https://images.unsplash.com/photo-${id}?w=${w}&q=80&auto=format&fit=crop`;

const industries: Industry[] = [
  {
    num: '01',
    name: 'Web3',
    tagline: 'Tokens, exchanges, on-chain infra.',
    blurb: 'We work with the founders building Web3 — from token launches to listed exchanges to live protocols carrying real volume.',
    bullets: [
      'Token launches with live community + Tier-1 PR',
      'CEX & DEX engineering, listings and market-making intros',
      'Wallet, staking and RWA platform development',
    ],
    cta: 'Explore Web3 work',
    href: '/industries/web3',
    accent: '#F2BF22',
    images: [
      { src: u('1622630998477-20aa696ecb05'), alt: 'Bitcoin coin on a laptop keyboard' },
      { src: u('1639152201720-5e536d254d81'), alt: 'Ethereum logo in three dimensions' },
      { src: u('1631603090989-93f9ef6f9d80'), alt: 'Pile of gold Bitcoin coins' },
    ],
  },
  {
    num: '02',
    name: 'AI',
    tagline: 'Foundation-model native products.',
    blurb: 'GTM, brand, and engineering for the AI-first companies setting category in 2026 — agents, foundation-model wrappers, and AI-native SaaS.',
    bullets: [
      'Positioning + launch for AI products that need investor narrative',
      'Foundation-model integrations and agent workflows',
      'AI-native SEO, AEO and GEO so the right answer engines surface you',
    ],
    cta: 'Explore AI work',
    href: '/industries/ai',
    accent: '#A78BFA',
    images: [
      { src: u('1620712943543-bcc4688e7485'), alt: 'Humanoid AI face' },
      { src: u('1531297484001-80022131f5a1'), alt: 'Code on a screen' },
      { src: u('1518770660439-4636190af475'), alt: 'Circuit board detail' },
    ],
  },
  {
    num: '03',
    name: 'Fintech',
    tagline: 'Cards, payments, embedded finance.',
    blurb: 'Regulated fintech brands that need both the engineering rigour and the marketing surface to compete with incumbents.',
    bullets: [
      'Card programmes, lending and embedded-finance launches',
      'MiCA / VARA / FCA-aware compliance narrative',
      'Payment infrastructure and on-chain settlement',
    ],
    cta: 'Explore Fintech work',
    href: '/industries/fintech',
    accent: '#34D399',
    images: [
      { src: u('1601597111158-2fceff292cdc'), alt: 'Mobile banking app' },
      { src: u('1556742049-0cfed4f6a45d'), alt: 'Credit cards' },
      { src: u('1554224155-6726b3ff858f'), alt: 'Currency closeup' },
    ],
  },
  {
    num: '04',
    name: 'SaaS',
    tagline: 'B2B platforms, vertical SaaS, dev tools.',
    blurb: 'From pre-seed positioning through Series-C scale — full-funnel growth, brand, and dev tooling for B2B platforms shipping into noisy markets.',
    bullets: [
      'Performance media + content engines tuned for SQL pipeline',
      'Marketing site + dashboard product UX',
      'Founder-led PR + thought leadership programmes',
    ],
    cta: 'Explore SaaS work',
    href: '/industries/saas',
    accent: '#60A5FA',
    images: [
      { src: u('1460925895917-afdab827c52f'), alt: 'Analytics dashboard' },
      { src: u('1551288049-bebda4e38f71'), alt: 'Workspace with laptop' },
      { src: u('1556761175-5973dc0f32e7'), alt: 'Team strategy session' },
    ],
  },
  {
    num: '05',
    name: 'Enterprise',
    tagline: 'Top-down digital transformation.',
    blurb: 'Brand programmes, internal narrative, and execution muscle for enterprise teams running multi-region, multi-stakeholder rollouts.',
    bullets: [
      'Global brand systems and country-level activation',
      'Internal narrative + change-management programmes',
      'Performance + PR across 30+ markets',
    ],
    cta: 'Explore Enterprise work',
    href: '/industries/enterprise',
    accent: '#FB923C',
    images: [
      { src: u('1542744173-8e7e53415bb0'), alt: 'Modern boardroom' },
      { src: u('1497366216548-37526070297c'), alt: 'Office workspace' },
      { src: u('1486406146926-c627a92ad1ab'), alt: 'Skyscraper financial district' },
    ],
  },
  {
    num: '06',
    name: 'Robotics',
    tagline: 'Hardware-software, deep-tech.',
    blurb: 'Frontier hardware companies translating engineering proof into investor-ready narrative, channel and brand.',
    bullets: [
      'Hardware launch positioning and investor briefs',
      'Technical content + thought leadership for engineering audiences',
      'Channel and partnership marketing programmes',
    ],
    cta: 'Explore Robotics work',
    href: '/industries/robotics',
    accent: '#F472B6',
    images: [
      { src: u('1581091226825-a6a2a5aee158'), alt: 'Robotic arm in factory' },
      { src: u('1535378917042-10a22c95931a'), alt: 'Robot face detail' },
