---
import Layout from "../layouts/Layout.astro";
import KotaverseCta from "../components/KotaverseCta.astro";

const industries = [
  {
    slug: "/industries/web3",
    name: "Web3 & Crypto",
    desc: "Exchanges, wallets, RWAs, DeFi, tokens — and the launch engine around them.",
    tag: "Core practice",
  },
  {
    slug: "/industries/fintech",
    name: "Fintech",
    desc: "Banks, neobanks, payment rails, lending — and the regulatory surface around each.",
    tag: "Regulated",
  },
  {
    slug: "/industries/ai",
    name: "AI",
    desc: "Agents, copilots, LLM pipelines — and the go-to-market that separates your launch from the wall of me-too AI.",
    tag: "Emerging",
  },
  {
    slug: "/industries/saas",
    name: "SaaS",
    desc: "B2B and B2C SaaS — product-led growth, enterprise sales motions, and the stack under both.",
    tag: "PLG & ABM",
  },
  {
    slug: "/industries/startups",
    name: "Startups",
    desc: "Pre-seed to Series A — products built for investors, users and the markets you haven't reached yet.",
    tag: "Early-stage",
  },
  {
    slug: "/industries/enterprise",
    name: "Enterprise",
    desc: "Fortune 500, financial institutions, government tech — delivery on the procurement clock.",
    tag: "Procurement",
  },
];
---
<Layout title="Industries | Corum8">

<section class="Hero_hero__zbooM"><div class="container"><div class="Hero_top__UZ6SA"><h2><span class="LineByLine_headingOuter__JmusT"><span>Six industries. One team. Delivery from strategy to production.</span></span></h2></div><div class="Hero_bottom__pLxrT"><h1><span class="MaskInUp_container__0AW5i" data-fill="false"><div><span><i></i>Industries</span></div></span></h1><div class="Hero_arrow__WTdEi"><span class="FadeInRotate_container__QE9u9" data-fill="false" data-direction="counterclockwise"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 75.91 75.65"><path d="m13.65 67.65 61.93-62L69.92 0 8 61.99V.25H0v75.4h75.91v-8H13.65z" style="stroke-width:0"></path></svg></span></div></div></div></section>

<section class="c8-industries-grid">
  <div class="container">
    <p class="c8-industries-lede">We work across six industries that share one thing — they move fast, regulate hard, and punish generic marketing. Pick the one that looks like your team.</p>
    <div class="c8-industries-list">
      {industries.map((i) => (
        <a class="c8-industry-card" href={i.slug}>
          <div class="c8-industry-card__meta">
            <span class="c8-industry-card__tag">{i.tag}</span>
          </div>
          <h3 class="c8-industry-card__name">{i.name}</h3>
          <p class="c8-industry-card__desc">{i.desc}</p>
          <span class="c8-industry-card__cta">
            Explore
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 17.1 15.17" width="14">
              <path d="m17.1,7.58s-.01-.04-.01-.06c.01-.22-.06-.45-.24-.61L9.23.19c-.31-.27-.78-.24-1.06.07-.27.31-.24.78.07,1.06l6.26,5.52H.75c-.41,0-.75.34-.75.75s.34.75.75.75h13.74l-6.26,5.52c-.31.27-.34.75-.07,1.06.15.17.35.25.56.25.18,0,.35-.06.5-.19l7.62-6.72c.18-.16.25-.39.24-.61,0-.02.01-.04.01-.06Z" fill="currentColor"></path>
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<KotaverseCta
  light="One team."
  bold="Six industries."
  subtitle="Book a call. We'll tell you what we'd do first."
/>

<style>
  .c8-industries-grid {
    padding: clamp(4rem, 8vw, 8rem) 0;
    background: #fafafa;
  }
  .c8-industries-lede {
    max-width: 42rem;
    margin: 0 auto 4rem;
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.7;
    color: #444;
    text-align: center;
  }
  .c8-industries-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
    max-width: 1400px;
    margin: 0 auto;
  }
  .c8-industry-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2.25rem;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 1.25rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.4s ease;
  }
  .c8-industry-card:hover {
    transform: translateY(-4px);
    border-color: var(--c8-gold);
    box-shadow: 0 28px 50px -24px rgba(0, 0, 0, 0.18);
  }
  .c8-industry-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .c8-industry-card__tag {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #888;
    font-weight: 600;
  }
  .c8-industry-card__name {
    font-size: clamp(1.45rem, 2vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0;
    color: #111;
  }
  .c8-industry-card__desc {
    font-size: 1rem;
    line-height: 1.6;
    color: #444;
    margin: 0;
  }
  .c8-industry-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: #111;
  }
  .c8-industry-card:hover .c8-industry-card__cta svg {
    transform: translateX(4px);
  }
  .c8-industry-card__cta svg {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
</style>

</Layout>
