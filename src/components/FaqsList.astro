---
// FAQ — centered single-column accordion. One question open at a time.
// No yellow / gold accents — kept entirely in neutral black/grey so it
// reads as quiet editorial rather than branded.

import { faqs } from '../data/content';
---

<section class="c8-faq">
  <div class="c8-faq__inner">
    <header class="c8-faq__head" data-reveal-stagger="100">
      <h2 class="c8-faq__heading" data-reveal="up">Frequently asked questions</h2>
    </header>

    <ol class="c8-faq__list" data-reveal-stagger="60">
      {faqs.map((f, i) => (
        <li class="c8-faq__item" data-reveal="up">
          <button
            type="button"
            class={`c8-faq__q${i === 0 ? ' is-active' : ''}`}
            aria-expanded={i === 0 ? 'true' : 'false'}
            aria-controls={`c8-faq-a-${i}`}
            data-faq-index={i}
          >
            <span class="c8-faq__q-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="c8-faq__q-text">{f.q}</span>
            <span class="c8-faq__q-icon" aria-hidden="true">
              <span class="c8-faq__q-bar c8-faq__q-bar--h"></span>
              <span class="c8-faq__q-bar c8-faq__q-bar--v"></span>
            </span>
          </button>
          <div
            class="c8-faq__a"
            id={`c8-faq-a-${i}`}
            role="region"
            aria-hidden={i === 0 ? 'false' : 'true'}
            data-open={i === 0 ? 'true' : 'false'}
          >
            <div class="c8-faq__a-inner">
              <p>{f.a}</p>
            </div>
          </div>
        </li>
      ))}
    </ol>

    <footer class="c8-faq__foot" data-reveal="up">
      <p class="c8-faq__foot-text">Still have a question?</p>
      <a class="c8-faq__foot-cta" href="/contact">
        <span>Book a strategy call</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </footer>
  </div>
</section>

<style is:global>
  .c8-faq {
    background: #ffffff;
    color: #0a0a0a;
    padding: clamp(4rem, 8vh, 6rem) clamp(1.5rem, 5vw, 5rem);
    border-top: 1px solid rgba(0,0,0,0.05);
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }
  /* Inner intentionally narrower than the global section rail —
     long-form copy reads better in a tighter measure. */
  .c8-faq__inner {
    max-width: 780px;
    margin: 0 auto;
  }

  /* ─── Head — centered ─── */
  .c8-faq__head {
    text-align: center;
    margin: 0 0 clamp(2.5rem, 5vh, 3.5rem);
  }
  .c8-faq__eyebrow {
    margin: 0 0 1rem;
    font-family: var(--montreal);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #6b6b6b;
  }
  .c8-faq__heading {
    margin: 0 0 0.85rem;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.2vw, 3.1rem);
    font-weight: 350;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .c8-faq__heading-accent {
    color: #6b6b6b;
    font-weight: 350;
  }
  .c8-faq__sub {
    margin: 0 auto;
    max-width: 38rem;
    font-family: var(--montreal);
    font-size: 0.98rem;
    line-height: 1.55;
    color: #555;
  }

  /* ─── List ─── */
  .c8-faq__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(0,0,0,0.1);
  }
  .c8-faq__item {
    border-bottom: 1px solid rgba(0,0,0,0.1);
  }

  /* Question row */
  .c8-faq__q {
    appearance: none;
    width: 100%;
    background: transparent;
    border: 0;
    text-align: left;
    cursor: pointer;
    color: #0a0a0a;
    padding: clamp(1.2rem, 2vw, 1.5rem) 0.5rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    column-gap: clamp(0.85rem, 1.4vw, 1.4rem);
    align-items: center;
    font-family: inherit;
    transition: padding-left 0.4s ease, background 0.4s ease, color 0.3s ease;
  }
  .c8-faq__q:hover {
    background: rgba(0, 0, 0, 0.02);
  }
  .c8-faq__q.is-active {
    background: rgba(0, 0, 0, 0.025);
  }

  .c8-faq__q-num {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: rgba(0, 0, 0, 0.45);
    transition: color 0.35s ease;
  }
  .c8-faq__q.is-active .c8-faq__q-num,
  .c8-faq__q:hover .c8-faq__q-num { color: #0a0a0a; }

  .c8-faq__q-text {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    font-weight: 350;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: #0a0a0a;
  }

  /* Plus icon — vertical bar collapses to scaleY(0) on open. */
  .c8-faq__q-icon {
    width: 22px;
    height: 22px;
    position: relative;
    display: inline-block;
    flex: 0 0 auto;
    color: rgba(0, 0, 0, 0.55);
    transition: color 0.3s ease, transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .c8-faq__q-bar {
    position: absolute;
    background: currentColor;
    border-radius: 1px;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .c8-faq__q-bar--h {
    left: 0; right: 0; top: 50%;
    height: 2px;
    transform: translateY(-50%);
  }
  .c8-faq__q-bar--v {
    top: 0; bottom: 0; left: 50%;
    width: 2px;
    transform: translateX(-50%) scaleY(1);
    transform-origin: center;
  }
  .c8-faq__q.is-active .c8-faq__q-bar--v {
    transform: translateX(-50%) scaleY(0);
  }
  .c8-faq__q.is-active .c8-faq__q-icon {
    color: #0a0a0a;
    transform: rotate(180deg);
  }

  /* Answer — auto-height transition via grid-template-rows. */
  .c8-faq__a {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
    background: rgba(0, 0, 0, 0.025);
  }
  .c8-faq__a[data-open="true"] { grid-template-rows: 1fr; }
  .c8-faq__a-inner {
    overflow: hidden;
    min-height: 0;
  }
  .c8-faq__a p {
    margin: 0;
    padding: 0.4rem 2.6rem 1.6rem 2.7rem;
    font-family: var(--montreal);
    font-size: 0.98rem;
    line-height: 1.65;
    color: #4a4a4a;
  }
  @media (max-width: 600px) {
    .c8-faq__a p { padding-left: 0.75rem; padding-right: 0.5rem; }
  }

  /* ─── Footer CTA ─── */
  .c8-faq__foot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    margin: clamp(2.5rem, 5vh, 3.5rem) 0 0;
    text-align: center;
  }
  .c8-faq__foot-text {
    margin: 0;
    font-family: var(--montreal);
    font-size: 0.92rem;
    color: #6b6b6b;
  }
  .c8-faq__foot-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.85rem 1.5rem;
    background: #0a0a0a;
    color: #fff;
    text-decoration: none;
    border-radius: 999px;
    font-family: var(--montreal);
    font-size: 0.9rem;
    font-weight: 600;
    transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease;
  }
  .c8-faq__foot-cta:hover {
    background: #fff;
    color: #0a0a0a;
    box-shadow: inset 0 0 0 1.5px #0a0a0a;
    transform: translateY(-2px);
  }
</style>

<script is:inline>
  /* Single-open accordion. Clicking a question:
     1. Closes whichever question was open.
     2. Opens the clicked one.
     If the clicked question is already open, it closes (so the user
     can fully collapse the section if they want). */
  function startFaqs() {
    var buttons = document.querySelectorAll('.c8-faq__q');
    var panels  = document.querySelectorAll('.c8-faq__a');
    if (!buttons.length || !panels.length) return;

    function setOpen(index) {
      Array.prototype.forEach.call(buttons, function (b, i) {
        var on = (i === index);
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-expanded', on ? 'true' : 'false');
        if (panels[i]) {
          panels[i].setAttribute('data-open', on ? 'true' : 'false');
          panels[i].setAttribute('aria-hidden', on ? 'false' : 'true');
        }
      });
    }

    Array.prototype.forEach.call(buttons, function (b, i) {
      b.addEventListener('click', function () {
        var alreadyOpen = b.getAttribute('aria-expanded') === 'true';
        // -1 = no-op / close all, otherwise open i.
        setOpen(alreadyOpen ? -1 : i);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startFaqs, { once: true });
  } else {
    startFaqs();
  }
</script>
