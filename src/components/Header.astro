---
import { brand, ctaLink } from '../data/siteNav';
import BrandMark from './BrandMark.astro';
import ArrowIcon from './ArrowIcon.astro';
---
<header class="Header_header__KwdYD" data-modal-hide="true" data-c8-sticky>
  <div class="Header_left">
    <a class="Header_logo____uDV" href="/" aria-label={brand.name}>
      <BrandMark variant="dark" />
    </a>
  </div>
  
  <nav class="MegaMenu_nav">
    <ul class="MegaMenu_list">
      <!-- Non-Dropdown Links -->
      <li class="MegaMenu_item"><a href="/" class="MegaMenu_link">Home</a></li>
      
      <!-- Marketing Mega Menu -->
      <li class="MegaMenu_item has-dropdown">
        <a href="/services/marketing" class="MegaMenu_link">Marketing <span class="Chevron"></span></a>
        
        <div class="MegaDropdown">
          <div class="MegaDropdown_bg"></div>
          <div class="MegaDropdown_inner">
            <div class="MegaColWrapper"><div class="MegaCol">
              <h4 class="MegaCol_title">Growth &amp; Digital</h4>
              <a href="/services/marketing/performance-marketing"><span>Performance Marketing</span><span class="MegaCol_desc">Full-funnel ads across Meta, Google & X</span></a>
              <a href="/services/marketing/seo"><span>SEO, AEO &amp; GEO</span><span class="MegaCol_desc">Rank on Google, appear in AI answers</span></a>
              <a href="/services/marketing/social-media"><span>Social Media Management</span><span class="MegaCol_desc">Platform-native strategy & reporting</span></a>
              <a href="/services/marketing/b2b-marketing"><span>B2B &amp; Lead Generation</span><span class="MegaCol_desc">ABM, LinkedIn outreach & CRM pipelines</span></a>
            </div>
            <div class="MegaCol">
              <h4 class="MegaCol_title">PR &amp; Branding</h4>
              <a href="/services/marketing/pr"><span>Crypto PR &amp; Media</span><span class="MegaCol_desc">Coverage across 10,000+ publications</span></a>
              <a href="/services/marketing/branding"><span>Branding &amp; Design Studio</span><span class="MegaCol_desc">Identity, pitch decks & motion graphics</span></a>
              <a href="/services/marketing/content"><span>Content Marketing</span><span class="MegaCol_desc">Blogs, whitepapers & thought leadership</span></a>
            </div>
            <div class="MegaCol">
              <h4 class="MegaCol_title">Web3 Specific</h4>
              <a href="/services/marketing/influencer-marketing"><span>Influencer &amp; KOL Marketing</span><span class="MegaCol_desc">25,000+ vetted influencers globally</span></a>
              <a href="/services/marketing/community"><span>Community Building</span><span class="MegaCol_desc">Telegram, Discord & organic growth</span></a>
              <a href="/services/marketing/listing"><span>Exchange Listings</span><span class="MegaCol_desc">CEX listing strategy & market making</span></a>
            </div></div>
            <div class="MegaCta">
              <p>25,000+ influencers. 10,000+ media outlets. Full-funnel campaigns.</p>
              <a href="/contact" class="Header_button__yG4_K MegaButton">
                <span class="Header_text__taNU6">
                  <span>Get Started</span>
                  <ArrowIcon class="Header_buttonArrow__frtNz" />
                </span>
              </a>
            </div>
          </div>
        </div>
      </li>

      <!-- Development Mega Menu -->
      <li class="MegaMenu_item has-dropdown">
        <a href="/services/development" class="MegaMenu_link">Development <span class="Chevron"></span></a>
        
        <div class="MegaDropdown">
          <div class="MegaDropdown_bg"></div>
          <div class="MegaDropdown_inner">
            <div class="MegaColWrapper"><div class="MegaCol">
              <h4 class="MegaCol_title">Web3 &amp; Blockchain</h4>
              <a href="/services/development/exchange"><span>CEX &amp; DEX Exchanges</span><span class="MegaCol_desc">Custom exchange platforms</span></a>
              <a href="/services/development/rwa"><span>RWA Marketplace</span><span class="MegaCol_desc">Tokenize real-world assets</span></a>
              <a href="/services/development/wallet"><span>Wallet Infrastructure</span><span class="MegaCol_desc">Enterprise-grade wallet systems</span></a>
              <a href="/services/development/defi"><span>DeFi &amp; Staking Platforms</span><span class="MegaCol_desc">Battle-tested DeFi protocols</span></a>
            </div>
            <div class="MegaCol">
              <h4 class="MegaCol_title">AI &amp; Core Tech</h4>
              <a href="/services/development/ai"><span>AI &amp; Automation</span><span class="MegaCol_desc">Production AI systems & workflows</span></a>
              <a href="/services/development/mobile-web"><span>Mobile &amp; Web Apps</span><span class="MegaCol_desc">High-performance applications</span></a>
              <a href="/services/development/token"><span>Token &amp; Stablecoin</span><span class="MegaCol_desc">End-to-end token launches</span></a>
              <a href="/services/development/blockchain-layer"><span>Blockchain L0/L1/L2</span><span class="MegaCol_desc">Custom layer development</span></a>
            </div>
            <div class="MegaCol">
              <h4 class="MegaCol_title">Fintech &amp; Trading</h4>
              <a href="/services/development/payment"><span>Payment Solutions</span><span class="MegaCol_desc">Crypto-fiat gateways & payment rails</span></a>
              <a href="/services/development/trading"><span>Trading Bots &amp; Tools</span><span class="MegaCol_desc">Automated trading infrastructure</span></a>
              <a href="/services/development/nft"><span>NFT Marketplace</span><span class="MegaCol_desc">Custom NFT platforms & launchpad</span></a>
            </div></div>
            <div class="MegaCta">
              <p>200+ products delivered. 40+ white-label solutions ready to deploy.</p>
              <a href="/contact" class="Header_button__yG4_K MegaButton">
                <span class="Header_text__taNU6">
                  <span>View Products</span>
                  <ArrowIcon class="Header_buttonArrow__frtNz" />
                </span>
              </a>
            </div>
          </div>
        </div>
      </li>

      <!-- Simple Dropdowns -->
      <li class="MegaMenu_item has-dropdown">
        <a href="/industries" class="MegaMenu_link">Industries <span class="Chevron"></span></a>
        <div class="MegaDropdown MiniDropdown">
          <div class="MegaDropdown_bg"></div>
          <div class="MegaDropdown_inner">
            <div class="MegaCol">
              <a href="/industries/web3">Web3 &amp; Crypto</a>
              <a href="/industries/startups">Startups</a>
              <a href="/industries/saas">SaaS</a>
              <a href="/industries/fintech">Fintech</a>
              <a href="/industries/ai">AI</a>
              <a href="/industries/enterprise">Enterprise</a>
            </div>
          </div>
        </div>
      </li>

      <li class="MegaMenu_item has-dropdown">
        <a href="/resources" class="MegaMenu_link">Resources <span class="Chevron"></span></a>
        <div class="MegaDropdown MiniDropdown">
          <div class="MegaDropdown_bg"></div>
          <div class="MegaDropdown_inner">
            <div class="MegaCol">
              <a href="/case-studies">Case Studies</a>
              <a href="/gallery">Gallery</a>
              <a href="/blog">Blog</a>
              <a href="/insights">Insights</a>
              <a href="/guides">Guides</a>
            </div>
          </div>
        </div>
      </li>

      <li class="MegaMenu_item has-dropdown">
        <a href="/about" class="MegaMenu_link">About <span class="Chevron"></span></a>
        <div class="MegaDropdown MiniDropdown">
          <div class="MegaDropdown_bg"></div>
          <div class="MegaDropdown_inner">
            <div class="MegaCol">
              <a href="/about/company">Company</a>
              <a href="/about/team">Team</a>
              <a href="/about/careers">Careers</a>
              <a href="/contact">Contact</a>
            </div>
          </div>
        </div>
      </li>

    </ul>
  </nav>

  <div class="Header_right">
    <a class="Header_button__yG4_K" href={ctaLink.href}>
      <span class="Header_text__taNU6">
        <span>{ctaLink.shortLabel}</span>
        <ArrowIcon class="Header_buttonArrow__frtNz" />
      </span>
    </a>
  </div>
</header>

<style is:global>
  /* Brand palette — gold sampled to match the Corum8 logo mark. Defined on
     the Header because the Header mounts on every page (Layout-based and
     the self-headed index.astro). CSS variables cascade, so downstream
     components can read var(--c8-gold) anywhere. */
  :root {
    --c8-gold: #d4a23a;
    --c8-gold-soft: rgba(212, 162, 58, 0.12);
    --c8-gold-glow: rgba(212, 162, 58, 0.35);
  }

  /* Base Header Layout — sticky so it stays available as the user scrolls. */
  .Header_header__KwdYD {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 100;
    transition: padding 0.3s ease, background-color 0.3s ease,
                backdrop-filter 0.3s ease, -webkit-backdrop-filter 0.3s ease,
                box-shadow 0.3s ease;
  }
  /* Scrolled state — compact bar with a subtle glass surface + hairline.
     Prefixing with `header` bumps specificity (type + class + attribute)
     above any kota-core `.Header_header__KwdYD` selector, and every
     override uses !important so width-specific media rules can't beat it. */
  header.Header_header__KwdYD[data-scrolled="true"] {
    padding-top: 0.5rem !important;
    padding-bottom: 0.5rem !important;
    padding-left: clamp(1rem, 3vw, 2rem) !important;
    padding-right: clamp(1rem, 3vw, 2rem) !important;
    background-color: rgba(255, 255, 255, 0.85) !important;
    backdrop-filter: saturate(160%) blur(14px) !important;
    -webkit-backdrop-filter: saturate(160%) blur(14px) !important;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06) !important;
    box-shadow: 0 10px 30px -18px rgba(0, 0, 0, 0.18) !important;
  }
  .Header_left, .Header_right {
    flex: 0 0 auto;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* Give logo same left breathing room as the CTA has on the right */
  .Header_left {
    padding-left: clamp(1rem, 2vw, 2rem);
  }
  /* Shrink the logo mark when scrolled */
  .Header_header__KwdYD .Header_logo____uDV {
    display: inline-flex;
    align-items: center;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: left center;
  }
  header.Header_header__KwdYD[data-scrolled="true"] .Header_logo____uDV {
    transform: scale(0.78) !important;
  }
  header.Header_header__KwdYD[data-scrolled="true"] .Header_logo____uDV svg {
    width: 2.5rem !important;
  }
  /* Tighten menu item padding + slightly shrink links when scrolled */
  header.Header_header__KwdYD[data-scrolled="true"] .MegaMenu_item {
    padding: 0.85rem 0 !important;
    transition: padding 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .MegaMenu_item {
    transition: padding 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .MegaMenu_link {
    transition: color 0.3s ease, font-size 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  header.Header_header__KwdYD[data-scrolled="true"] .MegaMenu_link {
    font-size: 0.95rem !important;
  }
  /* Shrink header CTA to match the compact bar */
  .Header_header__KwdYD .Header_button__yG4_K {
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), padding 0.35s ease;
    transform-origin: right center;
  }
  header.Header_header__KwdYD[data-scrolled="true"] .Header_button__yG4_K {
    transform: scale(0.88) !important;
  }

  /* Mega Menu Nav Core */
  .MegaMenu_nav {
    pointer-events: auto !important;
    flex: 1 1 auto;
    display: none; /* Hide on mobile to fallback to Nav.astro slider */
    justify-content: center;
  }
  @media (min-width: 1024px) {
    .MegaMenu_nav {
    pointer-events: auto !important; display: flex; }
    .PrimaryNavigation_page__DgiUM { display: none !important; }
  }
  /* Retire the KOTA PrimaryNavigation entirely — our Header owns all nav now.
     Previously the hamburger was only hidden at >=1024px, so the old drawer
     leaked through on mobile. Hiding the whole wrapper keeps its background
     panel and overlay out too. */
  

  .MegaMenu_list {
    display: flex;
    gap: 2.5rem;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }


  .MegaMenu_nav, .MegaMenu_list, .MegaMenu_item {
    position: static !important;
  }
  /* Items whose dropdown is a MiniDropdown need to anchor it to the trigger,
     not the full header, so override the static positioning above. */
  .MegaMenu_item:has(.MiniDropdown) {
    position: relative !important;
  }

  .MegaMenu_item {
    padding: 2rem 0;
  }

  .MegaMenu_link {
    color: var(--theme-primary);
    font-size: 1.1rem;
    font-weight: 500;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: color 0.3s ease;
  }
  .MegaMenu_item:hover .MegaMenu_link {
    opacity: 0.7;
  }

  .Chevron {
    width: 8px;
    height: 8px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .MegaMenu_item:hover .Chevron {
    transform: rotate(-135deg) translateY(-2px);
  }

  /* The Dropdown Container
     Two fixes for the "closes before my cursor gets there" bug:
     1. padding-top 0 so the visible panel sits flush with the menu bar — no
        empty gap for the cursor to fall into.
     2. visibility/pointer-events are delayed on hover-OUT only, so leaving
        the menu briefly doesn't tear the dropdown away. A 150ms grace window
        lets the cursor travel onto the panel without the bridge disappearing.
  */
  .MegaDropdown {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    display: flex;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px) scale(0.98);
    transform-origin: top center;
    transition:
      opacity    0.35s cubic-bezier(0.16, 1, 0.3, 1) 0.15s,
      transform  0.35s cubic-bezier(0.16, 1, 0.3, 1) 0.15s,
      visibility 0s linear 0.5s;
    pointer-events: none;
    z-index: 1000;
    padding-top: 0;
  }
  .MegaMenu_item:hover .MegaDropdown,
  .MegaMenu_item:focus-within .MegaDropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
    pointer-events: auto;
    /* Cancel the out-delay for show */
    transition-delay: 0s, 0s, 0s;
  }

  /* Invisible hover bridge — spans the full width between menu bar and panel
     so diagonal cursor movement to the dropdown never drops hover. */
  .MegaDropdown::before {
    content: '';
    position: absolute;
    top: -2rem;
    left: 0;
    right: 0;
    height: 2rem;
  }

  /* The Glass Background sits flush with header bottom */
  .MegaDropdown_bg {
    position: absolute;
    top: 0; left: 50%; transform: translateX(-50%);
    width: calc(100% - 4rem); max-width: 1300px; bottom: 0;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 2rem;
    box-shadow: 0 40px 80px rgba(0,0,0,0.1), 0 10px 20px rgba(0,0,0,0.05);
    z-index: -1;
  }

  /* Mini dropdown (Industries / Resources / About) — tight card, auto-sized */
  .MiniDropdown {
    /* Centre the whole mini panel under its trigger instead of spanning
       full header width. */
    left: 50%;
    right: auto;
    width: auto;
    max-width: 320px;
    transform: translateX(-50%) translateY(6px) scale(0.98);
  }
  .MegaMenu_item:hover .MiniDropdown,
  .MegaMenu_item:focus-within .MiniDropdown {
    transform: translateX(-50%) translateY(0) scale(1);
  }
  .MiniDropdown .MegaDropdown_bg {
    left: 0;
    transform: none;
    width: 100%;
    max-width: none;
  }
  .MiniDropdown .MegaDropdown_inner {
    width: 100%;
    max-width: none;
    padding: 0.75rem 1rem;
  }
  .MiniDropdown .MegaCol {
    gap: 0;
    min-width: 0;
    width: 100%;
  }
  .MiniDropdown .MegaCol a {
    padding: 0.7rem 0.9rem !important;
    font-size: 1rem !important;
    font-weight: 500 !important;
    border-radius: 0.6rem;
    color: #333 !important;
    transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease, opacity 0.3s ease !important;
  }
  .MiniDropdown .MegaCol a span:first-child {
    font-size: 1rem !important;
  }
  /* Group-hover physics for mini dropdowns — siblings dim while the hovered
     row lights up with a soft gold wash that echoes the logo mark. Text
     color stays dark on purpose: yellow text reads poorly on light bg. */
  .MiniDropdown .MegaCol:hover a {
    opacity: 0.45;
  }
  .MiniDropdown .MegaCol a:hover {
    opacity: 1 !important;
    color: #111 !important;
    background: var(--c8-gold-soft) !important;
    box-shadow: inset 0 0 0 1px var(--c8-gold-glow);
    transform: translateX(4px);
  }



  /* Glassmorphism Background */


  /* Grid Architecture
     Inner shares the exact same centering as .MegaDropdown_bg so the CTA
     card always sits inside the panel, at any viewport width. */
  .MegaDropdown_inner {
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    width: calc(100% - 4rem);
    max-width: 1300px;
    padding: 3.5rem;
    gap: 2rem;
    justify-content: space-between;
    box-sizing: border-box;
  }
  .MegaColWrapper {
    flex-shrink: 0;
    display: flex;
    gap: 3rem;
    flex: 1;
  }

  .MiniDropdown .MegaDropdown_inner {
    padding: 2rem;
    justify-content: center;
  }

  .MegaCol {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 200px;
  }

  .MegaCol_title {
    color: #999;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }

  .MegaCol a {
    color: #000;
    font-size: 1.15rem;
    text-decoration: none;
    font-weight: 500;
    position: relative;
    padding-bottom: 0.25rem;
    width: fit-content;
    transition: color 0.3s ease;
  }

  /* Premium Hover Underline Animation */
  .MegaCol a::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    width: 0%;
    height: 1px;
    background: linear-gradient(90deg, #7c41f3, #ff6eff);
    transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .MegaCol a:hover {
    color: #000;
  }
  .MegaCol a:hover::after {
    width: 100%;
  }

  /* Mega CTA Block */
  .MegaCta {
    flex-shrink: 0;
    background: linear-gradient(135deg, #1B0F2A 0%, #300C39 100%) !important;
    border-radius: 1.5rem;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
    width: 320px;
    min-height: 100%;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    position: relative;
    overflow: hidden;
  }
  /* Decorative Glass Orb inside CTA */
  .MegaCta::after {
    content: ""; position: absolute;
    width: 250px; height: 250px;
    background: radial-gradient(circle, rgba(255,110,255,0.4) 0%, rgba(124,65,243,0) 70%);
    top: -50px; right: -50px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
  }
  .MegaCta p, .MegaCta h4, .MegaCta a {
    position: relative; z-index: 1;
  }
  .MegaCta p {
    color: #F8F8F8 !important;
    font-size: 1.2rem;
    line-height: 1.6;
    margin: 0;
    font-weight: 500;
  }
  .MegaCta .MegaButton {
    background: #fff !important;
    color: #000 !important;
  }
  .MegaCta .MegaButton:hover {
    background: var(--c8-gold) !important;
    color: #111 !important;
    transform: scale(1.05);
    box-shadow: 0 10px 30px var(--c8-gold-glow);
  }

  .MegaButton {
    width: fit-content;
    border-radius: 2rem;
  }

  /* KOTA ships the header CTA with a pink (#ff34f3) hover. Re-tint to gold so
     the primary button accent tracks the logo mark. Text stays light for
     contrast on the dark pill. */
  .Header_button__yG4_K:hover {
    background: var(--c8-gold) !important;
    color: #111 !important;
    box-shadow: 0 10px 28px var(--c8-gold-glow);
  }
  .Header_button__yG4_K:hover .Header_buttonArrow__frtNz,
  .Header_button__yG4_K:hover .Header_text__taNU6 {
    color: #111 !important;
  }
  
  /* Staggered Fade-in Animation for columns */
  .MegaCol {
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .MegaMenu_item:hover .MegaCol:nth-child(1) { transition-delay: 0.1s; opacity: 1; transform: translateY(0); }
  .MegaMenu_item:hover .MegaCol:nth-child(2) { transition-delay: 0.15s; opacity: 1; transform: translateY(0); }
  .MegaMenu_item:hover .MegaCol:nth-child(3) { transition-delay: 0.2s; opacity: 1; transform: translateY(0); }
  .MegaMenu_item:hover .MegaCta { transition-delay: 0.25s; opacity: 1; transform: translateY(0); }
  .MegaCta {
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .Header_header__KwdYD {
    transform: none !important;
    background: transparent;
    border-bottom: none;
  }
  
  /* Mega Col Subtext & Color Enhancements */

  .MegaCol a {
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
    gap: 0.35rem !important;
    padding: 1rem !important;
    border-radius: 0.75rem;
    width: 100% !important;
    white-space: normal !important;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1) !important;
    clear: both;
  }
  .MegaCol a span:first-child {
    font-size: 1.05rem !important;
    font-weight: 600 !important;
    color: #111 !important;
    letter-spacing: -0.02em !important;
  }
  
  /* The Group Hover Physics Engine */
  .MegaColWrapper:hover .MegaCol a {
    opacity: 0.4;
    transform: scale(0.98);
  }
  .MegaColWrapper:hover .MegaCol a:hover {
    opacity: 1;
    transform: translateX(4px);
    background: #f8f8fb !important;
    border-radius: 12px;
  }

  
  .MegaCol a span {
    display: block !important;
    line-height: 1.2 !important;
    width: 100% !important;
  }

  
  .MegaCol a::after {
    display: none !important; /* Disable underline, replace with block highlight */
  }

  .MegaCol_title {
    padding-left: 1rem;
    color: #888 !important;
    font-size: 0.75rem;
    font-weight: 600 !important;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  


  .MegaCol_desc {
    font-size: 0.8rem;
    color: #888;
    font-weight: 400;
    line-height: 1.4;
    margin-top: 0.15rem;
  }
  
  /* Dark CTA panel — white text was unreadable on the earlier light purple. */
  .MegaCta {
    flex-shrink: 0;
    background: linear-gradient(135deg, #1B0F2A 0%, #300C39 100%) !important;
    border-color: rgba(255, 255, 255, 0.1) !important;
  }
  .MegaCta p {
    color: #ffffff !important;
  }
</style>

<script is:inline>
  (() => {
    const header = document.querySelector('[data-c8-sticky]');
    if (!header) return;
    const THRESHOLD = 40;

    const read = () =>
      window.scrollY ||
      window.pageYOffset ||
      document.documentElement.scrollTop ||
      document.body.scrollTop ||
      0;

    let lastState = null;
    const apply = () => {
      const scrolled = read() > THRESHOLD;
      if (scrolled === lastState) return;
      lastState = scrolled;
      if (scrolled) header.setAttribute('data-scrolled', 'true');
      else header.removeAttribute('data-scrolled');
    };

    // 1) Native scroll listeners — window + document catch any dispatcher,
    //    including smooth-scroll wrappers that sometimes bubble on document.
    window.addEventListener('scroll', apply, { passive: true, capture: true });
    document.addEventListener('scroll', apply, { passive: true, capture: true });

    // 2) IntersectionObserver sentinel — flips state when scroll crosses the
    //    threshold even if no scroll events make it to the listener.
    const sentinel = document.createElement('div');
    sentinel.setAttribute('aria-hidden', 'true');
    sentinel.style.cssText =
      'position:absolute;top:0;left:0;width:1px;height:' +
      THRESHOLD +
      'px;pointer-events:none;';
    document.body.prepend(sentinel);
    new IntersectionObserver(
      (entries) => entries.forEach(() => apply()),
      { threshold: 0 }
    ).observe(sentinel);

    // 3) rAF polling — last-resort belt-and-suspenders for any transform-based
    //    scroll engine (Lenis, locomotive) that doesn't emit scroll at all.
    let lastY = -1;
    const tick = () => {
      const y = read();
      if (y !== lastY) {
        lastY = y;
        apply();
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);

    apply();
  })();
</script>
