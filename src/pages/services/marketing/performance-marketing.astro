            >
              <span class="lp-tab__num">0{i + 1}</span>
              <span class="lp-tab__label">{d.label}</span>
            </button>
          ))}
        </nav>

        <div class="lp-tabs__stage">
          {deliverables.map((d, i) => (
            <article
              class={`lp-tabs__panel${i === 0 ? ' is-active' : ''}`}
              id={`lp-tab-panel-${d.key}`}
              role="tabpanel"
              aria-hidden={i === 0 ? 'false' : 'true'}
            >
              <figure class="lp-tabs__media">
                <img src={d.img} alt={d.label} loading="lazy" />
                <span class="lp-tabs__claim">{d.claim}</span>
              </figure>
              <div class="lp-tabs__body">
                <span class="lp-tabs__pillar-num">0{i + 1} · {d.label}</span>
                <h3 class="lp-tabs__headline">{d.headline}</h3>
                <ul class="lp-tabs__points">
                  {d.points.map((p) => (
