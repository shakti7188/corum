---
import { logos } from "../data/content";
// Duplicate list so translateX(-50%) loops seamlessly.
const track = [...logos, ...logos];
---

<section class="section-pad-small border-t border-[color:var(--color-rule)] overflow-hidden">
  <div class="container-wide mb-10" data-reveal-group>
    <p data-reveal class="text-[12px] uppercase tracking-[0.2em] text-[color:var(--color-ink-mute)] text-center">
      Trusted by brands across industries
    </p>
  </div>

  <div class="marquee" data-reveal>
    <div class="marquee-track gap-14 md:gap-20">
      {
        track.map((src, i) => (
          <div class="flex items-center justify-center min-w-[140px] md:min-w-[180px]">
            <img
              src={src}
              alt=""
              aria-hidden={i >= logos.length ? "true" : undefined}
              class="h-8 md:h-9 w-auto object-contain opacity-70 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300"
              loading="lazy"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
