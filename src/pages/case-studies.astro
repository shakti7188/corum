---
import Layout from "../layouts/Layout.astro";
import FinalCta from "../components/FinalCta.astro";

// ──────────────────────────────────────────────────────────────────────────
// /case-studies — every card mirrors the homepage <Work /> carousel.
//
// Same data shape (year, category, heading=result, description, tags,
// poster, posterMode, darkLogo) and same `.c8-work__*` markup + styles —
// the only difference is layout. Homepage shows them in a 1/2/3-up Swiper;
// this page shows all six in a 3×2 grid.
//
// Notes
// • No autoplay videos. Homepage uses static posters only — we match.
// • Ubuntu Tribe poster: homepage references `/images/utribe.png` which is
//   missing on disk (404). We fall back to `/images/ISI-Image.png`.
// ──────────────────────────────────────────────────────────────────────────

const projects = [
  {
    href: '/case-studies/cashaa',
    name: 'Cashaa',
    year: '2022',
    category: 'Token Launch',
    heading: '$32M raised',
    description: 'End-to-end token launch — global press across 200+ publications, Tier-1 KOL seeding, and a community built from zero across Discord and Telegram.',
    tags: ['PR', 'Influencer', 'Community'],
    poster: '/images/cashaa.jpg',
  },
  {
    href: '/case-studies/binance',
    name: 'Binance',
    year: '2024',
    category: 'Affiliate Network',
    heading: '$800M+ monthly',
    description: 'Built the affiliate network behind Binance India — drove $800M+ in monthly volume through curated KOL partnerships and programmatic referral growth.',
    tags: ['PR', 'Growth', 'Community'],
    poster: '/clients/binance.webp',
    posterMode: 'logo',
  },
  {
    href: '/case-studies/fanadise',
    name: 'Fanadise',
    year: '2024',
    category: 'Web3 Growth',
    heading: '$5M raised',
    description: 'Full-stack Web3 fan platform — smart contracts, NFT mechanics and a coordinated multi-channel growth campaign that drove raise momentum from day one.',
    tags: ['Development', 'Community', 'Influencer'],
    poster: '/images/fanadise.png',
  },
  {
    href: '/case-studies/ubuntu-tribe',
    name: 'Ubuntu Tribe',
    year: '2024',
    category: 'Event Launch',
    heading: 'Token2049 — global stage',
    description: 'Compressed multi-channel launch around Token2049 Dubai. PR, KOL activation and live community moments synchronized into a single 72-hour burst.',
    tags: ['PR', 'KOL', 'Community'],
    poster: '/images/ISI-Image.png',
  },
  {
    href: '/case-studies/kucoin',
    name: 'KuCoin',
    year: '2024',
    category: 'Strategic PR',
    heading: 'Tier-1 reach, every market',
    description: 'Ongoing strategic PR retainer — tier-1 placement, editorial strategy and proactive narrative management across 30+ priority markets.',
    tags: ['PR', 'Exchange', 'Global'],
    poster: '/images/KuCoin.jpg',
  },
  {
    href: '/case-studies/metarix',
    name: 'Metarix',
    year: '2023',
    category: 'Token Raise',
    heading: '$780K raised',
    description: 'Pre-launch community engineering, KOL seeding and PR — a full launch stack that turned a quiet pre-seed into a credible Web3 pre-token raise.',
    tags: ['Community', 'Influencer', 'PR'],
    poster: '/clients/metarix.webp',
    posterMode: 'logo',
    darkLogo: true,
  },
];
---
<Layout title="Case Studies | Corum8">
<div data-theme="light">

<!-- ───── Hero (custom — salesy boast, dark, big numbers) ───────────── -->
<section class="cs-hero">
  <div class="cs-hero__bg" aria-hidden="true">
    <span class="cs-hero__glow cs-hero__glow--gold"></span>
    <span class="cs-hero__glow cs-hero__glow--green"></span>
    <span class="cs-hero__grid"></span>
  </div>

  <div class="cs-hero__inner">
    <div class="cs-hero__copy" data-reveal-stagger="120">
      <p class="cs-hero__eyebrow" data-reveal="up">
        <span class="cs-hero__eyebrow-dot"></span>
        Case studies · Receipts only
      </p>

      <h1 class="cs-hero__h1">
        <span data-reveal="up">We don't pitch.</span>
        <span data-reveal="up">We point at <em>the work.</em></span>
      </h1>

      <p class="cs-hero__lede" data-reveal="up">
        Most agencies show you a deck. We show you the wire transfers, the volume reports, the listing screenshots. <strong>1,100+ projects since 2014</strong>, <strong>$120M+</strong> in client revenue, <strong>$32M raised</strong> on a single token, <strong>$800M+</strong> in monthly affiliate volume — every number is on a page below with the client's name attached. Browse what's public. The rest is behind an NDA.
      </p>

      <div class="cs-hero__cta-row" data-reveal="up">
        <a href="#case-studies-grid" class="cs-hero__cta cs-hero__cta--primary">
          <span>Browse our work</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
        </a>
        <a href="/book-a-strategy-call" class="cs-hero__cta cs-hero__cta--ghost">
          <span>Book a strategy call</span>
        </a>
      </div>
    </div>

    <ul class="cs-hero__chips" aria-label="Headline outcomes" data-reveal-stagger="80">
      <li class="cs-hero__chip" data-reveal="up">
        <span class="cs-hero__chip-fig">$32M</span>
        <span class="cs-hero__chip-lbl">raised on Cashaa's token launch</span>
      </li>
      <li class="cs-hero__chip" data-reveal="up">
        <span class="cs-hero__chip-fig">$800M+</span>
        <span class="cs-hero__chip-lbl">monthly affiliate volume — Binance</span>
      </li>
      <li class="cs-hero__chip" data-reveal="up">
        <span class="cs-hero__chip-fig">$5M</span>
        <span class="cs-hero__chip-lbl">raised on Fanadise — full-stack Web3</span>
      </li>
      <li class="cs-hero__chip" data-reveal="up">
        <span class="cs-hero__chip-fig">200+</span>
        <span class="cs-hero__chip-lbl">tier-1 placements per quarter — KuCoin</span>
      </li>
      <li class="cs-hero__chip" data-reveal="up">
        <span class="cs-hero__chip-fig">$780K</span>
        <span class="cs-hero__chip-lbl">raised on Metarix's pre-token round</span>
      </li>
      <li class="cs-hero__chip" data-reveal="up">
        <span class="cs-hero__chip-fig">72hr</span>
        <span class="cs-hero__chip-lbl">multi-channel burst — Token2049 Dubai</span>
      </li>
    </ul>
  </div>

  <div class="cs-hero__scroll" aria-hidden="true">
    <span class="cs-hero__scroll-line"></span>
    <span class="cs-hero__scroll-text">Scroll for receipts</span>
  </div>
</section>

<!-- ───── Case-study grid (homepage <Work /> cards in a 3×2 layout) ──── -->
<section class="cs-grid" id="case-studies-grid">
  <div class="cs-grid__inner">
    <header class="cs-grid__head" data-reveal-stagger="100">
      <p class="cs-grid__eyebrow" data-reveal="up">Selected engagements</p>
      <h2 class="cs-grid__heading" data-reveal="up">
        Real launches. <span class="cs-grid__heading-accent">Outsized outcomes.</span>
      </h2>
    </header>

    <div class="cs-grid__row" data-reveal-stagger="80">
      {projects.map((p) => (
        <a class="c8-work__card cs-grid__card" href={p.href} data-reveal="up">
          <div class={`c8-work__media${p.posterMode === 'logo' ? ' c8-work__media--logo' : ''}${p.darkLogo ? ' c8-work__media--invert' : ''}`}>
            <img src={p.poster} alt={`${p.name} case study`} loading="lazy" />
            <div class="c8-work__veil"></div>
            <span class="c8-work__cat">{p.category}</span>
          </div>
          <div class="c8-work__body">
            <div class="c8-work__meta">
              <span class="c8-work__name">{p.name}</span>
              <span class="c8-work__year">{p.year}</span>
            </div>
            <h3 class="c8-work__result">{p.heading}</h3>
            <p class="c8-work__desc">{p.description}</p>
            <ul class="c8-work__tags">
              {p.tags.map((t) => <li>{t}</li>)}
            </ul>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ───── Subscribe band ────────────────────────────────────────────── -->
<section class="cs-sub" id="subscribe">
  <div class="cs-sub__inner">
    <div class="cs-sub__copy" data-reveal-stagger="100">
      <p class="cs-sub__eyebrow" data-reveal="up">NDA-protected work</p>
      <h2 class="cs-sub__heading" data-reveal="up">
        Not everything can <span class="cs-sub__heading-accent">be public.</span>
      </h2>
      <p class="cs-sub__lede" data-reveal="up">
        Most of our work is covered by client NDAs and privacy agreements — we can't post it on a website. But we can walk you through it directly. Drop your email and we'll reach out to share what we can't show here: the full numbers, the playbooks, the engagements that can't be named publicly.
      </p>
    </div>

    <form class="cs-sub__form" action="/subscribe" method="post" novalidate data-reveal="up">
      <label class="cs-sub__field">
        <span class="cs-sub__label">Work email</span>
        <input
          type="email"
          name="email"
          required
          autocomplete="email"
          placeholder="founder@yourstartup.com"
          aria-label="Email address"
          class="cs-sub__input"
        />
      </label>
      <button type="submit" class="cs-sub__btn">
        <span>Get in touch →</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </button>

      <ul class="cs-sub__perks" aria-label="What you get">
        <li>
          <span class="cs-sub__perk-tick" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          NDA-covered work we can't post publicly
        </li>
        <li>
          <span class="cs-sub__perk-tick" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          Real numbers, real client names under NDA
        </li>
        <li>
          <span class="cs-sub__perk-tick" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          We reach out — <strong>no spam, ever</strong>
        </li>
      </ul>
    </form>
  </div>
</section>

<!-- ───── Locked teasers — case studies that continue past the email ── -->
<section class="cs-locked" aria-label="Upcoming case studies (subscribers)">
  <div class="cs-locked__inner">
    <header class="cs-locked__head" data-reveal-stagger="100">
      <p class="cs-locked__eyebrow" data-reveal="up">
        <span class="cs-locked__lock" aria-hidden="true">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </span>
        Coming up next · subscribers only
      </p>
      <h2 class="cs-locked__heading" data-reveal="up">
        14 more case studies <span class="cs-locked__heading-accent">behind the email.</span>
      </h2>
      <p class="cs-locked__sub" data-reveal="up">
        These ship to inboxes, not to the public site. The next three drops:
      </p>
    </header>

    <ul class="cs-locked__row" data-reveal-stagger="80">
      <li class="cs-locked__teaser" data-reveal="up">
        <div class="cs-locked__teaser-top">
          <span class="cs-locked__teaser-cat">Strategic PR</span>
          <span class="cs-locked__teaser-when">Next week</span>
        </div>
        <h3 class="cs-locked__teaser-name">A top-3 CEX · Q4 narrative reset</h3>
        <p class="cs-locked__teaser-result"><span>$██M</span> in earned media · 47 tier-1 placements</p>
        <p class="cs-locked__teaser-desc">How we rewrote the public narrative around a top-3 exchange after a regulatory event — what we said, what we refused to say, and the seven outlets we got to print it first.</p>
        <span class="cs-locked__teaser-fade" aria-hidden="true"></span>
      </li>

      <li class="cs-locked__teaser" data-reveal="up">
        <div class="cs-locked__teaser-top">
          <span class="cs-locked__teaser-cat">Token Launch</span>
          <span class="cs-locked__teaser-when">+2 weeks</span>
        </div>
        <h3 class="cs-locked__teaser-name">RWA platform · pre-listing run-up</h3>
        <p class="cs-locked__teaser-result"><span>$██M</span> raised · 4 tier-1 listings secured</p>
        <p class="cs-locked__teaser-desc">An RWA platform that sat at zero KOL coverage 90 days before listing. The cohort plan, the seeding cadence, and the three influencers who actually moved volume.</p>
        <span class="cs-locked__teaser-fade" aria-hidden="true"></span>
      </li>

      <li class="cs-locked__teaser" data-reveal="up">
        <div class="cs-locked__teaser-top">
          <span class="cs-locked__teaser-cat">Performance</span>
          <span class="cs-locked__teaser-when">+4 weeks</span>
        </div>
        <h3 class="cs-locked__teaser-name">Fintech card programme · EU launch</h3>
        <p class="cs-locked__teaser-result"><span>██% CAC</span> reduction · 3.4× pipeline lift</p>
        <p class="cs-locked__teaser-desc">A regulated EU card programme that needed FCA-friendly performance creative. Why our first 12 ads got rejected, and the playbook that took the next 200 live.</p>
        <span class="cs-locked__teaser-fade" aria-hidden="true"></span>
      </li>
    </ul>

    <a href="#subscribe" class="cs-locked__cta" data-reveal="up">
      <span>Unlock by subscribing above</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg>
    </a>
  </div>
</section>

<FinalCta
  light="Want a"
  bold="case like these?"
  subtitle="Book a call. We'll tell you what we'd ship and measure first."
/>
</div>

<style is:global>
  /* ────────────────────────────────────────────────────────────────────
     /case-studies — custom hero (dark salesy boast), grid section
     (homepage card styles duplicated here), subscribe band, and locked
     teasers section.
     ──────────────────────────────────────────────────────────────────── */

  /* ╔═══════════════════════════════════════════════════════════════════╗
     ║ HERO — dark, dramatic, salesy. Two-column on desktop:             ║
     ║   left = boast headline + lede + CTAs                             ║
     ║   right = stack of 6 outcome chips (each: figure + label)         ║
     ║ Stacks to one column on mobile.                                   ║
     ╚═══════════════════════════════════════════════════════════════════╝ */
  .cs-hero {
    position: relative;
    isolation: isolate;
    padding: clamp(8rem, 16vh, 11rem) clamp(1.5rem, 5vw, 5rem) clamp(5rem, 9vh, 7rem);
    color: #fff;
    background: #06070b;
    overflow: hidden;
  }
  .cs-hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .cs-hero__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(40px);
  }
  .cs-hero__glow--gold {
    top: -10%;
    right: -5%;
    width: 60%;
    height: 90%;
    background: radial-gradient(closest-side, rgba(242,191,34,0.32) 0%, rgba(242,191,34,0.10) 40%, transparent 75%);
  }
  .cs-hero__glow--green {
    bottom: -20%;
    left: -10%;
    width: 50%;
    height: 80%;
    background: radial-gradient(closest-side, rgba(52,211,153,0.18) 0%, rgba(52,211,153,0.06) 50%, transparent 75%);
  }
  .cs-hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse 75% 65% at 50% 35%, #000 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 75% 65% at 50% 35%, #000 30%, transparent 80%);
    opacity: 0.55;
  }

  .cs-hero__inner {
    max-width: var(--c8-section-max, 1320px);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }
  @media (max-width: 980px) {
    .cs-hero__inner { grid-template-columns: 1fr; gap: 3rem; }
  }

  .cs-hero__copy { max-width: 36rem; }
  .cs-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.4rem;
    padding: 0.45rem 0.9rem;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 999px;
    font-family: var(--montreal);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c8-gold);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .cs-hero__eyebrow-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--c8-gold);
    box-shadow: 0 0 0 4px rgba(242,191,34,0.25);
    animation: cs-pulse 2.4s ease-in-out infinite;
  }
  @keyframes cs-pulse {
    0%, 100% { transform: scale(1);   opacity: 1;   }
    50%      { transform: scale(1.3); opacity: 0.7; }
  }

  .cs-hero__h1 {
    margin: 0 0 1.6rem;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6.5vw, 4.6rem);
    font-weight: 350;
    line-height: 1;
    letter-spacing: -0.04em;
    color: #fff;
  }
  .cs-hero__h1 span { display: block; }
  .cs-hero__h1 em {
    font-style: normal;
    background: linear-gradient(110deg, var(--c8-gold-dark) 0%, var(--c8-gold) 50%, var(--c8-gold-light) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .cs-hero__lede {
    margin: 0 0 2rem;
    max-width: 36rem;
    font-family: var(--montreal);
    font-size: clamp(1rem, 1.2vw, 1.1rem);
    line-height: 1.65;
    color: rgba(255,255,255,0.78);
  }
  .cs-hero__lede strong { color: #fff; font-weight: 600; }

  .cs-hero__cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 0.9rem;
    align-items: center;
  }
  .cs-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 1rem 1.7rem;
    border-radius: 999px;
    text-decoration: none;
    font-family: var(--montreal);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    transition: transform 0.35s cubic-bezier(0.16,1,0.3,1), background 0.3s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .cs-hero__cta svg { transition: transform 0.35s cubic-bezier(0.16,1,0.3,1); }
  .cs-hero__cta--primary {
    background: var(--c8-gold);
    color: #0a0a0a;
    box-shadow: 0 18px 38px -16px var(--c8-gold-glow);
  }
  .cs-hero__cta--primary:hover {
    background: #fff;
    transform: translateY(-2px);
    box-shadow: 0 24px 50px -18px rgba(255,255,255,0.4);
  }
  .cs-hero__cta--primary:hover svg { transform: translateY(3px); }
  .cs-hero__cta--ghost {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255,255,255,0.32);
  }
  .cs-hero__cta--ghost:hover {
    border-color: #fff;
    background: rgba(255,255,255,0.06);
    transform: translateY(-2px);
  }

  /* Outcome chips column */
  .cs-hero__chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }
  .cs-hero__chip {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.1rem;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 14px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: transform 0.4s cubic-bezier(0.16,1,0.3,1), border-color 0.3s ease, background 0.3s ease;
  }
  .cs-hero__chip:hover {
    transform: translateY(-3px);
    border-color: rgba(242,191,34,0.45);
    background: rgba(242,191,34,0.06);
  }
  .cs-hero__chip-fig {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    font-weight: 350;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--c8-gold);
  }
  .cs-hero__chip-lbl {
    font-family: var(--montreal);
    font-size: 0.78rem;
    line-height: 1.4;
    color: rgba(255,255,255,0.7);
  }

  /* Scroll-cue at bottom of hero */
  .cs-hero__scroll {
    position: absolute;
    bottom: clamp(1.25rem, 3vh, 2rem);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    pointer-events: none;
  }
  .cs-hero__scroll-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(180deg, transparent 0%, var(--c8-gold) 100%);
    animation: cs-scroll-line 2.4s ease-in-out infinite;
    transform-origin: top;
  }
  @keyframes cs-scroll-line {
    0%, 100% { transform: scaleY(0.4); opacity: 0.4; }
    50%      { transform: scaleY(1);   opacity: 1;   }
  }
  .cs-hero__scroll-text {
    font-family: var(--montreal);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
  }
  @media (max-width: 980px) { .cs-hero__scroll { display: none; } }

  .cs-grid {
    background: var(--color-bg-dark);
    color: #fff;
    padding-block: var(--c8-pad-section, clamp(4.5rem, 9vh, 7rem));
    padding-inline: clamp(1.5rem, 5vw, 5rem);
  }
  .cs-grid__inner {
