    @media (max-width: 900px) { .lp-bignumbers__inner { grid-template-columns: 1fr 1fr; } }
    
    /* Channels — LIGHT band so the photo tiles read as foreground content. */
    .lp-channels-sect {
      padding: clamp(5rem, 10vh, 8rem) var(--lp-pad-x);
      background: #fff;
      color: #0a0a0a;
    }
    .lp-channels-grid { max-width: var(--lp-max); margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    .lp-ch-tile { position: relative; border-radius: 20px; overflow: hidden; display: flex; flex-direction: column; aspect-ratio: 4/3; text-decoration: none; color: #fff; }
    .lp-ch-tile__img { position: absolute; inset: 0; z-index: 0; }
