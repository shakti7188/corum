---
// Dynamic KOTA-Style Testimonials Carousel.
// Renders whatever the `testimonials` prop provides — no hardcoded slides.

export interface Testimonial {
  bg: string;
  logo: string;
  alt: string;
  quote: string;
  name: string;
  title: string;
  href: string;
}

export interface Props {
  testimonials?: Testimonial[];
  heading?: string;
}

// Fallback used only if the caller forgets to pass data.
// Three generic-but-Corum8-flavoured slides so the block never looks empty.
const defaultTestis: Testimonial[] = [
  {
    bg: "#d7e1d3",
    logo: "/clients/fanadise.png",
    alt: "Fanadise",
    quote:
      "We needed a partner who could run the full stack — campaign, narrative, community, and the listing push — without us translating between three separate agencies. Corum8 was that partner. The raise closed on target and the community carried the momentum.",
    name: "Fanadise leadership",
    title: "Founding team, Fanadise",
    href: "/case-studies",
  },
  {
    bg: "#a8e1ec",
    logo: "/clients/ubuntu-tribe.png",
    alt: "Ubuntu Tribe",
    quote:
      "Corum8 put us in front of the right audiences at Token2049 and kept the global coverage consistent in the months after. The community shape we came out of that run with is what's driven everything since.",
    name: "Ubuntu Tribe team",
    title: "Growth & partnerships, Ubuntu Tribe",
    href: "/case-studies",
  },
  {
    bg: "#c4b5f3",
    logo: "/clients/cashaa.png",
    alt: "Cashaa",
    quote:
      "Corum8 ran the narrative, the media, and the community push around our token event. The execution was clean, the relationships with outlets were already in place, and the team moved at the pace we needed.",
    name: "Kumar Gaurav",
    title: "Founder & CEO, Cashaa",
    href: "/case-studies",
  },
];

const {
  testimonials = defaultTestis,
  heading = "What our clients say",
} = Astro.props;

// Defensive — filter empties so a missing testimonial ID doesn't render an empty slide.
const slides = (testimonials && testimonials.length > 0 ? testimonials : defaultTestis).filter(
  (t) => t && t.quote
);

const arrowPath = "m17.1,7.58s-.01-.04-.01-.06c.01-.22-.06-.45-.24-.61L9.23.19c-.31-.27-.78-.24-1.06.07-.27.31-.24.78.07,1.06l6.26,5.52H.75c-.41,0-.75.34-.75.75s.34.75.75.75h13.74l-6.26,5.52c-.31.27-.34.75-.07,1.06.15.17.35.25.56.25.18,0,.35-.06.5-.19l7.62-6.72c.18-.16.25-.39.24-.61,0-.02.01-.04.01-.06Z";
---

<section class="Testimonials_testimonials__AMUEx">
  <div class="DarkThemeSwitch_cover__hn_xc"></div>
  <div class="container">
    <h2 class="Testimonials_heading__k0Yyf" data-reveal="up">
      <span class="LineByLine_headingOuter__JmusT"><span>{heading}</span></span>
    </h2>

    <!-- Desktop: video (left) + carousel (right) -->
    <div class="Testimonials_testimonialDesktop__v5dZX c8-testi-desktop-grid" data-reveal-stagger="160">
      <div class="c8-testi-video" data-reveal="left">
        <div class="c8-testi-video__frame">
          <iframe
            src="https://www.youtube.com/embed/wHMfo38ZbN8?rel=0"
            title="Corum8 client testimonial"
            loading="lazy"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      </div>
      <div class="TestimonialsCarousel_panels__qHnSA c8-testi-carousel-col" data-reveal="right">
        <div class="TestimonialsCarousel_container__YAjHa">
          <div class="TestimonialsCarousel_swiper__AMmtm swiper">
            <div class="swiper-wrapper">
              {slides.map((t) => (
                <div class="TestimonialsCarousel_swiperSlide__lovqP swiper-slide">
                  <div class="TestimonialsPanel_panel__QSk4x testimonialPanel" style={`background-color: ${t.bg}`}>
                    <div class="TestimonialsPanel_panelWrap__Lm7Hv">
                      {t.logo ? (
                        <figure class="TestimonialsPanel_logo__m6tmz">
                          <span class="Image_image__RAAdZ Image_intrinsic__JRoea">
                            <img data-src={t.logo} src={t.logo} alt={t.alt} fetchpriority="low" height="80" width="200" sizes="auto" class="lazyload" />
                          </span>
                        </figure>
                      ) : (
                        <figure class="TestimonialsPanel_logo__m6tmz TestimonialsPanel_logo--text">
                          <span class="TestimonialsPanel_companyName">{t.alt}</span>
                        </figure>
                      )}
                      <p class="TestimonialsPanel_description__njfi8">"{t.quote}"</p>
                      <div class="TestimonialsPanel_details__ijkyr">
                        <span class="TestimonialsPanel_name__Spm5c">{t.name}</span>
                        <span class="TestimonialsPanel_name__Spm5c">{t.title}</span>
                      </div>
                      <div class="TestimonialsPanel_buttons__fOECn">
                        <div class="Magnetic_magnetic__LncOy" data-fill="false">
                          <div class="Button_button__JJiqJ" data-direction="forwards">
                            <a class="Button_inner__fnyH6" href={t.href}>
                              <span class="Button_border__hirH2"></span>
                              <span class="Button_text__IZaCD">
                                <span class="Button_textInner__JTTHe">View project</span>
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 17.1 15.17" class="Button_buttonArrow__0W9XI">
                                  <path d={arrowPath} fill="currentColor"></path>
                                </svg>
                              </span>
                            </a>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
            <div class="TestimonialsCarousel_swiperNav__hRE1L">
              <div class="custom-swiper-btn swiper-panel-prev">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
              </div>
              <div class="custom-swiper-btn swiper-panel-next">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile carousel (same data, separate swiper instance) -->
  <div class="Testimonials_testimonialMobile__gCvdw">
    <div class="TestimonialsCarousel_panels__qHnSA">
      <div class="TestimonialsCarousel_container__YAjHa">
        <div class="TestimonialsCarousel_swiper__AMmtm swiper">
          <div class="swiper-wrapper">
            {slides.map((t) => (
              <div class="TestimonialsCarousel_swiperSlide__lovqP swiper-slide">
                <div class="TestimonialsPanel_panel__QSk4x testimonialPanel" style={`background-color: ${t.bg}`}>
                  <div class="TestimonialsPanel_panelWrap__Lm7Hv">
                    <figure class="TestimonialsPanel_logo__m6tmz">
                      <span class="Image_image__RAAdZ Image_intrinsic__JRoea">
                        <img data-src={t.logo} src={t.logo} alt={t.alt} fetchpriority="low" height="80" width="200" sizes="auto" class="lazyload" />
                      </span>
                    </figure>
                    <p class="TestimonialsPanel_description__njfi8">"{t.quote}"</p>
                    <div class="TestimonialsPanel_details__ijkyr">
                      <span class="TestimonialsPanel_name__Spm5c">{t.name}</span>
                      <span class="TestimonialsPanel_name__Spm5c">{t.title}</span>
                    </div>
                    <div class="TestimonialsPanel_buttons__fOECn">
                      <div class="Magnetic_magnetic__LncOy" data-fill="false">
                        <div class="Button_button__JJiqJ" data-direction="forwards">
                          <a class="Button_inner__fnyH6" href={t.href}>
                            <span class="Button_border__hirH2"></span>
                            <span class="Button_text__IZaCD">
                              <span class="Button_textInner__JTTHe">View project</span>
                              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 17.1 15.17" class="Button_buttonArrow__0W9XI">
                                <path d={arrowPath} fill="currentColor"></path>
                              </svg>
                            </span>
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
          <div class="TestimonialsCarousel_swiperNav__hRE1L">
            <div class="custom-swiper-btn swiper-panel-prev">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </div>
            <div class="custom-swiper-btn swiper-panel-next">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* ---------------------------------------------------------------
     Light-theme override — KOTA ships Testimonials with a baked-in
     `background:#000; color:#fff` on `.Testimonials_testimonials__AMUEx`.
     Reset both so the section sits on the page's light body colour. The
     pastel testimonial cards (#d7e1d3, #a8e1ec, #c4b5f3, #f8e5cb, etc.)
     carry all the visual interest now — they pop harder against light
     than they did against black. Heading swaps to dark for contrast. */
  .Testimonials_testimonials__AMUEx {
    background: transparent !important;
    color: #0a0a0a !important;
  }
  .Testimonials_testimonials__AMUEx .Testimonials_heading__k0Yyf,
  .Testimonials_testimonials__AMUEx [class*="Testimonials_heading"] {
    color: #0a0a0a !important;
  }
  .Testimonials_testimonials__AMUEx .DarkThemeSwitch_cover__hn_xc {
    display: none !important;
  }

  /* ---------------------------------------------------------------
     Force heading ABOVE everything, video+review grid BELOW.

     KOTA's default layout puts .Testimonials_heading (grid-column: span 6)
     next to .Testimonials_testimonialDesktop (grid-column: span 6) inside
     a 12-col `.container` — i.e. heading on the left, carousel on the
     right. We override both to span the full width so heading sits on
     top and the video+review 2-column grid sits below it — matching the
     pattern every other section on the page uses. */
  .Testimonials_testimonials__AMUEx .container {
    row-gap: clamp(2rem, 4.5vh, 3rem);
  }
  .Testimonials_testimonials__AMUEx .Testimonials_heading__k0Yyf {
    grid-column: 1 / -1 !important;
    align-self: start !important;
    text-align: left;
    font-size: clamp(2rem, 4vw, 3.25rem) !important;
    line-height: 1.05 !important;
    margin: 0 0 0.5rem !important;
  }
  .Testimonials_testimonials__AMUEx .Testimonials_testimonialDesktop__v5dZX {
    grid-column: 1 / -1 !important;
  }

  /* Clean 2-column split on desktop: YouTube testimonial video on the
     left, a SINGLE review card on the right. The default Swiper
     "creative effect" on testimonials peeks the next slide with a small
     translate + 0.85 opacity — that peek read as a third column next to
     the video. We hide all non-active slides in this layout so only one
     review card ever shows. Navigation arrows still cycle through them. */
  .Testimonials_testimonials__AMUEx .c8-testi-desktop-grid {
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.75rem);
    align-items: center;
  }
  .c8-testi-video {
    display: flex;
    align-items: center;
    min-width: 0;
  }
  .c8-testi-video__frame {
    position: relative;
    width: 100%;
    /* Near-square so the video column's height lines up with the review
       card on the right (review card min-height ~380–500px). 16:9 was
       too short; 1:1 was too tall with padding. 5:4 lands in the middle
       and matches the card height closely on desktop. */
    aspect-ratio: 5 / 4;
    border-radius: 24px;
    overflow: hidden;
    background: #000;
    box-shadow:
      0 30px 60px -24px rgba(0, 0, 0, 0.28),
      0 0 0 1px rgba(0, 0, 0, 0.06);
    transition: box-shadow 0.45s ease, transform 0.45s ease;
  }
  /* YouTube iframe itself stays 16:9 inside the 5:4 frame. Letterboxed
     black bars on top/bottom keep the video readable — we set the
     iframe to fit by width and center it vertically. */
  .c8-testi-video__frame iframe {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    transform: translateY(-50%);
    border: 0;
  }
  .c8-testi-video__frame:hover {
    box-shadow:
      0 40px 80px -24px rgba(0, 0, 0, 0.32),
      0 0 60px -18px var(--c8-gold-soft, rgba(242,191,34,0.35)),
      0 0 0 1px var(--c8-gold-glow, rgba(242,191,34,0.45));
    transform: translateY(-2px);
  }
  .c8-testi-carousel-col { min-width: 0; }

  /* Kill the peek of adjacent slides inside the desktop grid. Only the
     currently-active swiper-slide renders, so the right column shows a
     single clean review card that pairs 1:1 with the video on the left. */
  .c8-testi-desktop-grid .swiper-slide:not(.swiper-slide-active) {
    opacity: 0 !important;
    pointer-events: none !important;
    transform: translateX(0) !important;
  }
  .c8-testi-desktop-grid .swiper-slide.swiper-slide-active {
    opacity: 1 !important;
    transform: translateX(0) !important;
  }

  /* Review card inside the 2-col layout — shorter than the global default
     so it pairs visually with a 16:9 video rather than towering over it. */
  .c8-testi-desktop-grid .TestimonialsPanel_panel__QSk4x,
  .c8-testi-desktop-grid [class*="TestimonialsPanel_panel__"] {
    min-height: clamp(380px, 48vh, 500px) !important;
    padding: 2.5rem 2.75rem !important;
  }
  .c8-testi-desktop-grid [class*="TestimonialsPanel_description"] {
    font-size: clamp(1rem, 1.25vw, 1.2rem) !important;
    line-height: 1.5 !important;
  }

  /* Tablet + mobile: single column, video stacks on top, carousel below.
     Below the desktop breakpoint the site swaps to the mobile swiper, so
     this intermediate stack handles ~768–1023px cleanly. */
  @media (max-width: 1023px) {
    .Testimonials_testimonials__AMUEx .c8-testi-desktop-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  /* Cards — lift the minimum height so quotes breathe, add a premium
     inset highlight + soft external shadow that matches the reference
     design's card presentation. Gold edge on hover is the brand tell. */
  .Testimonials_testimonials__AMUEx .TestimonialsPanel_panel__QSk4x,
  .Testimonials_testimonials__AMUEx [class*="TestimonialsPanel_panel__"] {
    min-height: clamp(540px, 68vh, 680px) !important;
    padding: 4rem 4.5rem !important;
    display: flex !important;
    align-items: stretch !important;
    box-shadow:
      0 30px 60px -24px rgba(0, 0, 0, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.4),
      inset 0 -1px 0 rgba(0, 0, 0, 0.04) !important;
    border: 1px solid rgba(0, 0, 0, 0.04) !important;
    transition: box-shadow 0.45s ease, border-color 0.45s ease !important;
  }
  .Testimonials_testimonials__AMUEx .TestimonialsPanel_panel__QSk4x:hover,
  .Testimonials_testimonials__AMUEx [class*="TestimonialsPanel_panel__"]:hover {
    box-shadow:
      0 40px 80px -24px rgba(0, 0, 0, 0.22),
      0 0 60px -20px var(--c8-gold-soft),
      inset 0 1px 0 rgba(255, 255, 255, 0.4) !important;
    border-color: var(--c8-gold-glow) !important;
  }
  .Testimonials_testimonials__AMUEx [class*="TestimonialsPanel_panelWrap"] {
    display: flex !important;
    flex-direction: column !important;
    height: 100% !important;
    width: 100% !important;
  }
  .Testimonials_testimonials__AMUEx [class*="TestimonialsPanel_logo"] {
    flex: 0 0 auto;
    margin-bottom: 1.75rem !important;
  }
  /* Text-only company name — shown when no logo asset is available.
     Styled as a small-caps display mark so it reads as a brand label, not
     as accidental body copy. */
  .Testimonials_testimonials__AMUEx .TestimonialsPanel_logo--text {
    display: flex !important;
    align-items: center;
    min-height: 80px;
    margin: 0 0 1.75rem !important;
  }
  .Testimonials_testimonials__AMUEx .TestimonialsPanel_companyName {
    font-size: clamp(1.25rem, 1.6vw, 1.6rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #0a0a0a;
    line-height: 1.1;
  }
  .Testimonials_testimonials__AMUEx [class*="TestimonialsPanel_description"] {
    font-size: clamp(1.15rem, 1.5vw, 1.55rem) !important;
    line-height: 1.55 !important;
    flex: 1 1 auto;
    margin-bottom: 2rem !important;
  }
  .Testimonials_testimonials__AMUEx [class*="TestimonialsPanel_details"] {
    margin-top: auto !important;
  }
  .Testimonials_testimonials__AMUEx [class*="TestimonialsPanel_buttons"] {
    margin-top: 1.5rem !important;
  }

  /* Nav — bottom-right of the card, unfilled icon-only buttons. */
  .Testimonials_testimonials__AMUEx .TestimonialsCarousel_swiper__AMmtm {
    position: relative;
  }
  .TestimonialsCarousel_swiperNav__hRE1L {
    position: absolute;
    right: 2rem;
    bottom: 1.75rem;
    top: auto;
    left: auto;
    padding: 0 !important;
    margin: 0 !important;
    pointer-events: none !important;
    z-index: 20;
    display: flex !important;
    gap: 0.9rem;
  }
  .TestimonialsCarousel_swiperNav__hRE1L .custom-swiper-btn {
    position: static;
    width: 52px;
    height: 52px;
    border-radius: 0;
    border: 0;
    background: transparent !important;
    box-shadow: none !important;
    backdrop-filter: none;
    color: #0a0a0a;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    transition: color 0.25s ease, transform 0.25s ease, opacity 0.25s ease;
    pointer-events: auto !important;
    z-index: 21;
    padding: 0;
    transform: none;
  }
  .TestimonialsCarousel_swiperNav__hRE1L .custom-swiper-btn svg {
    width: 40px;
    height: 40px;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  .TestimonialsCarousel_swiperNav__hRE1L .custom-swiper-btn:hover {
    transform: translateX(2px) scale(1.05);
    color: #000;
  }
  .TestimonialsCarousel_swiperNav__hRE1L .swiper-panel-prev:hover {
    transform: translateX(-2px) scale(1.05);
  }
  .TestimonialsCarousel_swiperNav__hRE1L .custom-swiper-btn.swiper-button-disabled {
    opacity: 0.25;
    pointer-events: none !important;
  }
  .custom-swiper-btn svg {
    stroke: currentColor;
    width: 24px;
    height: 24px;
  }
  .custom-swiper-btn:hover {
    background: var(--c8-gold, #f2bf22);
    border-color: var(--c8-gold, #f2bf22);
    color: #111;
    transform: scale(1.06);
  }
  .custom-swiper-btn.swiper-button-disabled {
    opacity: 0.3;
    pointer-events: none;
  }
</style>
