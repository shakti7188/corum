    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--nb-brand-gold);
  }
  .mega-menu-cta h4 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--nb-text-on-dark);
    margin: 0 0 6px;
    line-height: 1.3;
  }
  .mega-menu-cta p {
    font-size: 0.78rem;
    color: var(--nb-text-on-dark-muted);
    line-height: 1.55;
    margin: 0;
  }
  .mega-menu-cta .c8-btn { width: 100%; justify-content: center; margin-top: 4px; }

  /* ─── Simple Dropdown (Industries, Resources, About) ─── */
  .dropdown-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    background: rgba(255,255,255,0.97);
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    border: 1px solid var(--nb-border-subtle);
    border-radius: var(--nb-radius-lg);
    padding: 12px;
    min-width: 200px;
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s var(--nb-ease-expo);
    box-shadow: 0 20px 60px rgba(0,0,0,0.08);
    z-index: 100;
  }
  .nav-item:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }
  .dropdown-link {
    display: block;
    padding: 10px 16px;
    font-size: 1rem;
    font-weight: 500;
    color: var(--nb-text-secondary);
    border-radius: var(--nb-radius-sm);
    transition: all 0.25s;
    text-decoration: none;
  }
  .dropdown-link:hover {
    color: var(--nb-brand-gold);
    background: rgba(var(--nb-brand-gold-rgb),0.06);
  }

  /* Dark state dropdown */
  .navbar--on-dark .dropdown-menu {
    background: rgba(20,20,20,0.95);
    border-color: rgba(255,255,255,0.08);
  }
  .navbar--on-dark .dropdown-link { color: var(--nb-text-on-dark-muted); }
  .navbar--on-dark .dropdown-link:hover {
    color: var(--nb-brand-gold);
    background: rgba(var(--nb-brand-gold-rgb),0.1);
  }

  /* ─── Buttons (used only in this navbar context) ─── */
  .c8-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 32px;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: var(--nb-radius-pill);
    transition: all 0.3s var(--nb-ease-expo);
    cursor: pointer;
    white-space: nowrap;
    text-decoration: none;
    border: none;
  }
  .c8-btn-gold {
    background: var(--nb-brand-gold);
    color: #fff;
  }
  .c8-btn-gold:hover {
    background: var(--nb-brand-gold-hover);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: var(--nb-shadow-glow);
  }
  .c8-btn-sm { padding: 10px 20px; font-size: 0.82rem; }

  /* ─── Mobile toggle ─── */
  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 6px;
    width: 28px;
    cursor: pointer;
    z-index: 210;
    background: none;
    border: none;
    padding: 0;
  }
  .menu-toggle span {
    display: block; width: 100%; height: 2px;
    background: var(--nb-text-primary);
    border-radius: 2px;
    transition: all 0.3s var(--nb-ease-expo);
    transform-origin: center;
  }
  .menu-toggle.active span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
  .menu-toggle.active span:nth-child(2) { opacity: 0; }
  .menu-toggle.active span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

  /* ─── Mobile menu overlay ─── */
  .mobile-menu {
    position: fixed;
    inset: 0;
    background: #f7f6f3;
    z-index: 205;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.6s var(--nb-ease-quart);
  }
  .mobile-menu.open { clip-path: inset(0 0 0 0); }
  .mobile-menu .mobile-nav-link {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 700;
    color: var(--nb-text-primary);
    text-decoration: none;
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.5s var(--nb-ease-expo);
  }
  .mobile-menu.open .mobile-nav-link { opacity: 1; transform: translateY(0); }
  .mobile-menu.open .mobile-nav-link:nth-child(1) { transition-delay: 0.08s; }
  .mobile-menu.open .mobile-nav-link:nth-child(2) { transition-delay: 0.13s; }
  .mobile-menu.open .mobile-nav-link:nth-child(3) { transition-delay: 0.18s; }
  .mobile-menu.open .mobile-nav-link:nth-child(4) { transition-delay: 0.23s; }
  .mobile-menu.open .mobile-nav-link:nth-child(5) { transition-delay: 0.28s; }
  .mobile-menu.open .mobile-nav-link:nth-child(6) { transition-delay: 0.33s; }

  /* ─── Responsive ─── */
  @media (max-width: var(--c8-section-max, 1320px)) {
    .mega-menu-inner {
      grid-template-columns: 1fr 1fr 280px;
    }
    .mega-menu-category:nth-child(3) { display: none; }

    /* Compact mega menus (Industries, Resources) drop to one category
       + CTA at narrow widths to avoid a cramped grid. */
    .mega-menu-inner--compact {
      grid-template-columns: 1fr 280px;
    }
    .mega-menu-inner--compact .mega-menu-category:nth-child(2) {
      display: none;
    }

    .nav-links { gap: 20px; }
  }

  @media (max-width: 1024px) {
    .nav-links { display: none; }
    .menu-toggle { display: flex; }
    .nav-cta.desktop-only { display: none; }
  }

  /* Compensate for fixed navbar on non-hero pages */
  body.has-fixed-nav main > *:first-child {
    padding-top: 80px;
  }
</style>

<script is:inline>
  /* Load Lucide icons, then init navbar */
  (function () {
    var s = document.createElement('script');
    s.src = 'https://unpkg.com/lucide@0.525.0/dist/umd/lucide.min.js';
    s.onload = function () {
      if (window.lucide) window.lucide.createIcons();
    };
    document.head.appendChild(s);
  })();
</script>

<script is:inline>
  /* Navbar: scroll detection, logo swap, mega menu, mobile toggle, active page */
  (function () {
    'use strict';

    var navbar     = document.getElementById('navbar');
    var menuToggle = document.getElementById('menuToggle');
    var mobileMenu = document.getElementById('mobileMenu');
    var logoDark   = document.getElementById('logoDark');
    var logoWhite  = document.getElementById('logoWhite');
    if (!navbar) return;

    /* ── Scroll + logo swap ── */
    function handleScroll() {
      var scrolled = window.scrollY > 50;
      if (scrolled) {
        navbar.classList.add('scrolled');
        if (logoDark && logoWhite) {
          logoDark.style.display = 'block';
          logoWhite.style.display = 'none';
        }
      } else {
        navbar.classList.remove('scrolled');
        if (logoDark && logoWhite) {
          var onDark = navbar.classList.contains('navbar--on-dark');
          logoDark.style.display  = onDark ? 'none'  : 'block';
          logoWhite.style.display = onDark ? 'block' : 'none';
        }
      }
    }

    var scrollTick = false;
    window.addEventListener('scroll', function () {
      if (!scrollTick) {
        requestAnimationFrame(function () { handleScroll(); scrollTick = false; });
        scrollTick = true;
      }
    }, { passive: true });
    handleScroll();

    /* ── Mobile menu ── */
    if (menuToggle && mobileMenu) {
      menuToggle.addEventListener('click', function () {
        var open = mobileMenu.classList.contains('open');
        mobileMenu.classList.toggle('open', !open);
        menuToggle.classList.toggle('active', !open);
        document.body.classList.toggle('menu-open', !open);
      });
      mobileMenu.querySelectorAll('.mobile-nav-link').forEach(function (link) {
        link.addEventListener('click', function () {
          mobileMenu.classList.remove('open');
          menuToggle.classList.remove('active');
          document.body.classList.remove('menu-open');
        });
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && mobileMenu.classList.contains('open')) {
          mobileMenu.classList.remove('open');
          menuToggle.classList.remove('active');
          document.body.classList.remove('menu-open');
        }
      });
    }

    /* ── Mega menu (desktop hover) ── */
    var megaCloseTimer = null;

    function openMega(item) {
      clearTimeout(megaCloseTimer);
      document.querySelectorAll('.nav-item').forEach(function (o) {
        if (o !== item) o.classList.remove('active');
      });
      item.classList.add('active');
      navbar.classList.add('mega-open');
      if (logoDark && logoWhite) {
        logoDark.style.display  = 'block';
        logoWhite.style.display = 'none';
      }
    }

    function closeMega() {
      megaCloseTimer = setTimeout(function () {
        document.querySelectorAll('.nav-item').forEach(function (i) {
          i.classList.remove('active');
        });
        navbar.classList.remove('mega-open');
        handleScroll();
      }, 180);
    }

    document.querySelectorAll('.nav-item').forEach(function (item) {
      var megaPanel = item.querySelector('.mega-menu');
      item.addEventListener('mouseenter', function () { openMega(item); });
      item.addEventListener('mouseleave', function () { closeMega(); });
      if (megaPanel) {
        megaPanel.addEventListener('mouseenter', function () {
          clearTimeout(megaCloseTimer);
          item.classList.add('active');
          navbar.classList.add('mega-open');
        });
        megaPanel.addEventListener('mouseleave', function () { closeMega(); });
      }
    });

    /* ── Active page highlight ── */
    var currentPath = window.location.pathname;
    document.querySelectorAll('.nav-link').forEach(function (link) {
      var href = link.getAttribute('href');
      if (href && href !== '/' && currentPath.startsWith(href)) {
        link.classList.add('active');
      }
    });
  })();
</script>
