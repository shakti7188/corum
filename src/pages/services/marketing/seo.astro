.s-case__inner{position:relative;z-index:1;max-width:860px;margin:0 auto;}
.s-case__tag{display:inline-block;font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#f2bf22;background:rgba(242,191,34,.1);padding:.3rem .9rem;border-radius:100px;margin-bottom:1.5rem;}
.s-case__h2{font-size:clamp(1.8rem,3.5vw,2.8rem);font-weight:800;line-height:1.2;letter-spacing:-.03em;color:#fff;margin-bottom:1.5rem;}
