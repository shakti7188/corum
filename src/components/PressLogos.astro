---
// Client trust strip — sits directly below the merged Hero. Same
// design treatment as the previous "As featured in" press strip
// (compact label + horizontal logo rail with edge fade), but now
// shows two rows of CLIENT logos instead of media outlets, per
// user direction. Label updated to "Trusted by 1,100+ brands".

const clients = [
  { src: '/clients/binance.png',       alt: 'Binance' },
  { src: '/clients/kucoin.png',        alt: 'KuCoin' },
  { src: '/clients/okx.png',           alt: 'OKX' },
  { src: '/clients/metamask.png',      alt: 'MetaMask' },
  { src: '/clients/tether.png',        alt: 'Tether' },
  { src: '/clients/tron.png',          alt: 'TRON' },
  { src: '/clients/etoro.png',         alt: 'eToro' },
  { src: '/clients/gate-io.png',       alt: 'Gate.io' },
  { src: '/clients/coinmarketcap.png', alt: 'CoinMarketCap' },
  { src: '/clients/wazirx.png',        alt: 'WazirX' },
  { src: '/clients/kava.png',          alt: 'Kava' },
  { src: '/clients/eos.png',           alt: 'EOS' },
  { src: '/clients/dream11.png',       alt: 'Dream11' },
  { src: '/clients/iotex.png',         alt: 'IoTeX' },
  { src: '/clients/Plasmapay.png',     alt: 'PlasmaPay' },
  { src: '/clients/salamantex.png',    alt: 'Salamantex' },
  { src: '/clients/cobox.png',         alt: 'Cobox' },
  { src: '/clients/metarix.png',       alt: 'Metarix' },
  { src: '/clients/fanadise.png',      alt: 'Fanadise' },
  { src: '/clients/ubuntu-tribe.png',  alt: 'Ubuntu Tribe' },
  { src: '/clients/flappy-bird.png',   alt: 'Flappy Bird' },
];

// Split into two rows of ~equal length. The first row carries the
// bigger-name brands so the section opens with strongest proof.
const half = Math.ceil(clients.length / 2);
const rowA = clients.slice(0, half);
const rowB = clients.slice(half);
---

<section class="c8-press">
  <p class="c8-press__label"><span>Trusted by 1,100+ brands</span></p>
  <div class="c8-press__rows">
    <div class="c8-press__logos c8-press__logos--a c8-marquee">
      <div class="c8-marquee__track">
        {rowA.map((m) => (
          <img src={m.src} alt={m.alt} loading="lazy" class="c8-press__img" />
        ))}
        {rowA.map((m) => (
          <img src={m.src} alt="" aria-hidden="true" loading="lazy" class="c8-press__img c8-marquee__clone" />
        ))}
      </div>
    </div>
    <div class="c8-press__logos c8-press__logos--b c8-marquee">
      <div class="c8-marquee__track">
        {rowB.map((m) => (
          <img src={m.src} alt={m.alt} loading="lazy" class="c8-press__img" />
        ))}
        {rowB.map((m) => (
          <img src={m.src} alt="" aria-hidden="true" loading="lazy" class="c8-press__img c8-marquee__clone" />
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
  .c8-press {
    width: 100%;
    background: #F7F6F3;
    padding: 1.75rem clamp(1.5rem, 5vw, 5rem) 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }
  .c8-press__label {
    margin: 0;
    font-family: var(--montreal);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #888;
  }
  .c8-press__label span::before {
    content: '';
    display: inline-block;
    width: 1.5rem;
    height: 1px;
    background: #ccc;
    vertical-align: middle;
    margin-right: 0.6rem;
  }
  .c8-press__label span::after {
    content: '';
    display: inline-block;
    width: 1.5rem;
    height: 1px;
    background: #ccc;
    vertical-align: middle;
    margin-left: 0.6rem;
  }

  .c8-press__rows {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  /* Desktop + tablet (>768px): STATIC centred rows, no scroll. Overflow
     clipped + faded at the edges. Mobile override re-enables the
     scrolling marquee. */
  .c8-press__logos {
    width: 100%;
    overflow: hidden;
    --c8-marquee-dur: 50s;
    mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
  }
  .c8-press__logos--a { --c8-marquee-dur: 50s; }
  .c8-press__logos--b { --c8-marquee-dur: 65s; }
  .c8-press__logos .c8-marquee__track {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: center;
    width: 100%;
    /* Tight gap because the client PNGs (600×160 canvases) carry their
       own internal whitespace padding — adding a generous CSS gap on
       top makes the row look sparse. */
    gap: clamp(0.25rem, 0.6vw, 0.5rem);
    animation: none;
  }
  .c8-press__logos .c8-marquee__track > * { flex: 0 0 auto; }
  .c8-press__logos .c8-marquee__clone { display: none; }
  .c8-press__img {
    /* Bumped to 36px so the logo content inside each canvas reads at
       a usable size despite the in-PNG padding. */
    height: 36px;
    width: auto;
    max-width: 150px;
    object-fit: contain;
    filter: grayscale(1) brightness(0.3);
    opacity: 0.72;
    transition: opacity 0.25s ease, filter 0.25s ease, transform 0.25s ease;
  }
  .c8-press__img:hover { filter: none; opacity: 1; transform: scale(1.04); }

  /* Mobile: re-enable scrolling marquee for both rows so 11+ logos
     don't get cut off in a narrow viewport. */
  @media (max-width: 768px) {
    .c8-press { padding: 1.25rem 1rem 1.5rem; }
    .c8-press__img { height: 30px; max-width: 130px; }
    .c8-press__logos .c8-marquee__track {
      width: max-content;
      justify-content: flex-start;
      gap: 0.6rem;
      animation: c8-marquee-scroll var(--c8-marquee-dur, 50s) linear infinite;
    }
    .c8-press__logos .c8-marquee__clone { display: inline-flex; }
    .c8-press__logos:hover .c8-marquee__track { animation-play-state: paused; }
  }
</style>
