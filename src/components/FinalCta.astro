---
// Final CTA Section — page-specific copy, same design.
import { resolveMedia } from "../data/media";

export interface Props {
  light?: string;                  // first line of headline
  bold?: string;                   // second line, emphasised
  subtitle?: string;
  buttonLabel?: string;
  buttonHref?: string;
}

const {
  light = "Ready to",
  bold = "build, launch & scale?",
  subtitle = "One team. Full stack. Dubai · US · India.",
  buttonLabel = "Book a Strategy Call",
  buttonHref = "/book-a-strategy-call",
} = Astro.props;

const blob = resolveMedia("video.ctaBlob");
---

<section class="FinalCta_wrapper">
  <!-- 3D Animated Background Object -->
  <figure class="FinalCta_videoBackground">
    <video autoplay loop muted playsinline preload="metadata" src={blob?.src}></video>
  </figure>

  <!-- Foreground Dark Gradient Overlay -->
  <div class="FinalCta_overlay"></div>

  <!-- Content -->
  <div class="FinalCta_content">
    <h2 class="FinalCta_title">
      <span class="FinalCta_light">{light}</span><br/>
      <span class="FinalCta_bold">{bold}</span>
    </h2>
    <p class="FinalCta_subtitle">{subtitle}</p>
    <a href={buttonHref} class="FinalCta_button">
      {buttonLabel}
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 17 15" class="FinalCta_arrow"><path d="M17 7.5S17 7.5 17 7.5c0-.2-.1-.5-.2-.6L9.2.2C8.9-.1 8.4-.1 8.1.2c-.3.3-.3.8 0 1.1l6.3 5.5H.8C.3 6.8 0 7.1 0 7.6c0 .4.3.8.8.8h13.7l-6.3 5.5c-.3.3-.3.8 0 1.1.2.2.4.3.6.3s.4-.1.5-.2l7.6-6.7c.2-.2.2-.4.2-.6 0 0 0 0 0 0Z" fill="currentColor"/></svg>
    </a>
  </div>
</section>

<style>
  .FinalCta_wrapper {
    position: relative;
    width: 100%;
    min-height: 80vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: var(--color-bg-dark);
    overflow: hidden;
    padding: 8rem 0;
  }

  .FinalCta_videoBackground {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 38vw;
    height: 62vh;
    transform: translate(-50%, -50%);
    z-index: 1;
    pointer-events: none;
    opacity: 0.9;
  }

  .FinalCta_videoBackground video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: screen;
  }

  .FinalCta_overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: radial-gradient(circle, rgba(0,0,0,0) 0%, var(--color-bg-dark) 80%);
    z-index: 2;
    pointer-events: none;
  }

  .FinalCta_content {
    position: relative;
    z-index: 10;
    text-align: center;
    color: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.6rem;
  }

  .FinalCta_title {
    font-size: clamp(2rem, 5.7vw, 6rem);
    line-height: 1;
    margin: 0;
    letter-spacing: -0.02em;
    font-weight: 400;
    color: #fff;
  }

  .FinalCta_light {
    font-weight: 400;
    color: #fff;
  }
  .FinalCta_bold {
    font-weight: 600;
    background: linear-gradient(135deg, var(--c8-gold) 0%, var(--c8-gold-light) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  .FinalCta_subtitle {
    margin: 0;
    font-size: clamp(0.8rem, 1.2vw, 1rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: #fff;
    text-shadow: 0 4px 15px rgba(0, 0, 0, 1);
  }

  .FinalCta_button {
    margin-top: 2.4rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1.2rem 2.8rem;
    border-radius: 4rem;
    border: 1px solid rgba(255, 255, 255, 0.85);
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(10px);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 1);
    transition: transform 0.3s ease, background 0.3s ease, border-color 0.3s ease, color 0.3s ease, text-shadow 0.3s ease;
  }

  .FinalCta_button:hover {
    background: var(--c8-gold);
    border-color: var(--c8-gold);
    color: #111;
    text-shadow: none;
    transform: scale(1.05);
  }

  .FinalCta_button:hover path {
    fill: #111;
  }

  .FinalCta_arrow {
    width: 20px;
    height: 15px;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .FinalCta_button:hover .FinalCta_arrow {
    transform: translateX(8px);
  }

  @media (max-width: 1024px) {
    .FinalCta_videoBackground {
      width: 150vw;
      height: 100vh;
    }
  }
</style>
