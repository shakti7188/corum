---
// Alt variant of the "Trusted worldwide" section — single-line heading
// above a full-colour marquee of client logos. Placed ABOVE the main
// ClientLogos (mesh grid) section so the two treatments can be compared
// side by side.
//
// Differences from the main ClientLogos:
//   - One-line heading ("Join our 1,100+ clients around the world…")
//   - No mesh grid — single horizontal marquee
//   - Logos in full colour (no grayscale/brightness filter)
//   - Slightly larger logo size (clamp 42–60px instead of 30–42px)

const clients = [
  { src: '/clients/binance.png',       alt: 'Binance' },
  { src: '/clients/kucoin.png',        alt: 'KuCoin' },
  { src: '/clients/okx.png',           alt: 'OKX' },
  { src: '/clients/metamask.png',      alt: 'MetaMask' },
  { src: '/clients/tether.png',        alt: 'Tether' },
  { src: '/clients/tron.png',          alt: 'TRON' },
  { src: '/clients/etoro.png',         alt: 'eToro' },
  { src: '/clients/gate-io.png',       alt: 'Gate.io' },
  { src: '/clients/coinmarketcap.png', alt: 'CoinMarketCap' },
  { src: '/clients/wazirx.png',        alt: 'WazirX' },
  { src: '/clients/kava.png',          alt: 'Kava' },
  { src: '/clients/eos.png',           alt: 'EOS' },
  { src: '/clients/dream11.png',       alt: 'Dream11' },
  { src: '/clients/iotex.png',         alt: 'IoTeX' },
  { src: '/clients/Plasmapay.png',     alt: 'PlasmaPay' },
  { src: '/clients/salamantex.png',    alt: 'Salamantex' },
  { src: '/clients/cobox.png',         alt: 'Cobox' },
  { src: '/clients/metarix.png',       alt: 'Metarix' },
  { src: '/clients/fanadise.png',      alt: 'Fanadise' },
  { src: '/clients/ubuntu-tribe.png',  alt: 'Ubuntu Tribe' },
  { src: '/clients/flappy-bird.png',   alt: 'Flappy Bird' },
];

// Split into two rows for the dual-row marquee. Both rows move in the
// same direction at slightly different speeds so the effect reads as
// continuous motion, not duelling marquees.
const half = Math.ceil(clients.length / 2);
const rowA = clients.slice(0, half);
const rowB = clients.slice(half);
---

<section class="c8-clients-alt">

  <h2 class="c8-clients-alt__title" data-reveal="up">
    Trusted by <span class="c8-clients-alt__count">1,100+ brands</span> around the world
  </h2>

  <div class="c8-clients-alt__rows" aria-label="Clients">
    <div class="c8-clients-alt__marquee c8-clients-alt__marquee--a c8-marquee">
      <div class="c8-marquee__track">
        {rowA.map((c) => (
          <img src={c.src} alt={c.alt} loading="lazy" class="c8-clients-alt__img" />
        ))}
        {rowA.map((c) => (
          <img src={c.src} alt="" aria-hidden="true" loading="lazy" class="c8-clients-alt__img c8-marquee__clone" />
        ))}
      </div>
    </div>
    <div class="c8-clients-alt__marquee c8-clients-alt__marquee--b c8-marquee">
      <div class="c8-marquee__track">
        {rowB.map((c) => (
          <img src={c.src} alt={c.alt} loading="lazy" class="c8-clients-alt__img" />
        ))}
        {rowB.map((c) => (
          <img src={c.src} alt="" aria-hidden="true" loading="lazy" class="c8-clients-alt__img c8-marquee__clone" />
        ))}
      </div>
    </div>
  </div>

</section>

<style is:global>
  .c8-clients-alt {
    width: 100%;
    background: #ffffff;
    padding: clamp(2.75rem, 7vh, 4.5rem) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.25rem, 3vh, 2rem);
    text-align: center;
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }

  /* Variant label — helps client identify which design they're looking at */
  .c8-clients-alt__tag-row { display: flex; justify-content: center; }
  .c8-clients-alt__variant-tag {
    font-family: var(--montreal);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--c8-gold);
    padding: 0.3rem 0.8rem;
    border: 1px solid rgba(242,191,34,0.35);
    border-radius: 999px;
    background: rgba(242,191,34,0.05);
  }

  .c8-clients-alt__title {
    margin: 0;
    font-family: var(--montreal);
    font-size: clamp(1.3rem, 2.4vw, 1.75rem);
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: rgba(10, 10, 10, 0.55);
    max-width: none;
    padding: 0 clamp(1rem, 4vw, 3rem);
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .c8-clients-alt__title {
      white-space: normal;
      font-size: 1.05rem;
    }
  }
  /* Whole sentence reads as one — count inherits the same transparent
     weight as the rest of the title. */
  .c8-clients-alt__count {
    color: inherit;
    font-style: normal;
    font-family: var(--montreal);
    font-weight: inherit;
  }

  /* Two-row marquee — both rows scroll left to right, slightly different
     speeds so the motion reads as continuous, not echoing. Clones wrap
     seamlessly. Mask fades the edges for an intentional crop. */
  .c8-clients-alt__rows {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .c8-clients-alt__marquee {
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent 0, #000 8%, #000 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 8%, #000 92%, transparent 100%);
  }
  .c8-clients-alt__marquee--a { --c8-marquee-dur: 50s; }
  .c8-clients-alt__marquee--b { --c8-marquee-dur: 65s; }
  .c8-clients-alt__marquee .c8-marquee__track {
    display: flex;
    gap: clamp(0.75rem, 1.5vw, 1.5rem);
    align-items: center;
    flex-wrap: nowrap;
    justify-content: flex-start;
    width: max-content;
    animation: c8-marquee-scroll var(--c8-marquee-dur, 55s) linear infinite;
  }
  .c8-clients-alt__marquee .c8-marquee__track > * { flex: 0 0 auto; }
  .c8-clients-alt__marquee .c8-marquee__clone { display: inline-flex; }
  .c8-clients-alt__marquee:hover .c8-marquee__track { animation-play-state: paused; }
  .c8-clients-alt__img {
    /* Full colour — no grayscale filter, no opacity dim */
    height: clamp(42px, 5vw, 60px);
    width: auto;
    max-width: 200px;
    object-fit: contain;
    opacity: 1;
    filter: none;
    transition: transform 0.3s ease;
  }
  .c8-clients-alt__img:hover { transform: scale(1.08); }

  @media (max-width: 640px) {
    .c8-clients-alt__img { height: 38px; }
    .c8-clients-alt__marquee .c8-marquee__track { gap: 1rem; }
    .c8-clients-alt__title { font-size: 1.3rem; }
  }
</style>
