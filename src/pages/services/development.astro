    company: 'Cashaa',
    region: 'United Kingdom / Global',
    stage: 'Banking + Custody',
    headline: '$200M+',
    subheadline: 'in deposits processed',
    body: 'Core banking, custody and on-ramp infrastructure for a regulated crypto-banking platform. Smart-contract custody integrated with traditional rails — audited, compliant, in production.',
