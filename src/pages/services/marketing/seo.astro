.s-why__col--us::before{content:"BEST CHOICE";position:absolute;top:-12px;right:24px;background:#f2bf22;color:#0a0b10;font-family:var(--font-display);font-size:.7rem;font-weight:400;letter-spacing:.12em;padding:.35rem .9rem;border-radius:100px;}
.s-why__col-h{font-family:var(--font-display);font-size:1.15rem;font-weight:400;letter-spacing:-.005em;color:#1a1a1a;margin-bottom:1.6rem;padding-bottom:1.2rem;border-bottom:1px dashed rgba(0,0,0,.12);display:flex;align-items:center;gap:.6rem;}
.s-why__col--them .s-why__col-h{color:#888;}
.s-why__col-h--us{color:#0a0b10;}
.s-why__col ul{list-style:none;display:flex;flex-direction:column;gap:1.1rem;padding:0;margin:0;}
.s-why__col li{font-size:1.05rem;line-height:1.55;color:#222;display:flex;align-items:flex-start;gap:.85rem;font-weight:500;}
.s-why__col--them li{color:#777;font-weight:400;}
.s-x{flex-shrink:0;width:28px;height:28px;border-radius:50%;background:#f3f3f0;color:#aaa;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:1.05rem;line-height:1;margin-top:.05rem;}
.s-tick{flex-shrink:0;width:28px;height:28px;border-radius:50%;background:#f2bf22;color:#0a0b10;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:.95rem;line-height:1;margin-top:.05rem;}
.s-why__cta{max-width:1180px;margin:2.5rem auto 0;display:flex;align-items:center;justify-content:space-between;gap:1.5rem;background:#fff;border-radius:20px;padding:1.6rem 2.2rem;border:1px solid rgba(0,0,0,.08);flex-wrap:wrap;}
.s-why__cta-text{font-size:1.15rem;font-weight:600;color:#0a0b10;font-family:var(--font-sans);}

/* ── TOOLS ── */
.s-tools{padding:2.5rem 2rem;text-align:center;}
.s-tools__label{font-size:.7rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#aaa;margin-bottom:1.2rem;}
.s-tools__chips{display:flex;flex-wrap:wrap;justify-content:center;gap:.6rem;}
.s-tools__chips span{background:#fff;border:1px solid rgba(0,0,0,.09);border-radius:100px;padding:.35rem 1rem;font-size:.82rem;font-weight:600;color:#555;transition:all .2s;cursor:default;}
.s-tools__chips span:hover{background:#0f0f0f;color:#fff;border-color:transparent;}

/* ── CASE STUDY ── */
.s-case{background:#0f0f0f;padding:clamp(4rem,8vh,6rem) 2rem;position:relative;overflow:hidden;}
