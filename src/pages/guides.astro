---
import Layout from "../layouts/Layout.astro";
import KotaverseCta from "../components/KotaverseCta.astro";

const arrowGrad = {
  id: 'gui',
  stops: [
    { offset: '0', color: '#7c41f3' },
    { offset: '1', color: '#ff6eff' },
  ],
};

const projects = [
  {
    href: '#',
    name: 'Token launch playbook',
    year: '12 steps · Intermediate',
    heading: 'End-to-end — allocations, vesting, audit, PR sequencing, CEX relationships, community seeding, TGE day ops.',
    tags: ['Token', 'Launch', 'Playbook'],
    poster: '/images/bento1-1.jpg',
  },
  {
    href: '#',
    name: 'Tier-1 exchange listings',
    year: '8 steps · Advanced',
    heading: 'What Binance, Coinbase, Kraken and OKX actually look at. How to build the relationship six months before you submit.',
    tags: ['Listings', 'Exchange', 'Strategy'],
    poster: '/images/bento2-1.jpg',
  },
  {
    href: '#',
    name: 'MiCA-compliant custody launch',
    year: '15 steps · Advanced',
    heading: 'Jurisdictional choice, capital requirements, client-fund segregation, audit trails. Written to be handed to your compliance counsel.',
    tags: ['MiCA', 'Compliance', 'Custody'],
    poster: '/images/bento3-1.jpg',
  },
  {
    href: '#',
    name: 'AI product GTM',
    year: '9 steps · Intermediate',
    heading: 'Pre-launch positioning, developer-first content, technical credibility, the paid-plus-organic motion once the story lands.',
    tags: ['AI', 'GTM', 'Product'],
    poster: '/images/bento4-1.jpg',
  },
  {
    href: '#',
    name: 'Post-MiCA stablecoin engineering',
    year: '11 steps · Advanced',
    heading: 'EMT vs ART, reserves, PoR, redemption engines, the architecture that clears EU and US regulators simultaneously.',
    tags: ['Stablecoin', 'MiCA', 'Engineering'],
    poster: '/images/bento1.jpg',
  },
  {
    href: '#',
    name: 'Web3 Series A pitch-deck system',
    year: '7 steps · Beginner',
    heading: 'The 18 slides that actually show up in every tier-1 raise, plus the six you can almost always cut.',
    tags: ['Pitch Deck', 'Series A', 'Raise'],
    poster: '/images/bento3.jpg',
  },
];
---
<Layout title="Guides | Corum8">
<div data-theme="light">
<section class="Hero_hero__Oyf4n"><div class="container"><div class="Hero_top__RRkYH"><h2><span class="LineByLine_headingOuter__JmusT"><span>Step-by-step playbooks. Written to be handed to your team on Monday.</span></span></h2><figure class="crosshair" aria-hidden="true"><span class="FadeInRotate_container__QE9u9" data-fill="true" data-direction="clockwise"><span class="inner"></span></span></figure><div class="Hero_video__rzcbe"><span class="ScaleFadeIn_container__cK78G" data-fill="true"><span class="ScaleFadeIn_inner__y4reT" data-fill="true"><video src="/media/bg2.mp4" class="Hero_video__rzcbe" autoplay muted loop playsinline></video></span></span></div></div><div class="Hero_bottom__ktiOH"><h1><span class="MaskInUp_container__0AW5i" data-fill="false"><div><span><i></i>Guides</span></div></span></h1><h3 class="Hero_introText__oP34v"><span class="FadeIn_container__bjQVL" data-fill="false"><span>Practical playbooks drawn from the programmes we run. No fluff. Read once, implement on Monday.</span></span></h3><div class="Hero_arrow__lxSeM"><span class="FadeInRotate_container__QE9u9" data-fill="false" data-direction="counterclockwise"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 75.91 75.65"><path d="m13.65 67.65 61.93-62L69.92 0 8 61.99V.25H0v75.4h75.91v-8H13.65z"></path></svg></span></div></div></div></section>

<div class="Work_work__rSI8c">
  <div class="DarkThemeSwitch_cover__hn_xc"></div>
  <div class="Work_projects__A5q77">
    <div class="AnimatedGrid_grid__otAMD">
      <div class="container">
        {projects.map((p) => (
          <a class="ProjectCard_project__d1wbY ProjectCard_small__xsL92" data-animation="grid-item" href={p.href}>
            <div class="ProjectCard_projectText__o770X">
              <h3>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14.78 14.78">
                  <defs>
                    <linearGradient id={arrowGrad.id} x1="3.54" x2="13.98" y1="3.54" y2="13.99" gradientUnits="userSpaceOnUse">
                      {arrowGrad.stops.map((s) => <stop offset={s.offset} stop-color={s.color}></stop>)}
                    </linearGradient>
                  </defs>
                  <path fill={`url(#${arrowGrad.id})`} stroke-width="0" d="M13.25 12.18L13.25 0.23 14.78 0.23 14.78 14.76 14.74 14.76 14.74 14.78 0.21 14.78 0.21 13.25 12.18 13.25 0 1.08 1.08 0 13.25 12.18z"></path>
                </svg>{p.name}
              </h3>
              <p>{p.year}</p>
            </div>
            <div class="ProjectCard_projectImage__Nfx9I">
              <div class="ProjectCard_imageOverlay__OCawr">
                <p class="ProjectCard_heading__1csIW">{p.heading}</p>
                <ul class="ProjectCard_tags__XdVcf">
                  {p.tags.map((t) => <li>{t}</li>)}
                </ul>
              </div>
              <span class="Image_image__RAAdZ Image_fill__EiIzS"><img src={p.poster} alt="" fetchpriority="low" loading="lazy" /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</div>

<KotaverseCta
  light="Want the playbook"
  bold="run for you?"
  subtitle="Book a call. We'll walk you through it and scope the engagement."
/>
</div>
</Layout>
