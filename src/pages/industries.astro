---
import Layout from "../layouts/Layout.astro";
import FinalCta from "../components/FinalCta.astro";

// ──────────────────────────────────────────────────────────────────────────
// /industries — editorial landing page.
//
// Design intent:
//   • Type-led, generous white space, restrained palette (cream / dark / gold).
//   • No reused KOTA hero, no bg-image bento. Custom shell, end-to-end.
//   • Six sections, all under one .indus__ namespace.
//
// Sections:
//   1. Hero        — eyebrow, 3-line H1, subhead, dual CTAs, soft gold glow.
//   2. Stats bar   — 4 huge numbers, no boxes, pure type on cream.
//   3. Industries  — six dramatic alternating bands. Each: huge ghost
//                    numeral, big editorial name, tagline, services chips,
//                    clients line, "Explore →" + a 3-image floating collage
//                    on the opposite side. Per-industry accent colour.
//                    Images are Unsplash hot-links (same convention as
//                    `src/components/Industries.astro`).
//   4. Dark band   — big statement + 3 pillar columns.
//   5. Testimonial — single quote, max 760px, premium card.
//   6. Final CTA   — existing component.
// ──────────────────────────────────────────────────────────────────────────

// Sized Unsplash hot-link helper. Returns a CDN URL with a width hint so
// the browser fetches a sensibly-sized variant for each tile.
const u = (id: string, w = 900) =>
  `https://images.unsplash.com/photo-${id}?w=${w}&q=80&auto=format&fit=crop`;

const industries = [
  {
    no: '01',
    href: '/industries/web3',
    name: 'Web3 & Crypto',
    tagline: 'Exchanges, wallets, RWAs, DeFi, tokens — and the launch engine that ships them.',
    services: ['CEX & DEX', 'Wallets', 'RWA', 'Tokens', 'PR'],
    clients: 'Binance · KuCoin · Cashaa · Fanadise · Metarix',
    accent: '#F2BF22',
    images: [
      { src: u('1622630998477-20aa696ecb05'), alt: 'Bitcoin coin on a laptop keyboard' },
      { src: u('1639152201720-5e536d254d81'), alt: 'Ethereum logo in three dimensions' },
      { src: u('1631603090989-93f9ef6f9d80'), alt: 'Pile of gold Bitcoin coins' },
    ],
  },
  {
    no: '02',
    href: '/industries/fintech',
    name: 'Fintech',
    tagline: 'Banks, neobanks, payment rails, lending — regulated engineering with marketing your legal team can sign off on.',
    services: ['Card Programmes', 'KYC/AML', 'Compliance', 'Institutional'],
    clients: 'Card programmes · MiCA-aware launches · FCA-friendly performance',
    accent: '#34D399',
    images: [
      { src: u('1601597111158-2fceff292cdc'), alt: 'Mobile banking app interface' },
      { src: u('1556742049-0cfed4f6a45d'),    alt: 'Stack of credit cards' },
      { src: u('1554224155-6726b3ff858f'),    alt: 'Currency closeup' },
    ],
  },
  {
    no: '03',
    href: '/industries/ai',
    name: 'AI',
    tagline: 'Agents, copilots, foundation-model wrappers — and the GTM that cuts through the me-too AI wall.',
    services: ['Agents', 'LLM', 'RAG', 'Developer GTM'],
    clients: 'Positioning · AEO/GEO · Developer-first launches',
    accent: '#A78BFA',
    images: [
      { src: u('1620712943543-bcc4688e7485'), alt: 'Humanoid AI face' },
      { src: u('1531297484001-80022131f5a1'), alt: 'Code on a monitor' },
      { src: u('1518770660439-4636190af475'), alt: 'Circuit board detail' },
    ],
  },
  {
    no: '04',
    href: '/industries/saas',
    name: 'SaaS',
    tagline: 'B2B and B2C platforms — product-led growth, enterprise sales motions, and the dev tooling under both.',
    services: ['PLG', 'ABM', 'Content', 'Analytics'],
    clients: 'Pipeline-tuned content · Dashboard UX · Founder-led PR',
    accent: '#60A5FA',
    images: [
      { src: u('1460925895917-afdab827c52f'), alt: 'Analytics dashboard on screen' },
      { src: u('1551288049-bebda4e38f71'),    alt: 'Workspace with laptop and notebook' },
      { src: u('1556761175-5973dc0f32e7'),    alt: 'Team strategy session at a table' },
    ],
  },
  {
    no: '05',
    href: '/industries/startups',
    name: 'Startups',
    tagline: "Pre-seed to Series A — products built for investors, users, and markets you haven't reached yet.",
    services: ['MVP', 'Pitch Decks', 'Launch PR', 'Growth'],
    clients: 'MVPs that ship in weeks · Decks that close rounds',
    accent: '#F472B6',
    images: [
      { src: u('1521737711867-e3b97375f902'), alt: 'Founders mid-conversation' },
      { src: u('1559136555-9303baea8ebd'),    alt: 'Whiteboard with sketches' },
      { src: u('1556761175-4b46a572b786'),    alt: 'Late-night build session' },
    ],
  },
  {
    no: '06',
    href: '/industries/enterprise',
    name: 'Enterprise',
    tagline: 'Fortune 500, financial institutions, government tech — delivery on the procurement clock.',
    services: ['Enterprise Blockchain', 'AI Integration', 'ABM', 'Analyst PR'],
    clients: 'Procurement-friendly SOWs · Analyst-grade dashboards',
    accent: '#FB923C',
    images: [
      { src: u('1542744173-8e7e53415bb0'), alt: 'Modern boardroom' },
      { src: u('1497366216548-37526070297c'), alt: 'Enterprise office floor' },
      { src: u('1486406146926-c627a92ad1ab'), alt: 'Skyscraper financial district' },
    ],
  },
];

const stats = [
  { figure: '1,100+', label: 'projects shipped' },
  { figure: '$120M+', label: 'revenue for clients' },
  { figure: '10+',    label: 'years shipping' },
  { figure: '30+',    label: 'partner countries' },
];

const pillars = [
  {
    eyebrow: 'Engineering',
    title: 'Code that ships against audits.',
    body: "We write Solidity, Rust, and TypeScript that has to clear external auditors before a single user touches it. Exchanges, wallets, RWAs, payment rails, agent stacks — the bar is the same.",
  },
  {
    eyebrow: 'Marketing',
    title: 'Go-to-market that ships against KPIs.',
    body: "PR that lands in The Block, Decrypt, CoinDesk, Bloomberg. Communities that hit retention, not DAU spikes. Performance media tuned to ROAS your CFO will believe.",
  },
  {
    eyebrow: 'One team',
    title: 'Engineering and marketing in the same room.',
    body: "One PM, one team across US, EU, UAE, India. Dev knows what marketing's promising. Marketing knows what dev's actually shipped. The handoff stops being a hand-off.",
  },
];

const featuredQuote = {
  quote: "Corum8 ran the narrative, the media, and the community push around our token event. The execution was clean, the relationships with outlets were already in place, and the team moved at the pace we needed. We raised what we set out to raise, and the coverage has kept working for us months later.",
  author: "Kumar Gaurav",
  role: "Founder & CEO, Cashaa",
  location: "London, UK",
  initials: "KG",
  outcome: "$32M raised",
};
---
<Layout title="Industries | Corum8">
<div data-theme="light" class="indus">

  <!-- ───── 1. Hero ──────────────────────────────────────────────────── -->
  <section class="indus__hero">
    <div class="indus__hero-bg" aria-hidden="true">
      <span class="indus__hero-glow"></span>
      <span class="indus__hero-grid"></span>
    </div>

    <div class="indus__container">
      <div class="indus__hero-inner" data-reveal-stagger="120">
        <p class="indus__eyebrow" data-reveal="up">Industries</p>

        <h1 class="indus__hero-h1">
          <span data-reveal="up">Six industries.</span>
          <span data-reveal="up">One team.</span>
          <span data-reveal="up"><em>Strategy to production.</em></span>
        </h1>

        <p class="indus__hero-sub" data-reveal="up">
          We ship engineering and go-to-market in the same room — for Web3, fintech, AI, SaaS, startups, and enterprise. Different surfaces. Same launch engine.
        </p>

        <div class="indus__hero-cta" data-reveal="up">
          <a href="/book-a-strategy-call" class="indus__btn indus__btn--primary">
            <span>Book a strategy call</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="/work" class="indus__btn indus__btn--ghost">
            <span>See our work</span>
          </a>
        </div>

        <p class="indus__hero-meta" data-reveal="up">
          Trusted by <strong>1,100+ brands</strong>. <strong>10+ years</strong> shipping. <strong>Dubai · US · India</strong>.
        </p>
      </div>
    </div>
  </section>

  <!-- ───── 2. Stats bar ─────────────────────────────────────────────── -->
  <section class="indus__stats">
    <div class="indus__container">
      <ul class="indus__stats-row" data-reveal-stagger="80">
        {stats.map((s) => (
          <li class="indus__stat" data-reveal="up">
            <span class="indus__stat-fig">{s.figure}</span>
            <span class="indus__stat-lbl">{s.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ───── 3. Industries — dramatic alternating rows ─────────────── -->
  <section class="indus__rows-sec">
    <div class="indus__container">
      <header class="indus__sec-head indus__sec-head--center" data-reveal-stagger="100">
        <p class="indus__eyebrow indus__eyebrow--muted" data-reveal="up">What we ship for</p>
        <h2 class="indus__h2" data-reveal="up">
          Six categories. <span class="indus__h2-accent">One bottleneck.</span>
        </h2>
        <p class="indus__sec-sub" data-reveal="up">
          The launch breaks where dev hands off to marketing. We work in the categories where that handoff has to disappear.
        </p>
      </header>
    </div>

    {industries.map((i, idx) => {
      const reverse = idx % 2 === 1;
      return (
        <article
          class={`indus__row${reverse ? ' indus__row--reverse' : ''}`}
          style={`--row-accent: ${i.accent};`}
          data-reveal-stagger="100"
        >
          <span class="indus__row-glow" aria-hidden="true"></span>
          <span class="indus__row-bg-num" aria-hidden="true">{i.no}</span>

          <div class="indus__container">
            <div class="indus__row-grid">
              <div class="indus__row-content" data-reveal="up">
                <span class="indus__row-no">
                  <span class="indus__row-no-dot"></span>
                  <span>{i.no} / 06</span>
                </span>
                <h3 class="indus__row-name">{i.name}</h3>
                <p class="indus__row-tagline">{i.tagline}</p>

                <ul class="indus__row-services" aria-label="What we ship">
                  {i.services.map((s) => <li>{s}</li>)}
                </ul>

                <p class="indus__row-clients">
                  <span class="indus__row-clients-label">Clients · proof</span>
                  <span class="indus__row-clients-text">{i.clients}</span>
                </p>

                <a class="indus__row-cta" href={i.href}>
                  <span>Explore {i.name}</span>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
              </div>

              <div class="indus__row-stage" data-reveal="up">
                <span class="indus__row-plate" aria-hidden="true"></span>
                {i.images.map((img, ix) => (
                  <figure class={`indus__photo indus__photo--${ix}`}>
                    <img src={img.src} alt={img.alt} loading="lazy" />
                  </figure>
                ))}
                <span class="indus__row-spark" aria-hidden="true"></span>
              </div>
            </div>
          </div>
        </article>
      );
    })}
  </section>

  <!-- ───── 4. Dark band — how we work ──────────────────────────────── -->
  <section class="indus__how">
    <div class="indus__container">
      <header class="indus__how-head" data-reveal-stagger="120">
        <p class="indus__eyebrow indus__eyebrow--gold" data-reveal="up">How we work</p>
        <h2 class="indus__h2 indus__h2--invert" data-reveal="up">
          The skills move. <span class="indus__h2-accent indus__h2-accent--invert">The surface changes.</span>
        </h2>
        <p class="indus__how-sub" data-reveal="up">
          A token launch and a card programme look different on the website. Under the hood, the work is the same — engineering against an audit, marketing against a number, one PM keeping both honest.
        </p>
      </header>

      <ol class="indus__pillars" data-reveal-stagger="120">
        {pillars.map((p, i) => (
          <li class="indus__pillar" data-reveal="up">
            <span class="indus__pillar-no">{String(i + 1).padStart(2, '0')}</span>
            <span class="indus__pillar-eyebrow">{p.eyebrow}</span>
            <h3 class="indus__pillar-title">{p.title}</h3>
            <p class="indus__pillar-body">{p.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ───── 6. Final CTA ────────────────────────────────────────────── -->
  <FinalCta
    light="One team."
    bold="Six industries."
    subtitle="Tell us where you're headed. We'll tell you what we'd ship first."
  />

</div>

<style is:global>
  /* ────────────────────────────────────────────────────────────────────
     /industries — editorial landing styles. Single .indus__* namespace.
     ──────────────────────────────────────────────────────────────────── */

  .indus { background: var(--color-bg); color: #0a0a0a; }

  .indus__container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 4vw, 3rem);
  }
  .indus__container--narrow { max-width: 1100px; }

  /* Shared eyebrow / heading */
  .indus__eyebrow {
    margin: 0 0 1.4rem;
    font-family: var(--montreal);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--c8-gold-dark);
  }
  .indus__eyebrow--muted { color: rgba(0,0,0,0.55); }
  .indus__eyebrow--gold  { color: var(--c8-gold); }

  .indus__h2 {
    margin: 0 0 1.1rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.6vw, 3.4rem);
    font-weight: 350;
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: #0a0a0a;
  }
  .indus__h2--invert { color: #fff; }
  .indus__h2-accent  { color: var(--c8-gold-dark); font-weight: 350; }
  .indus__h2-accent--invert { color: var(--c8-gold); }

  /* ───── 1. Hero ──────────────────────────────────────────────────── */
  .indus__hero {
    position: relative;
    isolation: isolate;
    padding: clamp(8rem, 16vh, 11rem) 0 clamp(5rem, 10vh, 7rem);
    overflow: hidden;
  }
  .indus__hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .indus__hero-glow {
    position: absolute;
    top: -10%;
    right: -10%;
    width: 70%;
    height: 110%;
    background:
      radial-gradient(closest-side, rgba(242,191,34,0.28) 0%, rgba(242,191,34,0.10) 40%, transparent 75%);
    filter: blur(8px);
  }
  .indus__hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0,0,0,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,0,0,0.04) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse 70% 65% at 50% 35%, #000 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 70% 65% at 50% 35%, #000 30%, transparent 80%);
    opacity: 0.5;
  }

  .indus__hero-inner {
    max-width: 980px;
  }
  .indus__hero-h1 {
    margin: 0 0 1.6rem;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6.2vw, 4.8rem);
    font-weight: 350;
    line-height: 1;
    letter-spacing: -0.04em;
    color: #0a0a0a;
  }
  .indus__hero-h1 span {
    display: block;
  }
  .indus__hero-h1 em {
    font-style: normal;
    background: linear-gradient(110deg, var(--c8-gold-dark) 0%, var(--c8-gold) 50%, var(--c8-gold-light) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .indus__hero-sub {
    margin: 0 0 2.2rem;
    max-width: 38rem;
    font-family: var(--montreal);
    font-size: clamp(1.05rem, 1.3vw, 1.18rem);
    line-height: 1.55;
    color: rgba(0,0,0,0.7);
  }

  .indus__hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1rem;
    align-items: center;
    margin-bottom: 2.4rem;
  }

  .indus__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 1.05rem 1.85rem;
    border-radius: 999px;
    text-decoration: none;
    font-family: var(--montreal);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    transition: transform 0.35s cubic-bezier(0.16,1,0.3,1), background 0.3s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .indus__btn svg { transition: transform 0.35s cubic-bezier(0.16,1,0.3,1); }
  .indus__btn--primary {
    background: #0a0a0a;
    color: #fff;
    box-shadow: 0 16px 32px -16px rgba(0,0,0,0.4);
  }
  .indus__btn--primary:hover {
    background: var(--c8-gold);
    color: #0a0a0a;
    transform: translateY(-2px);
    box-shadow: 0 22px 44px -20px var(--c8-gold-glow);
  }
  .indus__btn--primary:hover svg { transform: translateX(4px); }
  .indus__btn--ghost {
    background: transparent;
    color: #0a0a0a;
    border: 1px solid rgba(0,0,0,0.18);
  }
  .indus__btn--ghost:hover {
    border-color: #0a0a0a;
    transform: translateY(-2px);
  }

  .indus__hero-meta {
    margin: 0;
    font-family: var(--montreal);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    color: rgba(0,0,0,0.55);
  }
  .indus__hero-meta strong { color: #0a0a0a; font-weight: 600; }

  /* ───── 2. Stats bar ─────────────────────────────────────────────── */
  .indus__stats {
    padding: clamp(2rem, 4vh, 3.5rem) 0 clamp(4rem, 8vh, 6rem);
    border-top: 1px solid rgba(0,0,0,0.08);
  }
  .indus__stats-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
  }
  .indus__stat {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1.85rem;
    border-top: 1px solid rgba(0,0,0,0.08);
  }
  .indus__stat-fig {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    font-weight: 350;
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: #0a0a0a;
  }
  .indus__stat-lbl {
    font-family: var(--montreal);
    font-size: 0.86rem;
    line-height: 1.4;
    color: rgba(0,0,0,0.6);
  }
  @media (max-width: 800px) {
    .indus__stats-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 460px) {
    .indus__stats-row { grid-template-columns: 1fr; }
  }

  /* ───── 3. Industries — dramatic alternating rows ─────────────── */
  .indus__rows-sec {
    padding: clamp(4rem, 8vh, 6rem) 0 0;
  }
  .indus__sec-head {
    max-width: 56rem;
    margin: 0 0 clamp(2.5rem, 5vh, 3.5rem);
  }
  .indus__sec-head--center {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }
  .indus__sec-sub {
    margin: 0;
    max-width: 38rem;
    font-family: var(--montreal);
    font-size: clamp(1rem, 1.15vw, 1.08rem);
    line-height: 1.6;
    color: rgba(0,0,0,0.62);
  }
  .indus__sec-head--center .indus__sec-sub {
    margin-left: auto;
    margin-right: auto;
  }

  /* ─── Row band ─── */
  .indus__row {
    position: relative;
    padding: clamp(4rem, 9vh, 7rem) 0;
    isolation: isolate;
    overflow: hidden;
    border-top: 1px solid rgba(0,0,0,0.06);
  }
  .indus__row:first-of-type { border-top: 0; }

  /* Per-row coloured glow — subtle accent that distinguishes each
     industry without overwhelming the cream surface. */
  .indus__row-glow {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(900px circle at 88% 8%, color-mix(in srgb, var(--row-accent) 22%, transparent) 0%, transparent 55%),
      radial-gradient(700px circle at 6% 92%, color-mix(in srgb, var(--row-accent) 12%, transparent) 0%, transparent 55%);
    pointer-events: none;
  }
  .indus__row--reverse .indus__row-glow {
    background:
      radial-gradient(900px circle at 12% 8%, color-mix(in srgb, var(--row-accent) 22%, transparent) 0%, transparent 55%),
      radial-gradient(700px circle at 94% 92%, color-mix(in srgb, var(--row-accent) 12%, transparent) 0%, transparent 55%);
  }

  /* Huge ghost numeral painted behind the content. Decorative. */
  .indus__row-bg-num {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: -1;
    font-family: var(--font-display);
    font-size: clamp(18rem, 38vw, 36rem);
    font-weight: 350;
    line-height: 1;
    letter-spacing: -0.06em;
    color: var(--row-accent);
    opacity: 0.07;
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
  }

  .indus__row-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .indus__row--reverse .indus__row-grid {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
  }
  .indus__row--reverse .indus__row-content { order: 2; }
  .indus__row--reverse .indus__row-stage   { order: 1; }
  @media (max-width: 900px) {
    .indus__row-grid,
    .indus__row--reverse .indus__row-grid { grid-template-columns: 1fr; gap: 2.25rem; }
    .indus__row--reverse .indus__row-content,
    .indus__row--reverse .indus__row-stage { order: initial; }
  }

  /* Content side */
