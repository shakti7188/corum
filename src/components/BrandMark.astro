---
import { brand } from '../data/siteNav';
interface Props {
  fill?: string;
  stroke?: string;
}
const { fill = 'currentColor', stroke = '#0000' } = Astro.props;
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 90 90" aria-hidden="true">
  <rect x="5" y="5" width="80" height="80" fill={fill} stroke={stroke} stroke-width="0"></rect>
  <text
    x="45"
    y="58"
    text-anchor="middle"
    font-family="inherit"
    font-size="34"
    font-weight="700"
    letter-spacing="-1"
    fill={stroke === '#0000' ? '#efefef' : '#000'}
  >{brand.shortMark}</text>
</svg>
