  { bg: 'linear-gradient(135deg,#d7c7d0,#b895a4)',  user: 'milaxweb3',      hint: '',   likes: '8.9K'  },
  { bg: 'linear-gradient(135deg,#c7d3c2,#9fb4a0)',  user: 'defi.arielle',   hint: '',   likes: '23.1K' },
  { bg: 'linear-gradient(135deg,#c9d1d8,#98a6b4)',  user: 'jeff.vc',        hint: 'AD', likes: '4.2K'  },
  { bg: 'linear-gradient(135deg,#e8c9b5,#cb9880)',  user: 'nina.on.chain',  hint: '',   likes: '17.7K' },
  { bg: 'linear-gradient(135deg,#dcd3c4,#b4a890)',  user: 'max.tokens',     hint: '',   likes: '6.3K'  },
