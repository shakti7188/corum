    .lp-deep-row:first-of-type { border-top: 0; padding-top: clamp(1rem, 2vh, 2rem); }
    .lp-deep-row:last-child { border-bottom: 1px solid rgba(0,0,0,0.06); }
    @media (max-width: 900px) {
