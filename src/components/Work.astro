---
// Work section — Corum8 intro (large) + 6 featured case studies
const arrowGrad = {
  id: 'd',
  stops: [
    { offset: '0', color: '#7c41f3' },
    { offset: '1', color: '#ff6eff' },
  ],
};

// The first item is a Corum8 introduction panel. It uses the same card markup
// so the grid stays consistent, but carries intro-only copy (no case-study
// metric, no /work/* href) and plays bg2.mp4 as a brand loop.
const intro = {
  size: 'large',
  isIntro: true,
  href: '#our-work',
  name: 'Corum8',
  kicker: 'Introducing',
  result: 'Global marketing, PR & full-stack dev',
  heading: 'We build, market and scale Web3, AI and fintech companies that refuse to blend in.',
  tags: ['Global Marketing', 'PR', 'Full-Stack Development', 'Web3 · AI · Fintech'],
  video: '/media/bg2.mp4',
};

const projects = [
  {
    size: 'small',
    href: '/work/fanadise',
    name: 'Fanadise',
    type: 'Full-stack Web3 growth campaign',
    result: '$5M raised',
    heading: 'Full-stack Web3 growth campaign that rallied the community behind a $5M raise.',
    tags: ['Full-stack Web3', 'Growth Campaign', 'Community'],
    video: '/media/GOAT-FeatureVideo.mp4',
    poster: '/images/GOAT-FeaturedImage.png',
  },
  {
    size: 'small',
    href: '/work/ubuntu-tribe',
    name: 'Ubuntu Tribe',
    type: 'PR, community, influencer, Token2049',
    result: 'Global presence + community acceleration',
    heading: 'PR, community and influencer programme anchored around a Token2049 activation — delivering global presence and community acceleration.',
    tags: ['PR', 'Community', 'Influencer', 'Token2049 Event'],
    video: '/media/isi-vid2-1.mp4',
    poster: '/images/hero.webp',
  },
  {
    size: 'small',
    href: '/work/kucoin',
    name: 'KuCoin',
    type: 'Strategic PR for major exchange',
    result: 'Stronger brand visibility globally',
    heading: 'Strategic PR programme for a major exchange — amplifying brand visibility in every priority market.',
    tags: ['Strategic PR', 'Exchange', 'Global Visibility'],
    video: '/media/Duplicated-Assets.mp4',
    poster: '/images/ig-featured-mobile.jpg',
  },
  {
    size: 'small',
    href: '/work/metarix',
    name: 'Metarix',
    type: 'Full launch — influencers, PR, community',
    result: '$780K raised',
    heading: 'Full launch across influencers, PR and community that converted attention into a $780K raise.',
    tags: ['Influencers', 'PR', 'Community', 'Full Launch'],
    video: '/media/Featured-compressed.mp4',
    poster: '/images/wogan-featured-2.jpg',
  },
  {
    size: 'small',
    href: '/work/binance',
    name: 'Binance',
    type: 'Performance affiliate network',
    result: '$800M+ monthly exchange volume',
    heading: 'Performance affiliate network driving $800M+ monthly exchange volume.',
    tags: ['Performance Marketing', 'Affiliate Network', 'Exchange'],
    video: '/media/Company-Loop4-compressed-2.mp4',
    poster: '/images/upp-featured-mobile.jpg',
  },
  {
    size: 'small',
    href: '/work/cashaa',
    name: 'Cashaa',
    type: 'Token launch — influencer, PR, community',
    result: '$32M raised',
    heading: 'Token launch powered by influencer marketing, PR and community activation — $32M raised.',
    tags: ['Token Launch', 'Influencer Marketing', 'PR', 'Community'],
    video: '/media/Featured2-Compressed.mp4',
    poster: '/images/upp-featured-mobile.jpg',
  },
];

const allCards = [intro, ...projects];
---

<div class="Work_work__rSI8c" id="our-work">
  <div class="DarkThemeSwitch_cover__hn_xc"></div>
  <div class="container">
    <div class="Work_text__WI9A4">
      <h2 class="Work_heading__pbv4g">
        <div class="LargeHeading_headingOuter__i9qcd">
          <span class="Work_heading__pbv4g">Our</span><span class="Work_heading__pbv4g Work_bottom__rzrzH">Work</span>
        </div>
      </h2>
      <div class="Work_rightText__zx_Y0">
        <h3>
          <span data-blur-reveal="true">Campaigns that raise capital and move markets.</span>
        </h3>
        <p>
          <span data-blur-reveal="true">Featured case studies across Web3, AI and fintech — token launches, PR programmes and full-stack growth campaigns that delivered measurable results.</span>
        </p>
      </div>
    </div>
  </div>
  <div class="Work_projects__A5q77">
    <div class="AnimatedGrid_grid__otAMD">
      <div class="container">
        {allCards.map((p) => (
          <a
            class={`ProjectCard_project__d1wbY ${p.size === 'large' ? 'ProjectCard_large__JOQbv' : 'ProjectCard_small__xsL92'}${p.isIntro ? ' ProjectCard_intro__c8' : ''}`}
            data-animation="grid-item"
            href={p.href}
          >
            <div class="ProjectCard_projectText__o770X">
              <h3>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14.78 14.78">
                  <defs>
                    <linearGradient id={arrowGrad.id} x1="3.54" x2="13.98" y1="3.54" y2="13.99" gradientUnits="userSpaceOnUse">
                      {arrowGrad.stops.map((s) => <stop offset={s.offset} stop-color={s.color}></stop>)}
                    </linearGradient>
                  </defs>
                  <path fill={`url(#${arrowGrad.id})`} stroke-width="0" d="M13.25 12.18L13.25 0.23 14.78 0.23 14.78 14.76 14.74 14.76 14.74 14.78 0.21 14.78 0.21 13.25 12.18 13.25 0 1.08 1.08 0 13.25 12.18z"></path>
                </svg>{p.name}
              </h3>
              <p>
                {p.kicker && <span class="ProjectCard_kicker__c8">{p.kicker} &middot; </span>}
                {p.type && <span class="ProjectCard_type__c8">{p.type} &middot; </span>}
                <span class="ProjectCard_result__c8">{p.result}</span>
              </p>
            </div>
            <div class="ProjectCard_projectImage__Nfx9I">
              <div class="ProjectCard_imageOverlay__OCawr">
                <p class="ProjectCard_heading__1csIW">{p.heading}</p>
                <ul class="ProjectCard_tags__XdVcf">
                  {p.tags.map((t) => <li>{t}</li>)}
                </ul>
              </div>
              {p.poster && (
                <span class="Image_image__RAAdZ Image_fill__EiIzS"><img data-src={p.poster} alt="" fetchpriority="low" class="lazyload" /></span>
              )}
              <video src={p.video} class="ProjectCard_video__AheFz" autoplay="true" muted="true" loop="true" preload={p.size === 'large' ? 'auto' : 'metadata'} playsinline="true"></video>
            </div>
          </a>
        ))}
        <div class="Work_buttonContainer__Owbmu">
          <span class="FadeInUp_container___uxva" data-fill="false"><div class="Magnetic_magnetic__LncOy" data-fill="false">
            <div class="Button_button__JJiqJ Button_white__MQaf2" data-direction="forwards">
              <a class="Button_inner__fnyH6" href="/work"><span class="Button_border__hirH2"></span><span class="Button_text__IZaCD"><span class="Button_textInner__JTTHe">View all projects</span><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 17.1 15.17" class="Button_buttonArrow__0W9XI">
                <path d="m17.1,7.58s-.01-.04-.01-.06c.01-.22-.06-.45-.24-.61L9.23.19c-.31-.27-.78-.24-1.06.07-.27.31-.24.78.07,1.06l6.26,5.52H.75c-.41,0-.75.34-.75.75s.34.75.75.75h13.74l-6.26,5.52c-.31.27-.34.75-.07,1.06.15.17.35.25.56.25.18,0,.35-.06.5-.19l7.62-6.72c.18-.16.25-.39.24-.61,0-.02.01-.04.01-.06Z" fill="currentColor"></path></svg></span></a>
            </div>
          </div></span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .Work_work__rSI8c {
    background-color: #000 !important;
    padding-bottom: 15vh;
  }

  /* Intro card keeps the grid layout but styles the copy more prominently */
  .ProjectCard_intro__c8 .ProjectCard_projectText__o770X p {
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .ProjectCard_kicker__c8 {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.7em;
    opacity: 0.75;
  }

  .ProjectCard_type__c8 {
    opacity: 0.85;
  }

  .ProjectCard_result__c8 {
    font-weight: 600;
  }
</style>
