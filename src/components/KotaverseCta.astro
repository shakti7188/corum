---
// Final CTA Section
---

<section class="FinalCta_wrapper">
  <!-- 3D Animated Background Object exactly 50% smaller -->
  <figure class="FinalCta_videoBackground">
    <video autoplay loop muted playsinline src="https://kota-content.b-cdn.net/app/uploads/2024/01/blob-loop-uncompressed_1706098182.mp4"></video>
  </figure>

  <!-- Foreground Dark Gradient Overlay -->
  <div class="FinalCta_overlay"></div>

  <!-- Content -->
  <div class="FinalCta_content">
    <h2 class="FinalCta_title">
      <span class="FinalCta_light">Ready to</span><br/>
      <span class="FinalCta_bold">build, launch &amp; scale?</span>
    </h2>
    <p class="FinalCta_subtitle">One team. Full stack. Dubai · US · India.</p>
    <a href="/book-a-strategy-call" class="FinalCta_button">
      Book a Strategy Call
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 17 15" class="FinalCta_arrow"><path d="M17 7.5S17 7.5 17 7.5c0-.2-.1-.5-.2-.6L9.2.2C8.9-.1 8.4-.1 8.1.2c-.3.3-.3.8 0 1.1l6.3 5.5H.8C.3 6.8 0 7.1 0 7.6c0 .4.3.8.8.8h13.7l-6.3 5.5c-.3.3-.3.8 0 1.1.2.2.4.3.6.3s.4-.1.5-.2l7.6-6.7c.2-.2.2-.4.2-.6 0 0 0 0 0 0Z" fill="currentColor"/></svg>
    </a>
  </div>
</section>

<style>
  .FinalCta_wrapper {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #000;
    overflow: hidden;
    padding: 10rem 0;
  }

  .FinalCta_videoBackground {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 30vw;
    height: 50vh;
    transform: translate(-50%, -50%);
    z-index: 1;
    pointer-events: none;
    opacity: 0.8;
  }

  .FinalCta_videoBackground video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: screen;
  }

  .FinalCta_overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: radial-gradient(circle, rgba(0,0,0,0) 0%, #000 80%);
    z-index: 2;
    pointer-events: none;
  }

  .FinalCta_content {
    position: relative;
    z-index: 10;
    text-align: center;
    color: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
  }

  .FinalCta_title {
    font-size: clamp(2.5rem, 7.1vw, 7.5rem);
    line-height: 1;
    margin: 0;
    letter-spacing: -0.02em;
    font-weight: 400;
    color: #fff;
  }

  .FinalCta_light,
  .FinalCta_bold {
    font-weight: 400;
    color: #fff;
  }

  .FinalCta_subtitle {
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #a1a1aa;
    margin: 0;
  }

  .FinalCta_button {
    margin-top: 3rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    border: 1px solid rgba(255,255,255,0.2);
    padding: 1.5rem 3.5rem;
    border-radius: 4rem;
    font-size: 1.1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    background: rgba(255,255,255,0.03);
    backdrop-filter: blur(10px);
    color: #fff;
    text-decoration: none;
  }

  .FinalCta_button:hover {
    background: rgba(255,255,255,1);
    color: #000;
    border-color: #fff;
    transform: translateY(-3px);
    box-shadow: 0 10px 40px rgba(124, 65, 243, 0.3);
  }

  .FinalCta_arrow {
    width: 20px;
    height: 15px;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .FinalCta_button:hover .FinalCta_arrow {
    transform: translateX(8px);
  }
</style>
