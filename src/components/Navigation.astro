---
import { navLinks, ctaLink } from '../data/siteNav';
import ArrowIcon from './ArrowIcon.astro';
---
<div class="PrimaryNavigation_page__DgiUM">
  <button class="PrimaryNavigation_icon__qAQCe" data-modal-hide="true" aria-label="Open menu">
    <div class="PrimaryNavigation_line__eUBQ0"></div>
    <div class="PrimaryNavigation_line__eUBQ0"></div>
  </button>
  <aside class="PrimaryNavigation_flyout__nH7QV">
    <nav class="PrimaryNavigation_navigation__l8Jgb">
      <ul>
        {navLinks.map((item) => (
          <li>
            {item.children ? (
              <>
                <div class="PrimaryNavigation_parent__bfX37">
                  {item.label}
                  <figure class="PrimaryNavigation_toggleSign__XESvT">
                    <span class="PrimaryNavigation_toggleInner__Lz3QB">
                      <span class="PrimaryNavigation_toggleLine__QUlfd"></span>
                      <span class="PrimaryNavigation_toggleLine__QUlfd"></span>
                    </span>
                  </figure>
                </div>
                <ul class="PrimaryNavigation_submenu__ryGWu">
                  {item.children.map((child) => (
                    <li><a href={child.href}>{child.label}</a></li>
                  ))}
                </ul>
              </>
            ) : (
              <a href={item.href}>{item.label}</a>
            )}
          </li>
        ))}
      </ul>
      <div class="PrimaryNavigation_buttonContainer__iiKTy">
        <div class="Magnetic_magnetic__LncOy" data-fill="false">
          <div class="Button_button__JJiqJ" data-direction="forwards">
            <a class="Button_inner__fnyH6" href={ctaLink.href}>
              <span class="Button_border__hirH2"></span>
              <span class="Button_text__IZaCD">
                <span class="Button_textInner__JTTHe">{ctaLink.label}</span>
                <ArrowIcon class="Button_buttonArrow__0W9XI" />
              </span>
            </a>
          </div>
        </div>
      </div>
    </nav>
    <div class="PrimaryNavigation_background__vtv26"></div>
  </aside>
  <figure class="PrimaryNavigation_pageOverlay__QD6me"></figure>
</div>

<style is:global>
  /* Fix Mobile Overlap on Corum8 expanded menus */
  .PrimaryNavigation_submenu__ryGWu {
    position: relative !important;
    max-height: none !important;
    height: auto !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 0.75rem !important;
    padding-top: 1rem !important;
    padding-bottom: 2rem !important;
    min-height: fit-content !important;
    opacity: 1 !important;
    visibility: visible !important;
    transform: none !important;
    background: transparent !important;
  }
  .PrimaryNavigation_navigation__l8Jgb ul {
    position: relative !important;
    display: flex !important;
    flex-direction: column !important;
    height: auto !important;
    overflow: visible !important;
    padding-bottom: 5rem !important;
  }
  .PrimaryNavigation_navigation__l8Jgb li {
    position: relative !important;
    height: auto !important;
  }
  .PrimaryNavigation_navigation__l8Jgb .PrimaryNavigation_parent__bfX37 {
    margin-bottom: 0.5rem;
  }
  .PrimaryNavigation_submenu__ryGWu li a {
    font-size: 1.1rem !important;
    opacity: 0.8 !important;
    text-transform: none !important;
    letter-spacing: 0 !important;
  }
</style>
