    ],
  },
  {
    key: 'audit',
    label: 'Audit',
    headline: 'Two firms, plus our own. Never just one.',
    claim: 'Audited code is the floor, not the ceiling.',
    img: 'https://images.unsplash.com/photo-1556761175-5973dc0f32e7?w=900&q=80&auto=format&fit=crop',
    points: [
      'Internal review — staff auditors, no production code ships unread',
      'Two independent third-party firms — CertiK, OpenZeppelin, Trail of Bits, Quantstamp',
