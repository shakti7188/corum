    .lp-deep {
      padding: clamp(5rem, 10vh, 8rem) var(--lp-pad-x);
      background: #fff;
      color: #0a0a0a;
    }
    .lp-deep > * { max-width: var(--lp-max); margin-left: auto; margin-right: auto; }
    .lp-deep-row {
      display: grid;
