---
import "../styles/global.css";
import Navigation from '../components/Navigation.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="__variable_a78db3 __variable_ab8453">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <meta name="description" content="Discover Corum8, a Global Web3 Marketing, PR & Development Agency. Experts in Web3 & Crypto, Startups, SaaS, Fintech, AI, and Enterprise strategy." />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Preload brand icon for the preloader so the mark paints immediately
         (no fetch delay on the loading screen). -->
    <link rel="preload" href="/assets/logo/icon-gold.png" as="image" fetchpriority="high" />

    <!-- Preload only the primary body font. Other subsetted variants fetch
         lazily as rules need them (saves ~120 KB of blocking requests on
         first paint). -->
    <link rel="preload" href="/_next/static/media/482a8097102f5f9f-s.p.woff2" as="font" crossorigin="" type="font/woff2">

    <!-- Preload the Cocogoose display font — used for every heading. Avoids
         the heading FOUT on first paint. -->
    <link rel="preload" href="/fonts/Cocogoose.woff2" as="font" type="font/woff2" crossorigin>

    <!-- Preloader critical CSS — inlined so the overlay paints before the
         main stylesheet arrives. Uses the Corum8 gold icon with a subtle
         pulse + rotate. Fades out on window load. -->
    <style>
      #c8-preloader {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #0a0a0a;
        opacity: 1;
        transition: opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1);
        pointer-events: all;
      }
      #c8-preloader.is-done {
        opacity: 0;
        pointer-events: none;
      }
      #c8-preloader .c8-preloader__mark {
        width: 96px;
        height: 96px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
      }
      #c8-preloader .c8-preloader__mark::before {
        content: "";
        position: absolute;
        inset: -18px;
        border-radius: 50%;
        border: 1px solid rgba(242, 191, 34, 0.25);
        border-top-color: #f2bf22;
        animation: c8-preloader-spin 1.4s linear infinite;
      }
      #c8-preloader .c8-preloader__mark img {
        width: 64px;
        height: 64px;
        object-fit: contain;
        animation: c8-preloader-pulse 1.8s ease-in-out infinite;
      }
      @keyframes c8-preloader-spin {
        to { transform: rotate(360deg); }
      }
      @keyframes c8-preloader-pulse {
        0%, 100% { opacity: 0.85; transform: scale(1); }
        50%      { opacity: 1;    transform: scale(1.04); }
      }
      @media (prefers-reduced-motion: reduce) {
        #c8-preloader .c8-preloader__mark::before,
        #c8-preloader .c8-preloader__mark img {
          animation: none !important;
        }
      }
    </style>

    <!-- Critical CSS (blocking). The kota-core bundle carries layout/body
         type so first paint needs it. -->
    <link rel="stylesheet" href="/css/kota-core.css">

    <!-- Detail/interaction CSS deferred via `media="print"` + `onload` trick —
         browser still downloads in parallel but they don't block first paint. -->
    <link rel="stylesheet" href="/css/13f753c524b3db20.css" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="/css/57c1cf65c8fee4f0.css" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="/css/de01f06c65200d74.css" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="/css/d7d67e4e7d8a2a37.css" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="/css/ecdfc97c33854f51.css" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="/css/3d63d502945bea5a.css" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="/css/360c1cf90a1ae901.css" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="/css/842a33b51ca56037.css" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="/css/f84288c45a46068b.css" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="/css/df01bcfa5dec6e02.css" media="print" onload="this.media='all'">
    <noscript>
      <link rel="stylesheet" href="/css/13f753c524b3db20.css">
      <link rel="stylesheet" href="/css/57c1cf65c8fee4f0.css">
      <link rel="stylesheet" href="/css/de01f06c65200d74.css">
      <link rel="stylesheet" href="/css/d7d67e4e7d8a2a37.css">
      <link rel="stylesheet" href="/css/ecdfc97c33854f51.css">
      <link rel="stylesheet" href="/css/3d63d502945bea5a.css">
      <link rel="stylesheet" href="/css/360c1cf90a1ae901.css">
      <link rel="stylesheet" href="/css/842a33b51ca56037.css">
      <link rel="stylesheet" href="/css/f84288c45a46068b.css">
      <link rel="stylesheet" href="/css/df01bcfa5dec6e02.css">
    </noscript>

    <!-- Page-specific head (meta, canonical, OG, JSON-LD, etc.) -->
    <slot name="head" />
  </head>
  <body>
    <!-- Corum8 preloader — visible until window.load fires, then fades out. -->
    <div id="c8-preloader" aria-hidden="true">
      <div class="c8-preloader__mark">
        <img src="/assets/logo/icon-gold.png" alt="" role="presentation" />
      </div>
    </div>
    <script is:inline>
      (function () {
        var el = document.getElementById('c8-preloader');
        if (!el) return;
        var hide = function () {
          el.classList.add('is-done');
          // Remove from DOM after the fade so it can't block interaction.
          setTimeout(function () { el.remove(); }, 650);
        };
        // Don't trap users on slow networks — cap the visible time.
        var maxWait = setTimeout(hide, 4000);
        var ready = function () {
          clearTimeout(maxWait);
          // Short delay so layout has a beat to settle before the fade.
          setTimeout(hide, 150);
        };
        if (document.readyState === 'complete') {
          ready();
        } else {
          window.addEventListener('load', ready, { once: true });
        }
      })();
    </script>

    <Navigation />
    <Header />
    <main style="position: relative; z-index: 1;">
      <slot />
    </main>
    <Footer />

    <WhatsAppButton />

    <script>
      import '../scripts/site.ts';
    </script>

    <style is:global>
      /* Brand tokens (--c8-gold*) are declared in src/styles/global.css. */

      /* KOTA Missing Hydration CSS Overrides */
      [class*="Timeline_timeline__"] {
        display: block !important;
        overflow: hidden;
      }
      /* Ensure internal invisible wrappers are unlocked and scrollable */
      [class*="Timeline_timeline__"] {
        opacity: 1 !important;
        visibility: visible !important;
      }
      [class*="StaggeredItems_grid__"],
      [class*="Timeline_block__"] {
        opacity: 1 !important;
        visibility: visible !important;
        display: flex !important;
      }
      [class*="StaggeredItems_grid__"],
      [class*="Timeline_scroller__"] {
        display: flex !important;
        width: max-content !important;
        flex-wrap: nowrap;
        gap: 2rem;
      }
      [class*="Timeline_inner__"] {
        display: flex;
        gap: 2rem;
      }
      
      /* Global Image Premium Hover Upgrade (Replacing Shake) */
      img, [class*="Image_image__"] {
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s ease;
      }
      img:hover, [class*="Image_image__"]:hover {
        transform: scale(1.02);
      }
      
      /* Circular Wave Hover for Hero Top Media */
      [class*="Hero_video__"], [class*="Hero_video__"] * {
        transition: box-shadow 0.8s ease, transform 0.8s ease;
        border-radius: 50% !important; /* Enforce deeply nested circularity */
      }
      [class*="Hero_video__"] {
        aspect-ratio: 1 / 1 !important; /* Force geometric perfection */
        object-fit: cover !important;
        overflow: hidden;
      }
      [class*="Hero_video__"]:hover {
        box-shadow: 0 0 0 20px rgba(200, 255, 0, 0.1), 0 0 0 40px rgba(200, 255, 0, 0.05);
        transform: scale(1.03);
      }
      
      /* Header Breathing Room fix for Hero Top Media */
      [class*="Hero_hero__"] {
        padding-top: clamp(100px, 12vh, 160px) !important;
      }
      
      /* Force Visibility on Arrow Container */
      [class*="Hero_arrow__"] [class*="FadeIn"] {
        opacity: 1 !important;
        transform: none !important;
      }

      /* KOTA Button — keep text + arrow inline, site-wide. Fixes cases where
         narrow container widths cause the arrow SVG to wrap onto a new line. */
      [class*="Button_text__"] {
        display: inline-flex !important;
        align-items: center;
        flex-wrap: nowrap;
        white-space: nowrap;
      }
      [class*="Button_buttonArrow__"] {
        width: 14px;
        flex-shrink: 0;
      }

      /* Reduce KOTA hero H1 size site-wide. KOTA's --fs-60 (clamp(2.5rem,
         4.26vw, 4.375rem) = up to ~70px) was reading too large across
         /case-studies, /industries/*, /services/*, /about, etc. Pulled down
         to ~3rem ceiling for tighter editorial rhythm. */
      [class*="Hero_hero__"] h1,
      [class*="Hero_hero__"] h1 span,
      [class*="Hero_bottom__"] h1,
      [class*="Hero_bottom__"] h1 span {
        font-size: clamp(1.85rem, 3.4vw, 3rem) !important;
      }
      [class*="Hero_hero__"] h2,
      [class*="Hero_top__"] h2 {
        font-size: clamp(1.05rem, 1.6vw, 1.35rem) !important;
        line-height: 1.35 !important;
      }
      [class*="Hero_introText__"],
      [class*="Hero_introText__"] span {
        font-size: clamp(0.95rem, 1.2vw, 1.05rem) !important;
        line-height: 1.55 !important;
      }
    </style>
  </body>
</html>
