---
// Testimonials — clean two-column band per the redesign brief.
// Left: a single video testimonial (autoplay-muted YouTube embed).
// Right: a Swiper carousel of text reviews drawn from the real-client
// testimonials in src/data/testimonials.ts.
//
// Swiper init for this component uses the .c8-testi__carousel hook
// in src/scripts/site.ts (slidesPerView: 1, fade through with prev/
// next nav). The shared .swiper-panel-prev/-next pattern is already
// wired in the default init.

import { testimonials as allTestimonials } from '../data/testimonials';

// Hand-pick the 6 strongest real-client reviews for the homepage.
// Order biased toward the highest-impact named outcomes first.
const picks = [
  'cashaa-kumar',
  'fanadise-founder',
  'ubuntu-tribe-team',
  'cobox-adaa',
  'salamantex-rene',
  'metarix-founder',
];
const slides = picks
  .map((id) => allTestimonials.find((t) => t.id === id))
  .filter(Boolean) as typeof allTestimonials;

// Pair company id -> client logo path. Falls back gracefully if
// missing — the carousel still renders the quote + author block.
const companyLogo: Record<string, { src: string; invert?: boolean }> = {
  Cashaa:        { src: '/clients/cashaa.webp' },
  Fanadise:      { src: '/clients/fanadise.webp' },
  Salamantex:    { src: '/clients/salamantex.webp' },
};

const heroVideoId = 'wHMfo38ZbN8'; // existing client testimonial reel
---

<section class="c8-testi">
  <div class="c8-testi__inner">
    <header class="c8-testi__head" data-reveal-stagger="100">
      <p class="c8-testi__eyebrow" data-reveal="up">Client voices</p>
      <h2 class="c8-testi__heading" data-reveal="up">
        Real teams. <span class="c8-testi__heading-accent">Real outcomes.</span>
      </h2>
    </header>

    <div class="c8-testi__grid" data-reveal-stagger="160">
      <!-- LEFT — video testimonial (autoplay-muted) -->
      <div class="c8-testi__video" data-reveal="left">
        <div class="c8-testi__video-frame">
          <iframe
            src={`https://www.youtube.com/embed/${heroVideoId}?rel=0&autoplay=1&mute=1&loop=1&playlist=${heroVideoId}&modestbranding=1&controls=1`}
            title="Corum8 client testimonial"
            loading="lazy"
            allow="autoplay; encrypted-media; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>

      <!-- RIGHT — text testimonial carousel -->
      <div class="c8-testi__carousel-col" data-reveal="right">
        <div class="c8-testi__carousel swiper">
          <div class="swiper-wrapper">
            {slides.map((t) => {
              const logo = companyLogo[t.company];
              return (
                <article class="c8-testi__slide swiper-slide">
                  {logo ? (
                    <img
                      src={logo.src}
                      alt={t.company}
                      loading="lazy"
                      class={`c8-testi__logo${logo.invert ? ' c8-testi__logo--invert' : ''}`}
                    />
                  ) : (
                    <span class="c8-testi__logo c8-testi__logo--text">{t.company}</span>
                  )}

                  <div class="c8-testi__stars" aria-label={`${t.rating || 5} out of 5 stars`}>
                    {Array.from({ length: 5 }).map(() => (
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="#da9e49" stroke="none" aria-hidden="true">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                      </svg>
                    ))}
                  </div>

                  <blockquote class="c8-testi__quote">
                    <p>"{t.quote}"</p>
                  </blockquote>

                  <footer class="c8-testi__author">
                    <span class="c8-testi__author-name">{t.author}</span>
                    <span class="c8-testi__author-role">{t.role}, {t.company}{t.location ? ` · ${t.location}` : ''}</span>
                    {t.outcome && (
                      <span class="c8-testi__outcome">{t.outcome}</span>
                    )}
                  </footer>
                </article>
              );
            })}
          </div>
        </div>

        <div class="c8-testi__nav">
          <button type="button" class="c8-testi__navBtn swiper-panel-prev" aria-label="Previous testimonial">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button type="button" class="c8-testi__navBtn swiper-panel-next" aria-label="Next testimonial">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .c8-testi {
    background: var(--color-bg);
    color: #0a0a0a;
    padding-block: var(--c8-pad-section);
    padding-inline: var(--c8-section-pad);
  }
  .c8-testi__inner {
    max-width: var(--c8-section-max, 1320px);
    margin: 0 auto;
  }

  .c8-testi__head {
    max-width: 48rem;
    margin: 0 0 clamp(2.5rem, 5vh, 3.5rem);
  }
  .c8-testi__eyebrow {
    margin: 0 0 1rem;
    font-family: var(--montreal);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c8-gold-dark);
  }
  .c8-testi__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.2vw, 3.1rem);
    font-weight: 350;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .c8-testi__heading-accent {
    color: var(--c8-gold-dark);
    font-weight: 350;
  }

  /* ─── Two-column grid ─── */
  .c8-testi__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.75rem);
    align-items: stretch;
  }
  @media (max-width: 1023px) {
    .c8-testi__grid { grid-template-columns: 1fr; gap: 2rem; }
  }

  /* ─── LEFT — Video ─── */
  .c8-testi__video {
    display: flex;
    align-items: stretch;
    min-width: 0;
  }
  .c8-testi__video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 5 / 4;
    border-radius: 20px;
    overflow: hidden;
    background: #000;
    box-shadow:
      0 30px 60px -28px rgba(0, 0, 0, 0.32),
      0 0 0 1px rgba(0, 0, 0, 0.06);
    transition: box-shadow 0.45s ease, transform 0.45s ease;
  }
  .c8-testi__video-frame:hover {
    box-shadow:
      0 40px 80px -28px rgba(0, 0, 0, 0.4),
      0 0 60px -18px var(--c8-gold-soft),
      0 0 0 1px var(--c8-gold-glow);
    transform: translateY(-2px);
  }
  .c8-testi__video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* ─── RIGHT — Carousel column ─── */
  .c8-testi__carousel-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }
  .c8-testi__carousel {
    width: 100%;
    overflow: hidden;
    border-radius: 20px;
  }
  .c8-testi__slide {
    width: 100%;
    box-sizing: border-box;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 20px;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    box-shadow: 0 24px 48px -28px rgba(0, 0, 0, 0.18);
    height: auto;
    min-height: clamp(380px, 48vh, 480px);
  }

  .c8-testi__logo {
    height: 32px;
    width: auto;
    max-width: 160px;
    object-fit: contain;
    align-self: flex-start;
  }
  .c8-testi__logo--invert {
    filter: brightness(0);
    opacity: 0.78;
  }
  .c8-testi__logo--text {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 350;
    letter-spacing: -0.015em;
    color: #0a0a0a;
    line-height: 1.2;
  }

  .c8-testi__stars {
    display: inline-flex;
    gap: 2px;
    align-items: center;
  }

  .c8-testi__quote {
    margin: 0;
    flex: 1;
  }
  .c8-testi__quote p {
    margin: 0;
    font-family: var(--montreal);
    font-size: clamp(1.05rem, 1.3vw, 1.25rem);
    font-weight: 350;
    line-height: 1.55;
    color: #1a1a1a;
    letter-spacing: -0.005em;
  }

  .c8-testi__author {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    padding-top: 1rem;
    margin-top: auto;
  }
  .c8-testi__author-name {
    font-family: var(--montreal);
    font-size: 0.95rem;
    font-weight: 600;
    color: #0a0a0a;
    letter-spacing: -0.005em;
  }
  .c8-testi__author-role {
    font-family: var(--montreal);
    font-size: 0.85rem;
    color: #6b6b6b;
  }
  .c8-testi__outcome {
    display: inline-flex;
    align-self: flex-start;
    margin-top: 0.5rem;
    padding: 0.28rem 0.7rem;
    background: rgba(242, 191, 34, 0.12);
    border: 1px solid rgba(242, 191, 34, 0.4);
    border-radius: 999px;
    font-family: var(--montreal);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--c8-gold-dark);
  }

  /* ─── Nav ─── */
  .c8-testi__nav {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    align-self: flex-end;
    padding-right: 0.5rem;
  }
  .c8-testi__navBtn {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: transparent;
    border: 1.5px solid rgba(0, 0, 0, 0.18);
    color: #0a0a0a;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.25s ease, border-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
  }
  .c8-testi__navBtn:hover:not(.swiper-button-disabled) {
    background: var(--c8-gold);
    border-color: var(--c8-gold);
    color: #111;
    transform: translateY(-2px);
  }
  .c8-testi__navBtn.swiper-button-disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }
</style>
