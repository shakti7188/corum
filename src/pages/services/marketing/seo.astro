/* floating cards */
.s-fc{position:absolute;background:#fff;border:1px solid rgba(0,0,0,.08);border-radius:16px;box-shadow:0 16px 50px -12px rgba(0,0,0,.15);padding:1rem 1.2rem;z-index:10;}
.s-fc__label{font-size:.68rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:#bbb;margin-bottom:.6rem;}
