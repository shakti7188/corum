---
// Growth Partner manifesto. Dark section living between Ethos and Work.
// Visual-first: left side carries the message + 3 compact pillars. Right
// side carries a motion orbital with real client marks + a hero image
// collage to break up the text density.

const pillars = [
  { icon: 'M12 2l2.39 7.36H22l-6.3 4.57L18.09 22 12 17.43 5.91 22l2.39-8.07L2 9.36h7.61L12 2z',
    title: 'Skin in the game.',
    body: 'Your KPIs are our KPIs.' },
  { icon: 'M3 12h4l3-8 4 16 3-8h4',
    title: 'Specialists in-house.',
    body: 'No junior hand-offs.' },
  { icon: 'M20 6L9 17l-5-5',
    title: 'Proof over promises.',
    body: '1,100+ shipped. Receipts.' },
];

const stats = [
  { value: '1,100+',  label: 'Projects delivered' },
  { value: '$120M+',  label: 'Client revenue driven' },
  { value: '25,000+', label: 'Vetted creators' },
  { value: '10+',     label: 'Years in market' },
];

// Real client marks that float on the orbital — mapped to ring radius.
const orbitLogos = [
  { src: '/clients/binance.png',       alt: 'Binance',      ring: 1, angle:   0 },
  { src: '/clients/kucoin.png',        alt: 'KuCoin',       ring: 1, angle: 120 },
  { src: '/clients/okx.png',           alt: 'OKX',          ring: 1, angle: 240 },
  { src: '/clients/coinmarketcap.png', alt: 'CoinMarketCap',ring: 2, angle:  45 },
  { src: '/clients/tether.png',        alt: 'Tether',       ring: 2, angle: 135 },
  { src: '/clients/metamask.png',      alt: 'MetaMask',     ring: 2, angle: 225 },
  { src: '/clients/etoro.png',         alt: 'eToro',        ring: 2, angle: 315 },
];
---

<section class="c8-gp">
  <div class="c8-gp__bg" aria-hidden="true">
    <div class="c8-gp__glow c8-gp__glow--a"></div>
    <div class="c8-gp__glow c8-gp__glow--b"></div>
    <div class="c8-gp__grid"></div>
  </div>

  <div class="c8-gp__inner container">

    <div class="c8-gp__top">

      <div class="c8-gp__left">
        <p class="c8-gp__eyebrow"><span class="c8-gp__eyebrow-dot"></span>Why Corum8</p>
        <h2 class="c8-gp__headline">
          <span class="c8-gp__line c8-gp__line--muted">Not another agency.</span>
          <span class="c8-gp__line c8-gp__line--bold">Your growth <em>partner.</em></span>
        </h2>
        <p class="c8-gp__sub">
          Most agencies sell activity. We sell outcomes.
        </p>
        <a href="/book-a-strategy-call" class="c8-gp__cta">
          Book a strategy call
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 17.1 15.17" aria-hidden="true">
            <path d="m17.1,7.58s-.01-.04-.01-.06c.01-.22-.06-.45-.24-.61L9.23.19c-.31-.27-.78-.24-1.06.07-.27.31-.24.78.07,1.06l6.26,5.52H.75c-.41,0-.75.34-.75.75s.34.75.75.75h13.74l-6.26,5.52c-.31.27-.34.75-.07,1.06.15.17.35.25.56.25.18,0,.35-.06.5-.19l7.62-6.72c.18-.16.25-.39.24-.61,0-.02.01-.04.01-.06Z" fill="currentColor"/>
          </svg>
        </a>

        <!-- Compact pillar row anchored under the CTA -->
        <ul class="c8-gp__pillars">
          {pillars.map((p) => (
            <li class="c8-gp__pillar">
              <span class="c8-gp__pillar-icon">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={p.icon} />
                </svg>
              </span>
              <span class="c8-gp__pillar-text">
                <strong>{p.title}</strong>
                <em>{p.body}</em>
              </span>
            </li>
          ))}
        </ul>
      </div>

      <!-- RIGHT: animated orbital visual with real client marks + image spark -->
      <div class="c8-gp__right" aria-hidden="true">
        <div class="c8-gp__orbit">
          <div class="c8-gp__ring c8-gp__ring--3"></div>
          <div class="c8-gp__ring c8-gp__ring--2"></div>
          <div class="c8-gp__ring c8-gp__ring--1"></div>

          <!-- Centre core: brand mark pulse -->
          <div class="c8-gp__core">
            <span class="c8-gp__core-pulse"></span>
            <span class="c8-gp__core-pulse c8-gp__core-pulse--delay"></span>
            <span class="c8-gp__core-mark">C8</span>
          </div>

          <!-- Logo satellites on two rings -->
          {orbitLogos.map((l) => (
            <span class={`c8-gp__sat c8-gp__sat--r${l.ring}`} style={`--a:${l.angle}deg;`}>
              <span class="c8-gp__sat-inner">
                <img src={l.src} alt={l.alt} loading="lazy" />
              </span>
            </span>
          ))}

          <!-- Photo spark: small image tile to break text density -->
          <div class="c8-gp__photo c8-gp__photo--a">
            <img src="/images/culture-row-1.jpg" alt="" loading="lazy"/>
          </div>
          <div class="c8-gp__photo c8-gp__photo--b">
            <img src="/images/culture-row-2.jpg" alt="" loading="lazy"/>
          </div>
        </div>
      </div>
    </div>

    <div class="c8-gp__proof">
      {stats.map((s) => (
        <div class="c8-gp__stat">
          <span class="c8-gp__stat-value">{s.value}</span>
          <span class="c8-gp__stat-label">{s.label}</span>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .c8-gp {
    position: relative;
    background: #0b0b0b;
    padding-block: clamp(5rem, 10vh, 8rem);
    overflow: hidden;
    color: #fff;
  }

  .c8-gp__bg { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
  .c8-gp__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
  }
  .c8-gp__glow--a {
    top: -10%; left: -8%;
    width: 40vw; aspect-ratio: 1;
    background: radial-gradient(circle, rgba(245, 166, 35, 0.22) 0%, transparent 70%);
    animation: c8-gp-pulse 7s ease-in-out infinite alternate;
  }
  .c8-gp__glow--b {
    bottom: -10%; right: -8%;
    width: 35vw; aspect-ratio: 1;
    background: radial-gradient(circle, rgba(245, 166, 35, 0.14) 0%, transparent 70%);
    animation: c8-gp-pulse 9s ease-in-out infinite alternate 1s;
  }
  @keyframes c8-gp-pulse {
    0%   { transform: scale(0.92); opacity: 0.7; }
    100% { transform: scale(1.08); opacity: 1; }
  }
  .c8-gp__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
  }

  .c8-gp__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 6vh, 4.5rem);
  }

  /* ── Top row ── */
  .c8-gp__top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }

  .c8-gp__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c8-gold, #f5a623);
    margin: 0 0 1.5rem;
  }
  .c8-gp__eyebrow-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--c8-gold, #f5a623);
    box-shadow: 0 0 10px var(--c8-gold, #f5a623);
    animation: c8-gp-dot 2s ease-in-out infinite;
  }
  @keyframes c8-gp-dot {
    0%, 100% { transform: scale(1); opacity: 1; }
    50%      { transform: scale(1.4); opacity: 0.6; }
  }

  .c8-gp__headline { margin: 0 0 1.25rem; display: flex; flex-direction: column; gap: 0.1em; }
  .c8-gp__line {
    display: block;
    font-size: clamp(2.1rem, 3.8vw, 3.3rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .c8-gp__line--muted { color: rgba(255, 255, 255, 0.42); }
  .c8-gp__line--bold  { color: #fff; }
  .c8-gp__line em {
    font-style: italic;
    background: linear-gradient(135deg, var(--c8-gold, #f5a623) 0%, #f7c068 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  .c8-gp__sub {
    font-size: clamp(0.95rem, 1.1vw, 1.05rem);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.55);
    margin: 0 0 1.5rem;
    max-width: 32ch;
  }

  .c8-gp__cta {
    display: inline-flex; align-items: center; gap: 0.6rem;
    padding: 0.8rem 1.5rem;
    background: var(--c8-gold, #f5a623);
    color: #111;
    font-size: 0.9rem; font-weight: 600;
    border-radius: 999px; text-decoration: none;
    transition: background 0.25s, transform 0.25s, box-shadow 0.25s;
  }
  .c8-gp__cta svg { width: 13px; height: 13px; transition: transform 0.25s; }
  .c8-gp__cta:hover {
    background: #fff;
    transform: translateY(-2px);
    box-shadow: 0 10px 32px -8px rgba(245, 166, 35, 0.5);
  }
  .c8-gp__cta:hover svg { transform: translateX(3px); }

  /* Pillars row — compact, under CTA */
  .c8-gp__pillars {
    list-style: none;
    margin: 2.25rem 0 0; padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .c8-gp__pillar {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .c8-gp__pillar-icon {
    width: 28px; height: 28px;
    border-radius: 8px;
    background: rgba(245, 166, 35, 0.14);
    color: var(--c8-gold, #f5a623);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .c8-gp__pillar-text { display: flex; flex-direction: column; line-height: 1.2; }
  .c8-gp__pillar-text strong {
    font-size: 0.85rem; font-weight: 600; color: #fff; letter-spacing: -0.01em;
  }
  .c8-gp__pillar-text em {
    font-style: normal;
    font-size: 0.72rem;
    color: rgba(255,255,255,0.45);
  }

  /* ── RIGHT: orbital visual ── */
  .c8-gp__right {
    position: relative;
    min-height: clamp(360px, 46vw, 520px);
    display: flex; align-items: center; justify-content: center;
  }
  .c8-gp__orbit {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 520px;
  }
  .c8-gp__ring {
    position: absolute;
    inset: 0;
    margin: auto;
    border-radius: 50%;
    border: 1px dashed rgba(245, 166, 35, 0.22);
    animation: c8-gp-spin 40s linear infinite;
  }
  .c8-gp__ring--1 { width: 45%; height: 45%; inset: 0; border-color: rgba(245,166,35,0.32); animation-duration: 26s; animation-direction: reverse; }
  .c8-gp__ring--2 { width: 72%; height: 72%; inset: 0; border-color: rgba(245,166,35,0.2); animation-duration: 48s; }
  .c8-gp__ring--3 { width: 100%; height: 100%; inset: 0; border-color: rgba(255,255,255,0.06); border-style: solid; animation: none; }
  @keyframes c8-gp-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  /* Centre core */
  .c8-gp__core {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 22%; aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, #2a1a04 0%, #0b0b0b 70%);
    border: 1px solid rgba(245, 166, 35, 0.4);
    box-shadow: 0 0 48px -6px rgba(245, 166, 35, 0.5);
    display: flex; align-items: center; justify-content: center;
    z-index: 3;
  }
  .c8-gp__core-pulse {
    position: absolute; inset: 0;
    border-radius: 50%;
    border: 1px solid rgba(245, 166, 35, 0.5);
    animation: c8-gp-pulse-ring 2.8s ease-out infinite;
  }
  .c8-gp__core-pulse--delay { animation-delay: 1.4s; }
  @keyframes c8-gp-pulse-ring {
    0%   { transform: scale(1);   opacity: 0.7; }
    100% { transform: scale(1.9); opacity: 0; }
  }
  .c8-gp__core-mark {
    font-family: var(--syne, serif);
    font-weight: 600;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, var(--c8-gold, #f5a623), #f7c068);
    -webkit-background-clip: text; background-clip: text;
    color: transparent; -webkit-text-fill-color: transparent;
    position: relative; z-index: 1;
    text-shadow: 0 0 18px rgba(245,166,35,0.4);
  }

  /* Logo satellites on rings 1 & 2 */
  .c8-gp__sat {
    position: absolute;
    top: 50%; left: 50%;
    width: 0; height: 0;
    transform: translate(-50%, -50%) rotate(var(--a, 0deg));
    z-index: 2;
    animation: c8-gp-orbit-keep var(--dur, 26s) linear infinite;
  }
  .c8-gp__sat--r1 { --r: 22.5%; --dur: 26s; }
  .c8-gp__sat--r2 { --r: 36%;   --dur: 48s; animation-direction: reverse; }
  @keyframes c8-gp-orbit-keep {
    from { transform: translate(-50%, -50%) rotate(var(--a)); }
    to   { transform: translate(-50%, -50%) rotate(calc(var(--a) + 360deg)); }
  }
  .c8-gp__sat-inner {
    position: absolute;
    top: 0; left: 0;
    transform: translate(var(--r, 22.5%), -50%) rotate(calc(-1 * var(--a, 0deg)));
    width: 46px; height: 46px;
    border-radius: 50%;
    background: #111;
    border: 1px solid rgba(245, 166, 35, 0.35);
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 6px 20px -6px rgba(0,0,0,0.6), 0 0 18px -6px rgba(245,166,35,0.4);
    overflow: hidden;
  }
  .c8-gp__sat-inner img {
    width: 62%; height: auto; object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.85;
  }
  /* Counter-rotate so logos stay upright despite orbital spin */
  .c8-gp__sat {
    animation: c8-gp-sat-spin var(--dur, 26s) linear infinite;
  }
  .c8-gp__sat--r2 { animation-direction: reverse; }
  @keyframes c8-gp-sat-spin {
    from { transform: translate(-50%, -50%) rotate(var(--a, 0deg)); }
    to   { transform: translate(-50%, -50%) rotate(calc(var(--a, 0deg) + 360deg)); }
  }

  /* Photo sparks — floating image tiles to break text density */
  .c8-gp__photo {
    position: absolute;
    width: clamp(88px, 13vw, 130px);
    aspect-ratio: 4 / 5;
    border-radius: 0.85rem;
    overflow: hidden;
    border: 1px solid rgba(245, 166, 35, 0.25);
    box-shadow: 0 20px 44px -18px rgba(0,0,0,0.75), 0 0 28px -10px rgba(245,166,35,0.35);
    z-index: 4;
    animation: c8-gp-float 6s ease-in-out infinite alternate;
  }
  .c8-gp__photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .c8-gp__photo--a { top: -4%; left: -4%; animation-delay: 0s; }
  .c8-gp__photo--b { bottom: -4%; right: -4%; animation-delay: 1.5s; animation-duration: 7s; }
  @keyframes c8-gp-float {
    0%   { transform: translateY(0)    rotate(-2deg); }
    100% { transform: translateY(-10px) rotate( 2deg); }
  }

  /* ── Proof strip ── */
  .c8-gp__proof {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    padding: clamp(1.5rem, 3vh, 2.25rem) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .c8-gp__stat {
    display: flex; flex-direction: column; align-items: center; gap: 0.3rem;
    padding: 0.5rem 1rem;
    border-right: 1px solid rgba(255, 255, 255, 0.06);
    text-align: center;
  }
  .c8-gp__stat:last-child { border-right: none; }
  .c8-gp__stat-value {
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
    background: linear-gradient(135deg, #fff 0%, rgba(255,255,255,0.65) 100%);
    -webkit-background-clip: text; background-clip: text;
    color: transparent; -webkit-text-fill-color: transparent;
  }
  .c8-gp__stat-label {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }

  @media (max-width: 860px) {
    .c8-gp__top { grid-template-columns: 1fr; gap: 2.5rem; }
    .c8-gp__sub { max-width: none; }
    .c8-gp__line { font-size: clamp(1.9rem, 7vw, 2.8rem); }
    .c8-gp__right { min-height: 320px; }
    .c8-gp__orbit { max-width: 320px; }
    .c8-gp__photo { width: 70px; }
    .c8-gp__proof { grid-template-columns: repeat(2, 1fr); }
    .c8-gp__stat:nth-child(2) { border-right: none; }
    .c8-gp__stat:nth-child(1), .c8-gp__stat:nth-child(2) {
      padding-bottom: 1.25rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    .c8-gp__stat:nth-child(3), .c8-gp__stat:nth-child(4) { padding-top: 1.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .c8-gp__ring, .c8-gp__sat, .c8-gp__photo, .c8-gp__core-pulse,
    .c8-gp__eyebrow-dot, .c8-gp__glow--a, .c8-gp__glow--b {
      animation: none !important;
    }
  }
</style>
