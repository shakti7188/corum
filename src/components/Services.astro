<style>
  /* ════════════════════════════════════════════════════════════════════
     Services: living collages — real faces (pravatar), real press logos,
     phone mockups. Each card feels like a short reel rather than a chart.
     ════════════════════════════════════════════════════════════════════ */

  .ServiceMedia_mediaContainer__WGgZa {
    background: #ece4d2;
  }
  .ServiceMedia_mediaContainer__WGgZa > div[aria-hidden] {
    position: absolute; inset: 0; overflow: hidden;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", Inter, system-ui, sans-serif;
    color: #2b2721;
  }

  /* Slow camera drift — every collage wrapper parallaxes so the card
     reads as a moving frame rather than a static layout. */
  @keyframes c8-pan-x {
    0%,100% { transform: translateX(-1.2%) scale(1.015); }
    50%     { transform: translateX(1.2%) scale(1.015); }
  }
  @keyframes c8-pan-xy {
    0%,100% { transform: translate(-0.8%, -0.6%) scale(1.03); }
    50%     { transform: translate( 0.8%,  0.6%) scale(1.03); }
  }
  @keyframes c8-ken-burns {
    0%   { transform: scale(1.04) translate(-0.6%, -0.4%); }
    100% { transform: scale(1.08) translate( 0.6%,  0.4%); }
  }

  /* Shared floating pill — warm cream paper style */
  .c8-pill {
    position: absolute;
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 10px;
    background: rgba(247,241,228,0.88);
    color: #2b2721;
    border: 1px solid rgba(0,0,0,0.06);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: 999px;
    font-size: clamp(8px, 0.72vw, 11px);
    font-weight: 500;
    letter-spacing: 0.01em;
    z-index: 8;
  }
  .c8-pill b { font-weight: 700; }
  .c8-pill__dot { width: 6px; height: 6px; border-radius: 50%; background: #8a9e7c; box-shadow: 0 0 6px currentColor; color: #8a9e7c; }
  .c8-pill__dot--red { background: #c97767; color: #c97767; }
  .c8-pill__dot--green { background: #8a9e7c; color: #8a9e7c; }
  .c8-pill__dot, .c8-live-dot { animation: c8-pulse-dot 1.6s ease-in-out infinite; }
  @keyframes c8-pulse-dot { 0%,100%{opacity:.55; transform:scale(.85)} 50%{opacity:1; transform:scale(1.15)} }

  /* ── Card 1 · Living social feed (warm cream base) ─────────────── */
  .c8-feed {}
  .c8-feed__bg {
    position: absolute; inset: -3%;
    background:
      radial-gradient(55% 55% at 80% 20%, rgba(200,164,124,0.45), transparent 65%),
      radial-gradient(55% 55% at 10% 90%, rgba(184,149,164,0.35), transparent 65%),
      #e9e0ce;
    animation: c8-ken-burns 18s ease-in-out infinite alternate;
  }
  .c8-feed__grid {
    position: absolute; inset: 4% 4% 28% 4%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 4px;
    transform-origin: center;
    animation: c8-pan-xy 16s ease-in-out infinite;
  }
  .c8-feed__grid > * { transform: rotate(-3deg); }
  .c8-tile {
    position: relative; border-radius: 10px; overflow: hidden;
    background: var(--bg);
    box-shadow: 0 4px 14px rgba(45,37,25,0.18);
    animation: c8-tile-in 0.7s ease-out both;
    animation-delay: calc(var(--i, 0) * 0.12s);
  }
  .c8-tile--1 { --i: 0; }
  .c8-tile--2 { --i: 1; }
  .c8-tile--3 { --i: 2; }
  .c8-tile--4 { --i: 3; }
  .c8-tile--5 { --i: 4; }
  .c8-tile--6 { --i: 5; }
  @keyframes c8-tile-in {
    from { opacity: 0; transform: scale(0.92); }
    to   { opacity: 1; transform: scale(1); }
  }
  .c8-tile::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(40,32,22,0.35), transparent 45%);
