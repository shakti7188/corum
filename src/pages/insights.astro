---
import Layout from "../layouts/Layout.astro";
import KotaverseCta from "../components/KotaverseCta.astro";

const arrowGrad = {
  id: 'ins',
  stops: [
    { offset: '0', color: '#7c41f3' },
    { offset: '1', color: '#ff6eff' },
  ],
};

const projects = [
  {
    href: '#',
    name: 'State of Web3 launches, 2026',
    year: 'Apr 2026 · 42 pages',
    heading: 'Quarterly analysis of 200+ tracked launches — raise sizes, channel mix, community retention, and what separates the ones that still exist at 12 months from the ones that don\'t.',
    tags: ['Web3', 'Launches', 'Quarterly'],
    poster: '/images/bento1-1.jpg',
  },
  {
    href: '#',
    name: 'RWA tokenization operator map',
    year: 'Mar 2026 · 38 pages',
    heading: 'Which chains, which issuance standards, which secondary-market venues institutional operators actually use in 2026. With usage data, not marketing claims.',
    tags: ['RWA', 'Infrastructure', 'Data'],
    poster: '/images/bento3-1.jpg',
  },
  {
    href: '#',
    name: 'AI go-to-market, post-GPT-5',
    year: 'Mar 2026 · 54 pages',
    heading: 'What changed when LLM capability plateaued and differentiation became the only moat. Case studies across 15 AI product launches between 2024 and 2026.',
    tags: ['AI', 'GTM', 'Research'],
    poster: '/images/bento4-1.jpg',
  },
  {
    href: '#',
    name: 'Crypto PR in a fragmented media landscape',
    year: 'Feb 2026 · 29 pages',
    heading: 'The Block, CoinDesk, Decrypt, Blockworks, The Defiant — who reaches which audiences, what gets a reply, and what doesn\'t. Media contact density by region.',
    tags: ['PR', 'Media', 'Crypto'],
    poster: '/images/bento2-1.jpg',
  },
];
---
<Layout title="Insights | Corum8">
<div data-theme="light">
<section class="Hero_hero__Oyf4n"><div class="container"><div class="Hero_top__RRkYH"><h2><span class="LineByLine_headingOuter__JmusT"><span>Long-form research. Written by the people who shipped the product.</span></span></h2><figure class="crosshair" aria-hidden="true"><span class="FadeInRotate_container__QE9u9" data-fill="true" data-direction="clockwise"><span class="inner"></span></span></figure><div class="Hero_video__rzcbe"><span class="ScaleFadeIn_container__cK78G" data-fill="true"><span class="ScaleFadeIn_inner__y4reT" data-fill="true"><video src="/media/bg2.mp4" class="Hero_video__rzcbe" autoplay muted loop playsinline></video></span></span></div></div><div class="Hero_bottom__ktiOH"><h1><span class="MaskInUp_container__0AW5i" data-fill="false"><div><span><i></i>Insights</span></div></span></h1><h3 class="Hero_introText__oP34v"><span class="FadeIn_container__bjQVL" data-fill="false"><span>Quarterly long-form research on Web3, AI and fintech — written by the people running the programmes, not the marketing team summarising them.</span></span></h3><div class="Hero_arrow__lxSeM"><span class="FadeInRotate_container__QE9u9" data-fill="false" data-direction="counterclockwise"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 75.91 75.65"><path d="m13.65 67.65 61.93-62L69.92 0 8 61.99V.25H0v75.4h75.91v-8H13.65z"></path></svg></span></div></div></div></section>

<div class="Work_work__rSI8c">
  <div class="DarkThemeSwitch_cover__hn_xc"></div>
  <div class="Work_projects__A5q77">
    <div class="AnimatedGrid_grid__otAMD">
      <div class="container">
        {projects.map((p) => (
          <a class="ProjectCard_project__d1wbY ProjectCard_small__xsL92" data-animation="grid-item" href={p.href}>
            <div class="ProjectCard_projectText__o770X">
              <h3>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14.78 14.78">
                  <defs>
                    <linearGradient id={arrowGrad.id} x1="3.54" x2="13.98" y1="3.54" y2="13.99" gradientUnits="userSpaceOnUse">
                      {arrowGrad.stops.map((s) => <stop offset={s.offset} stop-color={s.color}></stop>)}
                    </linearGradient>
                  </defs>
                  <path fill={`url(#${arrowGrad.id})`} stroke-width="0" d="M13.25 12.18L13.25 0.23 14.78 0.23 14.78 14.76 14.74 14.76 14.74 14.78 0.21 14.78 0.21 13.25 12.18 13.25 0 1.08 1.08 0 13.25 12.18z"></path>
                </svg>{p.name}
              </h3>
              <p>{p.year}</p>
            </div>
            <div class="ProjectCard_projectImage__Nfx9I">
              <div class="ProjectCard_imageOverlay__OCawr">
                <p class="ProjectCard_heading__1csIW">{p.heading}</p>
                <ul class="ProjectCard_tags__XdVcf">
                  {p.tags.map((t) => <li>{t}</li>)}
                </ul>
              </div>
              <span class="Image_image__RAAdZ Image_fill__EiIzS"><img src={p.poster} alt="" fetchpriority="low" loading="lazy" /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</div>

<KotaverseCta
  light="Need a bespoke"
  bold="research piece?"
  subtitle="We build custom reports for teams that need data, not marketing summaries."
/>
</div>
</Layout>
