---
// Corum8 Premium Bespoke FAQ Redesign

export interface Props {
  titleLight?: string;
  titleBold?: string;
  subtitle?: string;
  faqs?: { question: string; answer: string }[];
}

const defaultFaqs = [
  {
    question: "What types of projects does Corum8 work with?",
    answer: "Crypto projects, centralized and decentralized exchanges, AI and SaaS companies, fintech brands, gaming studios, enterprises and ambitious founders across 30+ regions. If you're building in Web3, AI or emerging tech, we're built to serve you."
  },
  {
    question: "How is Corum8 different from other Web3 agencies?",
    answer: "Full-stack development and marketing under one roof — strategy, design, build, PR, community and growth coordinated by a single team. 1,100+ projects, 50+ awards and 10+ years in Web3 mean our frameworks are battle-tested at scale."
  },
  {
    question: "Can you handle both development and marketing for our project?",
    answer: "Yes — that's our core strength. Most projects fail because dev and marketing operate in silos. We align the tech roadmap with the GTM plan from day one, so launches are coordinated and the message is consistent across every touchpoint."
  },
  {
    question: "What is the typical engagement timeline?",
    answer: "A focused PR or influencer campaign can launch in 1–2 weeks. A full development project typically runs 8–16 weeks. Strategic retainers are month-to-month with flexible scaling. We start with a strategy session to define the right timeline for your goals."
  },
  {
    question: "Where is Corum8 headquartered?",
    answer: "HQ is in Dubai, UAE, with operational offices in the United States and India. Our 95+ specialists work across time zones to provide global coverage with local market understanding."
  },
  {
    question: "Do you offer white-label services for other agencies?",
    answer: "Yes. White-label development and marketing for agencies, consultancies and resellers worldwide. Your clients get our execution quality under your brand, with dedicated account management and confidential workflows."
  }
];

const {
  titleLight = "Your",
  titleBold = "Questions.",
  subtitle = "Straight answers on how we plan, build and scale Web3 brands.",
  faqs = defaultFaqs
} = Astro.props;
---

<section class="FAQCustom_wrapper" id="faq">
  <div class="FAQCustom_glow"></div>
  <div class="FAQCustom_container">
    
    <div class="FAQCustom_left">
      <div class="FAQCustom_header">
        <h2 class="FAQCustom_title">
          <span class="FAQCustom_titleLight">{titleLight}</span><br/>
          <span class="FAQCustom_titleBold">{titleBold}</span>
        </h2>
        <p class="FAQCustom_subtitle">{subtitle}</p>
      </div>
    </div>

    <div class="FAQCustom_right">
      <div class="FAQCustom_grid">
        {faqs.map((faq) => (
          <div class="FAQCustom_card">
            <button class="FAQCustom_question">
              <span class="FAQCustom_qText">{faq.question}</span>
              <div class="FAQCustom_iconWrap"><span class="FAQCustom_icon"></span></div>
            </button>
            <div class="FAQCustom_answerWrapper">
              <div class="FAQCustom_answerInner">
                <p class="FAQCustom_answer">{faq.answer}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  /* 
    CORUM8 BESPOKE FAQ DESIGN
    Features a modern sticky-sidebar split layout, evading all KOTA global generic containers.
  */
  
  .FAQCustom_wrapper {
    position: relative;
    background-color: var(--color-bg-dark);
    color: var(--color-ink-on-dark);
    padding: 8rem 0;
    overflow: hidden;
  }

  /* Ambient gold glow — pushes the dark panel toward the reference design's
     aesthetic instead of KOTA's original purple ambient. */
  .FAQCustom_glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 60vw;
    height: 60vh;
    background: radial-gradient(circle, var(--c8-gold-soft) 0%, rgba(0, 0, 0, 0) 70%);
    transform: translate(-50%, -50%);
    filter: blur(80px);
    z-index: 0;
    pointer-events: none;
  }

  /* Completely custom container isolating the scope from KOTA's grid system */
  .FAQCustom_container {
    position: relative;
    z-index: 10;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 4vw;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  @media (min-width: 768px) {
    .FAQCustom_container {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
    
    .FAQCustom_left {
      flex: 0 0 35%;
      position: sticky;
      top: 25vh; /* Premium sticky scrolling block */
      align-self: flex-start;
    }

    .FAQCustom_right {
      flex: 0 0 55%;
    }
  }

  .FAQCustom_header {
    margin-bottom: 2rem;
  }

  .FAQCustom_title {
    font-size: clamp(2.5rem, 7.1vw, 7.5rem);
    line-height: 1;
    margin: 0 0 1rem 0;
    letter-spacing: -0.02em;
    font-weight: 400;
    color: #fff;
  }

  .FAQCustom_titleLight,
  .FAQCustom_titleBold {
    font-weight: 400;
    color: #fff;
  }

  .FAQCustom_subtitle {
    font-size: 1.1rem;
    color: #999;
    letter-spacing: 0.1em;
    line-height: 1.6;
    text-transform: uppercase;
    max-width: 80%;
    margin-top: 2rem;
  }

  .FAQCustom_grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  /* Glassmorphic cards */
  .FAQCustom_card {
    background: rgba(25, 25, 25, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 1.5rem;
    backdrop-filter: blur(10px);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    width: 100%;
  }

  .FAQCustom_card:hover {
    background: rgba(40, 40, 40, 0.6);
    border-color: rgba(255, 255, 255, 0.15);
    transform: translateX(4px);
  }

  .FAQCustom_card.is-open {
    background: rgba(255, 255, 255, 0.03);
    border-color: var(--c8-gold-glow, rgba(245, 166, 35, 0.35));
    box-shadow: 0 0 40px -10px var(--c8-gold-soft);
  }

  .FAQCustom_question {
    display: flex;
    width: 100%;
    background: none;
    border: none;
    color: #fff;
    font-family: inherit;
    text-align: left;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 2rem;
    cursor: pointer;
    font-size: clamp(1.2rem, 1.8vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.5px;
    line-height: 1.4;
  }

  .FAQCustom_qText {
    padding-right: 2rem;
  }

  /* Custom animated Icon Logic - BIGGER */
  .FAQCustom_iconWrap {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    position: relative;
    transition: all 0.3s ease;
  }

  .FAQCustom_card:hover .FAQCustom_iconWrap {
    border-color: rgba(255,255,255,0.6);
  }

  .FAQCustom_icon, .FAQCustom_icon::before {
    content: '';
    position: absolute;
    background: #fff;
    width: 20px;
    height: 2.5px;
    border-radius: 2px;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s ease;
  }

  .FAQCustom_icon::before {
    transform: rotate(90deg);
  }

  /* Minus creation when open */
  .FAQCustom_card.is-open .FAQCustom_icon::before {
    transform: rotate(0deg);
  }
  
  .FAQCustom_card.is-open .FAQCustom_iconWrap {
    background: #fff;
    border-color: #fff;
  }
  
  .FAQCustom_card.is-open .FAQCustom_icon,
  .FAQCustom_card.is-open .FAQCustom_icon::before {
    background: #000;
  }

  /* Smooth Grid Accordion — only works if the inner row can actually shrink */
  .FAQCustom_answerWrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .FAQCustom_card.is-open .FAQCustom_answerWrapper {
    grid-template-rows: 1fr;
  }

  .FAQCustom_answerInner {
    min-height: 0;
    overflow: hidden;
  }

  .FAQCustom_answer {
    color: #a1a1aa;
    font-size: 1.15rem;
    line-height: 1.6;
    margin: 0;
    font-weight: 300;
    padding: 0 4rem 2.5rem 2rem;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  
  .FAQCustom_card.is-open .FAQCustom_answer {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.1s;
  }
</style>

<script>
  // Simple Vanilla JS to handle exclusive smooth accordion toggles
  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('.FAQCustom_card');
    
    cards.forEach(card => {
      const button = card.querySelector('.FAQCustom_question');
      if (!button) return;
      
      button.addEventListener('click', () => {
        const isOpen = card.classList.contains('is-open');
        
        // Close all other cards identically to a true accordion
        cards.forEach(c => c.classList.remove('is-open'));
        
        // Open this one if it was closed
        if (!isOpen) {
          card.classList.add('is-open');
        }
      });
    });
  });
</script>
