---
// Awards.astro
// Ported from the localhost:8001 awards-showcase block, retuned for our
// light KOTA-themed homepage. Placed above <Ethos /> so the page reads:
// Showcase (dark video) → InfluencerReach (light) → Awards (light) →
// Ethos (light) → Work → …
// Per user instruction: NO "Our Awards" label on top — the headline
// carries the section on its own.

type Award = {
  title: string;
  issuer: string;
  year: string;
  logo: string;
  alt: string;
};

// Six awards mirroring the source block. Logos already live at
// /public/awards/*.png, so no new assets needed.
const awards: Award[] = [
  { title: 'Best Marketing Agency',    issuer: 'Blockchain Life', year: '2025', logo: '/awards/blockchain-life.png', alt: 'Blockchain Life' },
  { title: 'Best Development Agency',  issuer: 'Finext',          year: '2024', logo: '/awards/finext.png',          alt: 'Finext' },
  { title: 'Best Leadership Award',    issuer: 'Finext',          year: '2025', logo: '/awards/finext.png',          alt: 'Finext' },
  { title: 'Entrepreneur Award',       issuer: 'Emmi Empire',     year: '2024', logo: '/awards/emmi-empire.png',     alt: 'Emmi Empire' },
  { title: 'Industry Recognition',     issuer: 'IISA',            year: '2023', logo: '/awards/iisa.png',            alt: 'IISA' },
  { title: 'Dubai Expo 2020',          issuer: 'Dubai Expo',      year: '2020', logo: '/awards/dubai-expo.png',      alt: 'Dubai Expo' },
];
---

<section class="c8-awards">
  <!-- Layer 1: video bg + readability veil (same pattern as Hero) -->
  <div class="c8-awards__bg" aria-hidden="true">
    <video
      class="c8-awards__video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/images/hero.webp">
      <source src="/media/bg2.mp4" type="video/mp4" />
    </video>
    <div class="c8-awards__veil"></div>
  </div>

  <div class="c8-awards__wash" aria-hidden="true"></div>
  <div class="c8-awards__inner">
    <header class="c8-awards__head" data-reveal-stagger="100">
      <h2 class="c8-awards__heading" data-reveal="up">
        Recognized across<br/><span class="c8-awards__heading-accent">the industry.</span>
      </h2>
      <p class="c8-awards__sub" data-reveal="up">
        50+ industry awards for excellence in development, marketing and creative execution — earned on results, not pitches.
      </p>
    </header>

    <div class="c8-awards__grid" data-reveal-stagger="90">
      {awards.map((a) => (
        <article class="c8-awards__card" data-reveal="scale">
          <div class="c8-awards__logo">
            <img src={a.logo} alt={a.alt} loading="lazy" />
          </div>
          <h3 class="c8-awards__title">{a.title}</h3>
          <p class="c8-awards__issuer">{a.issuer}</p>
          <span class="c8-awards__year">{a.year}</span>
        </article>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .c8-awards {
    position: relative;
    padding: clamp(5rem, 10vw, 9rem) clamp(1.5rem, 5vw, 5rem);
    background: #0a0a0a;
    color: #fff;
    overflow: hidden;
    isolation: isolate;
  }

  /* ── Video bg + veil — mirrors the Hero treatment ── */
  .c8-awards__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }
  .c8-awards__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    background: #0a0a0a;
  }
  .c8-awards__veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(420px circle at 20% 10%,
        rgba(242, 191, 34, 0.18) 0%,
        rgba(242, 191, 34, 0.06) 38%,
        transparent 65%),
      linear-gradient(180deg,
        rgba(10, 10, 10, 0.75) 0%,
        rgba(10, 10, 10, 0.55) 45%,
        rgba(10, 10, 10, 0.78) 100%);
  }

  /* Soft gold vignette layered on top of the veil — warms the dark bg. */
  .c8-awards__wash {
    position: absolute;
    inset: -10%;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 45% at 50% 35%, rgba(242, 191, 34, 0.10) 0%, transparent 70%),
      radial-gradient(ellipse 40% 30% at 20% 80%, rgba(242, 191, 34, 0.06) 0%, transparent 70%),
      radial-gradient(ellipse 35% 30% at 85% 75%, rgba(242, 191, 34, 0.07) 0%, transparent 70%);
    filter: blur(8px);
  }

  .c8-awards__inner {
    position: relative;
    z-index: 2;
    max-width: var(--c8-section-max, 1320px);
    margin: 0 auto;
  }

  .c8-awards__head {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto clamp(2.5rem, 5vh, 4rem);
  }
  .c8-awards__heading {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.2vw, 3.1rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin: 0 0 1rem;
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.45);
  }
  .c8-awards__heading-accent {
    font-style: normal;
    font-weight: 400;
    color: var(--c8-gold-dark);
  }
  .c8-awards__sub {
    font-family: var(--montreal, system-ui, sans-serif);
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.78);
    margin: 0;
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.35);
  }

  /* 6 cards across on wide screens, scaling down like the reference. */
  .c8-awards__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: clamp(0.75rem, 1.2vw, 1.25rem);
  }

  /* Cards sit on a very soft cream surface; border + shadow nudge up on
     hover, logo unmasks from grayscale. Same "premium quiet" treatment
     as the Services panels so the visual rhythm carries over. */
  .c8-awards__card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    padding: clamp(1.1rem, 1.8vw, 1.6rem) clamp(0.75rem, 1.2vw, 1.15rem);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    text-align: center;
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    box-shadow:
      0 18px 38px -20px rgba(0, 0, 0, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    transition:
      transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 0.4s ease,
      background 0.4s ease,
      box-shadow 0.4s ease;
  }
  .c8-awards__card:hover {
    transform: translateY(-4px);
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--c8-gold-glow, rgba(242, 191, 34, 0.45));
    box-shadow:
      0 26px 52px -20px rgba(0, 0, 0, 0.7),
      0 0 50px -10px var(--c8-gold-glow, rgba(242, 191, 34, 0.35)),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  .c8-awards__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 56px;
    width: 100%;
  }
  .c8-awards__logo img {
    height: 100%;
    max-height: 56px;
    max-width: 70%;
    width: auto;
    object-fit: contain;
    /* Logos are dark-ink PNGs — invert to white for the dark surface. */
    filter: brightness(0) invert(1);
    opacity: 0.75;
    transition: opacity 0.3s ease, filter 0.3s ease, transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .c8-awards__card:hover .c8-awards__logo img {
    filter: none;
    opacity: 1;
    transform: scale(1.04);
  }

  .c8-awards__title {
    font-family: var(--montreal, system-ui, sans-serif);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    line-height: 1.25;
    color: #ffffff;
    margin: 0.3rem 0 0;
  }
  .c8-awards__issuer {
    font-family: var(--montreal, system-ui, sans-serif);
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.62);
    margin: 0;
    letter-spacing: 0.005em;
  }

  /* Gold year pill — warmer on the dark surface. */
  .c8-awards__year {
    display: inline-block;
    margin-top: 0.3rem;
    padding: 0.22rem 0.7rem;
    border-radius: 999px;
    background: rgba(242, 191, 34, 0.14);
    border: 1px solid rgba(242, 191, 34, 0.4);
    color: #f5c96b;
    font-family: var(--montreal, monospace);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  @media (max-width: 1024px) {
    .c8-awards__grid { grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  }
  @media (max-width: 560px) {
    .c8-awards__grid { grid-template-columns: repeat(2, 1fr); gap: 0.85rem; }
    .c8-awards__card { padding: 1rem 0.75rem; }
    .c8-awards__logo { height: 48px; }
    .c8-awards__logo img { max-height: 48px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .c8-awards__video { display: none; }
  }
</style>

<script is:inline>
  /* Pause Awards bg video when prefers-reduced-motion is set. */
  (function () {
    var video = document.querySelector('.c8-awards__video');
    if (!video) return;
    var mq = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (mq.matches) {
      try { video.pause(); } catch (e) {}
      video.removeAttribute('autoplay');
    }
  })();
</script>
