  gsap.utils.toArray('.reveal-left').forEach(function(el){gsap.fromTo(el,{autoAlpha:0,x:-60},{autoAlpha:1,x:0,duration:1,ease:'power3.out',scrollTrigger:{trigger:el,start:'top 88%'}});});
  gsap.utils.toArray('.reveal-right').forEach(function(el){gsap.fromTo(el,{autoAlpha:0,x:60},{autoAlpha:1,x:0,duration:1,ease:'power3.out',scrollTrigger:{trigger:el,start:'top 88%'}});});
  ['.b2-disc-grid','.b2-process-grid','.b2-chan-grid','.b2-testi-grid'].forEach(function(sel){
    var p=document.querySelector(sel); if(!p) return;
    gsap.fromTo(p.querySelectorAll('.reveal-stagger'),{autoAlpha:0,y:60},{autoAlpha:1,y:0,duration:0.85,ease:'power3.out',stagger:0.1,scrollTrigger:{trigger:p,start:'top 86%'}});
  });
  document.querySelectorAll('.b2-faq-q').forEach(function(btn){
    btn.addEventListener('click',function(){
      var item=btn.closest('.b2-faq-item'); var ans=item.querySelector('.b2-faq-a'); var open=btn.getAttribute('aria-expanded')==='true';
      document.querySelectorAll('.b2-faq-item').forEach(function(i){i.querySelector('.b2-faq-q').setAttribute('aria-expanded','false');i.querySelector('.b2-faq-a').style.maxHeight='0';i.querySelector('.b2-faq-a').style.opacity='0';i.classList.remove('open');});
      if(!open){btn.setAttribute('aria-expanded','true');ans.style.maxHeight=ans.scrollHeight+'px';ans.style.opacity='1';item.classList.add('open');}
    });
  });
})();
</script>

