---
import Partners from "../components/Partners.astro";
import Layout from "./Layout.astro";
import FinalCta from "../components/FinalCta.astro";

const { title = "Web3 Agency | Corum8" } = Astro.props;
---
<Layout title={title}>
  <section class="Hero_hero__zbooM"><div class="container"><div class="Hero_top__UZ6SA"><h2><span class="LineByLine_headingOuter__JmusT"><span>Born in Web3. Built for what's next.</span></span><figure class="crosshair" aria-hidden="true"><span class="FadeInRotate_container__QE9u9" data-fill="true" data-direction="clockwise"><span class="inner"></span></span></figure></h2></div><div class="Hero_bottom__pLxrT"><h1><span class="MaskInUp_container__0AW5i" data-fill="false"><div><span><i></i>Agency</span></div></span></h1><div class="Hero_arrow__WTdEi"><span class="FadeInRotate_container__QE9u9" data-fill="false" data-direction="counterclockwise"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 75.91 75.65"><path d="m13.65 67.65 61.93-62L69.92 0 8 61.99V.25H0v75.4h75.91v-8H13.65z" style="stroke-width:0"></path></svg></span></div></div></div><!--$!--><template data-dgst="BAILOUT_TO_CLIENT_SIDE_RENDERING"></template><!--/$--></section><section class="Mission_mission__8wC67"><div class="container"><h2 class="Mission_heading__Z0yjM"><span class="LineByLine_headingOuter__JmusT"><span class="Mission_heading__Z0yjM">Our</span><span class="Mission_heading__Z0yjM Mission_bottom__FzQ0F">Mission</span></span></h2><figure class="Mission_image__gbyeM"><span class="ScaleFadeIn_container__cK78G" data-fill="true"><span class="ScaleFadeIn_inner__y4reT" data-fill="true"><span class="Image_image__RAAdZ Image_fill__EiIzS"><img data-srcset="/images/corum8-mission.png" data-src="/images/corum8-mission.png" alt="" fetchpriority="low" height="730" width="810" sizes="auto" class="lazyload"></span></span></span></figure><h3 class="Mission_subheading__mpPMf"><span class="FadeInUp_container___uxva" data-fill="false">Help Web3, AI and fintech teams ship real products and run growth that compounds.</span></h3><div class="Mission_mainText__ejHIS"><span class="FadeInUp_container___uxva" data-fill="false"><div><p>We've shipped 1,100+ launches across exchanges, wallets, RWA platforms, DeFi protocols, token sales and the PR programmes wrapped around them. The pattern we keep seeing: product teams treating go-to-market as an afterthought, marketing teams unable to explain what was built, and founders losing six months stitching agencies together. Corum8 is the one team that handles both — strategy, engineering, PR, community, growth — so the thing you ship and the story you tell come out aligned on day one.</p>
</div></span></div></div></section><section class="Video_video__ODG2u"><div class="ImageEnter_image__FSEP_" data-fill="false"><div class="Video_videoContainer__SQ5UJ"><div class="Video_playIcon__0b_gO "><div class="Magnetic_magnetic__LncOy" data-fill="true"><div class="Video_playButtonInner__hAyVq"><span>Play</span><figure class="Video_playButtonBackground__ZkEi5"></figure></div></div></div><div class="Video_pauseIcon__YDsTU Video_pauseActive__Y6U7Q"><div class="Magnetic_magnetic__LncOy" data-fill="true"><div class="Video_playButtonInner__hAyVq"><span>Pause</span><figure class="Video_playButtonBackground__ZkEi5"></figure></div></div></div><div class="Video_loopVideo__AH9Ag"><span class="AutoplayVideo_video__zckWy AutoplayVideo_fill__ZPgCR"><video src="/media/bg2.mp4" autoplay="true" loop="true" muted="true" playsinline="true"></video></span></div></div></div></section><section class="Approach_approach__l9ADx"><div class="container"><h2 class="Approach_heading__mbcS_"><div class="LargeHeading_headingOuter__i9qcd"><span class="Approach_heading__mbcS_">Our</span><span class="Approach_heading__mbcS_ Approach_bottom__o3s1M">Approach</span></div></h2><div class="Approach_arrow__3EkCM"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 75.91 75.65"><path d="m13.65 67.65 61.93-62L69.92 0 8 61.99V.25H0v75.4h75.91v-8H13.65z" style="stroke-width:0"></path></svg></div><figure class="Approach_image__xti5i"><div class="ImageEnter_image__FSEP_" data-fill="true"><span class="Image_image__RAAdZ Image_fill__EiIzS"><img data-srcset="/images/corum8-mission.png" data-src="images/approach.jpg" alt="" fetchpriority="low" height="1134" width="1086" sizes="auto" class="lazyload"></span></div></figure><div class="Approach_mainText__y2DyK"><span class="FadeInUp_container___uxva" data-fill="false"><div class="Approach_textContent__ncod1"><p>Strategy first. We pressure-test your positioning, audience, compliance constraints and win condition before we move a pixel or ship a smart contract. Skipping this is how launches end up technically fine and commercially invisible.</p>
<p>One team. 95+ specialists — engineers, token economists, PR leads, community managers, performance marketers, designers — sitting in the same Slack, running against one brief. No handoff tax between agencies.</p>
<p>Outcome-obsessed. We measure the work in raises closed, listings secured, volume held, users retained. Awards are fine. Revenue matters more.</p>
</div></span></div></div></section><section class="Culture_culture__lmpEt"><!--$!--><template data-dgst="BAILOUT_TO_CLIENT_SIDE_RENDERING"></template><!--/$--><div class="container"><p class="Culture_text__tkIGz"><span class="LineByLine_headingOuter__JmusT"><span><em>The work</em> is what we're judged on.</span></span></p><div class="Culture_buttonContainer__YAvTa"><div class="Magnetic_magnetic__LncOy" data-fill="false"><div class="Button_button__JJiqJ" data-direction="forwards"><a class="Button_inner__fnyH6" href="/case-studies"><span class="Button_border__hirH2"></span><span class="Button_text__IZaCD"><span class="Button_textInner__JTTHe">View case studies</span><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 17.1 15.17" class="Button_buttonArrow__0W9XI"><path d="m17.1,7.58s-.01-.04-.01-.06c.01-.22-.06-.45-.24-.61L9.23.19c-.31-.27-.78-.24-1.06.07-.27.31-.24.78.07,1.06l6.26,5.52H.75c-.41,0-.75.34-.75.75s.34.75.75.75h13.74l-6.26,5.52c-.31.27-.34.75-.07,1.06.15.17.35.25.56.25.18,0,.35-.06.5-.19l7.62-6.72c.18-.16.25-.39.24-.61,0-.02.01-.04.01-.06Z" fill="currentColor"></path></svg></span></a></div></div></div></div></section><Partners /><div class="BigUps_partners__xRCBU" style="padding: 10rem 0; background: #fdfdfd; position: relative;">
  <div class="container">
    <h2 style="font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 400; line-height: 1.1; margin-bottom: 4rem; text-align: center; color: #111;">
      Trusted & Recognized By The Best
    </h2>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; max-width: 1400px; margin: 0 auto;">
      
      <!-- Premium TrustPilot Block -->
      <div style="background: #fff; padding: 3rem 2rem; border-radius: 1.5rem; box-shadow: 0 20px 40px rgba(0,0,0,0.04); border: 1px solid rgba(0,0,0,0.05); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; transition: transform 0.3s ease;">
        <svg viewBox="0 0 150 24" width="180" height="35" xmlns="http://www.w3.org/2000/svg" style="margin-bottom: 1.5rem;">
          <path d="M17.48 10L20 2H14.96L17.48 10Z" fill="#00B67A"/>
          <text x="26" y="18" font-family="Helvetica, sans-serif" font-size="24" font-weight="800" fill="#111">Trustpilot</text>
        </svg>
        <div style="display: flex; gap: 0.35rem; margin-bottom: 1rem;">
          <div style="background:#00B67A; padding:0.4rem; display:flex; border-radius: 4px;"><svg width="24" height="24" viewBox="0 0 24 24" fill="#fff"><path d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z"/></svg></div>
          <div style="background:#00B67A; padding:0.4rem; display:flex; border-radius: 4px;"><svg width="24" height="24" viewBox="0 0 24 24" fill="#fff"><path d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z"/></svg></div>
          <div style="background:#00B67A; padding:0.4rem; display:flex; border-radius: 4px;"><svg width="24" height="24" viewBox="0 0 24 24" fill="#fff"><path d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z"/></svg></div>
          <div style="background:#00B67A; padding:0.4rem; display:flex; border-radius: 4px;"><svg width="24" height="24" viewBox="0 0 24 24" fill="#fff"><path d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z"/></svg></div>
          <div style="background:#00B67A; padding:0.4rem; display:flex; border-radius: 4px;"><svg width="24" height="24" viewBox="0 0 24 24" fill="#fff"><path d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z"/></svg></div>
        </div>
        <div style="font-size: 1.5rem; font-weight: 700; color: #111; line-height: 1.2;">Excellent, 4.9/5</div>
        <p style="color: #666; font-size: 0.95rem; margin-top: 0.5rem;">Based on 150+ global client reviews.</p>
      </div>

      <!-- Award 1 -->
      <div style="background: #fff; padding: 3rem 2rem; border-radius: 1.5rem; box-shadow: 0 20px 40px rgba(0,0,0,0.04); border: 1px solid rgba(0,0,0,0.05); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; transition: transform 0.3s ease;">
        <h3 style="font-size: 2.2rem; font-weight: 800; letter-spacing: -0.05em; color: #da9e49; margin-bottom: 1rem;">Clutch</h3>
        <h4 style="font-size: 1.25rem; color: #111; font-weight: 600; margin-bottom: 0.25rem;">Global Leader 2026</h4>
        <p style="color: #666; font-size: 0.95rem;">Top B2B Service Provider</p>
      </div>

      <!-- Award 2 -->
      <div style="background: #fff; padding: 3rem 2rem; border-radius: 1.5rem; box-shadow: 0 20px 40px rgba(0,0,0,0.04); border: 1px solid rgba(0,0,0,0.05); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; transition: transform 0.3s ease;">
        <h3 style="font-size: 2.2rem; font-weight: 800; letter-spacing: -0.05em; color: #111; margin-bottom: 1rem;">DesignRush</h3>
        <h4 style="font-size: 1.25rem; color: #111; font-weight: 600; margin-bottom: 0.25rem;">Top Web3 Agency</h4>
        <p style="color: #666; font-size: 0.95rem;">Excellence in Blockchain Design</p>
      </div>

      <!-- Award 3 -->
      <div style="background: #fff; padding: 3rem 2rem; border-radius: 1.5rem; box-shadow: 0 20px 40px rgba(0,0,0,0.04); border: 1px solid rgba(0,0,0,0.05); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; transition: transform 0.3s ease;">
        <h3 style="font-size: 2.2rem; font-weight: 800; letter-spacing: -0.05em; color: #f4cb4e; margin-bottom: 1rem;">The Manifest</h3>
        <h4 style="font-size: 1.25rem; color: #111; font-weight: 600; margin-bottom: 0.25rem;">Most Reviewed</h4>
        <p style="color: #666; font-size: 0.95rem;">Top 100 Agencies Globally</p>
      </div>

    </div>
  </div>
</div><section class="Custom_Team_Wrapper" style="display: block; position: relative; width: 100%; max-width: 1400px; margin: 5rem auto; padding: 0 2rem;">
  <div style="display: block; width: 100%; margin-bottom: 3rem; text-align: center;">
    <p style="font-size: 1.5rem; line-height: 1.5; max-width: 800px; color: #111 !important; margin: 0 auto;">
      We're proud to be a Certified Great Place to Work®! You'll find us working across Creative Web Design, Web Development, Branding, and Digital Marketing.
    </p>
  </div>
    
    <!-- Corum8 AI Generated Elite Team Photo -->
    <div style="position: relative; width: 100%; border-radius: 2rem; overflow: hidden; box-shadow: 0 40px 100px rgba(0,0,0,0.15);">
      <img src="/images/corum8-team.png" alt="Corum8 Multicultural Web3 Tech Team" style="width: 100%; height: auto; object-fit: cover; display: block;" />
      <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 2rem; background: linear-gradient(0deg, rgba(0,0,0,0.8) 0%, transparent 100%);">
        <h3 style="color: #fff; font-size: 2rem; margin: 0;">The Corum8 Intelligence Framework</h3>
        <p style="color: #ccc; margin-top: 0.5rem;">Driving B+ in Web3 Market Cap globally.</p>
      </div>
    </div>
  </div>
</section><FinalCta />

<script>
  
  // PLAY/PAUSE ENGINE
  function initVideoEngine() {
    const videoSection = document.querySelector('.Video_videoContainer__SQ5UJ');
    if (!videoSection) return;
    
    const video = videoSection.querySelector('video');
    const playBtn = videoSection.querySelector('.Video_playIcon__0b_gO');
    const pauseBtn = videoSection.querySelector('.Video_pauseIcon__YDsTU');
    
    // Ensure we don't double-bind
    if (videoSection.dataset.videoBound === 'true') return;
    videoSection.dataset.videoBound = 'true';

    // Toggle logic
    const togglePlay = () => {
      if (video.paused) {
        video.play();
        playBtn.classList.remove('Video_pauseActive__Y6U7Q'); // using KOTA's active class name logic
        pauseBtn.classList.add('Video_pauseActive__Y6U7Q');
        playBtn.style.opacity = '0';
        playBtn.style.pointerEvents = 'none';
        pauseBtn.style.opacity = '1';
        pauseBtn.style.pointerEvents = 'auto';
      } else {
        video.pause();
        pauseBtn.classList.remove('Video_pauseActive__Y6U7Q');
        playBtn.classList.add('Video_pauseActive__Y6U7Q');
        pauseBtn.style.opacity = '0';
        pauseBtn.style.pointerEvents = 'none';
        playBtn.style.opacity = '1';
        playBtn.style.pointerEvents = 'auto';
      }
    };

    // The entire video container handles the click since the magnetic buttons track the mouse
    videoSection.addEventListener('click', togglePlay);
  }

  document.addEventListener('DOMContentLoaded', initVideoEngine);
  document.addEventListener('astro:page-load', initVideoEngine);

  // Aurora engine disabled per user request
</script>


<style is:global>
  /* Cinematic Up-Res Filter Engine */
  .Video_loopVideo__AH9Ag {
    position: relative;
  }
  .Video_loopVideo__AH9Ag::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    /* Optical vignette to draw eyes away from low-res edges */
    background: radial-gradient(circle, rgba(0,0,0,0) 30%, rgba(0,0,0,0.8) 100%);
    pointer-events: none;
    z-index: 5;
  }
  .AutoplayVideo_video__zckWy video {
    /* Hard-contrast upscaling to fake 4K sharpness */
    filter: contrast(1.15) saturate(1.2) brightness(0.95);
  }
</style>
</Layout>