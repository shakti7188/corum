---
import Layout from "../layouts/Layout.astro";
import FinalCta from "../components/FinalCta.astro";

const arrowGrad = {
  id: 'blog',
  stops: [
    { offset: '0', color: '#da9e49' },
    { offset: '1', color: '#f4cb4e' },
  ],
};

const projects = [
  {
    href: '#',
    name: 'Exchange listings are relationships',
    year: 'Apr 2026 · Token & Listings',
    heading: 'The half-page CMC application is not the listing process. It\'s the last visible 10%. Here\'s what tier-1 exchanges actually want to see six months before you apply.',
    tags: ['Listings', 'Token', 'Exchange'],
    poster: '/images/bento1-1.jpg',
  },
  {
    href: '#',
    name: 'Post-MiCA custody, what shifts',
    year: 'Apr 2026 · Compliance',
    heading: 'MiCA took effect December 2024. Most custody teams still build as if it hasn\'t. What actually shifts in your architecture document — and what doesn\'t.',
    tags: ['Compliance', 'Custody', 'MiCA'],
    poster: '/images/bento2-1.jpg',
  },
  {
    href: '#',
    name: 'AI launches that cut through',
    year: 'Mar 2026 · AI GTM',
    heading: 'Every AI product launch now looks the same. Three things that get tier-1 coverage when everyone\'s drowning in the same visual kit.',
    tags: ['AI', 'GTM', 'Launch'],
    poster: '/images/bento3-1.jpg',
  },
  {
    href: '#',
    name: 'SEO is dead; AEO is the conversation',
    year: 'Mar 2026 · SEO & AEO',
    heading: 'ChatGPT, Perplexity and Gemini now sit between your audience and your website. Getting cited verbatim by the LLM summary box is the new top-of-funnel.',
    tags: ['SEO', 'AEO', 'LLMs'],
    poster: '/images/bento4-1.jpg',
  },
  {
    href: '#',
    name: 'Why most DeFi bugs aren\'t in the math',
    year: 'Mar 2026 · DeFi',
    heading: 'Audit findings rarely cite the AMM formula. They cite the glue — access control, upgrade paths, price oracles, rebasing mechanics. Where to look first.',
    tags: ['DeFi', 'Security', 'Audits'],
    poster: '/images/bento1.jpg',
  },
  {
    href: '#',
    name: 'Community after the airdrop',
    year: 'Mar 2026 · Community',
    heading: 'The hard part of community isn\'t launch. It\'s the six quiet months after. What programmes retain the 5% of community who\'ll still be there in 18 months.',
    tags: ['Community', 'Retention', 'Web3'],
    poster: '/images/bento3.jpg',
  },
];
---
<Layout title="Blog | Corum8">
<div data-theme="light">
<section class="Hero_hero__Oyf4n"><div class="container"><div class="Hero_top__RRkYH"><h2><span class="LineByLine_headingOuter__JmusT"><span>Short posts. Written by the people who did the work.</span></span></h2><figure class="crosshair" aria-hidden="true"><span class="FadeInRotate_container__QE9u9" data-fill="true" data-direction="clockwise"><span class="inner"></span></span></figure><div class="Hero_video__rzcbe"><span class="ScaleFadeIn_container__cK78G" data-fill="true"><span class="ScaleFadeIn_inner__y4reT" data-fill="true"><video src="/media/bg2.mp4" class="Hero_video__rzcbe" autoplay muted loop playsinline></video></span></span></div></div><div class="Hero_bottom__ktiOH"><h1><span class="MaskInUp_container__0AW5i" data-fill="false"><div><span><i></i>Blog</span></div></span></h1><h3 class="Hero_introText__oP34v"><span class="FadeIn_container__bjQVL" data-fill="false"><span>Notes from the engineers, PR leads and growth operators running the programmes we ship. Weekly.</span></span></h3><div class="Hero_arrow__lxSeM"><span class="FadeInRotate_container__QE9u9" data-fill="false" data-direction="counterclockwise"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 75.91 75.65"><path d="m13.65 67.65 61.93-62L69.92 0 8 61.99V.25H0v75.4h75.91v-8H13.65z"></path></svg></span></div></div></div></section>

<div class="Work_work__rSI8c">
  <div class="DarkThemeSwitch_cover__hn_xc"></div>
  <div class="Work_projects__A5q77">
    <div class="AnimatedGrid_grid__otAMD">
      <div class="container">
        {projects.map((p) => (
          <a class="ProjectCard_project__d1wbY ProjectCard_small__xsL92" data-animation="grid-item" href={p.href}>
            <div class="ProjectCard_projectText__o770X">
              <h3>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14.78 14.78">
                  <defs>
                    <linearGradient id={arrowGrad.id} x1="3.54" x2="13.98" y1="3.54" y2="13.99" gradientUnits="userSpaceOnUse">
                      {arrowGrad.stops.map((s) => <stop offset={s.offset} stop-color={s.color}></stop>)}
                    </linearGradient>
                  </defs>
                  <path fill={`url(#${arrowGrad.id})`} stroke-width="0" d="M13.25 12.18L13.25 0.23 14.78 0.23 14.78 14.76 14.74 14.76 14.74 14.78 0.21 14.78 0.21 13.25 12.18 13.25 0 1.08 1.08 0 13.25 12.18z"></path>
                </svg>{p.name}
              </h3>
              <p>{p.year}</p>
            </div>
            <div class="ProjectCard_projectImage__Nfx9I">
              <div class="ProjectCard_imageOverlay__OCawr">
                <p class="ProjectCard_heading__1csIW">{p.heading}</p>
                <ul class="ProjectCard_tags__XdVcf">
                  {p.tags.map((t) => <li>{t}</li>)}
                </ul>
              </div>
              <span class="Image_image__RAAdZ Image_fill__EiIzS"><img src={p.poster} alt="" fetchpriority="low" loading="lazy" /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</div>

<FinalCta
  light="Want to work"
  bold="with this team?"
  subtitle="The people writing these posts are the ones who'd ship your project."
/>
</div>
</Layout>
