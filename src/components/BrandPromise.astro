---
import { promise } from "../data/content";
---

<section id="agency" class="section-pad border-t border-[color:var(--color-rule)]">
  <div class="container-wide">
    <div class="max-w-[28ch]" data-reveal-group>
      <p data-reveal class="text-[12px] uppercase tracking-[0.2em] text-[color:var(--color-ink-mute)] mb-4">
        {promise.eyebrow}
      </p>
      <h2 data-reveal class="headline" style="font-size: var(--fs-100); max-width: 14ch;">
        {promise.title.a}{" "}
        <span class="font-serif-it">{promise.title.b}</span>
      </h2>
    </div>

    <div class="mt-20 grid grid-cols-12 gap-x-8 gap-y-24" data-reveal-group>
      {
        promise.items.map((it, i) => (
          <div
            class:list={[
              "col-span-12 md:col-span-6 grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-8 items-start",
              i % 2 === 0 ? "md:col-start-1" : "md:col-start-7",
            ]}
            data-reveal
          >
            <div class="md:col-span-5 promise-media">
              {it.isVideo ? (
                <video
                  src={it.media}
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                />
              ) : (
                <img src={it.media} alt="" loading="lazy" />
              )}
            </div>
            <div class="md:col-span-7 md:pt-6">
              <div class="flex items-center gap-4 mb-4 text-[color:var(--color-ink-mute)]">
                <span class="text-[13px] tracking-[0.24em]">{it.num}</span>
                <span class="h-px w-10 bg-[color:var(--color-rule)]" />
              </div>
              <h3 class="headline mb-3" style="font-size: var(--fs-44);">{it.title}</h3>
              <p class="text-[15px] leading-relaxed text-[color:var(--color-ink-soft)] max-w-[38ch]">
                {it.body}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
