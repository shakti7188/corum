---
import Layout from '../../../layouts/Layout.astro';
---
<Layout title="SEO & AEO Services — Rank First, Get Cited by AI | Corum8">
  <Fragment slot="head">
    <meta name="description" content="Corum8 SEO and AEO for Web3, AI, and fintech. Technical SEO, content strategy, and authority building so AI engines cite your brand directly." />
    <link rel="canonical" href="https://corum8.com/services/marketing/seo" />
  </Fragment>

<!-- ══════════════════════════════════════════════════════════════════
     1. HERO — headline left · floating cards + photo right
═══════════════════════════════════════════════════════════════════ -->
<section class="s-hero">
  <div class="s-blob s-blob--a"></div>
  <div class="s-blob s-blob--b"></div>
  <div class="s-hero__inner">

    <div class="s-hero__copy reveal-up">
      <span class="s-badge">SEO · AEO · GEO · since 2014</span>
      <h1 class="s-hero__h1">The team behind<br/><span class="s-orange">200+ tier-1 placements</span><br/>per quarter for KuCoin.</h1>
      <p class="s-hero__sub">We're an SEO and AEO agency for Web3, AI, and fintech. We rank you in Google. We get you quoted by ChatGPT, Gemini, and Perplexity. We've driven <strong>60M+ organic sessions</strong> for clients including Binance, KuCoin, and Cashaa.</p>
      <div class="s-hero__btns">
        <a href="/contact" class="s-btn s-btn--fill">Get a free SEO audit</a>
        <a href="#case-spotlight" class="s-btn s-btn--line">See the work →</a>
      </div>
      <ul class="s-hero__chips">
        <li><span class="s-chip-num">60M+</span><span class="s-chip-lbl">organic sessions</span></li>
        <li class="s-chip-div"></li>
        <li><span class="s-chip-num">200+</span><span class="s-chip-lbl">tier-1 placements / qtr</span></li>
        <li class="s-chip-div"></li>
        <li><span class="s-chip-num">14</span><span class="s-chip-lbl">languages live</span></li>
      </ul>
    </div>

    <div class="s-hero__visual reveal-right">
      <!-- main photo -->
      <div class="s-hero__photo">
        <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=900&q=80&auto=format&fit=crop" alt="Analytics dashboard" />
      </div>
      <!-- floating rank card -->
      <div class="s-fc s-fc--rank float-a">
        <div class="s-fc__label">Live rankings</div>
        <div class="s-fc__row"><span>crypto exchange platform</span><span class="green">#1</span></div>
        <div class="s-fc__row"><span>web3 marketing agency</span><span class="green">#2</span></div>
        <div class="s-fc__row"><span>defi token strategy</span><span class="green">#3</span></div>
      </div>
      <!-- floating traffic card -->
      <div class="s-fc s-fc--traffic float-b">
        <svg viewBox="0 0 180 55" fill="none" class="s-sparkline">
          <defs><linearGradient id="spg" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#f2bf22" stop-opacity=".3"/><stop offset="100%" stop-color="#f2bf22" stop-opacity="0"/></linearGradient></defs>
          <path class="sp-fill" d="M0 48 Q30 40,55 28 T110 16 T180 4 L180 55 L0 55Z" fill="url(#spg)"/>
          <path class="sp-line" d="M0 48 Q30 40,55 28 T110 16 T180 4" stroke="#f2bf22" stroke-width="2.5" stroke-linecap="round" fill="none"/>
        </svg>
        <div class="s-fc__stat"><span class="s-fc__big">+450%</span><span class="s-fc__lbl">organic · 12 mo</span></div>
      </div>
    </div>

  </div>
</section>

<!-- ── LOGO STRIP ── -->
<div class="s-logos reveal-up">
  <span>Binance</span><span class="sdot">·</span>
  <span>KuCoin</span><span class="sdot">·</span>
  <span>Cashaa</span><span class="sdot">·</span>
  <span>Fanadise</span><span class="sdot">·</span>
  <span>Metarix</span><span class="sdot">·</span>
  <span>Ubuntu Tribe</span>
</div>

<!-- ══════════════════════════════════════════════════════════════════
