        <div class="lp-hero__chip lp-hero__chip--outcome">
          <span class="lp-hero__chip-label">CAC ↓ this quarter</span>
          <span class="lp-hero__chip-value">−42<span class="lp-hero__chip-unit">%</span></span>
        </div>

        <div class="lp-hero__chip lp-hero__chip--live">
          <span class="lp-hero__chip-dot"></span>
          Attribution rebuilt · live
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    /* Hero horizontal parallax — drift the ads collage to the LEFT as
       the page scrolls down. Uses a rAF loop with getBoundingClientRect
       so it works regardless of the page's scroll engine (Lenis hijacks
       native scroll events). The image is sized at 136% width with an
       18% left offset so the transform has horizontal headroom to slide
       without exposing edges. */
    function lpHeroParallaxInit() {
      var bg = document.querySelector('.lp-hero__bg-img');
      var hero = document.querySelector('.lp-hero');
      if (!bg || !hero) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      var lastX = null;
      var scheduled = false;

      function apply() {
        scheduled = false;
        var rect = hero.getBoundingClientRect();
        if (rect.bottom < -200 || rect.top > window.innerHeight + 200) return;
        // rect.top decreases (toward negative) as user scrolls down,
        // producing a negative translateX so the bg drifts to the LEFT.
        var x = rect.top * 0.35;
        if (x === lastX) return;
        bg.style.setProperty('transform', 'translate3d(' + x + 'px, 0, 0)', 'important');
        lastX = x;
      }

      function onScroll() {
        if (scheduled) return;
        scheduled = true;
        // rAF in production; if rAF is throttled, fall back to immediate.
        if (typeof requestAnimationFrame === 'function') {
          requestAnimationFrame(apply);
          // safety net for environments where rAF is suspended
          setTimeout(function () { if (scheduled) apply(); }, 50);
        } else {
          apply();
        }
      }

      apply();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', lpHeroParallaxInit);
    } else {
      lpHeroParallaxInit();
    }
  </script>

  <!-- ── MARQUEE ── -->
  <section class="lp-marquee" aria-hidden="true">
    <div class="lp-marquee__track">
      <span>Acquisition</span><span class="lp-marquee__dot">●</span>
      <span>Attribution</span><span class="lp-marquee__dot">●</span>
      <span>LTV-weighted bidding</span><span class="lp-marquee__dot">●</span>
      <span>Conversions API</span><span class="lp-marquee__dot">●</span>
      <span>Pipeline ROAS</span><span class="lp-marquee__dot">●</span>
      <span>On-chain advertising</span><span class="lp-marquee__dot">●</span>
      <span>Acquisition</span><span class="lp-marquee__dot">●</span>
      <span>Attribution</span><span class="lp-marquee__dot">●</span>
      <span>LTV-weighted bidding</span><span class="lp-marquee__dot">●</span>
      <span>Conversions API</span><span class="lp-marquee__dot">●</span>
      <span>Pipeline ROAS</span><span class="lp-marquee__dot">●</span>
      <span>On-chain advertising</span><span class="lp-marquee__dot">●</span>
    </div>
  </section>

  <!-- ── COMBINED SECTION (Light Background) ── -->
