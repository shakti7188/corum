---
import Layout from "./Layout.astro";
import Testimonials from "../components/Testimonials.astro";
import FaqsList from "../components/FaqsList.astro";

const { 
  title = "Service Cluster | Corum8",
  heroHeadline = "B2B Tech, Software & SaaS",
  heroTagline = "Standout digital presences designed to scale with your ambitions.",
  introTitle = "What we offer:",
  introBody = "In the tech sphere, standing out demands more than just a functional website.",
  services = ["Creative Web Design", "Brand Strategy"],
  testimonials = undefined,
  stats = undefined,
  faqs = undefined
} = Astro.props;

// 10-Asset Matrix Pooling Strategy (Deterministic based on title length to keep SSG clean)
const web3Assets = [
  "/media/bg2.mp4",
  "/media/work-video.mp4",
  "/media/FF-Shapes-x1.mp4",
  "/media/Company-Loop4-compressed-2.mp4",
  "/media/Featured2-Compressed.mp4"
];
const bgVideo = web3Assets[(title.length % web3Assets.length)];

---

<Layout title={title}>
  <section class="Hero_hero__drBQ0"><h1>{heroHeadline}</h1><div class="container"><div class="Hero_top__plNyC"><div class="Hero_topContent__VKnSn"><h2><span class="LineByLine_headingOuter__JmusT"><span>{heroHeadline}</span></span></h2><h3 class="Hero_introText__H9sO_"><span class="FadeIn_container__bjQVL" data-fill="false"><span>{heroTagline}</span></span></h3><div class="Magnetic_magnetic__LncOy" data-fill="false"><div class="Button_button__JJiqJ" data-direction="forwards"><a class="Button_inner__fnyH6" href="/contact"><span class="Button_border__hirH2"></span><span class="Button_text__IZaCD"><span class="Button_textInner__JTTHe">Get in touch</span><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 17.1 15.17" class="Button_buttonArrow__0W9XI"><path d="m17.1,7.58s-.01-.04-.01-.06c.01-.22-.06-.45-.24-.61L9.23.19c-.31-.27-.78-.24-1.06.07-.27.31-.24.78.07,1.06l6.26,5.52H.75c-.41,0-.75.34-.75.75s.34.75.75.75h13.74l-6.26,5.52c-.31.27-.34.75-.07,1.06.15.17.35.25.56.25.18,0,.35-.06.5-.19l7.62-6.72c.18-.16.25-.39.24-.61,0-.02.01-.04.01-.06Z" fill="currentColor"></path></svg></span></a></div></div></div><div class="Hero_video__OxYni"><span class="ScaleFadeIn_container__cK78G" data-fill="true"><span class="ScaleFadeIn_inner__y4reT" data-fill="true">
  <video src={bgVideo} class="Hero_videoPlayer" autoplay muted loop playsinline style="width:100%; height:100%; object-fit:cover;"></video>
</span></span></div></div><div class="Hero_bottom__5rFZf"><div class="Hero_arrow__IRuwV"><span class="FadeInRotate_container__QE9u9" data-fill="false" data-direction="counterclockwise"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 75.91 75.65"><path d="m13.65 67.65 61.93-62L69.92 0 8 61.99V.25H0v75.4h75.91v-8H13.65z" style="stroke-width:0"></path></svg></span></div></div></div></section><section class="Bento_bento__jd1Vj"><div class="container"><div class="StaggeredItems_grid__5Yycm"><div class="Bento_bentoGrid__BhcGU"><div class="Bento_media1__YEH8Y" data-animation="grid-item"><span class="AutoplayVideo_video__zckWy AutoplayVideo_fill__ZPgCR"><video loop="" muted="" playsinline=""></video></span></div><div class="Bento_media2__owg5A" data-animation="grid-item"><span class="AutoplayVideo_video__zckWy AutoplayVideo_fill__ZPgCR"><video loop="" muted="" playsinline=""></video></span></div><div class="Bento_media3__0uD1R" data-animation="grid-item"><span class="Image_image__RAAdZ Image_fill__EiIzS"><img data- data-src="images/logo-design.jpg" alt="" fetchpriority="low" height="1224" width="1224" sizes="auto" class="lazyload"></span></div><div class="Bento_media4__1p3uU" data-animation="grid-item"><span class="Image_image__RAAdZ Image_fill__EiIzS"><img src="images/arcturis.jpg" alt="" loading="eager" fetchpriority="high" height="1188" width="554" sizes="100vw"></span></div></div></div></div></section><section class="Intro_intro__L3nUM"><div class="container"><div class="Intro_introLeft__ok0SK"><h2 class="Intro_heading__tjL0j"><span class="LineByLine_headingOuter__JmusT"><span>What we offer:</span></span></h2><div class="Intro_text__yXuAA prose"><span class="FadeIn_container__bjQVL" data-fill="false"><span><p>{introBody}</p></span></span></div></div><div class="Intro_introRight__pWwIZ"><h2 class="Intro_headingMobile__aI6Ht"><span class="LineByLine_headingOuter__JmusT"><span>What we offer:</span></span></h2><ul class="Intro_serviceList__QZaRK">
          {services.map((svc: string) => (
            <li><button class="Intro_serviceButton__R1Tyj">{svc}</button></li>
          ))}
        </ul></div></div></section><section class="TextImageRows_textImageRows__J0BOf"><div class="container"><div class="TextImageRows_headings__b_pFN"><p class="TextImageRows_heading__0tbTZ"><span class="LineByLine_headingOuter__JmusT"><span>Why choose Corum8?</span></span></p></div><div class="TextImageRows_row__syXSm"><div class="TextImageRows_text__m8z0M"><h3 class="TextImageRows_heading__0tbTZ"><span class="LineByLine_headingOuter__JmusT"><span>Scalable websites for growing enterprises</span></span></h3><div class="TextImageRows_text__m8z0M"><span class="FadeIn_container__bjQVL" data-fill="false"><span><p>As your business expands, your website should rise to the challenge. Our websites aren't just built for today—they're crafted to evolve with you, effortlessly handling more visitors, expanding product lines, and scaling business ventures.</p>
</span></span></div></div><figure class="TextImageRows_media__rfO7h"><div class="ImageEnter_image__FSEP_" data-fill="true"><span class="Image_image__RAAdZ Image_fill__EiIzS"><img data- data-src="images/bento3_1.jpg" alt="" fetchpriority="low" height="554" width="553" sizes="auto" class="lazyload"></span></div></figure></div><div class="TextImageRows_row__syXSm"><div class="TextImageRows_text__m8z0M"><h3 class="TextImageRows_heading__0tbTZ"><span class="LineByLine_headingOuter__JmusT"><span>Data-driven designs that perform</span></span></h3><div class="TextImageRows_text__m8z0M"><span class="FadeIn_container__bjQVL" data-fill="false"><span><p>Armed with data and analytics, our designs are scientifically sweet. We enhance user experience by focusing on what users truly need and eliminating what they don’t.</p>
</span></span></div></div><figure class="TextImageRows_media__rfO7h"><div class="ImageEnter_image__FSEP_" data-fill="true"><span class="Image_image__RAAdZ Image_fill__EiIzS"><img data- data-src="images/content-functionality.jpg" alt="" fetchpriority="low" height="1224" width="1224" sizes="auto" class="lazyload"></span></div></figure></div><div class="TextImageRows_row__syXSm"><div class="TextImageRows_text__m8z0M"><h3 class="TextImageRows_heading__0tbTZ"><span class="LineByLine_headingOuter__JmusT"><span>Secure, reliable, and ready for anything</span></span></h3><div class="TextImageRows_text__m8z0M"><span class="FadeIn_container__bjQVL" data-fill="false"><span><p>We don’t just promise excellent design and functionality; we guarantee security and reliability at every turn. In an industry where data protection is paramount, trust us to safeguard your digital assets while maintaining the highest levels of performance and uptime.</p>
</span></span></div></div><figure class="TextImageRows_media__rfO7h"><div class="ImageEnter_image__FSEP_" data-fill="true"><span class="Image_image__RAAdZ Image_fill__EiIzS"><img data- data-src="images/cynozure.jpg" alt="" fetchpriority="low" height="1049" width="1049" sizes="auto" class="lazyload"></span></div></figure></div></div></section><Testimonials testimonials={testimonials} /><section class="LargeCta_largeCta__ylf5C"><div class="DarkThemeSwitch_cover__hn_xc"></div><div class="container"><div class="LargeCta_inner__QmWie"><div class="LargeCta_left__YQVnr"><p class="LargeCta_mainHeading__IirAl"><span class="LineByLine_headingOuter__JmusT"><span>Interested in working with Corum8?</span></span></p></div><div class="LargeCta_right__5bEnD"><span class="FadeIn_container__bjQVL" data-fill="false"><div class="LargeCta_subHeading__Cs6d8"><p>Drop us a line at<br>
<a href="mailto:info@corum8.com">info@corum8.com</a></p>
</div><p class="LargeCta_mainText__6MrpN">We are a global Web3, AI and fintech agency. Dubai, UAE · United States · India — building, marketing and scaling the products that refuse to blend in.</p></span></div></div></div>
</Layout>