---
// Industries — vertical title carousel.
// LEFT: stacked industry titles. The active one is highlighted with
//   a gold rail, white-on-gold treatment, and a thin progress bar
//   underneath that fills as the auto-advance timer ticks.
// RIGHT: content panel that swaps to match — full-bleed image with
//   industry name, blurb, key services, and a CTA. Crossfades on
//   change.
//
// Interaction: auto-advances top→bottom every 6s, restarts on every
// title click, and pauses while the user hovers the panel (so they
// can read a slide they care about). Reduced-motion users get a
// static first slide and the click/keyboard nav still works.

type Industry = {
  num: string;
  name: string;
  tagline: string;
  blurb: string;
  bullets: string[];
  cta: string;
  href: string;
  image: string;
  imageAlt: string;
};

const industries: Industry[] = [
  {
    num: '01',
    name: 'Web3',
    tagline: 'Tokens, exchanges, on-chain infra.',
    blurb: 'We work with the founders building Web3 — from token launches to listed exchanges to live protocols carrying real volume.',
    bullets: [
      'Token launches with live community + Tier-1 PR',
      'CEX & DEX engineering, listings and market-making intros',
      'Wallet, staking and RWA platform development',
    ],
    cta: 'Explore Web3 work',
    href: '/industries/web3',
    image: 'https://images.unsplash.com/photo-1644361566696-3d442b5b482a?w=1600&q=80&auto=format&fit=crop',
    imageAlt: 'Web3 token and on-chain visual',
  },
  {
    num: '02',
    name: 'AI',
    tagline: 'Foundation-model native products.',
    blurb: 'GTM, brand, and engineering for the AI-first companies setting category in 2026 — agents, foundation-model wrappers, and AI-native SaaS.',
    bullets: [
      'Positioning + launch for AI products that need investor narrative',
      'Foundation-model integrations and agent workflows',
      'AI-native SEO, AEO and GEO so the right answer engines surface you',
    ],
    cta: 'Explore AI work',
    href: '/industries/ai',
    image: 'https://images.unsplash.com/photo-1620712943543-bcc4688e7485?w=1600&q=80&auto=format&fit=crop',
    imageAlt: 'Humanoid AI robot',
  },
  {
    num: '03',
    name: 'Fintech',
    tagline: 'Cards, payments, embedded finance.',
    blurb: 'Regulated fintech brands that need both the engineering rigour and the marketing surface to compete with incumbents.',
    bullets: [
      'Card programmes, lending and embedded-finance launches',
      'MiCA / VARA / FCA-aware compliance narrative',
      'Payment infrastructure and on-chain settlement',
    ],
    cta: 'Explore Fintech work',
    href: '/industries/fintech',
    image: 'https://images.unsplash.com/photo-1601597111158-2fceff292cdc?w=1600&q=80&auto=format&fit=crop',
    imageAlt: 'Fintech / digital banking on a phone',
  },
  {
    num: '04',
    name: 'SaaS',
    tagline: 'B2B platforms, vertical SaaS, dev tools.',
    blurb: 'From pre-seed positioning through Series-C scale — full-funnel growth, brand, and dev tooling for B2B platforms shipping into noisy markets.',
    bullets: [
      'Performance media + content engines tuned for SQL pipeline',
      'Marketing site + dashboard product UX',
      'Founder-led PR + thought leadership programmes',
    ],
    cta: 'Explore SaaS work',
    href: '/industries/saas',
    image: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=1600&q=80&auto=format&fit=crop',
    imageAlt: 'Analytics dashboard on a screen',
  },
  {
    num: '05',
    name: 'Enterprise',
    tagline: 'Top-down digital transformation.',
    blurb: 'Brand programmes, internal narrative, and execution muscle for enterprise teams running multi-region, multi-stakeholder rollouts.',
    bullets: [
      'Global brand systems and country-level activation',
      'Internal narrative + change-management programmes',
      'Performance + PR across 30+ markets',
    ],
    cta: 'Explore Enterprise work',
    href: '/industries/enterprise',
    image: 'https://images.unsplash.com/photo-1542744173-8e7e53415bb0?w=1600&q=80&auto=format&fit=crop',
    imageAlt: 'Modern boardroom strategy session',
  },
  {
    num: '06',
    name: 'Robotics',
    tagline: 'Hardware-software, deep-tech.',
    blurb: 'Frontier hardware companies translating engineering proof into investor-ready narrative, channel and brand.',
    bullets: [
      'Hardware launch positioning and investor briefs',
      'Technical content + thought leadership for engineering audiences',
      'Channel and partnership marketing programmes',
    ],
    cta: 'Explore Robotics work',
    href: '/industries/robotics',
    image: 'https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?w=1600&q=80&auto=format&fit=crop',
    imageAlt: 'Robotic arm in a factory',
  },
];
---

<section class="c8-ind">
  <div class="c8-ind__inner">
    <header class="c8-ind__head" data-reveal-stagger="100">
      <p class="c8-ind__eyebrow" data-reveal="up">Industries we serve</p>
      <h2 class="c8-ind__heading" data-reveal="up">
        Built for the categories <span class="c8-ind__heading-accent">that move next.</span>
      </h2>
    </header>

    <div class="c8-ind__panel" data-reveal="up">
      <!-- LEFT — clickable industry titles -->
      <ol class="c8-ind__list" role="tablist" aria-label="Industries">
        {industries.map((i, idx) => (
          <li class="c8-ind__list-item">
            <button
              type="button"
              class={`c8-ind__title${idx === 0 ? ' is-active' : ''}`}
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
              aria-controls={`c8-ind-panel-${idx}`}
              data-ind-index={idx}
            >
              <span class="c8-ind__title-num">{i.num}</span>
              <span class="c8-ind__title-name">{i.name}</span>
              <span class="c8-ind__title-tag">{i.tagline}</span>
              <span class="c8-ind__progress" aria-hidden="true"><span class="c8-ind__progress-bar"></span></span>
            </button>
          </li>
        ))}
      </ol>

      <!-- RIGHT — content panels (only the active one is visible) -->
      <div class="c8-ind__stage" id="c8-ind-stage">
        {industries.map((i, idx) => (
          <article
            class={`c8-ind__slide${idx === 0 ? ' is-active' : ''}`}
            id={`c8-ind-panel-${idx}`}
            role="tabpanel"
            aria-hidden={idx === 0 ? 'false' : 'true'}
          >
            <figure class="c8-ind__media">
              <img src={i.image} alt={i.imageAlt} loading="lazy" />
              <span class="c8-ind__media-veil"></span>
            </figure>
            <div class="c8-ind__body">
              <span class="c8-ind__body-num">{i.num} · {i.tagline}</span>
              <h3 class="c8-ind__body-name">{i.name}</h3>
              <p class="c8-ind__body-blurb">{i.blurb}</p>
              <ul class="c8-ind__body-points">
                {i.bullets.map((b) => (
                  <li>
                    <span class="c8-ind__body-tick" aria-hidden="true">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    </span>
                    {b}
                  </li>
                ))}
              </ul>
              <a class="c8-ind__body-cta" href={i.href}>
                <span>{i.cta}</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
  .c8-ind {
    background: #0a0a0a;
    color: #fff;
    padding: clamp(4.5rem, 9vh, 7rem) clamp(1.5rem, 5vw, 5rem);
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  /* Soft gold corner washes so the dark slab isn't flat. */
  .c8-ind::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(900px circle at 92% 18%, rgba(242,191,34,0.06) 0%, transparent 60%),
      radial-gradient(800px circle at 5% 95%, rgba(242,191,34,0.04) 0%, transparent 60%);
    pointer-events: none;
    z-index: 0;
  }
  .c8-ind__inner {
    position: relative;
    z-index: 1;
    max-width: var(--c8-section-max, 1320px);
    margin: 0 auto;
  }

  .c8-ind__head {
    max-width: 48rem;
    margin: 0 0 clamp(2.5rem, 5vh, 3.5rem);
  }
  .c8-ind__eyebrow {
    margin: 0 0 1rem;
    font-family: var(--montreal);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c8-gold);
  }
  .c8-ind__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.2vw, 3.1rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #fff;
  }
  .c8-ind__heading-accent {
    color: var(--c8-gold-dark);
    font-weight: 400;
  }

  /* ─── Panel: left titles, right stage ─── */
  .c8-ind__panel {
    display: grid;
    grid-template-columns: minmax(220px, 0.85fr) minmax(0, 2.15fr);
    gap: clamp(1.25rem, 2.5vw, 2.5rem);
    align-items: stretch;
  }
  @media (max-width: 900px) {
    .c8-ind__panel {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  /* ── LEFT — title list ── */
  .c8-ind__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .c8-ind__list-item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .c8-ind__title {
    appearance: none;
    width: 100%;
    background: transparent;
    border: 0;
    cursor: pointer;
    text-align: left;
    padding: 1.1rem 0.5rem 1.1rem 1rem;
    color: rgba(255, 255, 255, 0.55);
    font-family: inherit;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 0.85rem;
    align-items: baseline;
    position: relative;
    transition: color 0.4s ease, padding-left 0.4s ease, background 0.4s ease;
  }
  .c8-ind__title::before {
    /* Gold left rail. Hidden by default; expands when active. */
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    background: var(--c8-gold);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .c8-ind__title:hover {
    color: #fff;
    padding-left: 1.4rem;
  }
  .c8-ind__title.is-active {
    color: #fff;
    padding-left: 1.4rem;
  }
  .c8-ind__title.is-active::before { transform: scaleY(1); }

  .c8-ind__title-num {
    grid-column: 1; grid-row: 1 / span 2;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--c8-gold);
    align-self: center;
    opacity: 0.55;
    transition: opacity 0.35s ease;
  }
  .c8-ind__title.is-active .c8-ind__title-num,
  .c8-ind__title:hover .c8-ind__title-num { opacity: 1; }

  .c8-ind__title-name {
    grid-column: 2; grid-row: 1;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.7vw, 1.5rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .c8-ind__title-tag {
    grid-column: 2; grid-row: 2;
    margin-top: 0.3rem;
    font-family: var(--montreal);
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 0.005em;
    /* Collapse the tag on inactive items so the list stays scannable. */
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
                opacity 0.4s ease,
                margin-top 0.4s ease;
  }
  .c8-ind__title.is-active .c8-ind__title-tag {
    max-height: 2rem;
    opacity: 1;
  }

  /* Progress bar — only renders under the active title and fills as
     the auto-advance timer counts down. JS toggles the animation
     restart on each tick. */
  .c8-ind__progress {
    grid-column: 1 / -1;
    grid-row: 3;
    display: block;
    height: 1px;
    margin-top: 0.65rem;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .c8-ind__title.is-active .c8-ind__progress { opacity: 1; }
  .c8-ind__progress-bar {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--c8-gold);
    transform: scaleX(0);
    transform-origin: left;
  }
  .c8-ind__title.is-active .c8-ind__progress-bar {
    animation: c8-ind-progress var(--c8-ind-dur, 6000ms) linear forwards;
  }
  .c8-ind__title.is-paused .c8-ind__progress-bar {
    animation-play-state: paused;
  }
  @keyframes c8-ind-progress {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  /* ── RIGHT — stage ── */
  .c8-ind__stage {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    background: #050505;
    aspect-ratio: 16 / 10;
    min-height: 460px;
    /* Single hairline + soft gold-tinted shadow so the stage reads
       as a slightly raised tile against the dark section, not a
       disconnected dark slab. */
    box-shadow:
      0 30px 60px -28px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(255, 255, 255, 0.06);
  }
  .c8-ind__slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .c8-ind__slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .c8-ind__media {
    position: absolute;
    inset: 0;
    margin: 0;
    overflow: hidden;
  }
  .c8-ind__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 8s ease-out;
  }
  .c8-ind__slide.is-active .c8-ind__media img {
    transform: scale(1.08);
  }
  .c8-ind__media-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      0deg,
      rgba(0,0,0,0.92) 0%,
      rgba(0,0,0,0.6) 30%,
      rgba(0,0,0,0.18) 60%,
      rgba(0,0,0,0.18) 100%
    );
  }

  .c8-ind__body {
    position: relative;
    z-index: 1;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    color: #fff;
    max-width: 36rem;
  }
  .c8-ind__body-num {
    display: inline-block;
    margin: 0 0 0.5rem;
    font-family: var(--montreal);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c8-gold);
  }
  .c8-ind__body-name {
    margin: 0 0 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.025em;
    color: #fff;
  }
  .c8-ind__body-blurb {
    margin: 0 0 0.85rem;
    font-family: var(--montreal);
    font-size: clamp(0.95rem, 1.1vw, 1.05rem);
    line-height: 1.55;
    color: rgba(255,255,255,0.86);
  }
  .c8-ind__body-points {
    list-style: none;
    margin: 0 0 1.2rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .c8-ind__body-points li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-family: var(--montreal);
    font-size: 0.92rem;
    line-height: 1.45;
    color: rgba(255,255,255,0.78);
  }
  .c8-ind__body-tick {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: rgba(242, 191, 34, 0.16);
    color: var(--c8-gold);
    flex: 0 0 auto;
    margin-top: 0.05rem;
  }
  .c8-ind__body-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.35rem;
    border-radius: 999px;
    background: var(--c8-gold);
    color: #111;
    text-decoration: none;
    font-family: var(--montreal);
    font-size: 0.9rem;
    font-weight: 600;
    transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 12px 28px -10px rgba(242, 191, 34, 0.4);
  }
  .c8-ind__body-cta:hover {
    background: #fff;
    color: #111;
    transform: translateY(-2px);
  }

  /* Mobile stack */
  @media (max-width: 900px) {
    .c8-ind__stage { aspect-ratio: 5 / 4; min-height: 380px; }
    .c8-ind__title { padding: 0.9rem 0.5rem 0.9rem 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .c8-ind__title.is-active .c8-ind__progress-bar { animation: none; transform: scaleX(1); }
    .c8-ind__slide { transition: none; }
    .c8-ind__media img { transition: none; transform: none; }
  }
</style>

<script is:inline>
  /* Industries auto-rotating carousel:
       - default 6 second tick
       - click on a title jumps + restarts the timer
       - hover anywhere in the panel pauses (so the user has time
         to actually read the slide), resumes on mouseleave
       - reduced-motion users get a static first slide
  */
  function startIndCarousel() {
    var panel  = document.querySelector('.c8-ind__panel');
    if (!panel) return;
    var titles = panel.querySelectorAll('.c8-ind__title');
    var slides = panel.querySelectorAll('.c8-ind__slide');
    if (!titles.length || titles.length !== slides.length) return;

    var DURATION = 6000;
    var index = 0;
    var timer = null;
    var paused = false;
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function activate(i) {
      index = i;
      for (var n = 0; n < titles.length; n++) {
        var on = (n === i);
        titles[n].classList.toggle('is-active', on);
        titles[n].setAttribute('aria-selected', on ? 'true' : 'false');
        slides[n].classList.toggle('is-active', on);
        slides[n].setAttribute('aria-hidden', on ? 'false' : 'true');
      }
      // Restart progress-bar animation by removing + forcing reflow + readding
      // (we toggle is-active via the loop above, the keyframe restarts on
      // each is-active gain naturally).
    }

    function tick() {
      if (paused) { schedule(); return; }
      var next = (index + 1) % titles.length;
      activate(next);
      schedule();
    }
    function schedule() {
      if (timer) clearTimeout(timer);
      if (reduceMotion) return;
      timer = setTimeout(tick, DURATION);
    }
    function reset() {
      if (timer) clearTimeout(timer);
      schedule();
    }

    panel.style.setProperty('--c8-ind-dur', DURATION + 'ms');

    // Click handlers
    Array.prototype.forEach.call(titles, function (t, i) {
      t.addEventListener('click', function () {
        activate(i);
        reset();
      });
      t.addEventListener('focus', function () {
        // keyboard nav: focusing a title also activates it
        if (document.activeElement === t) activate(i);
        reset();
      });
    });

    // Pause on hover anywhere in the panel so the user can read.
    panel.addEventListener('mouseenter', function () {
      paused = true;
      Array.prototype.forEach.call(titles, function (t) { t.classList.add('is-paused'); });
    });
    panel.addEventListener('mouseleave', function () {
      paused = false;
      Array.prototype.forEach.call(titles, function (t) { t.classList.remove('is-paused'); });
      reset();
    });

    // Initial tick
    schedule();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startIndCarousel, { once: true });
  } else {
    startIndCarousel();
  }
</script>
