<style>
  /* ════════════════════════════════════════════════════════════════════
     Services "screen recording" mockups — realistic app UIs as pure CSS.
     Each card animation mimics a real product screen (dashboard, press
     coverage feed, code editor) so the panel reads like a video loop.
     ════════════════════════════════════════════════════════════════════ */

  .ServiceMedia_mediaContainer__WGgZa {
    background: #0a0a0a;
  }

  .c8-app {
    position: absolute;
    inset: 0;
    background: #0a0a0a;
    color: #eaeaea;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Inter", system-ui, sans-serif;
    font-size: clamp(7px, 0.85vw, 12px);
    letter-spacing: 0.005em;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* macOS-style window chrome */
  .c8-app__chrome {
    height: 11%;
    min-height: 22px;
    background: linear-gradient(to bottom, #202022, #151517);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    display: flex;
    align-items: center;
    padding: 0 10px;
    gap: 6px;
    position: relative;
  }
  .c8-app__chrome--dark {
    background: linear-gradient(to bottom, #1b1f2a, #13151c);
  }
  .c8-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
  .c8-dot--r { background: #ff5f57; }
  .c8-dot--y { background: #febc2e; }
  .c8-dot--g { background: #28c840; }
  .c8-app__url {
    position: absolute; left: 50%; transform: translateX(-50%);
    font-size: 0.8em; color: #8a8a92;
    padding: 3px 12px; background: rgba(255,255,255,0.06); border-radius: 999px;
    letter-spacing: 0.02em;
  }
  .c8-app__tabs {
    display: flex; gap: 2px; margin-left: 16px; align-items: center; height: 100%;
  }
  .c8-tab {
    padding: 4px 10px; font-size: 0.78em; color: #8a8a92;
    border-top-left-radius: 4px; border-top-right-radius: 4px;
  }
  .c8-tab--active {
    background: #0f1318; color: #eaeaea;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
  }

  /* ── Card 1 · Analytics dashboard ────────────────────────────────── */
  .c8-app--dash .c8-app__body {
    flex: 1; display: flex; min-height: 0;
  }
  .c8-app__sidebar {
    width: 9%; min-width: 28px;
    background: #0d0d0f;
    border-right: 1px solid rgba(255,255,255,0.05);
    padding: 8px 0; display: flex; flex-direction: column; align-items: center; gap: 10px;
  }
  .c8-side-item {
    width: 62%; aspect-ratio: 1/1; border-radius: 6px;
    display: flex; align-items: center; justify-content: center;
    color: #5a5a62;
    transition: background 0.3s, color 0.3s;
  }
  .c8-side-item svg { width: 55%; height: 55%; }
  .c8-side-item--active {
    background: rgba(245,158,11,0.12);
    color: #F59E0B;
  }

  .c8-app__main {
    flex: 1; padding: 2% 3%; display: flex; flex-direction: column; gap: 3%;
    min-width: 0;
  }
  .c8-kpi-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3%; }
  .c8-kpi {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 6px;
    padding: 6% 8%;
    display: flex; flex-direction: column; gap: 2px;
    min-width: 0;
  }
  .c8-kpi__lbl { font-size: 0.78em; color: #8a8a92; text-transform: uppercase; letter-spacing: 0.08em; }
  .c8-kpi__val { font-size: 1.3em; font-weight: 600; color: #fff; }
  .c8-kpi__delta { font-size: 0.72em; font-weight: 500; }
  .c8-kpi__delta--up { color: #10B981; }

  .c8-chart {
    flex: 1; min-height: 0; position: relative;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 6px; padding: 4%;
  }
  .c8-chart svg { width: 100%; height: 100%; display: block; }
  .c8-chart__line {
    stroke-dasharray: 900;
    stroke-dashoffset: 900;
    animation: c8-chart-draw 4s ease-out infinite;
  }
  .c8-chart__area { opacity: 0; animation: c8-chart-fade 4s ease-out infinite; }
  .c8-chart__pulse {
    animation: c8-chart-dot 4s ease-out infinite;
    transform-origin: 300px 14px;
  }
  @keyframes c8-chart-draw { 0%{stroke-dashoffset:900} 60%,100%{stroke-dashoffset:0} }
  @keyframes c8-chart-fade { 0%,40%{opacity:0} 75%,100%{opacity:1} }
  @keyframes c8-chart-dot {
    0%,55% { opacity: 0; transform: scale(0.4); }
    65% { opacity: 1; transform: scale(1.2); }
    75%,100% { opacity: 1; transform: scale(1); }
  }

  .c8-rows { display: flex; flex-direction: column; gap: 4px; }
  .c8-row {
    display: grid; grid-template-columns: 18% 1fr 18%;
