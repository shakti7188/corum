---
// Corum8 Premium Bespoke FAQ Redesign
---

<section class="FAQCustom_wrapper" id="faq">
  <div class="FAQCustom_glow"></div>
  <div class="FAQCustom_container">
    
    <div class="FAQCustom_left">
      <div class="FAQCustom_header">
        <h2 class="FAQCustom_title">
          <span class="FAQCustom_titleLight">Your</span><br/>
          <span class="FAQCustom_titleBold">Questions.</span>
        </h2>
        <p class="FAQCustom_subtitle">Uncovering exactly how we scale empires.</p>
      </div>
    </div>

    <div class="FAQCustom_right">
      <div class="FAQCustom_grid">
        <!-- FAQ 1 -->
        <div class="FAQCustom_card">
          <button class="FAQCustom_question">
            <span class="FAQCustom_qText">How much does the average retainer cost?</span>
            <div class="FAQCustom_iconWrap"><span class="FAQCustom_icon"></span></div>
          </button>
          <div class="FAQCustom_answerWrapper">
            <div class="FAQCustom_answerInner">
              <p class="FAQCustom_answer">
                We deal exclusively in high-ticket scaling solutions. Engagements are tailored based strictly on required capital outcomes, usually structured between £30k - £150k dynamically to ensure aggressive growth KPIs are universally tracked.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ 2 -->
        <div class="FAQCustom_card">
          <button class="FAQCustom_question">
            <span class="FAQCustom_qText">How quickly can you transform my brand identity?</span>
            <div class="FAQCustom_iconWrap"><span class="FAQCustom_icon"></span></div>
          </button>
          <div class="FAQCustom_answerWrapper">
            <div class="FAQCustom_answerInner">
              <p class="FAQCustom_answer">
                Velocity is our standard. Our strategic incubation periods run lean, delivering full-stack brand architectures and digital ecosystems in 12-14 weeks, completely disrupting the legacy agency timeline models.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ 3 -->
        <div class="FAQCustom_card">
          <button class="FAQCustom_question">
            <span class="FAQCustom_qText">Do you integrate advanced Web3 and AI infrastructure?</span>
            <div class="FAQCustom_iconWrap"><span class="FAQCustom_icon"></span></div>
          </button>
          <div class="FAQCustom_answerWrapper">
            <div class="FAQCustom_answerInner">
              <p class="FAQCustom_answer">
                Yes. Corum8 is engineered from the ground up to architect high-performance decentralized systems, custom AI agents, and deep blockchain integrations that ordinary web agencies simply cannot execute.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ 4 -->
        <div class="FAQCustom_card">
          <button class="FAQCustom_question">
            <span class="FAQCustom_qText">How does post-launch support work?</span>
            <div class="FAQCustom_iconWrap"><span class="FAQCustom_icon"></span></div>
          </button>
          <div class="FAQCustom_answerWrapper">
            <div class="FAQCustom_answerInner">
              <p class="FAQCustom_answer">
                Post-launch is when the actual scaling begins. We retain dedicated engineering and growth marketing cells on your project to endlessly execute SEO sprints, conversion rate optimizations, and infrastructure scaling iteratively.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  /* 
    CORUM8 BESPOKE FAQ DESIGN
    Features a modern sticky-sidebar split layout, evading all KOTA global generic containers.
  */
  
  .FAQCustom_wrapper {
    position: relative;
    background-color: #000;
    color: #fff;
    padding: 8rem 0;
    overflow: hidden;
  }

  .FAQCustom_glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 60vw;
    height: 60vh;
    background: radial-gradient(circle, rgba(124, 65, 243, 0.15) 0%, rgba(0,0,0,0) 70%);
    transform: translate(-50%, -50%);
    filter: blur(80px);
    z-index: 0;
    pointer-events: none;
  }

  /* Completely custom container isolating the scope from KOTA's grid system */
  .FAQCustom_container {
    position: relative;
    z-index: 10;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 4vw;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  @media (min-width: 768px) {
    .FAQCustom_container {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
    
    .FAQCustom_left {
      flex: 0 0 35%;
      position: sticky;
      top: 25vh; /* Premium sticky scrolling block */
    }

    .FAQCustom_right {
      flex: 0 0 55%;
    }
  }

  .FAQCustom_header {
    margin-bottom: 2rem;
  }

  .FAQCustom_title {
    font-size: clamp(2.5rem, 7.1vw, 7.5rem);
    line-height: 1;
    margin: 0 0 1rem 0;
    letter-spacing: -0.02em;
    font-weight: 400;
    color: #fff;
  }

  .FAQCustom_titleLight,
  .FAQCustom_titleBold {
    font-weight: 400;
    color: #fff;
  }

  .FAQCustom_subtitle {
    font-size: 1.1rem;
    color: #999;
    letter-spacing: 0.1em;
    line-height: 1.6;
    text-transform: uppercase;
    max-width: 80%;
    margin-top: 2rem;
  }

  .FAQCustom_grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  /* Glassmorphic cards */
  .FAQCustom_card {
    background: rgba(25, 25, 25, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 1.5rem;
    backdrop-filter: blur(10px);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    width: 100%;
  }

  .FAQCustom_card:hover {
    background: rgba(40, 40, 40, 0.6);
    border-color: rgba(255, 255, 255, 0.15);
    transform: translateX(4px);
  }

  .FAQCustom_card.is-open {
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(124, 65, 243, 0.4); /* Brand purple highlight */
  }

  .FAQCustom_question {
    display: flex;
    width: 100%;
    background: none;
    border: none;
    color: #fff;
    font-family: inherit;
    text-align: left;
    justify-content: space-between;
    align-items: center;
    padding: 2.5rem 2rem;
    cursor: pointer;
    font-size: clamp(1.2rem, 1.8vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.5px;
    line-height: 1.4;
  }

  .FAQCustom_qText {
    padding-right: 2rem;
  }

  /* Custom animated Icon Logic - BIGGER */
  .FAQCustom_iconWrap {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    position: relative;
    transition: all 0.3s ease;
  }

  .FAQCustom_card:hover .FAQCustom_iconWrap {
    border-color: rgba(255,255,255,0.6);
  }

  .FAQCustom_icon, .FAQCustom_icon::before {
    content: '';
    position: absolute;
    background: #fff;
    width: 20px;
    height: 2.5px;
    border-radius: 2px;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s ease;
  }

  .FAQCustom_icon::before {
    transform: rotate(90deg);
  }

  /* Minus creation when open */
  .FAQCustom_card.is-open .FAQCustom_icon::before {
    transform: rotate(0deg);
  }
  
  .FAQCustom_card.is-open .FAQCustom_iconWrap {
    background: #fff;
    border-color: #fff;
  }
  
  .FAQCustom_card.is-open .FAQCustom_icon,
  .FAQCustom_card.is-open .FAQCustom_icon::before {
    background: #000;
  }

  /* Smooth Grid Accordion Format */
  .FAQCustom_answerWrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .FAQCustom_card.is-open .FAQCustom_answerWrapper {
    grid-template-rows: 1fr;
  }

  .FAQCustom_answerInner {
    overflow: hidden;
  }

  .FAQCustom_answer {
    color: #a1a1aa;
    font-size: 1.15rem;
    line-height: 1.6;
    margin: 0;
    font-weight: 300;
    padding: 0 4rem 2.5rem 2rem;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  
  .FAQCustom_card.is-open .FAQCustom_answer {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.1s;
  }
</style>

<script>
  // Simple Vanilla JS to handle exclusive smooth accordion toggles
  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('.FAQCustom_card');
    
    cards.forEach(card => {
      const button = card.querySelector('.FAQCustom_question');
      if (!button) return;
      
      button.addEventListener('click', () => {
        const isOpen = card.classList.contains('is-open');
        
        // Close all other cards identically to a true accordion
        cards.forEach(c => c.classList.remove('is-open'));
        
        // Open this one if it was closed
        if (!isOpen) {
          card.classList.add('is-open');
        }
      });
    });
  });
</script>
