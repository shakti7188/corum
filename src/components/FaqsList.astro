---
// FAQ — two-pane interactive index.
// LEFT (~40%): a clickable list of every question (numbered, with a
//   gold left rail that fills on the active one).
// RIGHT (~60%): a single large answer panel — big number watermark
//   in the corner, question repeated as the panel header, the answer
//   body, plus a footer with "Still have a question?" + CTA.
//
// Only one question is open at a time. Clicking a question on the
// left swaps the right panel via a fast crossfade. Keyboard arrows
// (Up/Down) cycle through questions when a question is focused.

import { faqs } from '../data/content';
---

<section class="c8-faq">
  <div class="c8-faq__inner">
    <header class="c8-faq__head" data-reveal-stagger="100">
      <div class="c8-faq__head-text">
        <p class="c8-faq__eyebrow" data-reveal="up">Frequently asked</p>
        <h2 class="c8-faq__heading" data-reveal="up">
          Answered honestly. <span class="c8-faq__heading-accent">No procurement-ese.</span>
        </h2>
      </div>
      <div class="c8-faq__progress" aria-hidden="true">
        <span class="c8-faq__progress-count"><span class="c8-faq__progress-current">01</span><span class="c8-faq__progress-sep"> / </span><span class="c8-faq__progress-total">{String(faqs.length).padStart(2, '0')}</span></span>
      </div>
    </header>

    <div class="c8-faq__panel" data-reveal="up">
      <!-- LEFT — questions index -->
      <ol class="c8-faq__list" role="tablist" aria-label="Frequently asked questions">
        {faqs.map((f, i) => (
          <li class="c8-faq__item">
            <button
              type="button"
              class={`c8-faq__q${i === 0 ? ' is-active' : ''}`}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls="c8-faq-stage"
              data-faq-index={i}
            >
              <span class="c8-faq__q-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="c8-faq__q-text">{f.q}</span>
              <span class="c8-faq__q-arrow" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </button>
          </li>
        ))}
      </ol>

      <!-- RIGHT — single answer stage -->
      <div class="c8-faq__stage" id="c8-faq-stage" role="tabpanel" aria-live="polite">
        <span class="c8-faq__stage-watermark" aria-hidden="true">
          <span class="c8-faq__stage-watermark-num">01</span>
        </span>
        <div class="c8-faq__stage-inner">
          <p class="c8-faq__stage-num">Question · <span data-stage-num>01</span></p>
          <h3 class="c8-faq__stage-q" data-stage-q>{faqs[0].q}</h3>
          <p class="c8-faq__stage-a" data-stage-a>{faqs[0].a}</p>
          <footer class="c8-faq__stage-foot">
            <span class="c8-faq__stage-foot-text">Still have a question?</span>
            <a class="c8-faq__stage-foot-cta" href="/contact">
              <span>Book a strategy call</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </footer>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .c8-faq {
    background: #ffffff;
    color: #0a0a0a;
    padding: clamp(4rem, 8vh, 6rem) clamp(1.5rem, 5vw, 5rem);
    border-top: 1px solid rgba(0,0,0,0.05);
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }
  .c8-faq__inner {
    max-width: var(--c8-section-max, 1320px);
    margin: 0 auto;
  }

  /* ─── Head — heading on the left, big counter on the right ─── */
  .c8-faq__head {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: end;
    margin: 0 0 clamp(2rem, 4vh, 2.75rem);
  }
  @media (max-width: 900px) {
    .c8-faq__head { grid-template-columns: 1fr; align-items: start; gap: 1rem; }
  }
  .c8-faq__head-text { max-width: 36rem; }
  .c8-faq__eyebrow {
    margin: 0 0 1rem;
    font-family: var(--montreal);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c8-gold-dark);
  }
  .c8-faq__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.2vw, 3.1rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .c8-faq__heading-accent {
    color: var(--c8-gold-dark);
    font-weight: 400;
  }
  .c8-faq__progress {
    justify-self: end;
    align-self: end;
    font-family: var(--font-display);
    font-size: clamp(0.85rem, 1vw, 0.95rem);
    letter-spacing: 0.18em;
    color: #888;
  }
  .c8-faq__progress-current {
    color: var(--c8-gold-dark);
    font-size: clamp(1.2rem, 1.6vw, 1.5rem);
    font-weight: 400;
  }
  .c8-faq__progress-sep,
  .c8-faq__progress-total { font-weight: 400; }

  /* ─── Panel: 2-col index + stage ─── */
  .c8-faq__panel {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(1.25rem, 2.5vw, 2rem);
    align-items: stretch;
  }
  @media (max-width: 900px) {
    .c8-faq__panel { grid-template-columns: 1fr; gap: 1rem; }
  }

  /* ── LEFT — question list ── */
  .c8-faq__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(0,0,0,0.08);
  }
  .c8-faq__item {
    border-bottom: 1px solid rgba(0,0,0,0.08);
  }
  .c8-faq__q {
    appearance: none;
    width: 100%;
    background: transparent;
    border: 0;
    cursor: pointer;
    text-align: left;
    color: #6b6b6b;
    font-family: inherit;
    padding: 1rem 0.5rem 1rem 1rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    column-gap: 0.85rem;
    align-items: center;
    position: relative;
    transition: color 0.4s ease, padding-left 0.4s ease, background 0.4s ease;
  }
  /* Gold left rail — appears on active. */
  .c8-faq__q::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    background: var(--c8-gold);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .c8-faq__q:hover {
    color: #0a0a0a;
    padding-left: 1.4rem;
  }
  .c8-faq__q.is-active {
    color: #0a0a0a;
    padding-left: 1.4rem;
    background: linear-gradient(90deg, rgba(242, 191, 34, 0.06) 0%, transparent 60%);
  }
  .c8-faq__q.is-active::before { transform: scaleY(1); }

  .c8-faq__q-num {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--c8-gold-dark);
    opacity: 0.65;
    transition: opacity 0.35s ease;
  }
  .c8-faq__q.is-active .c8-faq__q-num,
  .c8-faq__q:hover .c8-faq__q-num { opacity: 1; }

  .c8-faq__q-text {
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 1.05vw, 1.05rem);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .c8-faq__q-arrow {
    display: inline-flex;
    color: #aaa;
    transition: color 0.35s ease, transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .c8-faq__q.is-active .c8-faq__q-arrow,
  .c8-faq__q:hover .c8-faq__q-arrow {
    color: var(--c8-gold-dark);
    transform: translateX(3px);
  }

  /* ── RIGHT — answer stage ── */
  .c8-faq__stage {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    background:
      linear-gradient(135deg, #fafaf6 0%, #f4f4f0 100%);
    border: 1px solid rgba(0, 0, 0, 0.06);
    padding: clamp(1.75rem, 3vw, 2.5rem);
    min-height: 380px;
    isolation: isolate;
  }
  .c8-faq__stage::before {
    /* Soft gold corner glow that anchors the panel visually. */
    content: '';
    position: absolute;
    top: -10%; right: -10%;
    width: 50%; height: 60%;
    background: radial-gradient(ellipse at top right,
      var(--c8-gold-soft) 0%, transparent 65%);
    pointer-events: none;
    z-index: 0;
  }
  .c8-faq__stage-watermark {
    position: absolute;
    top: clamp(0.5rem, 2vh, 1rem);
    right: clamp(1.2rem, 2.5vw, 2rem);
    pointer-events: none;
    z-index: 0;
    line-height: 0.8;
  }
  .c8-faq__stage-watermark-num {
    font-family: var(--font-display);
    font-size: clamp(7rem, 18vw, 14rem);
    font-weight: 400;
    color: rgba(218, 158, 73, 0.08);
    letter-spacing: -0.05em;
    transition: color 0.6s ease;
  }
  .c8-faq__stage-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .c8-faq__stage.is-swapping .c8-faq__stage-inner {
    opacity: 0;
    transform: translateY(8px);
  }
  .c8-faq__stage-num {
    margin: 0;
    font-family: var(--montreal);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c8-gold-dark);
  }
  .c8-faq__stage-q {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #0a0a0a;
    max-width: 42rem;
  }
  .c8-faq__stage-a {
    margin: 0;
    font-family: var(--montreal);
    font-size: clamp(0.95rem, 1.05vw, 1.05rem);
    line-height: 1.65;
    color: #4a4a4a;
    max-width: 50rem;
    flex: 1;
  }
  .c8-faq__stage-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.85rem;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    padding-top: 1rem;
    margin-top: 0.5rem;
  }
  .c8-faq__stage-foot-text {
    font-family: var(--montreal);
    font-size: 0.85rem;
    color: #6b6b6b;
  }
  .c8-faq__stage-foot-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.2rem;
    background: var(--c8-gold);
    color: #111;
    text-decoration: none;
    border-radius: 999px;
    font-family: var(--montreal);
    font-size: 0.88rem;
    font-weight: 600;
    transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 10px 24px -10px rgba(242, 191, 34, 0.45);
  }
  .c8-faq__stage-foot-cta:hover {
    background: #0a0a0a;
    color: var(--c8-gold);
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .c8-faq__stage-inner { transition: none; }
  }
</style>

<script is:inline>
  function startFaqs() {
    var buttons = document.querySelectorAll('.c8-faq__q');
    var stage   = document.getElementById('c8-faq-stage');
    var stageQ  = stage && stage.querySelector('[data-stage-q]');
    var stageA  = stage && stage.querySelector('[data-stage-a]');
    var stageN  = stage && stage.querySelector('[data-stage-num]');
    var watermark = stage && stage.querySelector('.c8-faq__stage-watermark-num');
    var progressCurrent = document.querySelector('.c8-faq__progress-current');
    if (!buttons.length || !stage || !stageQ || !stageA) return;

    // Read FAQ data from the buttons (question text already rendered).
    // Answers were rendered into the first stage on load — we need the
    // full set, so we attach data attributes to each button at boot.
    var data = Array.prototype.map.call(buttons, function (b, i) {
      return {
        num: String(i + 1).padStart(2, '0'),
        q: (b.querySelector('.c8-faq__q-text') || {}).textContent || '',
        // The answer for index 0 is in the stage; later indexes need
        // to be sourced. Astro already injected them as data on the
        // button via b.dataset.faqIndex, but the actual answer text
        // wasn't passed. We'll inline-store answers from a hidden
        // mirror below.
      };
    });

    // Pull answer text from the page-injected hidden mirror.
    var answers = window.__c8FaqAnswers || [];

    function setActive(i) {
      for (var n = 0; n < buttons.length; n++) {
        var on = (n === i);
        buttons[n].classList.toggle('is-active', on);
        buttons[n].setAttribute('aria-selected', on ? 'true' : 'false');
      }
      // Crossfade the stage content out, swap, fade back in.
      stage.classList.add('is-swapping');
      setTimeout(function () {
        stageQ.textContent = data[i].q;
        stageA.textContent = answers[i] || '';
        stageN.textContent = data[i].num;
        if (watermark)        watermark.textContent = data[i].num;
        if (progressCurrent)  progressCurrent.textContent = data[i].num;
        // Allow the next frame to apply before removing the transition class
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            stage.classList.remove('is-swapping');
          });
        });
      }, 220);
    }

    Array.prototype.forEach.call(buttons, function (b, i) {
      b.addEventListener('click', function () { setActive(i); });
      b.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
          e.preventDefault();
          var next = (i + 1) % buttons.length;
          buttons[next].focus();
          setActive(next);
        } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
          e.preventDefault();
          var prev = (i - 1 + buttons.length) % buttons.length;
          buttons[prev].focus();
          setActive(prev);
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startFaqs, { once: true });
  } else {
    startFaqs();
  }
</script>

<!-- Answers are written into a global so the swap script has access
     to all of them without re-reading the FAQ data file at runtime.
     This is a build-time inline of the same `faqs` import the
     component uses, so the strings stay in sync. -->
<script is:inline define:vars={{ faqAnswers: faqs.map((f) => f.a) }}>
  window.__c8FaqAnswers = faqAnswers;
</script>
