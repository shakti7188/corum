---
// Service-panel reels — original KOTA homepage videos, pulled locally from
// kota-content.b-cdn.net/app/uploads/2024/02/ so they deploy with the site
// instead of hot-linking the CDN. Trimmed to 3s apiece to stay on-page-weight.
// Panel order follows the original homepage mapping:
//   homepage.mp4   → panel 1 (was "Web design & development", now Marketing)
//   homepage-1.mp4 → panel 2 (was "Branding", now PR & Branding)
//   homepage-3.mp4 → panel 3 (was "Digital Marketing", now Development)
const cardVideos = {
  marketing:   '/media/homepage.mp4',
  pr:          '/media/homepage-1.mp4',
  development: '/media/homepage-3.mp4',
};
