    <div class="s-disc-card reveal-stagger">
      <div class="s-disc-card__img">
        <img src="https://images.unsplash.com/photo-1504868584819-f8e8b4b6d7e3?w=600&q=80&auto=format&fit=crop" alt="Technical audit" />
        <span class="s-disc-card__num">01</span>
