---
import Layout from "../layouts/Layout.astro";
import KotaverseCta from "../components/KotaverseCta.astro";

const posts = [
  {
    slug: "#",
    title: "Why exchange-listing is a relationship, not a form",
    excerpt: "The half-page CMC application is not the listing process. It's the last visible 10%. Here's what tier-1 exchanges actually want to see six months before you apply.",
    date: "2026-04-12",
    category: "Token & Listings",
    minutes: 6,
  },
  {
    slug: "#",
    title: "Post-MiCA, what changes for custody builds",
    excerpt: "MiCA took effect December 2024. Most custody teams still build as if it hasn't. What actually shifts in your architecture document — and what doesn't.",
    date: "2026-04-05",
    category: "Compliance",
    minutes: 8,
  },
  {
    slug: "#",
    title: "AI launches that cut through the me-too wall",
    excerpt: "Every AI product launch now looks the same. Dark background, glowing gradient, LLM demo. Three things that actually get tier-1 coverage when everyone's drowning in the same visual kit.",
    date: "2026-03-28",
    category: "AI Go-to-market",
    minutes: 5,
  },
  {
    slug: "#",
    title: "SEO is dead; AEO is the conversation",
    excerpt: "ChatGPT, Perplexity and Gemini now sit between your audience and your website. Ranking #1 is obsolete. Getting cited verbatim by the LLM summary box is the new top-of-funnel.",
    date: "2026-03-20",
    category: "SEO & AEO",
    minutes: 7,
  },
  {
    slug: "#",
    title: "Why most DeFi bugs aren't in the math",
    excerpt: "Audit findings rarely cite the AMM formula. They cite the glue — access control, upgrade paths, price oracles, rebasing mechanics. Here's where to look first.",
    date: "2026-03-14",
    category: "DeFi Engineering",
    minutes: 9,
  },
  {
    slug: "#",
    title: "Community building when the airdrop farmers leave",
    excerpt: "The hard part of community isn't launch. It's the six quiet months after. What programmes retain the 5% of community who'll still be there in 18 months.",
    date: "2026-03-07",
    category: "Community",
    minutes: 6,
  },
];

function fmt(d) {
  const dt = new Date(d);
  return dt.toLocaleDateString("en-GB", { month: "short", day: "numeric", year: "numeric" });
}
---
<Layout title="Blog | Corum8">

<section class="Hero_hero__zbooM"><div class="container"><div class="Hero_top__UZ6SA"><h2><span class="LineByLine_headingOuter__JmusT"><span>Short posts. Written by the people who did the work.</span></span></h2></div><div class="Hero_bottom__pLxrT"><h1><span class="MaskInUp_container__0AW5i" data-fill="false"><div><span><i></i>Blog</span></div></span></h1><div class="Hero_arrow__WTdEi"><span class="FadeInRotate_container__QE9u9" data-fill="false" data-direction="counterclockwise"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 75.91 75.65"><path d="m13.65 67.65 61.93-62L69.92 0 8 61.99V.25H0v75.4h75.91v-8H13.65z" style="stroke-width:0"></path></svg></span></div></div></div></section>

<section class="c8-blog">
  <div class="container">
    <div class="c8-blog__grid">
      {posts.map((p) => (
        <article class="c8-post">
          <div class="c8-post__meta">
            <span class="c8-post__category">{p.category}</span>
            <span class="c8-post__read">{p.minutes} min read</span>
          </div>
          <h3 class="c8-post__title"><a href={p.slug}>{p.title}</a></h3>
          <p class="c8-post__excerpt">{p.excerpt}</p>
          <div class="c8-post__foot">
            <time class="c8-post__date">{fmt(p.date)}</time>
            <a class="c8-post__cta" href={p.slug}>
              Read
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 17.1 15.17" width="14">
                <path d="m17.1,7.58s-.01-.04-.01-.06c.01-.22-.06-.45-.24-.61L9.23.19c-.31-.27-.78-.24-1.06.07-.27.31-.24.78.07,1.06l6.26,5.52H.75c-.41,0-.75.34-.75.75s.34.75.75.75h13.74l-6.26,5.52c-.31.27-.34.75-.07,1.06.15.17.35.25.56.25.18,0,.35-.06.5-.19l7.62-6.72c.18-.16.25-.39.24-.61,0-.02.01-.04.01-.06Z" fill="currentColor"></path>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<KotaverseCta
  light="Want to work"
  bold="with this team?"
  subtitle="The people writing these posts are the ones who'd ship your project."
/>

<style>
  .c8-blog {
    padding: clamp(4rem, 8vw, 8rem) 0;
    background: #fafafa;
  }
  .c8-blog__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
    max-width: 1400px;
    margin: 0 auto;
  }
  .c8-post {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2.25rem;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 1.25rem;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .c8-post:hover {
    transform: translateY(-4px);
    box-shadow: 0 28px 50px -24px rgba(0, 0, 0, 0.18);
  }
  .c8-post__meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #888;
  }
  .c8-post__title {
    font-size: 1.35rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .c8-post__title a {
    color: #111;
    text-decoration: none;
  }
  .c8-post__title a:hover {
    color: var(--c8-gold);
  }
  .c8-post__excerpt {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #444;
    margin: 0;
  }
  .c8-post__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }
  .c8-post__date {
    font-size: 0.8rem;
    color: #888;
  }
  .c8-post__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: #111;
    text-decoration: none;
  }
  .c8-post:hover .c8-post__cta svg {
    transform: translateX(4px);
  }
  .c8-post__cta svg {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
</style>

</Layout>
