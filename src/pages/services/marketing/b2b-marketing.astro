.b2-chan-card__more-cta{display:inline-flex;font-size:.82rem;font-weight:700;color:#f2bf22;text-decoration:none;border-bottom:1px solid rgba(242,191,34,.4);padding-bottom:.15rem;}

/* CASE */
.b2-case{background:#0f0f0f;padding:clamp(4rem,8vh,6rem) 2rem;position:relative;overflow:hidden;}
.b2-case__bg{position:absolute;inset:0;z-index:0;}
.b2-case__bg img{width:100%;height:100%;object-fit:cover;opacity:.13;}
.b2-case__overlay{position:absolute;inset:0;background:linear-gradient(135deg,rgba(15,15,15,.95) 40%,rgba(15,15,15,.7));}
.b2-case__inner{position:relative;z-index:1;max-width:860px;margin:0 auto;}
.b2-case__tag{display:inline-block;font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#f2bf22;background:rgba(242,191,34,.15);padding:.3rem .9rem;border-radius:100px;margin-bottom:1.5rem;}
.b2-case__h2{font-size:clamp(1.8rem,3.5vw,2.8rem);font-weight:800;line-height:1.2;letter-spacing:-.03em;color:#fff;margin-bottom:1.5rem;}
