  { target: 12, prefix: '', suffix: '+', label: 'Years building Web3 infrastructure — through three full cycles',
    spark: 'bars' },
  { target: 200, prefix: '', suffix: '+', label: 'Engineers in our network — Solidity, Rust, Go, TypeScript, ML',
    spark: 'M0 24 L18 20 L36 16 L54 14 L72 10 L90 6 L100 4' },
  { target: 50, prefix: '', suffix: '+', label: 'Chains shipped to in production — EVM, non-EVM, modular rollups',
    spark: 'globe' },
];

const phases = [
  {
    key: 'architecture',
    label: 'Architecture',
