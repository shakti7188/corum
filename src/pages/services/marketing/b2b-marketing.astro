.b2-case__metrics{display:flex;flex-wrap:wrap;gap:2rem;padding:2rem;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:18px;margin-bottom:2.5rem;}
.b2-case__metrics div span{display:block;font-size:2rem;font-weight:800;color:#f2bf22;line-height:1;}
.b2-case__metrics div small{font-size:.75rem;color:rgba(255,255,255,.4);}

/* TESTIMONIALS */
.b2-testi{padding:clamp(4rem,8vh,6rem) 2rem;background:#f4f4f0;}
.b2-testi-grid{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.5rem;}
.b2-testi-card{background:#fff;border:1px solid rgba(0,0,0,.07);border-radius:24px;padding:2rem;box-shadow:0 10px 40px -12px rgba(0,0,0,.08);transition:transform .3s,box-shadow .3s;}
.b2-testi-card:hover{transform:translateY(-4px);box-shadow:0 20px 60px -15px rgba(0,0,0,.12);}
.b2-testi-img{width:56px;height:56px;border-radius:50%;overflow:hidden;margin-bottom:1rem;border:2px solid rgba(242,191,34,.3);}
.b2-stars{color:#f59e0b;font-size:.9rem;letter-spacing:.05em;margin-bottom:1rem;}
.b2-testi-card blockquote{font-size:.88rem;line-height:1.7;color:#444;font-style:italic;margin-bottom:1.2rem;}
.b2-testi-name{font-size:.88rem;font-weight:700;color:#0f0f0f;}
.b2-testi-role{font-size:.75rem;color:#999;margin-top:.15rem;}

/* FAQ */
.b2-faq{padding:clamp(4rem,8vh,6rem) 2rem;background:#fff;border-top:1px solid rgba(0,0,0,.06);}
.b2-faq-list{max-width:760px;margin:0 auto;}
.b2-faq-item{border-bottom:1px solid rgba(0,0,0,.07);}
.b2-faq-item:first-child{border-top:1px solid rgba(0,0,0,.07);}
.b2-faq-q{width:100%;text-align:left;padding:1.3rem 0;background:none;border:none;cursor:pointer;font-size:.95rem;font-weight:700;color:#0f0f0f;display:flex;align-items:center;justify-content:space-between;gap:1rem;font-family:inherit;transition:color .2s;}
.b2-faq-q:hover,.b2-faq-q[aria-expanded="true"]{color:#f2bf22;}
.b2-chevron{flex-shrink:0;width:22px;height:22px;border:1.5px solid currentColor;border-radius:50%;position:relative;transition:transform .3s;}
.b2-chevron::before,.b2-chevron::after{content:'';position:absolute;top:50%;left:50%;width:7px;height:1.5px;background:currentColor;border-radius:2px;}
.b2-chevron::before{transform:translate(-50%,-50%) rotate(-45deg) translateX(2px);}
.b2-chevron::after{transform:translate(-50%,-50%) rotate(45deg) translateX(-2px);}
.b2-faq-q[aria-expanded="true"] .b2-chevron{transform:rotate(180deg);}
.b2-faq-a{max-height:0;overflow:hidden;opacity:0;font-size:.9rem;line-height:1.75;color:#555;transition:max-height .4s cubic-bezier(.16,1,.3,1),opacity .3s;}
.b2-faq-item.open .b2-faq-a{padding-bottom:1.4rem;}

/* CTA */
.b2-cta{background:#0f0f0f;padding:clamp(5rem,10vh,8rem) 2rem;text-align:center;position:relative;overflow:hidden;}
.b2-cta__bg{position:absolute;inset:0;z-index:0;}
.b2-cta__bg img{width:100%;height:100%;object-fit:cover;opacity:.1;}
