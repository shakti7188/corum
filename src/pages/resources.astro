---
import Layout from "../layouts/Layout.astro";
import KotaverseCta from "../components/KotaverseCta.astro";

const arrowGrad = {
  id: 'res',
  stops: [
    { offset: '0', color: '#7c41f3' },
    { offset: '1', color: '#ff6eff' },
  ],
};

const projects = [
  {
    href: '/case-studies',
    name: 'Case studies',
    year: 'Outcomes',
    heading: 'Six engagements across exchanges, token launches, community programmes and performance networks — with the numbers.',
    tags: ['Exchanges', 'Token Launches', 'Community', 'Performance'],
    poster: '/images/upp-featured-mobile.jpg',
  },
  {
    href: '/gallery',
    name: 'Gallery',
    year: 'Visuals',
    heading: 'Identity systems, pitch decks, motion graphics and product shipments — the visual work side by side.',
    tags: ['Identity', 'Motion', 'Decks', 'Product'],
    poster: '/images/Featured.png',
  },
  {
    href: '/blog',
    name: 'Blog',
    year: 'Weekly',
    heading: 'Short posts on launches, market movements, and the engineering decisions behind the campaigns we run.',
    tags: ['Launches', 'Engineering', 'Growth'],
    poster: '/images/bento3.jpg',
  },
  {
    href: '/insights',
    name: 'Insights',
    year: 'Quarterly',
    heading: 'Long-form analysis on Web3, AI and fintech — written by the people who shipped the product, not the marketing team.',
    tags: ['Research', 'Web3', 'AI', 'Fintech'],
    poster: '/images/bento1-1.jpg',
  },
  {
    href: '/guides',
    name: 'Guides',
    year: 'How-to',
    heading: 'Step-by-step playbooks: token launches, exchange listings, post-MiCA compliance, AI product GTM. Written to be used.',
    tags: ['Token Launch', 'Listings', 'Compliance', 'GTM'],
    poster: '/images/bento4-1.jpg',
  },
];
---
<Layout title="Resources | Corum8">
<div data-theme="light">
<section class="Hero_hero__Oyf4n"><div class="container"><div class="Hero_top__RRkYH"><h2><span class="LineByLine_headingOuter__JmusT"><span>Everything we've learned shipping 1,100+ launches. Written up.</span></span></h2><figure class="crosshair" aria-hidden="true"><span class="FadeInRotate_container__QE9u9" data-fill="true" data-direction="clockwise"><span class="inner"></span></span></figure><div class="Hero_video__rzcbe"><span class="ScaleFadeIn_container__cK78G" data-fill="true"><span class="ScaleFadeIn_inner__y4reT" data-fill="true"><video src="/media/bg2.mp4" class="Hero_video__rzcbe" autoplay muted loop playsinline></video></span></span></div></div><div class="Hero_bottom__ktiOH"><h1><span class="MaskInUp_container__0AW5i" data-fill="false"><div><span><i></i>Resources</span></div></span></h1><h3 class="Hero_introText__oP34v"><span class="FadeIn_container__bjQVL" data-fill="false"><span>Case studies with numbers. Long-form analysis on the categories we work in. Step-by-step playbooks for the launches we run.</span></span></h3><div class="Hero_arrow__lxSeM"><span class="FadeInRotate_container__QE9u9" data-fill="false" data-direction="counterclockwise"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 75.91 75.65"><path d="m13.65 67.65 61.93-62L69.92 0 8 61.99V.25H0v75.4h75.91v-8H13.65z"></path></svg></span></div></div></div></section>

<div class="Work_work__rSI8c">
  <div class="DarkThemeSwitch_cover__hn_xc"></div>
  <div class="Work_projects__A5q77">
    <div class="AnimatedGrid_grid__otAMD">
      <div class="container">
        {projects.map((p) => (
          <a class="ProjectCard_project__d1wbY ProjectCard_small__xsL92" data-animation="grid-item" href={p.href}>
            <div class="ProjectCard_projectText__o770X">
              <h3>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14.78 14.78">
                  <defs>
                    <linearGradient id={arrowGrad.id} x1="3.54" x2="13.98" y1="3.54" y2="13.99" gradientUnits="userSpaceOnUse">
                      {arrowGrad.stops.map((s) => <stop offset={s.offset} stop-color={s.color}></stop>)}
                    </linearGradient>
                  </defs>
                  <path fill={`url(#${arrowGrad.id})`} stroke-width="0" d="M13.25 12.18L13.25 0.23 14.78 0.23 14.78 14.76 14.74 14.76 14.74 14.78 0.21 14.78 0.21 13.25 12.18 13.25 0 1.08 1.08 0 13.25 12.18z"></path>
                </svg>{p.name}
              </h3>
              <p>{p.year}</p>
            </div>
            <div class="ProjectCard_projectImage__Nfx9I">
              <div class="ProjectCard_imageOverlay__OCawr">
                <p class="ProjectCard_heading__1csIW">{p.heading}</p>
                <ul class="ProjectCard_tags__XdVcf">
                  {p.tags.map((t) => <li>{t}</li>)}
                </ul>
              </div>
              <span class="Image_image__RAAdZ Image_fill__EiIzS"><img src={p.poster} alt="" fetchpriority="low" loading="lazy" /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</div>

<KotaverseCta
  light="More specific"
  bold="question in mind?"
  subtitle="Skip the reading. Book a call and we'll walk you through it."
/>
</div>
</Layout>
