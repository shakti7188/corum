];
---

<section class="c8-ind">
  <div class="c8-ind__inner">
    <header class="c8-ind__head" data-reveal-stagger="100">
      <p class="c8-ind__eyebrow" data-reveal="up">Industries we serve</p>
      <h2 class="c8-ind__heading" data-reveal="up">
        Built for the categories <span class="c8-ind__heading-accent">that move next.</span>
      </h2>
    </header>

    <div class="c8-ind__panel" data-reveal="up">
      <!-- LEFT — clickable industry titles -->
      <ol class="c8-ind__list" role="tablist" aria-label="Industries">
        {industries.map((i, idx) => (
          <li class="c8-ind__list-item">
            <button
              type="button"
              class={`c8-ind__title${idx === 0 ? ' is-active' : ''}`}
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
              aria-controls={`c8-ind-panel-${idx}`}
              data-ind-index={idx}
            >
              <span class="c8-ind__title-name">{i.name}</span>
              <span class="c8-ind__title-tag">{i.tagline}</span>
              <span class="c8-ind__progress" aria-hidden="true"><span class="c8-ind__progress-bar"></span></span>
            </button>
          </li>
        ))}
      </ol>

      <!-- RIGHT — photo collage stage per industry -->
      <div class="c8-ind__stage" id="c8-ind-stage">
        {industries.map((i, idx) => (
          <article
            class={`c8-ind__slide${idx === 0 ? ' is-active' : ''}`}
            id={`c8-ind-panel-${idx}`}
            role="tabpanel"
            aria-hidden={idx === 0 ? 'false' : 'true'}
            style={`--ind-accent: ${i.accent};`}
          >
            <div class="c8-ind__scene" aria-hidden="true">
              <div class="c8-ind__plate"></div>
              {i.images.map((img, ix) => (
                <figure class={`ind-photo ind-photo--${ix}`}>
                  <img src={img.src} alt={img.alt} loading="lazy" />
                </figure>
              ))}
            </div>

            <div class="c8-ind__body">
              <span class="c8-ind__body-num">{i.tagline}</span>
              <h3 class="c8-ind__body-name">{i.name}</h3>
              <p class="c8-ind__body-blurb">{i.blurb}</p>
              <ul class="c8-ind__body-points">
                {i.bullets.map((b) => (
                  <li>
                    <span class="c8-ind__body-tick" aria-hidden="true">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    </span>
                    {b}
                  </li>
                ))}
              </ul>
              <a class="c8-ind__body-cta" href={i.href}>
                <span>{i.cta}</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
  .c8-ind {
    background: #0a0a0a;
    color: #fff;
    padding: clamp(4.5rem, 9vh, 7rem) clamp(1.5rem, 5vw, 5rem);
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .c8-ind::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(900px circle at 92% 18%, rgba(242,191,34,0.06) 0%, transparent 60%),
      radial-gradient(800px circle at 5% 95%, rgba(242,191,34,0.04) 0%, transparent 60%);
    pointer-events: none;
    z-index: 0;
  }
  .c8-ind__inner {
    position: relative;
    z-index: 1;
    max-width: var(--c8-section-max, 1320px);
    margin: 0 auto;
  }

  .c8-ind__head {
    max-width: 48rem;
    margin: 0 0 clamp(2.5rem, 5vh, 3.5rem);
  }
  .c8-ind__eyebrow {
    margin: 0 0 1rem;
    font-family: var(--montreal);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c8-gold);
  }
  .c8-ind__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.2vw, 3.1rem);
    font-weight: 350;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #fff;
  }
  .c8-ind__heading-accent {
    color: var(--c8-gold-dark);
    font-weight: 350;
  }

  /* ─── Panel: left titles, right stage ─── */
  .c8-ind__panel {
    display: grid;
    grid-template-columns: minmax(220px, 0.85fr) minmax(0, 2.15fr);
    gap: clamp(1.25rem, 2.5vw, 2.5rem);
    align-items: stretch;
  }
  @media (max-width: 900px) {
    .c8-ind__panel {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  /* ── LEFT — title list ── */
  .c8-ind__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .c8-ind__list-item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .c8-ind__title {
    appearance: none;
    width: 100%;
    background: transparent;
    border: 0;
    cursor: pointer;
    text-align: left;
    padding: 1.1rem 0.5rem 1.1rem 1rem;
    color: rgba(255, 255, 255, 0.55);
    font-family: inherit;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 0.85rem;
    align-items: baseline;
    position: relative;
    transition: color 0.4s ease, padding-left 0.4s ease, background 0.4s ease;
  }
  .c8-ind__title::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    background: var(--c8-gold);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .c8-ind__title:hover { color: #fff; padding-left: 1.4rem; }
  .c8-ind__title.is-active { color: #fff; padding-left: 1.4rem; }
  .c8-ind__title.is-active::before { transform: scaleY(1); }

  .c8-ind__title-num {
    grid-column: 1; grid-row: 1 / span 2;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--c8-gold);
    align-self: center;
    opacity: 0.55;
    transition: opacity 0.35s ease;
  }
  .c8-ind__title.is-active .c8-ind__title-num,
  .c8-ind__title:hover .c8-ind__title-num { opacity: 1; }

  .c8-ind__title-name {
    grid-column: 2; grid-row: 1;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.7vw, 1.5rem);
    font-weight: 350;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .c8-ind__title-tag {
    grid-column: 2; grid-row: 2;
    margin-top: 0.3rem;
    font-family: var(--montreal);
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 0.005em;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
                opacity 0.4s ease,
                margin-top 0.4s ease;
  }
  .c8-ind__title.is-active .c8-ind__title-tag {
    max-height: 2rem;
    opacity: 1;
  }

  .c8-ind__progress {
    grid-column: 1 / -1;
    grid-row: 3;
    display: block;
    height: 1px;
    margin-top: 0.65rem;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .c8-ind__title.is-active .c8-ind__progress { opacity: 1; }
  .c8-ind__progress-bar {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--c8-gold);
    transform: scaleX(0);
    transform-origin: left;
  }
  .c8-ind__title.is-active .c8-ind__progress-bar {
    animation: c8-ind-progress var(--c8-ind-dur, 6000ms) linear forwards;
  }
  .c8-ind__title.is-paused .c8-ind__progress-bar { animation-play-state: paused; }
  @keyframes c8-ind-progress {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  /* ── RIGHT — stage ──
     All slides share a single grid cell so the stage auto-sizes to
     the tallest slide's content (no fixed min-height needed and the
     CTA at the bottom of the body never gets clipped). Active slide
     fades to opacity 1; the rest stay at 0 but still occupy layout
     so the cell measures correctly. */
  .c8-ind__stage {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    background: linear-gradient(180deg, #0e0e0e 0%, #050505 100%);
    display: grid;
    grid-template-columns: 1fr;
    box-shadow:
      0 30px 60px -28px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(255, 255, 255, 0.06);
  }
  .c8-ind__slide {
    grid-column: 1 / 2;
    grid-row: 1 / 2;
    display: flex;
    flex-direction: column;
    width: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .c8-ind__slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .c8-ind__scene {
    position: relative;
    flex: 1 1 auto;
    min-height: 320px;
  }
  .c8-ind__plate {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at center, rgba(255,255,255,0.05) 1px, transparent 1.5px);
    background-size: 24px 24px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, #000 35%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, #000 35%, transparent 80%);
    opacity: 0.7;
  }
  .c8-ind__slide::before {
    content: '';
    position: absolute;
    top: 25%;
    right: 12%;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--ind-accent) 0%, transparent 65%);
    opacity: 0.18;
    pointer-events: none;
    filter: blur(28px);
  }

  /* ── Photo collage cards ── */
  .ind-photo {
    position: absolute;
    margin: 0;
    border-radius: 14px;
    overflow: hidden;
    box-shadow:
      0 26px 54px -22px rgba(0,0,0,0.7),
      0 0 0 1px rgba(255,255,255,0.06);
    background: #111;
    will-change: transform;
  }
  .ind-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 8s ease-out;
  }
  .c8-ind__slide.is-active .ind-photo img {
    transform: scale(1.05);
  }

  /* Three positions per stage. Each photo floats independently with
     a different delay + duration so the collage feels alive. */
  .ind-photo--0 {
    top: 8%;
    left: 4%;
    width: 38%;
    aspect-ratio: 4 / 3;
    transform: rotate(-1.5deg);
    animation: ind-float-a 7.5s ease-in-out infinite;
  }
  .ind-photo--1 {
    top: 14%;
    right: 6%;
    width: 36%;
    aspect-ratio: 5 / 4;
    transform: rotate(1.8deg);
    z-index: 2;
    animation: ind-float-b 9s ease-in-out infinite;
    animation-delay: -2.5s;
  }
  .ind-photo--2 {
    bottom: 8%;
    left: 28%;
    width: 36%;
    aspect-ratio: 16 / 10;
    transform: rotate(-0.8deg);
    z-index: 3;
    animation: ind-float-c 10.5s ease-in-out infinite;
    animation-delay: -5s;
  }

  /* Three differently-shaped float cycles so the photos never lock-step. */
  @keyframes ind-float-a {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(-1.5deg); }
    50%      { transform: translate3d(6px, -10px, 0) rotate(-0.6deg); }
  }
  @keyframes ind-float-b {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(1.8deg); }
    50%      { transform: translate3d(-8px, 8px, 0) rotate(0.6deg); }
  }
  @keyframes ind-float-c {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(-0.8deg); }
    50%      { transform: translate3d(4px, -7px, 0) rotate(0.4deg); }
  }

  /* Reveal animation as a slide enters */
  .c8-ind__slide.is-active .ind-photo {
    animation-play-state: running;
  }
  .c8-ind__slide:not(.is-active) .ind-photo {
    animation-play-state: paused;
  }

  @media (max-width: 1100px) {
    .ind-photo--0 { width: 44%; }
    .ind-photo--1 { width: 42%; }
    .ind-photo--2 { width: 42%; left: 25%; }
  }

  /* ── Body ── */
  .c8-ind__body {
    position: relative;
    z-index: 1;
    padding: clamp(1.25rem, 2.3vw, 1.85rem) clamp(1.5rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 2.5rem);
    color: #fff;
    background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.45) 100%);
    border-top: 1px solid rgba(255,255,255,0.06);
    flex: 0 0 auto;
  }
  .c8-ind__body-num {
    display: inline-block;
    margin: 0 0 0.4rem;
    font-family: var(--montreal);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c8-gold);
  }
  .c8-ind__body-name {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    font-weight: 350;
    line-height: 1;
    letter-spacing: -0.025em;
    color: #fff;
  }
  .c8-ind__body-blurb {
    margin: 0 0 0.85rem;
    font-family: var(--montreal);
    font-size: clamp(0.92rem, 1.05vw, 1rem);
    line-height: 1.55;
    color: rgba(255,255,255,0.82);
    max-width: 38rem;
  }
  .c8-ind__body-points {
    list-style: none;
    margin: 0 0 1.1rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.45rem 1.4rem;
  }
  .c8-ind__body-points li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-family: var(--montreal);
    font-size: 0.86rem;
    line-height: 1.4;
    color: rgba(255,255,255,0.78);
  }
  .c8-ind__body-tick {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: rgba(242, 191, 34, 0.16);
    color: var(--c8-gold);
    flex: 0 0 auto;
    margin-top: 0.05rem;
  }
  .c8-ind__body-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border-radius: 999px;
    background: var(--c8-gold);
    color: #111;
    text-decoration: none;
    font-family: var(--montreal);
    font-size: 0.88rem;
    font-weight: 600;
    transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 12px 28px -10px rgba(242, 191, 34, 0.4);
  }
  .c8-ind__body-cta:hover {
    background: #fff;
    color: #111;
    transform: translateY(-2px);
  }

  @media (max-width: 900px) {
    .c8-ind__stage { min-height: 660px; }
    .c8-ind__title { padding: 0.9rem 0.5rem 0.9rem 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .c8-ind__title.is-active .c8-ind__progress-bar { animation: none; transform: scaleX(1); }
    .c8-ind__slide { transition: none; }
    .ind-photo { animation: none !important; }
  }
</style>

<script is:inline>
  function startIndCarousel() {
    var panel  = document.querySelector('.c8-ind__panel');
    if (!panel) return;
    var titles = panel.querySelectorAll('.c8-ind__title');
    var slides = panel.querySelectorAll('.c8-ind__slide');
    if (!titles.length || titles.length !== slides.length) return;

    var DURATION = 6000;
    var index = 0;
    var timer = null;
    var paused = false;
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function activate(i) {
      index = i;
      for (var n = 0; n < titles.length; n++) {
        var on = (n === i);
        titles[n].classList.toggle('is-active', on);
        titles[n].setAttribute('aria-selected', on ? 'true' : 'false');
        slides[n].classList.toggle('is-active', on);
        slides[n].setAttribute('aria-hidden', on ? 'false' : 'true');
      }
    }

    function tick() {
      if (paused) { schedule(); return; }
      var next = (index + 1) % titles.length;
      activate(next);
      schedule();
    }
    function schedule() {
      if (timer) clearTimeout(timer);
      if (reduceMotion) return;
      timer = setTimeout(tick, DURATION);
    }
    function reset() {
      if (timer) clearTimeout(timer);
      schedule();
    }

    panel.style.setProperty('--c8-ind-dur', DURATION + 'ms');

    Array.prototype.forEach.call(titles, function (t, i) {
      t.addEventListener('click', function () { activate(i); reset(); });
      t.addEventListener('focus', function () {
        if (document.activeElement === t) activate(i);
        reset();
      });
    });

    panel.addEventListener('mouseenter', function () {
      paused = true;
      Array.prototype.forEach.call(titles, function (t) { t.classList.add('is-paused'); });
    });
    panel.addEventListener('mouseleave', function () {
      paused = false;
      Array.prototype.forEach.call(titles, function (t) { t.classList.remove('is-paused'); });
      reset();
    });

    schedule();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startIndCarousel, { once: true });
  } else {
    startIndCarousel();
  }
</script>
