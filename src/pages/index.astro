---
import "../styles/global.css";

import Navigation      from '../components/Navigation.astro';
import Header          from '../components/Header.astro';
import Footer          from '../components/Footer.astro';
import Preloader       from '../components/Preloader.astro';

import Hero              from '../components/Hero.astro';
import PressLogos        from '../components/PressLogos.astro';
// import ClientLogosAlt    from '../components/ClientLogosAlt.astro'; // Hidden per user request
import Services          from '../components/Services.astro';
import InfluencerReach   from '../components/InfluencerReach.astro';
import PrAuthority       from '../components/PrAuthority.astro';
import Awards            from '../components/Awards.astro';
import Work              from '../components/Work.astro';
import ProcessHorizontal from '../components/ProcessHorizontal.astro';
import Testimonials      from '../components/Testimonials.astro';
import Industries        from '../components/Industries.astro';
import FaqsList          from '../components/FaqsList.astro';
import FinalCta          from '../components/FinalCta.astro';

import WhatsAppButton  from '../components/WhatsAppButton.astro';
import ScrollReveal    from '../components/ScrollReveal.astro';
---
<!doctype html>
<html lang="en" class="__variable_a78db3 __variable_ab8453">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Corum8 — preview</title>

    <link rel="icon"            type="image/png" href="/favicon.png" />
    <link rel="shortcut icon"   type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon"                  href="/favicon.png" />

    <!--
      Asset preloads
      ──────────────
      One primary body-font woff2 (the rest are subsetted variants the
      browser will fetch lazily as rules need them), one brand icon for
      the preloader mark, and one hero video. The hero video is reused
      by InfluencerReach + Awards — preloading it once lets the HTTP
      cache serve all three <video> consumers from a single fetch.
    -->
    <link rel="preload" href="/_next/static/media/482a8097102f5f9f-s.p.woff2" as="font"  type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/logo/icon-gold.png"                    as="image" fetchpriority="high" />
    <link rel="preload" href="/media/bg2.mp4"                                as="video" type="video/mp4" />

    <!--
      KOTA stylesheet fragments
      ─────────────────────────
      The first four carry ~95% of the layout rules and load sync so the
      page paints correctly. The remainder are interaction / detail rules
      that don't affect first paint, so they're deferred via `media=print`
      then flipped to `all` on load. <noscript> fallback restores them for
      users without JS.
    -->
    <link rel="stylesheet" href="/css/c6a848d34dfd7dce.css" />
    <link rel="stylesheet" href="/css/0aea7e632ce3cedf.css" />
    <link rel="stylesheet" href="/css/053ade63481ccabc.css" />
    <link rel="stylesheet" href="/css/e36a1a112c1c5ec8.css" />
    <link rel="stylesheet" href="/css/13f753c524b3db20.css" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="/css/57c1cf65c8fee4f0.css" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="/css/de01f06c65200d74.css" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="/css/d7d67e4e7d8a2a37.css" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="/css/ecdfc97c33854f51.css" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="/css/3d63d502945bea5a.css" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="/css/13f753c524b3db20.css" />
      <link rel="stylesheet" href="/css/57c1cf65c8fee4f0.css" />
      <link rel="stylesheet" href="/css/de01f06c65200d74.css" />
      <link rel="stylesheet" href="/css/d7d67e4e7d8a2a37.css" />
      <link rel="stylesheet" href="/css/ecdfc97c33854f51.css" />
      <link rel="stylesheet" href="/css/3d63d502945bea5a.css" />
    </noscript>
  </head>

  <body>
    <Preloader />

    <Navigation />
    <Header />

    <main>
      <Hero />
      <PressLogos />
      {/* <ClientLogosAlt /> -- hidden per user request */}
      <Services />
      <InfluencerReach />
      <PrAuthority />
      <Awards />
      <Work />
      <ProcessHorizontal />
      <Testimonials />
      <Industries />
      <FaqsList />
      <FinalCta />
    </main>

    <Footer />

    <WhatsAppButton />

    <!-- Global scroll-reveal controller (runs once, observes every main > *) -->
    <ScrollReveal />

    <script>
      import '../scripts/site.ts';
    </script>

    <style is:global>
      body { margin: 0; background: var(--color-bg); }
      main { position: relative; z-index: 1; }
    </style>
  </body>
</html>
