---
import Layout from "../../layouts/Layout.astro";
import KotaverseCta from "../../components/KotaverseCta.astro";

const arrowGrad = {
  id: 'careers',
  stops: [
    { offset: '0', color: '#7c41f3' },
    { offset: '1', color: '#ff6eff' },
  ],
};

const roles = [
  {
    href: '/contact',
    name: 'Senior Smart Contract Engineer',
    year: 'Remote · Dubai / EU',
    heading: 'Build and audit Solidity / Rust contracts for DeFi, RWAs and tokens. Lead audit engagements with Trail of Bits, Least Authority or ConsenSys Diligence.',
    tags: ['DeFi', 'Solidity', 'Rust', 'Audits'],
    poster: '/images/bento1-1.jpg',
  },
  {
    href: '/contact',
    name: 'Exchange Platform Lead',
    year: 'Dubai · On-site',
    heading: 'Own matching engine, custody integrations and compliance pipelines for exchange builds. Lead engagements with CEX operators across MENA, EU and APAC.',
    tags: ['Exchange', 'Custody', 'Compliance'],
    poster: '/images/bento2-1.jpg',
  },
  {
    href: '/contact',
    name: 'AI Engineer, Production Systems',
    year: 'Remote · US / EU',
    heading: 'Ship AI agents, RAG pipelines and inference infrastructure into customer workflows. Work across vLLM, TensorRT, Triton, pgvector and agentic frameworks.',
    tags: ['AI', 'LLM', 'Infra', 'Agents'],
    poster: '/images/bento3-1.jpg',
  },
  {
    href: '/contact',
    name: 'Growth Marketing Manager',
    year: 'Remote · Global',
    heading: 'Run paid programmes across Google, Meta, X, TikTok, Reddit and onchain ads. Own attribution, LTV modelling and the creative production pipeline.',
    tags: ['Growth', 'Paid', 'Attribution'],
    poster: '/images/bento4-1.jpg',
  },
  {
    href: '/contact',
    name: 'Crypto PR Lead',
    year: 'Remote · Global',
    heading: 'Lead tier-1 media relationships across The Block, CoinDesk, Decrypt, Blockworks and Bloomberg. Coordinate embargoed launches for token and product rollouts.',
    tags: ['PR', 'Media', 'Crypto'],
    poster: '/images/bento1.jpg',
  },
  {
    href: '/contact',
    name: 'Community Manager (Web3)',
    year: 'Remote · APAC / EU',
    heading: 'Build and moderate Discord, Telegram and Farcaster communities across token launches. Regional ambassadors, localisation, programme cadence.',
    tags: ['Community', 'Discord', 'Telegram'],
    poster: '/images/bento3.jpg',
  },
];

const principles = [
  {
    num: "01",
    title: "Ship, then write about it.",
    body: "We publish after the work lands. Case studies come with numbers from the client's own dashboards. Nobody ghost-writes results."
  },
  {
    num: "02",
    title: "One team, one brief.",
    body: "No handoff tax. Engineering, PR, community, growth and design sit in the same Slack and run against the same strategic document."
  },
  {
    num: "03",
    title: "Stay close to the craft.",
    body: "Senior people stay technical. Leads still write code, still pitch journalists, still moderate communities. No detachment ladder."
  },
  {
    num: "04",
    title: "Opinions earn the floor.",
    body: "Experience matters; so does the clearest argument. Hierarchy exists for decisions, not for who gets heard in the room."
  },
];
---
<Layout title="Careers | Corum8">

<section class="Hero_hero__zbooM"><div class="container"><div class="Hero_top__UZ6SA"><h2><span class="LineByLine_headingOuter__JmusT"><span>Build, launch and scale the products that refuse to blend in.</span></span><figure class="crosshair" aria-hidden="true"><span class="FadeInRotate_container__QE9u9" data-fill="true" data-direction="clockwise"><span class="inner"></span></span></figure></h2></div><div class="Hero_bottom__pLxrT"><h1><span class="MaskInUp_container__0AW5i" data-fill="false"><div><span><i></i>Careers</span></div></span></h1><div class="Hero_arrow__WTdEi"><span class="FadeInRotate_container__QE9u9" data-fill="false" data-direction="counterclockwise"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 75.91 75.65"><path d="m13.65 67.65 61.93-62L69.92 0 8 61.99V.25H0v75.4h75.91v-8H13.65z" style="stroke-width:0"></path></svg></span></div></div></div></section>

<section class="Mission_mission__8wC67"><div class="container"><h2 class="Mission_heading__Z0yjM"><span class="LineByLine_headingOuter__JmusT"><span class="Mission_heading__Z0yjM">The</span><span class="Mission_heading__Z0yjM Mission_bottom__FzQ0F">Team</span></span></h2><figure class="Mission_image__gbyeM"><span class="ScaleFadeIn_container__cK78G" data-fill="true"><span class="ScaleFadeIn_inner__y4reT" data-fill="true"><span class="Image_image__RAAdZ Image_fill__EiIzS"><img data-src="/images/corum8-team.png" src="/images/corum8-team.png" alt="" fetchpriority="low" height="730" width="810" sizes="auto" class="lazyload"></span></span></span></figure><h3 class="Mission_subheading__mpPMf"><span class="FadeInUp_container___uxva" data-fill="false">95+ engineers, PR leads, community managers, growth operators and designers across Dubai, the US and India.</span></h3><div class="Mission_mainText__ejHIS"><span class="FadeInUp_container___uxva" data-fill="false"><div><p>Every hire raises the bar. Every engagement gets senior work — not a team-of-juniors shuffle. We hire people who want to ship things that move markets, and get their name in the write-up afterwards.</p>
</div></span></div></div></section>

<section class="Approach_approach__l9ADx"><div class="container"><h2 class="Approach_heading__mbcS_"><div class="LargeHeading_headingOuter__i9qcd"><span class="Approach_heading__mbcS_">How</span><span class="Approach_heading__mbcS_ Approach_bottom__o3s1M">We Work</span></div></h2><div class="Approach_arrow__3EkCM"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 75.91 75.65"><path d="m13.65 67.65 61.93-62L69.92 0 8 61.99V.25H0v75.4h75.91v-8H13.65z" style="stroke-width:0"></path></svg></div><figure class="Approach_image__xti5i"><div class="ImageEnter_image__FSEP_" data-fill="true"><span class="Image_image__RAAdZ Image_fill__EiIzS"><img data-src="/images/corum8-mission.png" src="/images/corum8-mission.png" alt="" fetchpriority="low" height="1134" width="1086" sizes="auto" class="lazyload"></span></div></figure><div class="Approach_mainText__y2DyK"><span class="FadeInUp_container___uxva" data-fill="false"><div class="Approach_textContent__ncod1">
{principles.map((p) => (
  <p><strong>{p.num} — {p.title}</strong><br/>{p.body}</p>
))}
</div></span></div></div></section>

<div class="Work_work__rSI8c">
  <div class="DarkThemeSwitch_cover__hn_xc"></div>
  <div class="container">
    <div class="Work_text__WI9A4">
      <h2 class="Work_heading__pbv4g">
        <div class="LargeHeading_headingOuter__i9qcd">
          <span class="Work_heading__pbv4g">Open</span><span class="Work_heading__pbv4g Work_bottom__rzrzH">Roles</span>
        </div>
      </h2>
      <div class="Work_rightText__zx_Y0">
        <h3>
          <span data-blur-reveal="true">Senior work. Shipped under your own name.</span>
        </h3>
        <p>
          <span data-blur-reveal="true">Bring a link to something you shipped. No cover letter. If we can see the work, we can take it from there.</span>
        </p>
      </div>
    </div>
  </div>
  <div class="Work_projects__A5q77">
    <div class="AnimatedGrid_grid__otAMD">
      <div class="container">
        {roles.map((r) => (
          <a class="ProjectCard_project__d1wbY ProjectCard_small__xsL92" data-animation="grid-item" href={r.href}>
            <div class="ProjectCard_projectText__o770X">
              <h3>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14.78 14.78">
                  <defs>
                    <linearGradient id={arrowGrad.id} x1="3.54" x2="13.98" y1="3.54" y2="13.99" gradientUnits="userSpaceOnUse">
                      {arrowGrad.stops.map((s) => <stop offset={s.offset} stop-color={s.color}></stop>)}
                    </linearGradient>
                  </defs>
                  <path fill={`url(#${arrowGrad.id})`} stroke-width="0" d="M13.25 12.18L13.25 0.23 14.78 0.23 14.78 14.76 14.74 14.76 14.74 14.78 0.21 14.78 0.21 13.25 12.18 13.25 0 1.08 1.08 0 13.25 12.18z"></path>
                </svg>{r.name}
              </h3>
              <p>{r.year}</p>
            </div>
            <div class="ProjectCard_projectImage__Nfx9I">
              <div class="ProjectCard_imageOverlay__OCawr">
                <p class="ProjectCard_heading__1csIW">{r.heading}</p>
                <ul class="ProjectCard_tags__XdVcf">
                  {r.tags.map((t) => <li>{t}</li>)}
                </ul>
              </div>
              <span class="Image_image__RAAdZ Image_fill__EiIzS"><img src={r.poster} alt="" fetchpriority="low" loading="lazy" /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</div>

<KotaverseCta
  light="Bring the work"
  bold="you're proudest of."
  subtitle="Apply with a link to something you shipped. No cover letter required."
/>

</Layout>
