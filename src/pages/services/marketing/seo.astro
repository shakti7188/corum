---
import "../../../styles/global.css";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SEO & AEO Services | Corum8</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>

  <body class="bg-[#f5f2eb] text-slate-900 font-sans antialiased overflow-x-hidden selection:bg-[#ff9b71]/30">
    <main class="relative z-10 pt-20 lg:pt-32 pb-24 overflow-hidden" id="smooth-wrapper">
      <div id="smooth-content">

        <!-- Ambient Background -->
        <div class="absolute top-0 right-0 -z-10 w-[600px] h-[600px] bg-[#ff9b71]/10 blur-[100px] rounded-full pointer-events-none translate-x-1/2 -translate-y-1/2"></div>
        
        <!-- HERO SECTION -->
        <section class="max-w-6xl mx-auto px-6 text-center min-h-[70vh] flex flex-col justify-center">
          <div class="gs-reveal">
            <div class="inline-flex items-center px-4 py-2 rounded-full bg-[#ff9b71]/10 text-[#d35400] font-bold text-xs tracking-widest uppercase mb-8 border border-[#ff9b71]/20">
              SEO & AEO AGENCY
            </div>
            <h1 class="text-5xl lg:text-7xl font-extrabold tracking-tight text-slate-900 leading-[1.1] mb-6">
              Bring <span class="text-[#ff9b71]">Qualified Traffic</span><br/> to your website.
            </h1>
            <p class="text-xl text-slate-600 max-w-2xl mx-auto mb-12 leading-relaxed">
              We help Web3, AI, and Fintech brands dominate search engines and AI-generated answers. Get a free SEO audit today to uncover missed revenue.
            </p>
            
            <!-- AUDIT FORM -->
            <div class="max-w-3xl mx-auto bg-white p-2 sm:p-3 rounded-3xl sm:rounded-full shadow-[0_20px_40px_-15px_rgba(0,0,0,0.1)] border border-slate-200 flex flex-col sm:flex-row gap-2 sm:gap-0 relative z-20 mb-20 transform transition-transform hover:-translate-y-1 duration-300">
              <input type="url" placeholder="Your Website URL" class="flex-1 bg-transparent border-none outline-none px-6 py-4 text-slate-800 placeholder-slate-400 font-medium sm:border-r border-slate-200" />
              <input type="email" placeholder="Your Email Address" class="flex-1 bg-transparent border-none outline-none px-6 py-4 text-slate-800 placeholder-slate-400 font-medium" />
              <button class="bg-[#ff9b71] hover:bg-[#e0835b] text-white px-8 py-4 rounded-xl sm:rounded-full font-bold transition-all hover:shadow-lg whitespace-nowrap">
                Get Free Audit
              </button>
            </div>
          </div>

          <!-- HERO VISUAL / TRAFFIC CARD -->
          <div class="max-w-md mx-auto bg-white rounded-[32px] p-8 shadow-[0_30px_60px_-15px_rgba(0,0,0,0.1)] border border-slate-100 text-left relative z-10 gs-reveal">
            <h3 class="font-bold text-slate-900 mb-6 text-lg flex items-center justify-between">
              Organic Traffic Growth
              <span class="w-8 h-8 rounded-full bg-slate-50 flex items-center justify-center text-slate-400">↗</span>
            </h3>
            
            <!-- Mock Chart -->
            <div class="h-24 w-full border-b border-dashed border-slate-200 mb-6 relative">
              <svg viewBox="0 0 100 40" class="w-full h-full overflow-visible">
                <path d="M0 30 Q 20 25, 40 10 T 80 15 T 100 0" fill="none" stroke="#ff9b71" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="dash-anim" />
                <path d="M0 30 Q 20 25, 40 10 T 80 15 T 100 0 L 100 40 L 0 40 Z" fill="url(#gradient)" opacity="0.2" />
                <defs>
                  <linearGradient id="gradient" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="#ff9b71" stop-opacity="1" />
                    <stop offset="100%" stop-color="#ff9b71" stop-opacity="0" />
                  </linearGradient>
                </defs>
              </svg>
            </div>
            
            <div class="flex items-end gap-3">
              <span class="text-4xl font-extrabold text-[#27c93f]">+450%</span>
              <span class="text-sm font-medium text-slate-400 mb-1">vs last year</span>
            </div>
          </div>
        </section>

        <!-- LOGO CLOUD -->
        <section class="py-12 mt-12 mb-20 gs-reveal">
          <div class="max-w-7xl mx-auto px-6 text-center">
            <p class="text-sm font-bold tracking-widest text-slate-400 uppercase mb-8">Ranked #1 for global queries</p>
            <div class="flex flex-wrap justify-center items-center gap-12 lg:gap-24 opacity-60 grayscale hover:grayscale-0 transition-all duration-500">
              <div class="text-2xl font-black text-slate-800">Shopify</div>
              <div class="text-2xl font-black text-slate-800 tracking-tighter">Webflow</div>
              <div class="text-2xl font-black text-slate-800 italic">Vercel</div>
              <div class="text-2xl font-black text-slate-800 uppercase tracking-widest">Stripe</div>
            </div>
          </div>
        </section>

        <!-- SERVICE CARDS (DARK) -->
        <section class="py-24 lg:py-32 bg-[#111] rounded-[40px] lg:rounded-[80px] text-white mx-4 lg:mx-8">
          <div class="max-w-7xl mx-auto px-6 lg:px-12">
            <h2 class="text-4xl lg:text-6xl font-extrabold text-center mb-16 gs-reveal">How we rank your site</h2>
            
            <div class="grid md:grid-cols-3 gap-8">
              <!-- Card 1 -->
              <div class="bg-[#1a1a1a] p-10 rounded-3xl border border-[#2a2a2a] hover:border-[#ff9b71] transition-all hover:-translate-y-2 group gs-reveal">
                <span class="text-6xl font-extrabold text-transparent bg-clip-text bg-gradient-to-br from-[#ff9b71]/50 to-transparent mb-6 block" style="-webkit-text-stroke: 1px #ff9b71;">01</span>
                <h3 class="text-2xl font-bold mb-4 text-white">Technical SEO</h3>
                <p class="text-slate-400 leading-relaxed group-hover:text-slate-300 transition-colors">We fix crawlability, site speed, and structured data so search engines can read and index your site perfectly.</p>
              </div>
              <!-- Card 2 -->
              <div class="bg-[#1a1a1a] p-10 rounded-3xl border border-[#2a2a2a] hover:border-[#ff9b71] transition-all hover:-translate-y-2 group gs-reveal" style="transition-delay: 100ms;">
                <span class="text-6xl font-extrabold text-transparent bg-clip-text bg-gradient-to-br from-[#ff9b71]/50 to-transparent mb-6 block" style="-webkit-text-stroke: 1px #ff9b71;">02</span>
                <h3 class="text-2xl font-bold mb-4 text-white">Content Strategy</h3>
                <p class="text-slate-400 leading-relaxed group-hover:text-slate-300 transition-colors">Data-driven content clusters that target high-intent commercial keywords with low difficulty for rapid wins.</p>
              </div>
              <!-- Card 3 -->
              <div class="bg-[#1a1a1a] p-10 rounded-3xl border border-[#2a2a2a] hover:border-[#ff9b71] transition-all hover:-translate-y-2 group gs-reveal" style="transition-delay: 200ms;">
                <span class="text-6xl font-extrabold text-transparent bg-clip-text bg-gradient-to-br from-[#ff9b71]/50 to-transparent mb-6 block" style="-webkit-text-stroke: 1px #ff9b71;">03</span>
                <h3 class="text-2xl font-bold mb-4 text-white">AEO & Authority</h3>
                <p class="text-slate-400 leading-relaxed group-hover:text-slate-300 transition-colors">Securing high-DR backlinks and optimizing entities so ChatGPT, Gemini, and Perplexity quote your brand directly.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- GROWTH STATS -->
        <section class="py-24 mt-12 bg-white mx-4 lg:mx-8 rounded-[40px] lg:rounded-[80px] shadow-sm border border-slate-100">
          <div class="max-w-7xl mx-auto px-6 lg:px-12 grid lg:grid-cols-2 gap-16 items-center">
            <div class="gs-reveal-left">
              <h2 class="text-4xl lg:text-5xl font-extrabold text-slate-900 mb-6 leading-[1.1]">
                We don't just chase rankings. <br/> We chase <span class="text-[#ff9b71]">Revenue</span>.
              </h2>
              <p class="text-xl text-slate-600 leading-relaxed mb-8">
                Traffic is a vanity metric if it doesn't convert. Our SEO and AEO strategies are built purely around commercial intent and driving actual pipeline value for high-ticket clients.
              </p>
              <a href="/contact" class="px-8 py-4 inline-block rounded-full bg-slate-900 text-white font-bold text-lg hover:bg-[#ff9b71] transition-colors">
                View Case Studies
              </a>
            </div>
            
            <div class="grid sm:grid-cols-2 gap-6 gs-reveal-right">
              <div class="bg-[#f5f2eb] p-10 rounded-3xl text-center border border-slate-200">
                <h3 class="text-5xl font-extrabold text-[#ff9b71] mb-2">98%</h3>
                <span class="font-bold text-slate-700">Avg. Client Retention</span>
              </div>
              <div class="bg-[#f5f2eb] p-10 rounded-3xl text-center border border-slate-200 sm:mt-12">
                <h3 class="text-5xl font-extrabold text-[#ff9b71] mb-2">60M+</h3>
                <span class="font-bold text-slate-700">Organic Traffic Generated</span>
              </div>
            </div>
          </div>
        </section>

        <!-- TESTIMONIALS -->
        <section class="py-32">
          <div class="max-w-7xl mx-auto px-6 lg:px-12">
            <div class="text-center max-w-3xl mx-auto mb-20 gs-reveal">
              <h2 class="text-4xl lg:text-5xl font-extrabold text-slate-900 mb-6">Real Results.</h2>
            </div>
            <div class="grid md:grid-cols-2 gap-8">
              <div class="bg-white p-10 rounded-3xl shadow-lg border border-slate-100 gs-reveal">
                <div class="flex text-amber-400 mb-6 text-2xl">★★★★★</div>
                <p class="text-xl text-slate-700 leading-relaxed mb-8 italic font-medium">"Within 6 months, Corum8 doubled our organic traffic. But more importantly, our qualified inbound leads tripled. They understand B2B SaaS SEO better than anyone."</p>
                <div class="flex items-center gap-4">
                  <div class="w-14 h-14 bg-slate-200 rounded-full"></div>
                  <div>
                    <h4 class="font-bold text-slate-900 text-lg">Jonathan Reed</h4>
                    <p class="text-slate-500">CEO at FinMatrix</p>
                  </div>
                </div>
              </div>
              <div class="bg-white p-10 rounded-3xl shadow-lg border border-slate-100 gs-reveal" style="transition-delay: 100ms;">
                <div class="flex text-amber-400 mb-6 text-2xl">★★★★★</div>
                <p class="text-xl text-slate-700 leading-relaxed mb-8 italic font-medium">"Their AEO strategy got our brand mentioned directly inside ChatGPT and Claude answers. We bypassed traditional search entirely for our biggest enterprise deals."</p>
                <div class="flex items-center gap-4">
                  <div class="w-14 h-14 bg-slate-200 rounded-full"></div>
                  <div>
                    <h4 class="font-bold text-slate-900 text-lg">Emily Chen</h4>
                    <p class="text-slate-500">Head of Marketing, Web3Core</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- FAQ -->
        <section class="py-24 bg-white border-y border-slate-200">
          <div class="max-w-4xl mx-auto px-6 lg:px-12">
            <div class="text-center mb-16 gs-reveal">
              <h2 class="text-4xl font-extrabold text-slate-900">Frequently Asked Questions</h2>
            </div>
            <div class="space-y-6 gs-reveal">
              <div class="p-6 rounded-2xl bg-[#f5f2eb] border border-slate-200">
                <h4 class="text-xl font-bold text-slate-900 mb-2">How long does SEO take to see results?</h4>
                <p class="text-slate-600">Typically, you will start seeing noticeable movement in rankings and traffic within 3 to 6 months, depending on the competitiveness of your industry.</p>
              </div>
              <div class="p-6 rounded-2xl bg-[#f5f2eb] border border-slate-200">
                <h4 class="text-xl font-bold text-slate-900 mb-2">What is AEO?</h4>
                <p class="text-slate-600">Answer Engine Optimization (AEO) focuses on structuring your content and building authority so that AI engines like ChatGPT, Claude, and Gemini cite your brand in their answers.</p>
              </div>
              <div class="p-6 rounded-2xl bg-[#f5f2eb] border border-slate-200">
                <h4 class="text-xl font-bold text-slate-900 mb-2">Do you guarantee #1 rankings?</h4>
                <p class="text-slate-600">No agency can guarantee a specific ranking. Instead, we guarantee a data-driven process that has consistently delivered massive ROI and top-tier visibility for our clients.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- CTA SECTION -->
        <section class="py-32">
          <div class="max-w-5xl mx-auto px-6 text-center gs-reveal">
            <h2 class="text-5xl lg:text-7xl font-extrabold text-slate-900 mb-8 leading-[1.1]">Dominate your <br/><span class="text-[#ff9b71]">Search Market</span></h2>
            <p class="text-xl text-slate-600 mb-10 max-w-2xl mx-auto">Get a comprehensive audit of your current SEO landscape and a roadmap to outrank your competitors.</p>
            <a href="/contact" class="px-10 py-5 rounded-full bg-[#ff9b71] hover:bg-[#e0835b] text-white font-bold text-xl transition-all shadow-xl hover:-translate-y-1 inline-block">
              Request Your Free Audit
            </a>
          </div>
        </section>

      </div>
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" is:inline></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js" is:inline></script>
    <script src="https://unpkg.com/@studio-freight/lenis@1.0.33/dist/lenis.min.js" is:inline></script>
    
    <script is:inline>
      document.addEventListener("DOMContentLoaded", (event) => {
        const lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          direction: 'vertical',
          gestureDirection: 'vertical',
          smooth: true
        });

        function raf(time) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);

        gsap.registerPlugin(ScrollTrigger);

        const revealElements = document.querySelectorAll(".gs-reveal");
        revealElements.forEach((el) => {
          gsap.fromTo(el, { autoAlpha: 0, y: 50 }, {
            duration: 1, autoAlpha: 1, y: 0,
            ease: "power3.out",
            scrollTrigger: { trigger: el, start: "top 85%", toggleActions: "play none none reverse" }
          });
        });

        const revealLeft = document.querySelectorAll(".gs-reveal-left");
        revealLeft.forEach((el) => {
          gsap.fromTo(el, { autoAlpha: 0, x: -50 }, {
            duration: 1, autoAlpha: 1, x: 0,
            ease: "power3.out",
            scrollTrigger: { trigger: el, start: "top 85%", toggleActions: "play none none reverse" }
          });
        });

        const revealRight = document.querySelectorAll(".gs-reveal-right");
        revealRight.forEach((el) => {
          gsap.fromTo(el, { autoAlpha: 0, x: 50 }, {
            duration: 1, autoAlpha: 1, x: 0,
            ease: "power3.out",
            scrollTrigger: { trigger: el, start: "top 85%", toggleActions: "play none none reverse" }
          });
        });
      });
    </script>

    <style is:global>
      body { font-family: 'DM Sans', sans-serif; }
      .dash-anim {
        stroke-dasharray: 1000;
        stroke-dashoffset: 1000;
        animation: dash 3s ease-out forwards;
        animation-delay: 0.5s;
      }
      @keyframes dash {
        to { stroke-dashoffset: 0; }
      }
    </style>
  </body>
</html>
