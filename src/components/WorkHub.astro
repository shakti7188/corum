---

<div class="WorkHub_container">
  
  <!-- Custom Filter Bar Engine -->
  <div class="WorkHub_filters">
    <div class="container" style="display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 3rem;">
      {filterCategories.map(cat => (
        <button class="WorkHub_filterBtn" data-filter={cat.slug}>
          {cat.label}
        </button>
      ))}
    </div>
  </div>

  <div class="Work_projects__A5q77">
    <div class="AnimatedGrid_grid__otAMD">
      <div class="container" id="WorkHub_grid">
        {projects.map((p) => (
          <a
            class="ProjectCard_project__d1wbY ProjectCard_small__xsL92 WorkHub_card"
            data-category={p.category}
            data-animation="grid-item"
            href={p.href}
          >
            <div class="ProjectCard_projectText__o770X">
              <h3>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14.78 14.78">
                  <defs>
                    <linearGradient id={arrowGrad.id} x1="3.54" x2="13.98" y1="3.54" y2="13.99" gradientUnits="userSpaceOnUse">
                      {arrowGrad.stops.map((s) => <stop offset={s.offset} stop-color={s.color}></stop>)}
                    </linearGradient>
                  </defs>
                  <path fill={`url(#${arrowGrad.id})`} stroke-width="0" d="M13.25 12.18L13.25 0.23 14.78 0.23 14.78 14.76 14.74 14.76 14.74 14.78 0.21 14.78 0.21 13.25 12.18 13.25 0 1.08 1.08 0 13.25 12.18z"></path>
                </svg>{p.name}
              </h3>
              <p>
                {p.type && <span class="ProjectCard_type__c8">{p.type} &middot; </span>}
                <span class="ProjectCard_result__c8">{p.result}</span>
              </p>
            </div>
            <div class="ProjectCard_projectImage__Nfx9I">
              <div class="ProjectCard_imageOverlay__OCawr">
                <p class="ProjectCard_heading__1csIW">{p.heading}</p>
                <ul class="ProjectCard_tags__XdVcf">
                  {p.tags.map((t) => <li>{t}</li>)}
                </ul>
              </div>
              {p.poster && (
                <span class="Image_image__RAAdZ Image_fill__EiIzS"><img src={p.poster} alt="" fetchpriority="low" /></span>
              )}
              <video src={p.video} class="ProjectCard_video__AheFz" autoplay="true" muted="true" loop="true" playsinline="true"></video>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .WorkHub_container { margin-bottom: 8vw; }
  .WorkHub_filters {
    padding-top: 2rem;
  }
  .WorkHub_filterBtn {
    background: transparent;
    border: 1px solid currentColor;
    color: var(--theme-text);
    padding: 0.75rem 1.75rem;
    border-radius: 30px;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .WorkHub_filterBtn:hover {
    border-color: #ff6eff;
    color: #ff6eff;
  }
  .WorkHub_filterBtn.active {
    background: linear-gradient(90deg, #7c41f3 0%, #ff6eff 100%);
    border-color: transparent;
    color: var(--theme-text);
  }
  .WorkHub_card {
    transition: transform 0.4s ease, opacity 0.4s ease;
  }
</style>

<script>
  function initFilters() {
    const filterBtns = document.querySelectorAll('.WorkHub_filterBtn');
    const cards = document.querySelectorAll('.WorkHub_card');
    if (filterBtns.length === 0) return;
    
    // Reset standard behavior on load for safety
    filterBtns.forEach(b => b.classList.remove('active'));
    filterBtns[0].classList.add('active');
    
    // Safety unbind to prevent duplicates if navigating back and forth
    filterBtns.forEach(btn => {
      const newBtn = btn.cloneNode(true);
      btn.parentNode.replaceChild(newBtn, btn);
    });
    
    const cleanBtns = document.querySelectorAll('.WorkHub_filterBtn');
    cleanBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        cleanBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const activeSlug = btn.getAttribute('data-filter');
        cards.forEach(card => {
          const cardCategory = card.getAttribute('data-category');
          if (activeSlug === 'all' || cardCategory === activeSlug) {
            card.style.display = 'block';
            setTimeout(() => { card.style.opacity = '1'; card.style.transform = 'scale(1)'; }, 50);
          } else {
            card.style.opacity = '0';
            card.style.transform = 'scale(0.95)';
            setTimeout(() => { card.style.display = 'none'; }, 400);
          }
        });
      });
    });
  }
  document.addEventListener('DOMContentLoaded', initFilters);
  document.addEventListener('astro:page-load', initFilters);
  initFilters();
</script>
