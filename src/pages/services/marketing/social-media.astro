---
import "../../../styles/global.css";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Social Media Marketing | Corum8</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>

  <body class="bg-[#fcfcff] text-slate-800 font-sans antialiased overflow-x-hidden selection:bg-indigo-200">
    <main class="relative z-10 pt-20 pb-24 overflow-hidden" id="smooth-wrapper">
      <div id="smooth-content">
        <!-- Background Ambient Glow -->
        <div class="absolute top-0 right-0 -z-10 w-[800px] h-[800px] bg-indigo-500/10 blur-[120px] rounded-full pointer-events-none translate-x-1/3 -translate-y-1/4"></div>
        <div class="absolute top-1/2 left-0 -z-10 w-[600px] h-[600px] bg-purple-500/10 blur-[100px] rounded-full pointer-events-none -translate-x-1/2"></div>

        <!-- HERO SECTION -->
        <section class="max-w-7xl mx-auto px-6 lg:px-12 grid lg:grid-cols-2 gap-16 items-center min-h-[85vh]">
          <div class="max-w-2xl gs-reveal">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-indigo-50 border border-indigo-100 text-indigo-600 font-semibold text-sm mb-8 shadow-sm">
              <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
              Social Media Automation 2.0
            </div>
            <h1 class="text-5xl lg:text-7xl font-extrabold tracking-tight text-slate-900 leading-[1.1] mb-6">
              Master Your <br/> <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-purple-600">Social Presence</span>
            </h1>
            <p class="text-xl text-slate-600 leading-relaxed mb-10">
              Automate your posting, track engagement in real-time, and grow your audience exponentially with our data-driven social media engine.
            </p>
            <div class="flex flex-wrap items-center gap-4">
              <a href="#" class="px-8 py-4 rounded-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-lg transition-all hover:-translate-y-1 hover:shadow-xl hover:shadow-indigo-600/30">
                Start Growing Today
              </a>
              <a href="#features" class="px-8 py-4 rounded-full bg-white border border-slate-200 hover:border-indigo-600 hover:text-indigo-600 text-slate-700 font-bold text-lg transition-all flex items-center gap-2 group">
                <svg class="w-5 h-5 text-slate-400 group-hover:text-indigo-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path></svg>
                Watch Demo
              </a>
            </div>
          </div>

          <!-- HERO MOCKUP -->
          <div class="relative w-full aspect-square max-w-[600px] mx-auto gs-reveal-right">
            <!-- Main Dashboard Card -->
            <div class="absolute inset-4 lg:inset-8 bg-white/60 backdrop-blur-2xl border border-white/80 shadow-[0_40px_80px_-20px_rgba(79,70,229,0.15)] rounded-3xl p-8 flex flex-col justify-between transform transition-transform hover:scale-[1.02] duration-500">
              <div class="flex justify-between items-start">
                <div>
                  <p class="text-slate-500 font-semibold mb-1">Total Engagement</p>
                  <p class="text-4xl font-extrabold text-slate-900">124,592</p>
                </div>
                <div class="px-3 py-1 bg-emerald-100 text-emerald-700 rounded-lg font-bold text-sm flex items-center gap-1">
                  +245%
                </div>
              </div>
              
              <!-- Chart Mockup -->
              <div class="h-48 flex items-end gap-3 w-full mt-8">
                {[40, 70, 45, 90, 65, 85, 100].map((height, i) => (
                  <div class="w-full bg-slate-100 rounded-t-md relative group">
                    <div class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-indigo-600 to-purple-500 rounded-t-md transition-all duration-1000 origin-bottom" style={`height: ${height}%; animation: growUp 1.5s ease-out forwards ${i * 0.1}s;`}></div>
                  </div>
                ))}
              </div>
            </div>
            <!-- Floating Element 1 -->
            <div class="absolute -bottom-6 -left-6 lg:-left-12 bg-white rounded-2xl shadow-xl p-5 border border-slate-100 flex items-center gap-4 animate-[float-y_4s_ease-in-out_infinite]">
              <div class="flex -space-x-4">
                <div class="w-10 h-10 rounded-full border-2 border-white bg-indigo-200"></div>
                <div class="w-10 h-10 rounded-full border-2 border-white bg-purple-200"></div>
                <div class="w-10 h-10 rounded-full border-2 border-white bg-pink-200"></div>
              </div>
              <div>
                <p class="text-sm font-bold text-slate-900 m-0">+1.2k Followers</p>
              </div>
            </div>
            <!-- Floating Element 2 -->
            <div class="absolute top-10 -right-6 bg-white rounded-2xl shadow-xl p-4 border border-slate-100 flex items-center gap-3 animate-[float-y_5s_ease-in-out_infinite_reverse]">
              <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center font-bold">✓</div>
              <div>
                <p class="text-xs text-slate-500 m-0">Campaign Status</p>
                <p class="text-sm font-bold text-slate-900 m-0">Active</p>
              </div>
            </div>
          </div>
        </section>

        <!-- LOGO CLOUD -->
        <section class="border-y border-slate-200 bg-white py-12 mt-10">
          <div class="max-w-7xl mx-auto px-6 text-center">
            <p class="text-sm font-bold tracking-widest text-slate-400 uppercase mb-8">Trusted by innovative teams worldwide</p>
            <div class="flex flex-wrap justify-center items-center gap-12 lg:gap-24 opacity-60 grayscale hover:grayscale-0 transition-all duration-500">
              <div class="text-2xl font-black text-slate-800">AcmeCorp</div>
              <div class="text-2xl font-black text-slate-800 tracking-tighter">GlobalTech</div>
              <div class="text-2xl font-black text-slate-800 italic">Nexus</div>
              <div class="text-2xl font-black text-slate-800 uppercase tracking-widest">Vertex</div>
              <div class="text-2xl font-black text-slate-800">Quantum</div>
            </div>
          </div>
        </section>

        <!-- ANALYTICS GRID -->
        <section id="features" class="max-w-7xl mx-auto px-6 lg:px-12 mt-32">
          <div class="text-center max-w-3xl mx-auto mb-20 gs-reveal">
            <h2 class="text-4xl lg:text-5xl font-extrabold text-slate-900 mb-6">Insights that drive action</h2>
            <p class="text-xl text-slate-600">Stop guessing. Start knowing exactly what works for your audience with our unified analytics engine.</p>
          </div>

          <div class="grid md:grid-cols-3 gap-8">
            <div class="bg-white p-10 rounded-3xl shadow-lg border border-slate-100 hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 gs-reveal">
              <div class="w-16 h-16 rounded-2xl bg-indigo-50 flex items-center justify-center mb-8">
                <svg class="w-8 h-8 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
              </div>
              <h3 class="text-2xl font-bold text-slate-900 mb-4">Audience Reach</h3>
              <p class="text-slate-600 leading-relaxed">Expand your reach organically with AI-optimized posting schedules and content formatting that algorithms love.</p>
            </div>
            <div class="bg-white p-10 rounded-3xl shadow-lg border border-slate-100 hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 gs-reveal" style="transition-delay: 100ms;">
              <div class="w-16 h-16 rounded-2xl bg-purple-50 flex items-center justify-center mb-8">
                <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
              </div>
              <h3 class="text-2xl font-bold text-slate-900 mb-4">Click-through Rates</h3>
              <p class="text-slate-600 leading-relaxed">Monitor which posts drive traffic to your site and optimize your calls-to-action for the highest possible conversion.</p>
            </div>
            <div class="bg-white p-10 rounded-3xl shadow-lg border border-slate-100 hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 gs-reveal" style="transition-delay: 200ms;">
              <div class="w-16 h-16 rounded-2xl bg-emerald-50 flex items-center justify-center mb-8">
                <svg class="w-8 h-8 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
              </div>
              <h3 class="text-2xl font-bold text-slate-900 mb-4">Growth Tracking</h3>
              <p class="text-slate-600 leading-relaxed">Track follower growth, churn rate, and demographic shifts across all platforms from a single unified dashboard.</p>
            </div>
          </div>
        </section>

        <!-- AUTOMATION SECTION -->
        <section class="max-w-7xl mx-auto px-6 lg:px-12 mt-40 grid lg:grid-cols-2 gap-16 items-center">
          <div class="order-2 lg:order-1 relative h-[500px] w-full rounded-[40px] bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center overflow-hidden shadow-2xl gs-reveal-left">
            <div class="bg-white w-72 rounded-2xl shadow-2xl p-6 relative z-10 animate-[float-y_5s_ease-in-out_infinite_reverse]">
              <div class="flex justify-between items-center mb-6">
                <h4 class="font-bold text-slate-900 m-0">Post Scheduled</h4>
              </div>
              <div class="space-y-3 mb-6">
                <div class="h-3 w-full bg-slate-100 rounded-full"></div>
                <div class="h-3 w-4/5 bg-slate-100 rounded-full"></div>
                <div class="h-3 w-2/3 bg-slate-100 rounded-full"></div>
              </div>
              <div class="inline-flex px-3 py-1 bg-emerald-100 text-emerald-700 text-xs font-bold rounded-full">Ready to publish</div>
            </div>
            <div class="absolute top-10 left-10 w-32 h-32 bg-white/20 rounded-full blur-2xl"></div>
            <div class="absolute bottom-10 right-10 w-48 h-48 bg-indigo-900/30 rounded-full blur-2xl"></div>
          </div>

          <div class="order-1 lg:order-2 gs-reveal-right">
            <div class="text-indigo-600 font-bold mb-4 uppercase tracking-widest text-sm">Autopilot Engine</div>
            <h2 class="text-4xl lg:text-5xl font-extrabold text-slate-900 mb-6 leading-[1.1]">Put your content on autopilot</h2>
            <p class="text-xl text-slate-600 leading-relaxed mb-10">
              Schedule weeks of content in minutes. Our automation tools ensure your brand stays active even when you're sleeping. Let AI handle the timing.
            </p>
            <ul class="space-y-5 p-0 m-0 list-none">
              {[
                'Multi-platform scheduling from one calendar',
                'Auto-reposting for evergreen content',
                'Best-time-to-post AI suggestions based on your data',
                'Seamless approval workflows for teams'
              ].map(item => (
                <li class="flex items-center gap-4 text-lg font-semibold text-slate-800 m-0">
                  <span class="flex-shrink-0 w-8 h-8 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center font-bold">✓</span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </section>

        <!-- DASHBOARD SHOWCASE -->
        <section class="max-w-7xl mx-auto px-6 lg:px-12 mt-40">
          <div class="bg-slate-900 rounded-[40px] p-10 lg:p-20 relative overflow-hidden gs-reveal">
            <!-- Background Decoration -->
            <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-indigo-500/20 blur-[100px] rounded-full pointer-events-none"></div>
            
            <div class="text-center max-w-3xl mx-auto mb-16 relative z-10">
              <h2 class="text-4xl lg:text-5xl font-extrabold text-white mb-6">Manage everything from a single dashboard</h2>
              <p class="text-xl text-slate-300">Stop switching between tabs. Reply to comments, track brand mentions, and analyze performance across 10+ platforms simultaneously.</p>
            </div>

            <!-- UI Mockup Window -->
            <div class="relative w-full max-w-5xl mx-auto rounded-xl border border-slate-700 bg-[#0f172a] shadow-2xl overflow-hidden gs-reveal">
              <div class="h-10 bg-slate-800 border-b border-slate-700 flex items-center px-4 gap-2">
                <div class="w-3 h-3 rounded-full bg-slate-600"></div>
                <div class="w-3 h-3 rounded-full bg-slate-600"></div>
                <div class="w-3 h-3 rounded-full bg-slate-600"></div>
              </div>
              <div class="p-8 grid md:grid-cols-4 gap-6">
                <!-- Sidebar -->
                <div class="col-span-1 space-y-4 hidden md:block">
                  <div class="h-8 bg-slate-800 rounded w-full"></div>
                  <div class="h-8 bg-indigo-600 rounded w-4/5"></div>
                  <div class="h-8 bg-slate-800 rounded w-full"></div>
                  <div class="h-8 bg-slate-800 rounded w-2/3"></div>
                </div>
                <!-- Main Content -->
                <div class="col-span-3 space-y-6">
                  <div class="grid grid-cols-3 gap-4">
                    <div class="h-24 bg-slate-800 rounded-lg border border-slate-700"></div>
                    <div class="h-24 bg-slate-800 rounded-lg border border-slate-700"></div>
                    <div class="h-24 bg-slate-800 rounded-lg border border-slate-700"></div>
                  </div>
                  <div class="h-64 bg-slate-800 rounded-lg border border-slate-700 relative overflow-hidden">
                    <div class="absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-indigo-500/20 to-transparent"></div>
                    <svg class="absolute bottom-0 w-full h-full" preserveAspectRatio="none" viewBox="0 0 100 100">
                      <path d="M0 100 L 0 50 Q 25 30, 50 60 T 100 20 L 100 100 Z" fill="rgba(79, 70, 229, 0.2)" stroke="rgb(79, 70, 229)" stroke-width="1"/>
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- TESTIMONIALS -->
        <section class="max-w-7xl mx-auto px-6 lg:px-12 mt-40">
          <div class="text-center max-w-3xl mx-auto mb-20 gs-reveal">
            <h2 class="text-4xl lg:text-5xl font-extrabold text-slate-900 mb-6">Loved by marketing teams</h2>
          </div>
          <div class="grid md:grid-cols-3 gap-8">
            <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-200 gs-reveal">
              <div class="flex text-amber-400 mb-4">★★★★★</div>
              <p class="text-slate-700 mb-6 font-medium">"Corum8's social engine saved us 20 hours a week. The AI scheduling alone is worth the investment."</p>
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-slate-200 rounded-full"></div>
                <div>
                  <h4 class="font-bold text-slate-900">Sarah Jenkins</h4>
                  <p class="text-sm text-slate-500">CMO at TechFlow</p>
                </div>
              </div>
            </div>
            <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-200 gs-reveal" style="transition-delay: 100ms;">
              <div class="flex text-amber-400 mb-4">★★★★★</div>
              <p class="text-slate-700 mb-6 font-medium">"The analytics dashboard gives us exactly what we need to prove ROI to our board. Invaluable tool."</p>
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-slate-200 rounded-full"></div>
                <div>
                  <h4 class="font-bold text-slate-900">Marcus Chen</h4>
                  <p class="text-sm text-slate-500">Director of Growth</p>
                </div>
              </div>
            </div>
            <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-200 gs-reveal" style="transition-delay: 200ms;">
              <div class="flex text-amber-400 mb-4">★★★★★</div>
              <p class="text-slate-700 mb-6 font-medium">"Our organic reach skyrocketed by 300% in the first quarter after we let the AI dictate our posting times."</p>
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-slate-200 rounded-full"></div>
                <div>
                  <h4 class="font-bold text-slate-900">Elena Rodriguez</h4>
                  <p class="text-sm text-slate-500">Social Media Manager</p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- CTA SECTION -->
        <section class="max-w-5xl mx-auto px-6 lg:px-12 mt-40 mb-32 gs-reveal">
          <div class="bg-indigo-600 rounded-[40px] p-12 lg:p-20 text-center text-white relative overflow-hidden shadow-2xl">
            <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjAiIGhlaWdodD0iMjAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PGNpcmNsZSBjeD0iMiIgY3k9IjIiIHI9IjIiIGZpbGw9InJnYmEoMjU1LDI1NSwyNTUsMC4xKSIvPjwvc3ZnPg==')] opacity-50"></div>
            <div class="relative z-10">
              <h2 class="text-4xl lg:text-6xl font-extrabold mb-6">Ready to scale your social?</h2>
              <p class="text-xl text-indigo-100 max-w-2xl mx-auto mb-10">Join 10,000+ modern teams using our platform to dominate their organic reach.</p>
              <a href="/contact" class="px-10 py-5 rounded-full bg-white text-indigo-600 font-bold text-xl hover:shadow-xl hover:scale-105 transition-transform inline-block">
                Start your 14-day free trial
              </a>
              <p class="mt-6 text-sm text-indigo-200">No credit card required. Cancel anytime.</p>
            </div>
          </div>
        </section>

      </div>
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" is:inline></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js" is:inline></script>
    <script src="https://unpkg.com/@studio-freight/lenis@1.0.33/dist/lenis.min.js" is:inline></script>
    
    <script is:inline>
      document.addEventListener("DOMContentLoaded", (event) => {
        // Initialize Lenis for Smooth Scrolling
        const lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          direction: 'vertical',
          gestureDirection: 'vertical',
          smooth: true,
          mouseMultiplier: 1,
          smoothTouch: false,
          touchMultiplier: 2,
          infinite: false,
        });

        function raf(time) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);

        // Initialize GSAP
        gsap.registerPlugin(ScrollTrigger);

        const revealElements = document.querySelectorAll(".gs-reveal");
        revealElements.forEach((el) => {
          gsap.fromTo(el, { autoAlpha: 0, y: 50 }, {
            duration: 1, autoAlpha: 1, y: 0,
            ease: "power3.out",
            scrollTrigger: { trigger: el, start: "top 85%", toggleActions: "play none none reverse" }
          });
        });

        const revealLeft = document.querySelectorAll(".gs-reveal-left");
        revealLeft.forEach((el) => {
          gsap.fromTo(el, { autoAlpha: 0, x: -50 }, {
            duration: 1, autoAlpha: 1, x: 0,
            ease: "power3.out",
            scrollTrigger: { trigger: el, start: "top 85%", toggleActions: "play none none reverse" }
          });
        });

        const revealRight = document.querySelectorAll(".gs-reveal-right");
        revealRight.forEach((el) => {
          gsap.fromTo(el, { autoAlpha: 0, x: 50 }, {
            duration: 1, autoAlpha: 1, x: 0,
            ease: "power3.out",
            scrollTrigger: { trigger: el, start: "top 85%", toggleActions: "play none none reverse" }
          });
        });
      });
    </script>

    <style is:global>
      body { font-family: 'Inter', sans-serif; }
      @keyframes growUp { 0% { transform: scaleY(0); } 100% { transform: scaleY(1); } }
      @keyframes float-y { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-15px); } }
    </style>
  </body>
</html>
