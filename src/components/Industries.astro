---
// Industries — six premium category cards that replace the homepage's
// blog/Articles section per the redesign brief. Each card is a stock image
// + overlay text + slight zoom-on-hover. Verticals match the brief's
// recommended set (Web3, AI, Fintech, SaaS, Enterprise, Robotics).

const industries = [
  {
    name: 'Web3',
    blurb: 'Tokens, exchanges, infra, on-chain everything.',
    image: 'https://images.unsplash.com/photo-1639762681485-074b7f938ba0?w=800&h=600&fit=crop',
    href: '/industries/web3',
  },
  {
    name: 'AI',
    blurb: 'Foundation models, agents, AI-native products.',
    image: 'https://images.unsplash.com/photo-1677442136019-21780ecad995?w=800&h=600&fit=crop',
    href: '/industries/ai',
  },
  {
    name: 'Fintech',
    blurb: 'Cards, payments, lending, embedded finance.',
    image: 'https://images.unsplash.com/photo-1565514020179-026b92b84bb6?w=800&h=600&fit=crop',
    href: '/industries/fintech',
  },
  {
    name: 'SaaS',
    blurb: 'B2B platforms, vertical SaaS, dev tools.',
    image: 'https://images.unsplash.com/photo-1551434678-e076c223a692?w=800&h=600&fit=crop',
    href: '/industries/saas',
  },
  {
    name: 'Enterprise',
    blurb: 'Top-down digital transformation programmes.',
    image: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=800&h=600&fit=crop',
    href: '/industries/enterprise',
  },
  {
    name: 'Robotics',
    blurb: 'Hardware-software, automation, deep-tech.',
    image: 'https://images.unsplash.com/photo-1485827404703-89b55fcc595e?w=800&h=600&fit=crop',
    href: '/industries/robotics',
  },
];
---

<section class="c8-ind">
  <div class="c8-ind__inner">
    <header class="c8-ind__head" data-reveal-stagger="100">
      <p class="c8-ind__eyebrow" data-reveal="up">— Industries we serve</p>
      <h2 class="c8-ind__heading" data-reveal="up">
        Built for the categories <span class="c8-ind__heading-accent">that move next.</span>
      </h2>
    </header>

    <div class="c8-ind__grid" data-reveal-stagger="120">
      {industries.map((i) => (
        <a class="c8-ind__card" href={i.href} data-reveal="up">
          <div class="c8-ind__media">
            <img src={i.image} alt={`${i.name} industry`} loading="lazy" />
            <div class="c8-ind__veil"></div>
          </div>
          <div class="c8-ind__text">
            <h3 class="c8-ind__name">{i.name}</h3>
            <p class="c8-ind__blurb">{i.blurb}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .c8-ind {
    background: var(--color-bg);
    color: #0a0a0a;
    padding: clamp(4.5rem, 9vh, 7rem) clamp(1.5rem, 5vw, 5rem);
  }
  .c8-ind__inner {
    max-width: 1440px;
    margin: 0 auto;
  }
  .c8-ind__head {
    max-width: 48rem;
    margin: 0 0 clamp(2.5rem, 5vh, 3.5rem);
  }
  .c8-ind__eyebrow {
    margin: 0 0 1rem;
    font-family: var(--montreal);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c8-gold-dark);
  }
  .c8-ind__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.2vw, 3.1rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .c8-ind__heading-accent {
    color: var(--c8-gold-dark);
    font-weight: 400;
  }

  .c8-ind__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 1.6vw, 1.5rem);
  }

  .c8-ind__card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 16px;
    text-decoration: none;
    color: #fff;
    isolation: isolate;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.5s ease;
    box-shadow: 0 18px 38px -22px rgba(0,0,0,0.4);
  }
  .c8-ind__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 28px 56px -22px rgba(0,0,0,0.5), 0 0 50px -12px var(--c8-gold-soft);
  }

  .c8-ind__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .c8-ind__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .c8-ind__card:hover .c8-ind__media img {
    transform: scale(1.06);
  }
  .c8-ind__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0,0,0,0.05) 0%,
      rgba(0,0,0,0.15) 45%,
      rgba(0,0,0,0.85) 100%
    );
  }

  .c8-ind__text {
    position: absolute;
    left: 1.5rem;
    right: 1.5rem;
    bottom: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    z-index: 1;
  }
  .c8-ind__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: #fff;
  }
  .c8-ind__blurb {
    margin: 0;
    font-family: var(--montreal);
    font-size: 0.9rem;
    line-height: 1.4;
    color: rgba(255,255,255,0.82);
    max-width: 24rem;
  }

  @media (max-width: 1024px) {
    .c8-ind__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .c8-ind__grid { grid-template-columns: 1fr; gap: 1rem; }
    .c8-ind__card { aspect-ratio: 16 / 11; }
  }
</style>
