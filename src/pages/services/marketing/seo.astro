    <div class="s-proc-card reveal-stagger">
      <div class="s-proc-card__img">
        <img src="https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?w=600&q=80&auto=format&fit=crop" alt="Content production" />
        <span class="s-proc-num">03</span>
      </div>
      <h3>Content production</h3>
