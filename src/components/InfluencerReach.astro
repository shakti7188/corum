---
// Influencer reach — takes the place of the old Statistics "Influencer
// & KOL Marketing" slide. Light background, two-column layout: orbital
// visual on the left, headline + stats + vertical tags + CTA on the
// right. The purple/blue gradient from the reference is retuned to the
// site's gold family so it tracks the rest of the theme.

import { resolveMedia } from '../data/media';

const orbs = [
  {
    cls: 'orb-1',
    img: 'https://images.unsplash.com/photo-1570295999919-56ceb5ecca61?w=300&h=300&fit=crop',
    alt: 'Creator portrait — Web3 / Crypto vertical',
    count: '120K+',
    vertical: 'Web3 / Crypto',
  },
  {
    cls: 'orb-2',
    img: 'https://images.unsplash.com/photo-1529626455594-4ff0802cfb7e?w=300&h=300&fit=crop',
    alt: 'Creator portrait — AI Tech vertical',
    count: '500K+',
    vertical: 'AI Tech',
  },
  {
    cls: 'orb-3',
    img: 'https://images.unsplash.com/photo-1517841905240-472988babdf9?w=300&h=300&fit=crop',
    alt: 'Creator portrait — iGaming vertical',
    count: '2.4M+',
    vertical: 'iGaming',
  },
  {
    cls: 'orb-4',
    img: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=300&h=300&fit=crop',
    alt: 'Creator portrait — Fintech vertical',
    count: '850K+',
