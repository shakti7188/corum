---
// "How we work" — ported from Xcentra's HowItWorks.tsx so the visual
// grammar matches the reference site exactly: centred cards, flanked
// "STEP 0x" eyebrow, premium 3D-gradient icon tiles (one accent colour
// per step), a thin multi-stop connection line running across the icons
// on desktop. Only the step content is Corum8's.

interface Step {
  number: string;
  title: string;
  description: string;
  accentStyle: string; // inline background colour for the rail flanks
  iconId: 'strategy' | 'build' | 'launch' | 'scale';
}

// Accent rails + SVG-icon gradients all pull from the brand gold family
// — same palette as the rest of the page, no blue/emerald/amber/purple.
const steps: Step[] = [
  {
    number: '01',
    title: 'Strategy',
    description:
      'Positioning pressure-tested against data from 1,100+ launches. You leave with a wedge you can defend.',
    accentStyle: 'background:var(--c8-gold)',
    iconId: 'strategy',
  },
  {
    number: '02',
    title: 'Build',
    description:
      'One team. One Slack. One plan. 95+ in-house specialists — no vendor stack, no handoffs.',
    accentStyle: 'background:var(--c8-gold)',
    iconId: 'build',
  },
  {
    number: '03',
    title: 'Launch',
    description:
      'Tier-1 PR, 25,000+ KOLs and community drops — every channel lands inside the same window.',
    accentStyle: 'background:var(--c8-gold)',
    iconId: 'launch',
  },
  {
    number: '04',
    title: 'Scale',
    description:
      'Performance, SEO and retention loops that compound. Launch is the start line, not the finish.',
    accentStyle: 'background:var(--c8-gold)',
    iconId: 'scale',
  },
];
---

<section class="c8-ethos">
  <div class="c8-ethos__inner">
    <div class="c8-ethos__head">
      <h2 class="c8-ethos__heading">
        <span>How Corum8 <span class="c8-ethos__heading-accent">Works</span></span>
      </h2>
      <p class="c8-ethos__intro">
        The exact sequence we&rsquo;ve run across 1,100+ launches — strategy pressure-tested against data, built in-house by one team, launched in a single window, then scaled on compounding loops.
      </p>
    </div>

    <div class="c8-ethos__wrap">
      <div class="c8-ethos__rail" aria-hidden="true">
        <span class="c8-ethos__rail-line"></span>
      </div>

      <div class="c8-ethos__grid">
        {steps.map((s) => (
          <div class="c8-ethos__step">
            <div class="c8-ethos__step-top">
              <span class="c8-ethos__step-rail" style={s.accentStyle}></span>
              <span class="c8-ethos__step-num">Step {s.number}</span>
              <span class="c8-ethos__step-rail" style={s.accentStyle}></span>
            </div>

            <div class="c8-ethos__step-icon">
              {s.iconId === 'strategy' && (
                <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
                  <defs>
                    <linearGradient id="c8-icon-strategy" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#d48e1a" />
                      <stop offset="100%" stop-color="#f5a623" />
                    </linearGradient>
                    <filter id="c8-icon-strategy-shadow">
                      <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#d48e1a" flood-opacity="0.3" />
                    </filter>
                  </defs>
                  <circle cx="24" cy="24" r="18" fill="url(#c8-icon-strategy)" filter="url(#c8-icon-strategy-shadow)" />
                  <circle cx="24" cy="24" r="18" fill="#fff" fill-opacity="0.08" />
                  <circle cx="24" cy="24" r="12" fill="none" stroke="#fff" stroke-width="1.5" stroke-opacity="0.35" />
                  <circle cx="24" cy="24" r="6" fill="none" stroke="#fff" stroke-width="1.5" stroke-opacity="0.5" />
                  <circle cx="24" cy="24" r="2.2" fill="#fff" fill-opacity="0.9" />
                  <circle cx="18" cy="18" r="5" fill="#fff" fill-opacity="0.1" />
                </svg>
              )}
              {s.iconId === 'build' && (
                <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
                  <defs>
                    <linearGradient id="c8-icon-build" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#d48e1a" />
                      <stop offset="100%" stop-color="#f5a623" />
                    </linearGradient>
                    <filter id="c8-icon-build-shadow">
                      <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#d48e1a" flood-opacity="0.3" />
                    </filter>
                  </defs>
                  <path
                    d="M27.5 4.8 24 10l-3.5-5.2-5.6 1.4 1.4 6.2-5.8 2.4-1.4-2.5L4 17.4l4.4 4.4 2.5-1.4 2.4 5.8-6.2 1.4L5.7 33l6.2 1.4 1.4 6.2 5.6-1.4L17.4 44H24l3.5-5.2 5.6 1.4 1.4-6.2 6.2-1.4-1.4-5.6-6.2-1.4 2.4-5.8 2.5 1.4 4.4-4.4-5.1-5.1-2.5 1.4-2.4-5.8 6.2-1.4L33.1 6.2z"
                    fill="url(#c8-icon-build)"
                    filter="url(#c8-icon-build-shadow)"
                    transform="scale(0.88) translate(3.3 3.3)"
                  />
                  <circle cx="24" cy="24" r="7" fill="#fff" fill-opacity="0.22" />
                  <circle cx="24" cy="24" r="3.5" fill="#fff" fill-opacity="0.85" />
                </svg>
              )}
              {s.iconId === 'launch' && (
                <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
                  <defs>
                    <linearGradient id="c8-icon-launch" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#d48e1a" />
                      <stop offset="100%" stop-color="#f5a623" />
                    </linearGradient>
                    <filter id="c8-icon-launch-shadow">
                      <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#d48e1a" flood-opacity="0.3" />
                    </filter>
                  </defs>
                  <!-- Fuselage -->
                  <path d="M24 5 C29 10 32 16 32 23 L32 32 L16 32 L16 23 C16 16 19 10 24 5 Z" fill="url(#c8-icon-launch)" filter="url(#c8-icon-launch-shadow)" />
                  <!-- Highlight -->
                  <path d="M24 5 C29 10 32 16 32 23 L32 32 L16 32 L16 23 C16 16 19 10 24 5 Z" fill="#fff" fill-opacity="0.1" />
                  <!-- Window -->
                  <circle cx="24" cy="19" r="3.5" fill="#fff" fill-opacity="0.85" />
                  <circle cx="24" cy="19" r="1.8" fill="#111" fill-opacity="0.25" />
                  <!-- Fins -->
                  <path d="M16 32 L10 40 L16 36 Z" fill="url(#c8-icon-launch)" />
                  <path d="M32 32 L38 40 L32 36 Z" fill="url(#c8-icon-launch)" />
                  <!-- Exhaust -->
                  <path d="M20 32 L24 42 L28 32 Z" fill="#fff" fill-opacity="0.85" />
                  <path d="M22 34 L24 40 L26 34 Z" fill="#f5a623" />
                </svg>
              )}
              {s.iconId === 'scale' && (
                <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
                  <defs>
                    <linearGradient id="c8-icon-scale" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#d48e1a" />
                      <stop offset="100%" stop-color="#f5a623" />
                    </linearGradient>
                    <filter id="c8-icon-scale-shadow">
                      <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#d48e1a" flood-opacity="0.3" />
                    </filter>
                  </defs>
                  <circle cx="24" cy="24" r="18" fill="url(#c8-icon-scale)" filter="url(#c8-icon-scale-shadow)" />
                  <circle cx="24" cy="24" r="18" fill="#fff" fill-opacity="0.08" />
                  <!-- Upward trend line -->
                  <polyline
                    points="12,30 18,24 23,27 30,18 36,14"
                    stroke="#fff"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <!-- Arrow head at the peak -->
                  <polyline
                    points="30,14 36,14 36,20"
                    stroke="#fff"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <circle cx="18" cy="16" r="4" fill="#fff" fill-opacity="0.1" />
                </svg>
              )}
            </div>

            <h3 class="c8-ethos__step-title">{s.title}</h3>
            <p class="c8-ethos__step-body">{s.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .c8-ethos {
    padding: clamp(5rem, 10vh, 9rem) 0 clamp(5rem, 9vh, 8rem);
    background: var(--color-bg);
    color: var(--color-ink);
    position: relative;
  }

  /* KOTA's .container is a 12-col grid that would squash our step grid
     to 1 col. Skip it — plain block wrapper with explicit max-width. */
  .c8-ethos__inner {
    display: block;
    position: relative;
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: clamp(1.5rem, 5vw, 4rem);
  }

  /* ---------- Heading cluster ---------- */
  .c8-ethos__head {
    text-align: center;
    margin: 0 auto 4rem;
  }

  .c8-ethos__heading {
    margin: 0 0 1.25rem;
    font-size: clamp(2.6rem, 5.6vw, 4.75rem);
    line-height: 1;
    letter-spacing: -0.03em;
    font-weight: 500;
    color: #111;
  }
  .c8-ethos__heading-accent {
    background: linear-gradient(135deg, var(--c8-gold) 0%, var(--c8-gold-light) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  .c8-ethos__intro {
    max-width: 48rem;
    margin: 0 auto;
    font-size: clamp(1.1rem, 1.3vw, 1.25rem);
    line-height: 1.6;
    color: #4a4a4a;
  }

  /* ---------- Grid wrapper + rail ---------- */
  .c8-ethos__wrap {
    position: relative;
  }

  .c8-ethos__rail {
    display: none;
    position: absolute;
    top: calc(1.5rem + 18px + 1rem + 40px); /* centre on icon row */
    left: calc(12.5% + 40px);
    right: calc(12.5% + 40px);
    pointer-events: none;
  }
  .c8-ethos__rail-line {
    display: block;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      rgba(147, 197, 253, 0.4) 0%,
      rgba(252, 211, 77, 0.6) 50%,
      rgba(196, 181, 253, 0.4) 100%
    );
  }

  .c8-ethos__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  /* ---------- Step card ---------- */
  .c8-ethos__step {
    position: relative;
    text-align: center;
  }

  .c8-ethos__step-top {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .c8-ethos__step-rail {
    display: inline-block;
    height: 3px;
    width: 1.5rem;
    border-radius: 999px;
    opacity: 0.3;
  }
  .c8-ethos__step-num {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(107, 114, 128, 0.6);
  }

  .c8-ethos__step-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    margin: 0 auto 1.25rem;
    border-radius: 1rem;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.04);
    box-shadow: 0 20px 28px -16px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .c8-ethos__step-icon svg {
    width: 40px;
    height: 40px;
  }
  .c8-ethos__step:hover .c8-ethos__step-icon {
    transform: scale(1.05);
    box-shadow: 0 28px 40px -18px rgba(0, 0, 0, 0.14);
  }

  .c8-ethos__step-title {
    margin: 0 0 0.75rem;
    font-size: clamp(1.35rem, 1.75vw, 1.6rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    color: #111;
  }

  .c8-ethos__step-body {
    margin: 0;
    font-size: clamp(0.95rem, 1vw, 1rem);
    line-height: 1.65;
    color: #474a52;
  }

  /* ---------- Breakpoints ---------- */
  @media (min-width: 640px) {
    .c8-ethos__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .c8-ethos__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2rem;
    }
    .c8-ethos__rail {
      display: block;
    }
    .c8-ethos__step {
      z-index: 1; /* icon tile sits above the rail */
    }
  }
</style>
