    img: '/images/fanadise.png',
  },
  {
    company: 'KuCoin',
    region: '30+ Markets',
    stage: 'Exchange Engineering',
    headline: 'Tier-1',
    subheadline: 'integrations live',
    body: 'Smart-contract integrations and custody work for one of the largest centralised exchanges by volume. Listings, bridges, liquidity routing — engineered to institutional standards.',
    img: '/images/KuCoin.jpg',
  },
];

const testimonials = [
  {
    quote: 'Corum8 rebuilt our entire DEX smart-contract architecture in six weeks. CertiK passed it with zero critical findings. Their senior team is the only one I trust with production Solidity.',
    name: 'Alex R.',
    role: 'CTO · Decentralised exchange',
    avatar: '/images/corum8-team.png',
  },
  {
    quote: 'The wallet infrastructure they shipped scaled to 500K daily active users without a re-architecture. MPC, recovery, swaps — all working in production from week one.',
    name: 'Sarah K.',
    role: 'Lead Architect · Layer-1 chain',
    avatar: '/images/approach.webp',
  },
  {
    quote: 'We brought them in to audit our internal team\'s code. They found four high-severity issues two prior auditors missed. We now route every release through Corum8 review.',
    name: 'Daniel M.',
    role: 'Head of Engineering · DeFi protocol',
    avatar: '/images/corum8-mission.png',
  },
  {
    quote: 'Senior Rust engineers who actually understand Solana runtime. Our staking program shipped on-chain in eight weeks and has held since — through two halts, three upgrades.',
    name: 'Priya R.',
    role: 'VP Engineering · Solana protocol',
    avatar: '/images/bento3-1.jpg',
  },
  {
    quote: 'On-call rotation across three timezones meant a US-time incident got a London engineer in seven minutes. That alone justified moving infrastructure work to Corum8.',
    name: 'Marcus W.',
    role: 'CTO · RWA platform',
    avatar: '/images/bento4-1.jpg',
  },
];

const faqs = [
  {
    q: 'Why hire Corum8 over individual contractors or boutique shops?',
    a: 'Because production crypto code requires a depth of specialisations no single contractor carries — Solidity, Rust, formal verification, infra, frontend, on-call. We run all of that as one team with shared standards, shared review, and shared incident response. Our senior engineers have shipped through three full crypto cycles. That doesn\'t come from a freelancer marketplace.',
  },
  {
    q: 'Do you only build crypto products?',
    a: 'No — roughly 30% of our work is AI agents, fintech infrastructure, and consumer apps where the same engineering bar applies. The discipline (threat modelling, audit-first, on-call) translates. The runtime shifts. We don\'t take on consumer projects we couldn\'t ship at the standard a regulated exchange would expect.',
  },
  {
    q: 'How do you handle smart-contract audits?',
    a: 'We never rely on a single auditor. Every contract that holds real value gets reviewed internally first, then by two independent third-party firms — typically two of CertiK, OpenZeppelin, Trail of Bits, and Quantstamp. We add fuzzing, formal verification on critical paths, and a public bug bounty before mainnet. Audit reports are shared with clients in full.',
  },
  {
    q: 'Do you use AI in code generation?',
    a: 'AI helps with boilerplate and test scaffolding. It does not write contracts that hold value. Every line of Solidity, Rust, or Move that goes to mainnet is written or reviewed by a named senior engineer. We don\'t ship autonomous AI output to production. The risk profile is wrong for the upside.',
  },
  {
    q: 'What does the engagement structure look like?',
    a: 'Two shapes: dedicated team (a senior engineer or two embedded for the duration) or scoped project (fixed milestones with sign-off gates). Both run with weekly demos, shared docs, and shared CI. Cost structure depends on team size, audit depth, integration count, and chain coverage — never percentage-of-TVL or token-warrant arrangements.',
  },
  {
    q: 'Do you support products after they ship?',
    a: 'Yes. Post-launch we offer monitoring, on-call rotations, contract upgrade work, and incident response. SLOs are written into the engagement. Post-mortems within seven days of any incident, shared with the client team, kept in a public repo where the client allows it. Continuity matters more than initial ship.',
  },
  {
    q: 'What technology stack do you typically work with?',
    a: 'Solidity, Rust, Move on the contract side. TypeScript, React, Next.js, Astro on frontend. Go, Node, Python on backend. Kubernetes and Terraform for infra. Observability through Datadog, Grafana, and chain-specific tooling. We pick stack to fit the system, not to fit a sales pitch.',
  },
  {
    q: 'How do you protect client IP and source code?',
    a: 'Mutual NDAs sign first, before any technical conversation. Source goes into client-owned repos from day one — never our internal code. Access controls audited. Credentials rotated on engagement end. Where regulated environments require it, we run isolated build environments with chain-of-custody logs.',
  },
];
---

<Layout title="Engineering Services — Production-Grade Web3 & AI | Corum8">
  <Fragment slot="head">
    <meta name="description" content="Production-grade engineering for Web3 and AI. 1,100+ shipped systems, $2B+ value secured, 0 critical exploits. Exchange, wallet, DeFi, RWA, AI — built and audited." />
    <link rel="canonical" href="https://corum8.com/services/development" />
  </Fragment>

  <!-- ── HERO ── -->
  <section class="lp-hero">
    <img class="lp-hero__bg-img" src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=1600&q=80&auto=format&fit=crop" alt="" aria-hidden="true" />
    <div class="lp-hero__bg-veil" aria-hidden="true"></div>
    <div class="lp-hero__bg-grid" aria-hidden="true"></div>

    <div class="lp-hero__inner">
      <div class="lp-hero__copy">
        <span class="lp-hero__pillar-badge" aria-label="Service category">
          <span class="lp-hero__pillar-bar" aria-hidden="true"></span>
          Pillar service
        </span>
        <p class="lp-hero__eyebrow">Engineering · Production</p>
        <h1 class="lp-hero__title lp-hero__title--xl">
          Code that ships. <span class="lp-hero__title-accent">And survives production.</span>
        </h1>
        <a class="lp-cta lp-cta--primary lp-cta--lg" href="/contact">Book a technical call →</a>
        <ul class="lp-hero__credibility" aria-label="Credibility signals">
          <li><strong>$2B+</strong> value secured</li>
          <li class="lp-hero__cred-dot" aria-hidden="true">●</li>
          <li><strong>50+</strong> chains</li>
          <li class="lp-hero__cred-dot" aria-hidden="true">●</li>
          <li><strong>0</strong> critical exploits</li>
        </ul>
      </div>

      <div class="lp-hero__feature">
        <figure class="lp-hero__photo">
          <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=1100&q=80&auto=format&fit=crop" alt="Production code on a dark editor — clean lines, monospace" loading="eager" />
          <span class="lp-hero__photo-corner" aria-hidden="true"></span>
        </figure>

        <div class="lp-hero__chip lp-hero__chip--outcome">
          <span class="lp-hero__chip-label">Systems shipped</span>
          <span class="lp-hero__chip-value">1,100<span class="lp-hero__chip-unit">+</span></span>
        </div>

        <div class="lp-hero__chip lp-hero__chip--live">
          <span class="lp-hero__chip-pulse" aria-hidden="true"></span>
          On-call · live now
        </div>
      </div>
    </div>
  </section>

  <!-- ── MARQUEE ── -->
  <section class="lp-marquee" aria-hidden="true">
    <div class="lp-marquee__track">
      <span>Solidity</span><span class="lp-marquee__dot">●</span>
      <span>Rust</span><span class="lp-marquee__dot">●</span>
      <span>Audits</span><span class="lp-marquee__dot">●</span>
      <span>Fuzzing</span><span class="lp-marquee__dot">●</span>
      <span>MPC custody</span><span class="lp-marquee__dot">●</span>
      <span>Zero-knowledge</span><span class="lp-marquee__dot">●</span>
      <span>Modular rollups</span><span class="lp-marquee__dot">●</span>
      <span>On-call</span><span class="lp-marquee__dot">●</span>
      <span>Post-mortems</span><span class="lp-marquee__dot">●</span>
      <span>Solidity</span><span class="lp-marquee__dot">●</span>
      <span>Rust</span><span class="lp-marquee__dot">●</span>
      <span>Audits</span><span class="lp-marquee__dot">●</span>
      <span>Fuzzing</span><span class="lp-marquee__dot">●</span>
      <span>MPC custody</span><span class="lp-marquee__dot">●</span>
      <span>Zero-knowledge</span><span class="lp-marquee__dot">●</span>
      <span>Modular rollups</span><span class="lp-marquee__dot">●</span>
      <span>On-call</span><span class="lp-marquee__dot">●</span>
      <span>Post-mortems</span><span class="lp-marquee__dot">●</span>
    </div>
  </section>

  <!-- ── VOLUME — engineering scoreboard ── -->
  <section class="lp-volume">
    <div class="lp-volume__bg" aria-hidden="true"></div>
    <div class="lp-volume__inner">
      <header class="lp-volume__head">
        <h2 class="lp-volume__title">
          The numbers that hold up to a code review. <span class="lp-volume__title-accent">Shipped, audited, live.</span>
        </h2>
      </header>

      <div class="lp-volume__grid">
        {outputs.map((o, i) => (
          <article class={`lp-volume-card lp-volume-card--${o.size} lp-volume-card--${o.kind}`} style={`--vol-i: ${i};`}>
            <span class="lp-volume-card__bar" aria-hidden="true"></span>

            <span class="lp-volume-card__deco" aria-hidden="true">
              {o.kind === 'waves' && (
                <svg viewBox="0 0 200 200" preserveAspectRatio="xMidYMid slice">
                  <circle class="lp-deco-wave lp-deco-wave--1" cx="160" cy="40" r="20" />
                  <circle class="lp-deco-wave lp-deco-wave--2" cx="160" cy="40" r="40" />
                  <circle class="lp-deco-wave lp-deco-wave--3" cx="160" cy="40" r="60" />
                  <circle class="lp-deco-wave lp-deco-wave--4" cx="160" cy="40" r="80" />
                </svg>
              )}
              {o.kind === 'nodes' && (
                <svg viewBox="0 0 200 200" preserveAspectRatio="xMidYMid slice">
                  <line class="lp-deco-node-link" x1="40"  y1="40"  x2="120" y2="80" />
                  <line class="lp-deco-node-link" x1="120" y1="80"  x2="170" y2="40" />
                  <line class="lp-deco-node-link" x1="120" y1="80"  x2="160" y2="140" />
                  <line class="lp-deco-node-link" x1="40"  y1="40"  x2="60"  y2="130" />
                  <line class="lp-deco-node-link" x1="60"  y1="130" x2="160" y2="140" />
                  <circle class="lp-deco-node lp-deco-node--1" cx="40"  cy="40"  r="4" />
                  <circle class="lp-deco-node lp-deco-node--2" cx="120" cy="80"  r="5" />
                  <circle class="lp-deco-node lp-deco-node--3" cx="170" cy="40"  r="3" />
                  <circle class="lp-deco-node lp-deco-node--4" cx="60"  cy="130" r="3" />
                  <circle class="lp-deco-node lp-deco-node--5" cx="160" cy="140" r="4" />
                </svg>
              )}
              {o.kind === 'bars' && (
                <svg viewBox="0 0 200 200" preserveAspectRatio="xMidYMid slice">
                  <rect class="lp-deco-bar lp-deco-bar--1" x="20"  y="120" width="22" height="60" rx="3" />
                  <rect class="lp-deco-bar lp-deco-bar--2" x="56"  y="90"  width="22" height="90" rx="3" />
                  <rect class="lp-deco-bar lp-deco-bar--3" x="92"  y="60"  width="22" height="120" rx="3" />
                  <rect class="lp-deco-bar lp-deco-bar--4" x="128" y="40"  width="22" height="140" rx="3" />
                  <rect class="lp-deco-bar lp-deco-bar--5" x="164" y="20"  width="22" height="160" rx="3" />
                </svg>
              )}
              {o.kind === 'stack' && (
                <svg viewBox="0 0 200 200" preserveAspectRatio="xMidYMid slice">
                  <rect class="lp-deco-doc lp-deco-doc--3" x="60"  y="40" width="100" height="130" rx="6" />
                  <rect class="lp-deco-doc lp-deco-doc--2" x="50"  y="50" width="100" height="130" rx="6" />
                  <rect class="lp-deco-doc lp-deco-doc--1" x="40"  y="60" width="100" height="130" rx="6" />
                  <line class="lp-deco-doc-line" x1="56"  y1="86"  x2="120" y2="86" />
                  <line class="lp-deco-doc-line" x1="56"  y1="106" x2="120" y2="106" />
                  <line class="lp-deco-doc-line" x1="56"  y1="126" x2="100" y2="126" />
                </svg>
              )}
              {o.kind === 'pulse' && (
                <svg viewBox="0 0 200 200" preserveAspectRatio="xMidYMid slice">
                  <circle class="lp-deco-pulse-ring lp-deco-pulse-ring--1" cx="100" cy="100" r="30" />
                  <circle class="lp-deco-pulse-ring lp-deco-pulse-ring--2" cx="100" cy="100" r="30" />
                  <circle class="lp-deco-pulse-ring lp-deco-pulse-ring--3" cx="100" cy="100" r="30" />
                  <circle class="lp-deco-pulse-core" cx="100" cy="100" r="8" />
                  <circle class="lp-deco-pulse-dot" cx="40"  cy="60"  r="3" />
                  <circle class="lp-deco-pulse-dot" cx="160" cy="50"  r="3" />
                  <circle class="lp-deco-pulse-dot" cx="50"  cy="155" r="3" />
                  <circle class="lp-deco-pulse-dot" cx="160" cy="150" r="3" />
                </svg>
              )}
            </span>

            <div class="lp-volume-card__top">
              <span class="lp-volume-card__num">{o.num}</span>
              <span class="lp-volume-card__period">{o.period}</span>
            </div>
            <h3 class="lp-volume-card__label">{o.label}</h3>
            <p class="lp-volume-card__note">{o.note}</p>
          </article>
        ))}
      </div>

      <aside class="lp-volume__trust" aria-label="Categories of clients we work with">
        <span class="lp-volume__trust-label">Built at this bar for</span>
        <ul class="lp-volume__trust-list">
          <li>Tier-1 exchanges</li>
          <li class="lp-volume__trust-dot" aria-hidden="true">●</li>
          <li>Layer-1 chains</li>
          <li class="lp-volume__trust-dot" aria-hidden="true">●</li>
          <li>DeFi protocols at scale</li>
          <li class="lp-volume__trust-dot" aria-hidden="true">●</li>
          <li>Regulated payment networks</li>
          <li class="lp-volume__trust-dot" aria-hidden="true">●</li>
          <li>Series-B AI infrastructure</li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- ── STATS ── -->
  <section class="lp-bignumbers" id="lp-stats">
    <div class="lp-bignumbers__inner">
      {stats.map((s) => (
        <article class="lp-bignum">
          <div class="lp-bignum__top">
            <span
              class="lp-bignum__val"
              data-count-target={s.target}
              data-count-prefix={s.prefix}
              data-count-suffix={s.suffix}
            >{s.prefix}0{s.suffix}</span>
            {s.spark === 'bars' ? (
              <svg class="lp-bignum__spark" viewBox="0 0 100 30" preserveAspectRatio="none">
                <rect x="2"  y="18" width="14" height="12" rx="2" fill="var(--c8-gold)" opacity="0.55" />
                <rect x="22" y="14" width="14" height="16" rx="2" fill="var(--c8-gold)" opacity="0.7" />
                <rect x="42" y="10" width="14" height="20" rx="2" fill="var(--c8-gold)" opacity="0.85" />
                <rect x="62" y="6"  width="14" height="24" rx="2" fill="var(--c8-gold)" />
                <rect x="82" y="2"  width="14" height="28" rx="2" fill="var(--c8-gold-dark)" />
              </svg>
            ) : s.spark === 'globe' ? (
