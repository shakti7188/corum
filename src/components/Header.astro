<style is:global>
  /* ─── Navbar tokens — bridged to the brand palette in global.css so
     the header tracks the rest of the site, not a one-off scheme. ─── */
  :root {
    --nb-brand-gold:     var(--c8-gold);
    --nb-brand-gold-rgb: 242, 191, 34;
    --nb-brand-gold-hover: var(--c8-gold-light);
    --nb-brand-dark:     #222222;
    --nb-bg-elevated:    var(--color-bg-card, #ffffff);
    --nb-bg-glass:       color-mix(in srgb, var(--color-bg) 92%, transparent);
    --nb-bg-dark:        var(--color-bg-dark);
    --nb-text-primary:   #111111;
    --nb-text-secondary: #4A4A4A;
    --nb-text-muted:     #888888;
    --nb-text-on-dark:   #F0F0F0;
    --nb-text-on-dark-muted: #B0B0B0;
    --nb-border-subtle:  rgba(0, 0, 0, 0.05);
    --nb-border-default: rgba(0, 0, 0, 0.08);
    --nb-shadow-lg:      0 8px 40px rgba(0, 0, 0, 0.08);
    --nb-shadow-glow:    0 0 40px var(--c8-gold-soft);
    --nb-ease-expo:      cubic-bezier(0.16,1,0.3,1);
    --nb-ease-quart:     cubic-bezier(0.76,0,0.24,1);
    --nb-radius-sm:      8px;
    --nb-radius-lg:      20px;
    --nb-radius-pill:    9999px;
  }

  /* ─── Navbar shell ─── */
  .navbar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 200;
    padding: 16px 0;
    transition: background 0.35s var(--nb-ease-expo),
                border-color 0.35s var(--nb-ease-expo),
                padding 0.35s var(--nb-ease-expo),
                box-shadow 0.35s var(--nb-ease-expo);
    /* No border until scrolled */
    border-bottom: 1px solid transparent;
  }

  .navbar--on-dark .nav-link { color: rgba(255,255,255,0.75); }
  .navbar--on-dark .nav-link:hover { color: #fff; }
  .navbar--on-dark .menu-toggle span { background: #fff; }

  .navbar.scrolled {
    background: rgba(255,255,255,0.88);
    backdrop-filter: saturate(160%) blur(18px);
    -webkit-backdrop-filter: saturate(160%) blur(18px);
    border-bottom: 1px solid rgba(0,0,0,0.07);
    box-shadow: 0 1px 24px rgba(0,0,0,0.06);
    padding: 10px 0;
  }
  .navbar.scrolled .nav-link { color: var(--nb-text-secondary); }
  .navbar.scrolled .nav-link:hover { color: var(--nb-text-primary); }
  .navbar.scrolled .menu-toggle span { background: var(--nb-text-primary); }

  /* When a mega-menu panel is open, give the bar a solid white bg
     so the dark text and gold CTA stay readable over any page content.
     The CTA button is intentionally left untouched — it keeps its gold style. */
  .navbar.mega-open {
    background: rgba(255,255,255,0.97) !important;
    border-bottom: 1px solid rgba(0,0,0,0.07) !important;
    box-shadow: none !important;
  }
  .navbar.mega-open .nav-link { color: var(--nb-text-secondary) !important; }
  .navbar.mega-open .nav-link:hover { color: var(--nb-text-primary) !important; }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0 clamp(24px, 5vw, 80px);
  }

  /* ─── Logo ─── */
  .navbar-logo {
    display: flex; align-items: center;
    z-index: 60;
    text-decoration: none;
  }
  .navbar-logo img { height: 32px; width: auto; }
  .navbar-logo:hover { opacity: 0.9; }

  /* ─── Nav links row ─── */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-link {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--nb-text-secondary);
    position: relative;
    padding: 8px 0;
    text-decoration: none;
    transition: color 0.3s var(--nb-ease-expo);
    white-space: nowrap;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    width: 100%; height: 2px;
    background: var(--nb-brand-gold);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--nb-ease-expo);
  }
  .nav-link:hover::after,
  .nav-link.active::after { transform: scaleX(1); transform-origin: left; }
  .nav-link:hover { color: var(--nb-text-primary); }
  .nav-link.active { color: var(--nb-brand-gold); }

  /* ─── Nav CTA button ─── */
  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 24px;
    border-radius: var(--nb-radius-pill);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    color: #111;
    background: var(--nb-brand-gold);
    text-decoration: none;
    transition: all 0.3s var(--nb-ease-expo);
    white-space: nowrap;
    box-shadow: 0 4px 20px -8px rgba(242,191,34,0.5);
  }
  .nav-cta:hover {
    background: #111;
    color: var(--nb-brand-gold);
    transform: translateY(-1px);
    box-shadow: 0 8px 28px -8px rgba(0,0,0,0.4);
  }

  /* ─── Mega Menu ─── */
  .nav-item { position: relative; }

  .mega-menu {
    position: fixed;
    top: 64px; left: 0; right: 0;
    background: var(--nb-bg-elevated);
    border-bottom: 1px solid var(--nb-border-default);
    padding: 18px clamp(24px, 5vw, 80px) 22px;
    max-height: calc(100vh - 72px);
    overflow-y: auto;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-10px);
    transition: all 0.35s var(--nb-ease-expo);
    box-shadow: var(--nb-shadow-lg);
    z-index: 190;
  }
  .navbar.scrolled .mega-menu { top: 52px; }

  .nav-item:hover .mega-menu,
  .nav-item.active .mega-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .mega-menu-inner {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 260px;
    gap: 22px;
    width: 100%;
    max-width: var(--c8-section-max, 1320px);
    margin: 0 auto;
  }

  /* Compact variant used by Industries + Resources — two categories
     + CTA card instead of three. Keeps Marketing / Development /
     Industries / Resources visually unified under a single mega-menu
     style, just narrower because there's less to show. */
  .mega-menu-inner--compact {
    grid-template-columns: 1fr 1fr 280px;
    max-width: 1100px;
  }

  .mega-menu-category-title {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
