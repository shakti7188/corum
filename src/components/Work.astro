---
// Work section — simplified to match the raw-clone KOTA treatment:
// • Heading + right-side copy aside (instead of single centered heading)
// • Each card shows only brand name + year; the tags / one-line heading
//   move into the hover image overlay, which KOTA already wires up via
//   ProjectCard_imageOverlay__OCawr.
// The grid positions and slide-in animation are preserved — only the
// internal card composition changed.
const arrowGrad = {
  id: 'd',
  stops: [
    { offset: '0', color: '#d48e1a' },
    { offset: '1', color: '#ffc857' },
  ],
};

// Intro / Corum8 brand video moved out of this grid into the new Showcase
// section above Ethos (src/components/Showcase.astro). Keeping the data
// shape here in case we want to reintroduce it later:
//   {
//     size: 'large', isIntro: true, href: '#our-work', name: 'Corum8',
//     year: '2026', video: '/media/bg2.mp4',
//     heading: 'We build, market and scale Web3, AI and fintech companies that refuse to blend in.',
//     tags: ['Global Marketing', 'PR', 'Full-Stack Development', 'Web3 · AI · Fintech'],
//   }

// Four featured case studies — each one ships with a specific outcome
// number pulled straight from docs/CONTENT.md. Headings lead with the
// result so the card reads like a headline, not a brochure. Metarix and
// Binance kept in the file-level history but hidden from the homepage.
const projects = [
  {
    size: 'small',
    href: '/work/cashaa',
    name: 'Cashaa',
    year: '2022',
    category: 'Token Launch',
    heading: '$32M raised',
    description: 'End-to-end token launch campaign — media outreach across 200+ publications, Tier-1 crypto KOL seeding, and a full community build across Discord and Telegram from zero to active.',
    tags: ['PR', 'Influencer', 'Community'],
    poster: '/images/cashaa.jpg',
  },
  {
    size: 'small',
    href: '/work/fanadise',
    name: 'Fanadise',
    year: '2024',
    category: 'Web3 Growth',
    heading: '$5M raised',
    description: 'Full-stack Web3 fan platform — smart contract development, NFT mechanics and a coordinated multi-channel growth campaign that drove raise momentum from day one.',
    tags: ['Development', 'Community', 'Influencer'],
    poster: '/images/fanadise.png',
  },
  {
    size: 'small',
    href: '/work/ubuntu-tribe',
    name: 'Ubuntu Tribe',
    year: '2024',
    category: 'Event Launch',
    heading: 'Token2049 Dubai — global stage',
    description: 'Compressed, multi-channel launch window around Token2049 Dubai. PR, KOL activation and live community events synchronized across a single 72-hour burst — global presence in under a week.',
    tags: ['PR', 'KOL', 'Community'],
    logo: '/clients/ubuntu-tribe.png',
    // Ubuntu Tribe uses a static image instead of a video clip — the case
    // is a live-event moment that reads better as a single strong photo.
    poster: '/images/utribe.png',
  },
  {
    size: 'small',
    href: '/work/kucoin',
    name: 'KuCoin',
    year: '2024',
    category: 'Strategic PR',
    heading: 'Tier-1 exchange, every market',
    description: 'Ongoing strategic PR retainer for one of the world\'s top exchanges — tier-1 publication placement, editorial strategy and proactive narrative management across 30+ priority markets.',
    tags: ['PR', 'Exchange', 'Global'],
    poster: '/images/KuCoin.jpg',
  },
];

const allCards = [...projects];
---

<div class="Work_work__rSI8c" id="our-work">
  <div class="DarkThemeSwitch_cover__hn_xc"></div>
  <div class="container">
    <div class="Work_text__WI9A4">
      <h2 class="Work_heading__pbv4g">
        <div class="LargeHeading_headingOuter__i9qcd">
          <span class="Work_heading__pbv4g">Our</span><span class="Work_heading__pbv4g Work_bottom__rzrzH">Work</span>
        </div>
      </h2>
      <div class="Work_rightText__zx_Y0">
        <h3>
          <span data-blur-reveal="true">Making brands a damn site better.</span>
        </h3>
        <p>
          <span data-blur-reveal="true">Featured work across Web3, AI and fintech — token launches, PR programmes and full-stack growth campaigns engineered to move markets.</span>
        </p>
      </div>
    </div>
  </div>
  <div class="Work_projects__A5q77">
    <div class="AnimatedGrid_grid__otAMD">
      <div class="container">
        {allCards.map((p) => (
          <a
            class={`ProjectCard_project__d1wbY ${p.size === 'large' ? 'ProjectCard_large__JOQbv' : 'ProjectCard_small__xsL92'}${p.isIntro ? ' ProjectCard_intro__c8' : ''}`}
            data-animation="grid-item"
            href={p.href}
          >
            <div class="ProjectCard_projectText__o770X">
              <h3>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14.78 14.78">
                  <defs>
                    <linearGradient id={arrowGrad.id} x1="3.54" x2="13.98" y1="3.54" y2="13.99" gradientUnits="userSpaceOnUse">
                      {arrowGrad.stops.map((s) => <stop offset={s.offset} stop-color={s.color}></stop>)}
                    </linearGradient>
                  </defs>
                  <path fill={`url(#${arrowGrad.id})`} stroke-width="0" d="M13.25 12.18L13.25 0.23 14.78 0.23 14.78 14.76 14.74 14.76 14.74 14.78 0.21 14.78 0.21 13.25 12.18 13.25 0 1.08 1.08 0 13.25 12.18z"></path>
                </svg>{p.name}
              </h3>
              <p>{p.year}</p>
            </div>
            <div class="ProjectCard_projectImage__Nfx9I">
              <div class="ProjectCard_imageOverlay__OCawr c8-work-overlay">
                {p.logo && (
                  <img src={p.logo} alt={p.name} class="c8-work-overlay__logo" />
                )}
                <span class="c8-work-overlay__category">{p.category}</span>
                <p class="c8-work-overlay__heading">{p.heading}</p>
                <p class="c8-work-overlay__desc">{p.description}</p>
                <ul class="ProjectCard_tags__XdVcf">
                  {p.tags.map((t) => <li>{t}</li>)}
                </ul>
              </div>
              {p.poster && (
                <span class="Image_image__RAAdZ Image_fill__EiIzS"><img data-src={p.poster} alt="" fetchpriority="low" class="lazyload" /></span>
              )}
              {p.video && (
                <video data-src={p.video} class="ProjectCard_video__AheFz c8-lazy-video" muted="true" loop="true" preload="none" playsinline="true"></video>
              )}
            </div>
          </a>
        ))}
        <div class="Work_buttonContainer__Owbmu">
          <span class="FadeInUp_container___uxva" data-fill="false"><div class="Magnetic_magnetic__LncOy" data-fill="false">
            <div class="Button_button__JJiqJ Button_white__MQaf2" data-direction="forwards">
              <a class="Button_inner__fnyH6" href="/work"><span class="Button_border__hirH2"></span><span class="Button_text__IZaCD"><span class="Button_textInner__JTTHe">View all projects</span><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 17.1 15.17" class="Button_buttonArrow__0W9XI">
                <path d="m17.1,7.58s-.01-.04-.01-.06c.01-.22-.06-.45-.24-.61L9.23.19c-.31-.27-.78-.24-1.06.07-.27.31-.24.78.07,1.06l6.26,5.52H.75c-.41,0-.75.34-.75.75s.34.75.75.75h13.74l-6.26,5.52c-.31.27-.34.75-.07,1.06.15.17.35.25.56.25.18,0,.35-.06.5-.19l7.62-6.72c.18-.16.25-.39.24-.61,0-.02.01-.04.01-.06Z" fill="currentColor"></path></svg></span></a>
            </div>
          </div></span>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .Work_work__rSI8c {
    background-color: var(--color-bg-dark) !important;
    padding-bottom: 15vh;
  }

  /* Grid preserves KOTA's spacing but we add a little extra room beneath the
     intro card so the Corum8 video isn't crowded by the first small case. */
  .Work_projects__A5q77 .AnimatedGrid_grid__otAMD .container {
    row-gap: 4rem !important;
    column-gap: 2.5rem !important;
  }
  .ProjectCard_intro__c8 { margin-bottom: 1.5rem !important; }
  .Work_buttonContainer__Owbmu { margin-top: 5rem !important; }

  /* Intro card reads as brand statement rather than case-study metric. */
  .ProjectCard_intro__c8 .ProjectCard_projectText__o770X p {
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  /* Gold "Our Work" title — matches the section's role as the portfolio
     anchor. KOTA's default is white against the dark panel; re-tint the
     second half ("Work") to brand gold so it pops the eye at scroll-in. */
  .Work_work__rSI8c .Work_heading__pbv4g .Work_bottom__rzrzH {
    background: linear-gradient(135deg, var(--c8-gold) 0%, var(--c8-gold-light) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent !important;
    -webkit-text-fill-color: transparent;
  }

  /* Overlay — always visible. Bottom 40% of the card is the "content zone":
     dark and solid so copy sits clean. Top 60% stays light so the media is
     the hero. Ramp is tight between the two zones so the handoff is crisp. */
  .Work_work__rSI8c .ProjectCard_imageOverlay__OCawr.c8-work-overlay {
    display: flex !important;
    opacity: 1 !important;
    background:
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0) 0%,
        rgba(0, 0, 0, 0) 55%,
        rgba(0, 0, 0, 0.82) 62%,
        rgba(0, 0, 0, 0.96) 100%
      ) !important;
    justify-content: flex-end;
    flex-direction: column;
    gap: 0.6rem;
    /* Content block reserves ~40% of the card's height so the copy lives
       inside the dark zone without crowding. */
    padding: clamp(1.2rem, 2.4vw, 1.75rem) clamp(1.1rem, 2.5vw, 1.85rem) clamp(1.2rem, 2.5vw, 1.85rem) !important;
    min-height: 40%;
    transition: background 0.4s ease;
  }
  .Work_work__rSI8c .ProjectCard_project__d1wbY:hover .c8-work-overlay {
    background:
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0) 0%,
        rgba(0, 0, 0, 0.05) 50%,
        rgba(0, 0, 0, 0.88) 62%,
        rgba(0, 0, 0, 0.98) 100%
      ) !important;
  }

  /* Client logo badge — sits at the top of the overlay content zone,
     above the category pill. White version reads clean on dark gradient. */
  .c8-work-overlay__logo {
    display: block;
    height: 28px;
    width: auto;
    max-width: 120px;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.9;
    margin-bottom: 0.6rem;
  }

  /* Category pill — small gold-tinted label above the headline */
  .c8-work-overlay__category {
    display: inline-block;
    width: fit-content;
    font-family: var(--montreal, system-ui, sans-serif);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c8-gold, #f5a623);
    padding: 0.2rem 0.65rem;
    border: 1px solid rgba(245, 166, 35, 0.45);
    border-radius: 999px;
    background: rgba(245, 166, 35, 0.1);
    margin-bottom: 0.1rem;
  }

  /* Main result headline — bigger display size, mid-weight so it reads
     elegant rather than shouty. */
  .c8-work-overlay__heading {
    font-family: var(--montreal, system-ui, sans-serif);
    font-size: clamp(1.5rem, 2.8vw, 2.1rem) !important;
    font-weight: 500;
    line-height: 1.15;
    color: #fff !important;
    margin: 0;
    letter-spacing: -0.025em;
  }

  /* Description — reads clearly under the headline, two lines. */
  .c8-work-overlay__desc {
    font-family: var(--montreal, system-ui, sans-serif);
    font-size: clamp(0.85rem, 1.05vw, 0.95rem);
    font-weight: 400;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.78);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Tag chips */
  .Work_work__rSI8c .c8-work-overlay .ProjectCard_tags__XdVcf {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    list-style: none;
    margin: 0.2rem 0 0;
    padding: 0;
  }
  .Work_work__rSI8c .c8-work-overlay .ProjectCard_tags__XdVcf li {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 0.22rem 0.58rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.75);
    text-transform: uppercase;
  }

  /* Hover — lift the whole card, inset a gold border glow, scale the
     poster/video underneath slightly. No reveal; details already shown. */
  .Work_work__rSI8c .ProjectCard_project__d1wbY .ProjectCard_projectImage__Nfx9I {
    position: relative;
    overflow: hidden;
    border-radius: 1.25rem;
    transition:
      transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.5s ease;
  }
  .Work_work__rSI8c .ProjectCard_project__d1wbY .ProjectCard_projectImage__Nfx9I img,
  .Work_work__rSI8c .ProjectCard_project__d1wbY .ProjectCard_projectImage__Nfx9I video {
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .Work_work__rSI8c .ProjectCard_project__d1wbY:hover .ProjectCard_projectImage__Nfx9I {
    transform: translateY(-6px);
    box-shadow:
      0 24px 48px -16px rgba(0, 0, 0, 0.5),
      inset 0 0 0 2px var(--c8-gold);
  }
  .Work_work__rSI8c .ProjectCard_project__d1wbY:hover .ProjectCard_projectImage__Nfx9I img,
  .Work_work__rSI8c .ProjectCard_project__d1wbY:hover .ProjectCard_projectImage__Nfx9I video {
    transform: scale(1.04);
  }
  /* Stop KOTA's default hover-reveal from fighting our always-visible overlay. */
  .Work_work__rSI8c .ProjectCard_project__d1wbY:hover .ProjectCard_imageOverlay__OCawr {
    opacity: 1 !important;
  }
</style>

<script is:inline>
  // Lazy-load project-card videos. With 6 cards each carrying 150–600 KB of
  // video, eager loading would push ~2.5 MB through the wire before a user
  // has even scrolled. Instead: start at preload="none", swap `data-src → src`
  // when the card gets within 400 px of the viewport, then autoplay.
  (function () {
    var vids = document.querySelectorAll('.c8-lazy-video');
    if (!vids.length) return;

    var load = function (v) {
      if (v.dataset.loaded === '1') return;
      var src = v.getAttribute('data-src');
      if (!src) return;
      v.setAttribute('src', src);
      v.setAttribute('preload', 'metadata');
      v.dataset.loaded = '1';
      // `play()` returns a promise on modern browsers; swallow rejections
      // (autoplay policies may block until user interaction).
      var p = v.play();
      if (p && typeof p.catch === 'function') p.catch(function () {});
    };

    if (!('IntersectionObserver' in window)) {
      vids.forEach(load);
      return;
    }

    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          load(entry.target);
          io.unobserve(entry.target);
        }
      });
    }, { rootMargin: '400px 0px' });

    vids.forEach(function (v) { io.observe(v); });
  })();
</script>
