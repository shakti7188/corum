---
// PR Authority — dark editorial band that stages the earned-media
// proof points. Includes a layered "coverage wall" visual between
// the heading and stats: mock article preview cards from the named
// Tier-1 outlets, with a circular lens floating across them as if
// scanning the placements.

const tierOneLogos = [
  { src: '/media-logos/cointelegraph.png',   alt: 'CoinTelegraph' },
  { src: '/media-logos/decrypt.png',         alt: 'Decrypt' },
  { src: '/media-logos/blockworks.png',      alt: 'Blockworks' },
  { src: '/media-logos/yahoo-finance.png',   alt: 'Yahoo Finance' },
  { src: '/media-logos/Forbes.webp',         alt: 'Forbes' },
  { src: '/media-logos/Bloomberg.webp',      alt: 'Bloomberg' },
  { src: '/media-logos/Coindesk.webp',       alt: 'CoinDesk' },
  { src: '/media-logos/theblock.png',        alt: 'The Block' },
];

// Mock-article cards for the coverage wall. Headlines are written
// to feel plausibly drafted from Corum8 case-study outcomes — they
// reference real numbers (Cashaa $32M, Binance $800M+ monthly,
// Fanadise $5M) but the article URLs are illustrative, not real.
type Article = {
  outlet: string;
  logo: string;
  invertLogo?: boolean;
  headline: string;
  meta: string;
  cls: string;
};
const articles: Article[] = [
  {
    outlet: 'CoinTelegraph',
    logo: '/media-logos/cointelegraph.png',
    invertLogo: false,
    headline: 'Inside the Affiliate Network Driving $800M+ in Monthly Volume',
    meta: 'Markets · 5 min read',
    cls: 'a-1',
  },
  {
    outlet: 'Forbes',
    logo: '/media-logos/Forbes.webp',
    invertLogo: false,
    headline: 'How One Agency Is Powering The Next Wave Of Web3 Brands',
    meta: 'Crypto · Editorial',
    cls: 'a-2',
  },
  {
    outlet: 'Decrypt',
    logo: '/media-logos/decrypt.png',
    invertLogo: false,
    headline: 'The Community Playbook Behind Cashaa\'s $32M Raise',
    meta: 'Long read · Web3',
    cls: 'a-3',
  },
  {
    outlet: 'Yahoo Finance',
    logo: '/media-logos/yahoo-finance.png',
    invertLogo: false,
    headline: 'Earned Media in Crypto: Why Founders Are Doubling Down on PR',
    meta: 'Finance · Op-ed',
    cls: 'a-4',
  },
];
---

<section class="c8-pr">
  <div class="c8-pr__inner">
    <header class="c8-pr__head" data-reveal-stagger="100">
      <div class="c8-pr__head-text">
        <p class="c8-pr__eyebrow" data-reveal="up">Public Relations &amp; Earned Media</p>
        <h2 class="c8-pr__heading" data-reveal="up">
          Coverage that <span class="c8-pr__heading-accent">moves markets.</span>
        </h2>
        <p class="c8-pr__sub" data-reveal="up">
          Earned, not bought. We've secured <strong>8,250+ placements</strong> across
          CoinTelegraph, Decrypt, TechCrunch, Blockworks, Yahoo Finance and the rest
          of the Tier-1 list — the pitches we write, the releases we ship, and the
          relationships we've spent a decade building.
        </p>
        <p class="c8-pr__sub c8-pr__sub--soft" data-reveal="up">
          From launch-week splashes to ongoing media programmes that keep your narrative
          in front of investors, partners and customers — quarter after quarter.
        </p>
      </div>

      <!-- Coverage wall — sits in the empty space alongside the head copy
           so we don't push the section taller. Cards intentionally angle
           and overlap so the right side reads as a press cluster, not a
           strict 50/50 second column. -->
      <div class="c8-pr__wall" aria-hidden="true">
        <div class="c8-pr__wall-grid">
          {articles.map((a) => (
            <article class={`c8-pr__article ${a.cls}`}>
              <header class="c8-pr__article-meta">
                <img src={a.logo} alt="" class={`c8-pr__article-logo${a.invertLogo ? ' c8-pr__article-logo--invert' : ''}`} />
                <span class="c8-pr__article-time">{a.meta}</span>
              </header>
              <p class="c8-pr__article-headline">{a.headline}</p>
              <span class="c8-pr__article-rule"></span>
              <span class="c8-pr__article-foot">— {a.outlet}</span>
            </article>
          ))}
        </div>
        <!-- Floating lens — circular ring that drifts across the cluster -->
        <div class="c8-pr__lens" aria-hidden="true">
          <span class="c8-pr__lens-ring"></span>
          <span class="c8-pr__lens-handle"></span>
          <span class="c8-pr__lens-flare"></span>
        </div>
      </div>
    </header>

    <div class="c8-pr__stats" data-reveal-stagger="120">
      <div class="c8-pr__stat" data-reveal="up">
        <span class="c8-pr__stat-num">8,250+</span>
        <span class="c8-pr__stat-lbl">Earned placements to date</span>
      </div>
      <div class="c8-pr__stat" data-reveal="up">
        <span class="c8-pr__stat-num">10,000+</span>
        <span class="c8-pr__stat-lbl">Active press relationships</span>
      </div>
      <div class="c8-pr__stat" data-reveal="up">
        <span class="c8-pr__stat-num">30+</span>
        <span class="c8-pr__stat-lbl">Markets covered worldwide</span>
      </div>
    </div>

    <div class="c8-pr__logos" data-reveal="up">
      {tierOneLogos.map((m) => (
        <img src={m.src} alt={m.alt} loading="lazy" class="c8-pr__logo" />
      ))}
    </div>
  </div>
</section>

<style is:global>
  .c8-pr {
    position: relative;
    background: #0a0a0a;
    color: #fff;
    padding: clamp(4.5rem, 9vh, 7.5rem) clamp(1.5rem, 5vw, 5rem);
    overflow: hidden;
    isolation: isolate;
  }
  .c8-pr::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(900px circle at 80% 20%, rgba(242,191,34,0.06) 0%, transparent 60%),
      radial-gradient(800px circle at 10% 90%, rgba(242,191,34,0.04) 0%, transparent 60%);
    pointer-events: none;
    z-index: 0;
  }
  .c8-pr__inner {
    position: relative;
    z-index: 1;
    max-width: var(--c8-section-max, 1320px);
    margin: 0 auto;
  }
  .c8-pr__head {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: center;
    margin: 0 0 clamp(2.5rem, 5vh, 3.75rem);
  }
  .c8-pr__head-text {
    max-width: 36rem;
  }
  @media (max-width: 900px) {
    .c8-pr__head {
      grid-template-columns: 1fr;
    }
  }
  .c8-pr__eyebrow {
    margin: 0 0 1rem;
    font-family: var(--montreal);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c8-gold);
  }
  .c8-pr__heading {
    margin: 0 0 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.4vw, 3.4rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #fff;
  }
  .c8-pr__heading-accent {
    color: var(--c8-gold-dark);
    font-weight: 400;
  }
  .c8-pr__sub {
    margin: 0;
    font-family: var(--montreal);
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.6;
    color: rgba(255,255,255,0.78);
    max-width: 48rem;
  }
  .c8-pr__sub strong {
    color: #fff;
    font-weight: 600;
  }
  .c8-pr__sub + .c8-pr__sub {
    margin-top: 1rem;
  }
  .c8-pr__sub--soft {
    color: rgba(255,255,255,0.6);
    font-size: clamp(0.95rem, 1.1vw, 1.05rem);
  }

  /* ─── Coverage wall (right cell of the head grid) ─── */
  .c8-pr__wall {
    position: relative;
    width: 100%;
    /* Match the natural height of the text column — we don't want this
       to push the section taller. min-height keeps the cluster legible
       on viewports where the head copy is short. */
    min-height: clamp(260px, 28vw, 340px);
    /* Allow cards to overflow the right column boundary so the cluster
       doesn't read as a strict 50/50 column. */
    overflow: visible;
    isolation: isolate;
  }
  .c8-pr__wall-grid {
    position: absolute;
    inset: 0;
  }
  .c8-pr__article {
    position: absolute;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 10px;
    padding: 0.75rem 0.85rem 0.8rem;
    width: clamp(170px, 18vw, 220px);
    color: #1a1a1a;
    box-shadow:
      0 18px 42px -18px rgba(0,0,0,0.55),
      0 6px 16px -10px rgba(0,0,0,0.35),
      inset 0 1px 0 rgba(255,255,255,0.6);
    /* Rotation + scale come from CSS variables so the lens-hover effect
       can change scale without fighting the per-card rotation. The
       float keyframe animates `translate` (a separate property), so
       they all compose cleanly. */
    --c8-pr-rot: 0deg;
    --c8-pr-scl: 1;
    transform: rotate(var(--c8-pr-rot)) scale(var(--c8-pr-scl));
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
                border-color 0.45s ease,
                box-shadow 0.45s ease,
                background 0.45s ease;
    will-change: transform;
  }
  .c8-pr__article:hover { border-color: var(--c8-gold-glow); z-index: 5; }

  /* 4-card press cluster — Decrypt now anchors the upper-left so the
     top half of the wall doesn't read empty. Cards still scatter at
     varied tilts and one card (a-3 Decrypt) overflows the cell
     leftward so the cluster bleeds into the text/wall gutter, which
     defeats the tidy 50/50 column read. */
  .c8-pr__article.a-1 {
    /* CoinTelegraph — top-right anchor */
    top: 0;       right: 12%;
    --c8-pr-rot: -2.5deg;
    z-index: 2;
    animation: c8-pr-float-a 9s ease-in-out infinite;
  }
  .c8-pr__article.a-2 {
    /* Forbes — pushed down to mid-right so it doesn't crowd the top */
    top: 42%;     right: -4%;
    --c8-pr-rot: 1.8deg;
    z-index: 3;
    animation: c8-pr-float-b 11s ease-in-out infinite 1.2s;
  }
  .c8-pr__article.a-3 {
    /* Decrypt — anchored mid-left of the cluster. User-tuned values
       from a DevTools dial-in: 22% top / 5% left reads better than
       the earlier upper-left overflow because it gives the cluster
       a real left-right balance against CoinTelegraph at the top. */
    top: 22%;     left: 5%;
    --c8-pr-rot: -1.4deg;
    z-index: 1;
    animation: c8-pr-float-a 10s ease-in-out infinite 0.6s;
  }
  .c8-pr__article.a-4 {
    /* Yahoo Finance — bottom-centre, lowest z so it tucks under */
    bottom: 0;    right: 22%;
    --c8-pr-rot: 2.2deg;
    z-index: 4;
    animation: c8-pr-float-b 12s ease-in-out infinite 2.0s;
  }

  /* The card the lens is currently focused on. Slight scale up, gold
     halo, brighter rule, gold attribution. White card stays white. */
  .c8-pr__article.is-lensed {
    --c8-pr-scl: 1.06;
    border-color: var(--c8-gold-dark);
    box-shadow:
      0 22px 56px -18px rgba(0,0,0,0.5),
      0 0 0 1px var(--c8-gold-dark),
      0 0 32px rgba(242, 191, 34, 0.45),
      inset 0 1px 0 rgba(255,255,255,0.7);
    z-index: 5;
  }
  .c8-pr__article.is-lensed .c8-pr__article-headline {
    color: #000;
  }
  .c8-pr__article.is-lensed .c8-pr__article-rule {
    background: var(--c8-gold);
    opacity: 1;
    width: 36px;
    transition: width 0.5s ease, background 0.4s ease, opacity 0.4s ease;
  }
  .c8-pr__article.is-lensed .c8-pr__article-foot {
    color: var(--c8-gold-dark);
  }
  .c8-pr__article.is-lensed .c8-pr__article-logo {
    opacity: 1;
  }

  @keyframes c8-pr-float-a {
    0%, 100% { translate: 0 0; }
    50%      { translate: 0 -10px; }
  }
  @keyframes c8-pr-float-b {
    0%, 100% { translate: 0 0; }
    50%      { translate: 0 8px; }
  }

  .c8-pr__article-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    margin: 0 0 0.7rem;
  }
  .c8-pr__article-logo {
    height: 14px;
    width: auto;
    max-width: 90px;
    object-fit: contain;
    /* Logos render in their native colour on the white card. Most of
       our outlet PNGs are dark-on-transparent, which reads cleanly. */
    opacity: 0.85;
  }
  /* Kept for back-compat with the data flag, but on white cards we
     don't actually invert — logos already read dark on white. */
  .c8-pr__article-logo--invert { filter: none; }
  .c8-pr__article-time {
    font-family: var(--montreal);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #888;
  }
  .c8-pr__article-headline {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(0.78rem, 0.9vw, 0.88rem);
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: #0a0a0a;
    /* Clamp to keep cards uniform height-wise */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .c8-pr__article-rule {
    display: block;
    width: 24px;
    height: 1px;
    background: var(--c8-gold-dark);
    opacity: 0.85;
    margin: 0 0 0.55rem;
  }
  .c8-pr__article-foot {
    font-family: var(--montreal);
    font-size: 0.7rem;
    color: var(--c8-gold-dark);
    letter-spacing: 0.04em;
    font-weight: 600;
  }

  /* ─── Lens ─── */
  .c8-pr__lens {
    position: absolute;
    width: clamp(90px, 10vw, 130px);
    height: clamp(90px, 10vw, 130px);
    /* Position is driven by JS (see <script> below) — set initial state
       so the lens has somewhere to sit before the script kicks in. */
    left: 12%;
    top: 24%;
    pointer-events: none;
    z-index: 6;
    filter: drop-shadow(0 18px 36px rgba(0,0,0,0.45));
    /* The translate property carries the per-frame micro-jitter while
       left/top carry the waypoint motion. They stack cleanly. */
    transition: filter 0.4s ease;
  }
  .c8-pr__lens.is-focused {
    filter: drop-shadow(0 22px 44px rgba(0,0,0,0.55))
            drop-shadow(0 0 18px rgba(242, 191, 34, 0.35));
  }
  .c8-pr__lens-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 4px solid rgba(242, 191, 34, 0.78);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08) inset,
      0 0 24px rgba(242, 191, 34, 0.35);
    background:
      radial-gradient(circle at 35% 30%, rgba(255,255,255,0.18) 0%, rgba(255,255,255,0) 35%),
      radial-gradient(circle at center, rgba(242, 191, 34, 0.10) 0%, rgba(242, 191, 34, 0.04) 60%, transparent 100%);
  }
  /* Subtle inner highlight ring — sells the convex glass feel. */
  .c8-pr__lens-ring::before {
    content: '';
    position: absolute;
    inset: 6%;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.12);
    box-shadow: inset 0 0 30px rgba(0,0,0,0.35);
  }
  /* The handle — short stick at the lower-right at a typical loupe angle. */
  .c8-pr__lens-handle {
    position: absolute;
    width: 24%;
    height: 7%;
    bottom: 4%;
    right: -10%;
    transform: rotate(45deg);
    transform-origin: 0% 50%;
    background: linear-gradient(90deg, rgba(242,191,34,0.85) 0%, rgba(218,158,73,0.7) 100%);
    border-radius: 4px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.45);
  }
  /* Glint — a small white highlight that drifts within the lens. */
  .c8-pr__lens-flare {
    position: absolute;
    width: 26%;
    height: 26%;
    left: 22%;
    top: 18%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,255,255,0.55) 0%, rgba(255,255,255,0) 70%);
    animation: c8-pr-lens-glint 6s ease-in-out infinite;
  }
  @keyframes c8-pr-lens-glint {
    0%, 100% { transform: translate(0, 0); opacity: 0.8; }
    50%      { transform: translate(8%, 6%); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .c8-pr__article,
    .c8-pr__lens-flare {
      animation: none !important;
    }
    /* Reduced-motion: park the lens centred and stop the drive script
       (handled in <script> below by checking matchMedia). */
    .c8-pr__lens { left: 50%; top: 50%; transform: translate(-50%, -50%); }
  }
  /* Below 900px the head stacks (text on top, wall below). Hide the wall
     entirely on small phones — we don't want it adding height there. On
     tablets, show a slimmer 3-card cluster. */
  @media (max-width: 900px) {
    .c8-pr__wall {
      min-height: 280px;
      max-width: 520px;
      margin-top: 0.5rem;
    }
    .c8-pr__article { width: clamp(180px, 32vw, 220px); }
  }
  @media (max-width: 600px) {
    .c8-pr__wall { display: none; }
  }

  /* ─── Stats row ─── */
  .c8-pr__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.4vw, 2rem);
    margin: 0 0 clamp(2.5rem, 5vh, 3.75rem);
  }
  .c8-pr__stat {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.5rem 1.25rem;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 14px;
    transition: border-color 0.4s ease, background 0.4s ease;
  }
  .c8-pr__stat:hover {
    border-color: rgba(242,191,34,0.4);
    background: rgba(255,255,255,0.06);
  }
  .c8-pr__stat-num {
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3.2vw, 2.4rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--c8-gold-dark);
    line-height: 1;
  }
  .c8-pr__stat-lbl {
    font-family: var(--montreal);
    font-size: 0.92rem;
    color: rgba(255,255,255,0.68);
    line-height: 1.35;
  }

  /* ─── Tier-1 logo strip ─── */
  .c8-pr__logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding: clamp(1.75rem, 3vh, 2.5rem) 0 0;
    border-top: 1px solid rgba(255,255,255,0.08);
  }
  .c8-pr__logo {
    height: 26px;
    width: auto;
    max-width: 140px;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.55;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .c8-pr__logo:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .c8-pr__stats { grid-template-columns: 1fr; }
    .c8-pr__logo { height: 22px; }
  }
</style>

<script is:inline>
  /* Lens drive — replaces the previous CSS keyframe loop with a
     waypoint-based motion model so the lens reads as someone actually
     scanning the press wall:

       • Eased moves (easeInOutQuart) between waypoints — slow start,
         fast middle, slow end. Not a constant linear drift.
       • Variable leg duration scaled by distance + a randomised
         component, so two passes of the same loop don't time-match.
       • Hold/"reading" pauses at each card — not just an animation
         endpoint, an actual stop with realistic dwell time.
       • Micro-jitter (low-frequency sine waves) drifts the position
         a fraction of a percent in real time so the lens never sits
         perfectly still even while "reading."

     While that's running, an overlap check toggles the .is-lensed
     class on whichever card the lens centre currently sits over —
     CSS handles the gold halo + scale + headline whiten. */
  function startLensDrive() {
    var wall  = document.querySelector('.c8-pr__wall');
    if (!wall) return;
    var lens  = wall.querySelector('.c8-pr__lens');
    var cards = Array.prototype.slice.call(wall.querySelectorAll('.c8-pr__article'));
    if (!lens || cards.length === 0) return;

    var mq = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (mq.matches) return; // CSS parks the lens centred for reduced-motion users.

    /* Waypoints — anchored on the four cards' approximate centres so
       the lens "reads" each in turn. Coordinates are % of the wall.
       hold = milliseconds spent reading at each card.

       Order matches the new card layout (Decrypt now top-left, was
       mid-left). The path traces top-left → top-right → mid-right →
       bottom, which scans diagonally rather than in a predictable
       circle. */
    var waypoints = [
      { x: 70, y: 16, hold: 1800 }, // a-1 CoinTelegraph (top-right)
      { x: 22, y: 42, hold: 2100 }, // a-3 Decrypt (mid-left, user-tuned)
      { x: 80, y: 60, hold: 1500 }, // a-2 Forbes (mid-right)
      { x: 52, y: 86, hold: 1700 }, // a-4 Yahoo (bottom-centre)
    ];

    var idx  = 0;
    var from = waypoints[waypoints.length - 1];
    var to   = waypoints[0];
    var dur  = 1400;
    var t0   = performance.now();
    var phase = 'moving'; // 'moving' or 'holding'

    function easeInOutQuart(t) {
      return t < 0.5
        ? 8 * t * t * t * t
        : 1 - Math.pow(-2 * t + 2, 4) / 2;
    }

    function nextLeg() {
      from = to;
      idx = (idx + 1) % waypoints.length;
      to = waypoints[idx];
      var dx = to.x - from.x, dy = to.y - from.y;
      var dist = Math.sqrt(dx * dx + dy * dy);
      // Distance-scaled duration + random jitter — every leg differs.
      dur = 800 + dist * 24 + Math.random() * 700;
      t0 = performance.now();
      phase = 'moving';
    }

    function checkOverlap() {
      var lensRect = lens.getBoundingClientRect();
      var cx = lensRect.left + lensRect.width / 2;
      var cy = lensRect.top + lensRect.height / 2;
      var anyHit = false;
      for (var i = 0; i < cards.length; i++) {
        var r = cards[i].getBoundingClientRect();
        var hit =
          cx >= r.left && cx <= r.right &&
          cy >= r.top  && cy <= r.bottom;
        cards[i].classList.toggle('is-lensed', hit);
        if (hit) anyHit = true;
      }
      lens.classList.toggle('is-focused', anyHit);
    }

    function tick(now) {
      var x, y;
      if (phase === 'moving') {
        var t = Math.min(1, (now - t0) / dur);
        var e = easeInOutQuart(t);
        x = from.x + (to.x - from.x) * e;
        y = from.y + (to.y - from.y) * e;
        if (t >= 1) {
          phase = 'holding';
          t0 = now;
        }
      } else {
        // Holding at the waypoint — micro-jitter only.
        x = to.x;
        y = to.y;
        if ((now - t0) >= to.hold) nextLeg();
      }

      // Always-on micro-jitter — low-amplitude sine waves at
      // different frequencies so the motion never feels mechanical.
      var jx = Math.sin(now * 0.0011) * 0.55 + Math.sin(now * 0.0027) * 0.18;
      var jy = Math.cos(now * 0.0009) * 0.55 + Math.cos(now * 0.0031) * 0.16;

      lens.style.left = (x + jx) + '%';
      lens.style.top  = (y + jy) + '%';

      checkOverlap();
      requestAnimationFrame(tick);
    }

    requestAnimationFrame(tick);
  }

  // Wait for DOM if we got hoisted to <head>.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startLensDrive, { once: true });
  } else {
    startLensDrive();
  }
</script>
