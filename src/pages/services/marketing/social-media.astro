.sm-faq-item{border-bottom:1px solid rgba(0,0,0,.07);}
.sm-faq-item:first-child{border-top:1px solid rgba(0,0,0,.07);}
.sm-faq-q{width:100%;text-align:left;padding:1.3rem 0;background:none;border:none;cursor:pointer;font-size:.95rem;font-weight:700;color:#0f0f0f;display:flex;align-items:center;justify-content:space-between;gap:1rem;font-family:inherit;transition:color .2s;}
.sm-faq-q:hover,.sm-faq-q[aria-expanded="true"]{color:#f2bf22;}
.sm-chevron{flex-shrink:0;width:22px;height:22px;border:1.5px solid currentColor;border-radius:50%;position:relative;transition:transform .3s;}
.sm-chevron::before,.sm-chevron::after{content:'';position:absolute;top:50%;left:50%;width:7px;height:1.5px;background:currentColor;border-radius:2px;}
.sm-chevron::before{transform:translate(-50%,-50%) rotate(-45deg) translateX(2px);}
.sm-chevron::after{transform:translate(-50%,-50%) rotate(45deg) translateX(-2px);}
.sm-faq-q[aria-expanded="true"] .sm-chevron{transform:rotate(180deg);}
.sm-faq-a{max-height:0;overflow:hidden;opacity:0;font-size:.9rem;line-height:1.75;color:#555;transition:max-height .4s cubic-bezier(.16,1,.3,1),opacity .3s;}
.sm-faq-item.open .sm-faq-a{padding-bottom:1.4rem;}

/* CTA */
.sm-cta{background:#0f0f0f;padding:clamp(5rem,10vh,8rem) 2rem;text-align:center;position:relative;overflow:hidden;}
.sm-cta__bg{position:absolute;inset:0;z-index:0;}
.sm-cta__bg img{width:100%;height:100%;object-fit:cover;opacity:.1;}
.sm-cta__overlay{position:absolute;inset:0;background:radial-gradient(ellipse at center,rgba(15,15,15,.5) 0%,rgba(15,15,15,.97) 70%);}
.sm-cta__inner{position:relative;z-index:1;max-width:680px;margin:0 auto;}
.sm-cta__h2{font-size:clamp(2.4rem,5vw,3.8rem);font-weight:800;line-height:1.1;letter-spacing:-.04em;color:#fff;margin:1rem 0;}
.sm-cta__inner p{font-size:1rem;line-height:1.7;color:rgba(255,255,255,.45);margin-bottom:2.5rem;}
.sm-cta__btns{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;}

@media(prefers-reduced-motion:reduce){.float-a,.float-b{animation:none;}}
