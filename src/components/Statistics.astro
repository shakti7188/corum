<style is:global>
  .Statistics_statistics__vWlOY {
    background-color: #000 !important;
    position: relative;
    min-height: 100vh;
    padding: 0;
    overflow: hidden;
  }

  .StatisticsCarousel_container__2XA6W {
    display: flex;
    justify-content: center;
  }

  @media (min-width: 1024px) {
    .StatisticsCarousel_panels__pxnru {
      position: absolute;
      top: 50%;
      left: 0;
      right: 0;
      transform: translateY(-50%);
      margin: 0 !important;
      z-index: 2;
    }
    .StatisticsCarousel_swiper__PGdj6 .swiper-wrapper {
      position: relative;
      display: block !important;
      min-height: 62vh;
      max-height: 72vh;
      z-index: 5;
    }
    .StatisticsPanel_panel__5YHtR {
      min-height: 62vh !important;
      max-height: 72vh !important;
      padding: 2.5rem 3.5rem !important;
    }
    .StatisticsPanel_description__csS74 { margin-bottom: 2.25rem !important; }
    .StatisticsPanel_heading__UrLlt { font-size: clamp(5rem, 8vw, 8rem) !important; }
    .StatisticsCarousel_swiperSlide__is8BS { width: 100% !important; height: 100% !important; }
  }

  .StatisticsPanel_pillar__c8 {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.35);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ── Influencer / KOL visual — feed of realistic social posts ───────────── */
  .c8-kol-visual {
    width: 100%;
    height: 100%;
    min-height: 320px;
    padding: 1rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    align-content: center;
    position: relative;
  }
  .c8-post {
    background: #18181b;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 14px;
    padding: 0.85rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: #e4e4e7;
    font-size: 0.78rem;
    line-height: 1.4;
    transition: transform 0.4s cubic-bezier(.2,.8,.2,1), border-color 0.3s, box-shadow 0.3s;
    overflow: hidden;
    position: relative;
  }
  .c8-post:hover {
    transform: translateY(-4px);
    border-color: rgba(255,255,255,0.22);
    box-shadow: 0 10px 30px -10px rgba(0,0,0,0.6);
  }
  .c8-post__head {
    display: flex; align-items: center; gap: 0.55rem;
    margin-bottom: 0.55rem;
  }
  .c8-post__avatar {
    width: 30px; height: 30px; border-radius: 50%;
    background: linear-gradient(135deg, #f72585, #4361ee);
    flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-weight: 700; font-size: 0.7rem;
  }
  .c8-post__user { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .c8-post__name { font-weight: 700; font-size: 0.78rem; color: #fff; display: flex; align-items: center; gap: 0.25rem; }
  .c8-post__name svg { color: #1da1f2; flex-shrink: 0; }
  .c8-post__handle { font-size: 0.68rem; color: #71717a; }
  .c8-post__platform { width: 14px; height: 14px; flex-shrink: 0; opacity: 0.7; }
  .c8-post__body { font-size: 0.76rem; color: #d4d4d8; margin-bottom: 0.55rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .c8-post__body b { color: #f72585; font-weight: 600; }
  .c8-post__stats { display: flex; gap: 0.85rem; font-size: 0.68rem; color: #71717a; padding-top: 0.45rem; border-top: 1px solid rgba(255,255,255,0.06); }
  .c8-post__stats span { display: inline-flex; align-items: center; gap: 0.25rem; }
  .c8-post__stats svg { width: 11px; height: 11px; }

  /* ── PR / Media visual — newspaper article cards ─────────────────────────── */
  .c8-pr-visual {
    width: 100%;
    height: 100%;
    min-height: 320px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    justify-content: center;
  }
  .c8-article {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 0.85rem;
    background: #fff;
    color: #111;
    border-radius: 10px;
    padding: 0.7rem;
    font-family: 'Georgia', serif;
    transition: transform 0.4s cubic-bezier(.2,.8,.2,1), box-shadow 0.3s;
    overflow: hidden;
  }
  .c8-article:hover {
    transform: translateX(4px);
    box-shadow: 0 14px 30px -12px rgba(0,0,0,0.5);
  }
  .c8-article__thumb {
    width: 80px; height: 64px; border-radius: 6px;
    background: linear-gradient(135deg, var(--thumb-a, #1f2937), var(--thumb-b, #374151));
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
  }
  .c8-article__thumb::after {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(circle at 70% 30%, rgba(255,255,255,0.25), transparent 60%);
  }
  .c8-article__body { min-width: 0; display: flex; flex-direction: column; justify-content: space-between; }
  .c8-article__pub {
    font-family: -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #71717a;
    font-weight: 700;
    margin-bottom: 0.2rem;
  }
  .c8-article__pub b { color: #f72585; }
  .c8-article__headline {
    font-family: 'Georgia', serif;
    font-size: 0.84rem;
    line-height: 1.25;
    color: #111;
    font-weight: 700;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    margin-bottom: 0.25rem;
  }
  .c8-article__meta {
    font-family: -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 0.62rem;
    color: #71717a;
    display: flex; gap: 0.65rem; align-items: center;
  }

  /* ── Dev visual — 2x2 grid of fake product screenshots ──────────────────── */
  .c8-dev-visual {
    width: 100%;
    height: 100%;
    min-height: 360px;
    padding: 0.5rem;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 0.85rem;
    perspective: 1400px;
  }
  .c8-product {
    position: relative;
    background: #ffffff;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 18px 38px -16px rgba(0,0,0,0.65), 0 2px 6px rgba(0,0,0,0.25);
    font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
    transform-style: preserve-3d;
    transition: transform 0.5s ease;
    will-change: transform;
  }
  .c8-product:nth-child(1) { transform: rotate(-1.2deg) translateY(0); }
  .c8-product:nth-child(2) { transform: rotate( 0.8deg) translateY(-4px); }
  .c8-product:nth-child(3) { transform: rotate( 1.4deg) translateY(2px); }
  .c8-product:nth-child(4) { transform: rotate(-0.6deg) translateY(-2px); }
  .c8-product:hover { transform: rotate(0deg) translateY(-6px) scale(1.02); z-index: 2; }

  /* Browser-window chrome shared by web product mockups */
  .c8-product__chrome {
    background: #f1f1f3;
    padding: 0.4rem 0.6rem;
    display: flex; align-items: center; gap: 0.45rem;
    border-bottom: 1px solid #e3e3e6;
    height: 22px;
  }
  .c8-product__chrome i { width: 7px; height: 7px; border-radius: 50%; display: inline-block; }
  .c8-product__chrome i:nth-child(1) { background: #ff5f57; }
  .c8-product__chrome i:nth-child(2) { background: #febc2e; }
  .c8-product__chrome i:nth-child(3) { background: #28c840; }
  .c8-product__url {
    margin-left: 0.45rem;
    font-size: 0.55rem;
    background: #fff;
    border-radius: 4px;
    padding: 2px 8px;
    color: #888;
    border: 1px solid #e1e1e3;
    flex: 1;
    text-align: center;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* ── 1: Crypto exchange swap card ─────────────────────────────────────── */
  .c8-product--swap .c8-product__inner {
    padding: 0.7rem 0.75rem 0.85rem;
    background: linear-gradient(160deg, #0b1221 0%, #1a1f3a 100%);
    color: #fff;
    height: calc(100% - 22px);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .c8-product--swap .c8-swap__title {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .c8-product--swap .c8-swap__row {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    padding: 0.45rem 0.55rem;
    display: flex; justify-content: space-between; align-items: center;
    gap: 0.5rem;
  }
  .c8-product--swap .c8-swap__amt {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .c8-product--swap .c8-swap__sub { font-size: 0.5rem; opacity: 0.55; margin-top: 1px; }
  .c8-product--swap .c8-swap__token {
    display: flex; align-items: center; gap: 0.35rem;
    background: rgba(255,255,255,0.08);
    border-radius: 999px;
    padding: 3px 8px 3px 4px;
    font-size: 0.6rem; font-weight: 600;
  }
  .c8-product--swap .c8-swap__token b {
    width: 16px; height: 16px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 0.5rem; font-weight: 700;
  }
  .c8-product--swap .c8-swap__btn {
    margin-top: auto;
    background: linear-gradient(90deg, #ff006e, #b5179e);
    border-radius: 8px;
    padding: 0.45rem;
    text-align: center;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .c8-product--swap .c8-swap__rate {
    display: flex; justify-content: space-between;
    font-size: 0.5rem;
    opacity: 0.65;
  }

  /* ── 2: Mobile wallet phone mockup ────────────────────────────────────── */
  .c8-product--wallet {
    background: linear-gradient(180deg, #1a1d29 0%, #0d0f1a 100%);
    padding: 0.6rem;
    display: flex; align-items: center; justify-content: center;
  }
  .c8-product--wallet .c8-phone {
    width: 96px;
    height: 100%;
    max-height: 200px;
    background: #fff;
    border-radius: 12px;
    border: 2px solid #2a2e3d;
    overflow: hidden;
    position: relative;
    display: flex; flex-direction: column;
    box-shadow: 0 8px 20px -8px rgba(0,0,0,0.5);
  }
  .c8-product--wallet .c8-phone__notch {
    background: #1a1d29;
    height: 12px;
    margin: 4px auto 0;
    width: 38px;
    border-radius: 6px;
  }
  .c8-product--wallet .c8-phone__bal {
    text-align: center; padding: 0.45rem 0.3rem 0.35rem;
    color: #0a0a0a;
  }
  .c8-product--wallet .c8-phone__bal small { font-size: 0.45rem; opacity: 0.55; display: block; }
  .c8-product--wallet .c8-phone__bal b { font-size: 0.85rem; font-weight: 700; letter-spacing: -0.02em; }
  .c8-product--wallet .c8-phone__bal span { color: #00b67a; font-size: 0.5rem; margin-left: 3px; }
  .c8-product--wallet .c8-phone__pills {
    display: flex; justify-content: center; gap: 4px; padding: 0 0.3rem 0.35rem;
  }
  .c8-product--wallet .c8-phone__pill {
    flex: 1; background: #f3f4f8; border-radius: 999px;
    text-align: center; font-size: 0.42rem; padding: 3px;
    color: #555; font-weight: 600;
  }
  .c8-product--wallet .c8-phone__list { flex: 1; padding: 0.25rem 0.4rem; overflow: hidden; }
  .c8-product--wallet .c8-phone__row {
    display: grid; grid-template-columns: 14px 1fr auto;
    align-items: center; gap: 5px;
    padding: 4px 0;
    border-bottom: 1px solid #f0f1f4;
    font-size: 0.5rem;
    color: #0a0a0a;
  }
  .c8-product--wallet .c8-phone__row:last-child { border-bottom: 0; }
  .c8-product--wallet .c8-phone__row i {
    width: 14px; height: 14px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 0.42rem; font-weight: 700; color: #fff;
    font-style: normal;
  }
  .c8-product--wallet .c8-phone__row em {
    text-align: right; font-style: normal; font-weight: 600;
