<!-- ── SCRIPTS ── -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" is:inline></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js" is:inline></script>
<script src="https://unpkg.com/@studio-freight/lenis@1.0.33/dist/lenis.min.js" is:inline></script>
<script is:inline>
(function(){
  // Lenis smooth scroll
  var lenis = new Lenis({ duration: 1.15, easing: function(t){ return Math.min(1,1.001-Math.pow(2,-10*t)); } });
  function raf(t){ lenis.raf(t); requestAnimationFrame(raf); }
  requestAnimationFrame(raf);

  gsap.registerPlugin(ScrollTrigger);

  // reveal-up
  gsap.utils.toArray('.reveal-up').forEach(function(el){
    gsap.fromTo(el,{autoAlpha:0,y:50},{autoAlpha:1,y:0,duration:0.9,ease:'power3.out',
      scrollTrigger:{trigger:el,start:'top 88%'}});
  });
  // reveal-left/right
  gsap.utils.toArray('.reveal-left').forEach(function(el){
    gsap.fromTo(el,{autoAlpha:0,x:-60},{autoAlpha:1,x:0,duration:1,ease:'power3.out',
      scrollTrigger:{trigger:el,start:'top 88%'}});
  });
  gsap.utils.toArray('.reveal-right').forEach(function(el){
    gsap.fromTo(el,{autoAlpha:0,x:60},{autoAlpha:1,x:0,duration:1,ease:'power3.out',
      scrollTrigger:{trigger:el,start:'top 88%'}});
  });
  // stagger grids
  ['.s-disc-grid','.s-process-grid','.s-testi-grid'].forEach(function(sel){
    var parent = document.querySelector(sel);
    if(!parent) return;
    gsap.fromTo(parent.querySelectorAll('.reveal-stagger'),
      {autoAlpha:0,y:60},{autoAlpha:1,y:0,duration:0.85,ease:'power3.out',stagger:0.13,
      scrollTrigger:{trigger:parent,start:'top 86%'}});
  });

  // sparkline draw
  var sp = document.querySelector('.sp-line');
  if(sp){ var l=sp.getTotalLength(); gsap.set(sp,{strokeDasharray:l,strokeDashoffset:l}); gsap.to(sp,{strokeDashoffset:0,duration:2.2,ease:'power2.out',delay:0.5}); }

  // FAQ accordion
  document.querySelectorAll('.s-faq-q').forEach(function(btn){
    btn.addEventListener('click',function(){
      var item=btn.closest('.s-faq-item');
      var ans=item.querySelector('.s-faq-a');
      var open=btn.getAttribute('aria-expanded')==='true';
      document.querySelectorAll('.s-faq-item').forEach(function(i){
        i.querySelector('.s-faq-q').setAttribute('aria-expanded','false');
        i.querySelector('.s-faq-a').style.maxHeight='0';
        i.querySelector('.s-faq-a').style.opacity='0';
        i.classList.remove('open');
      });
      if(!open){ btn.setAttribute('aria-expanded','true'); ans.style.maxHeight=ans.scrollHeight+'px'; ans.style.opacity='1'; item.classList.add('open'); }
    });
  });
})();
</script>

<!-- ── STYLES ── -->
<style is:global>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
body{font-family:var(--font-sans);background:#f4f4f0;color:#0f0f0f;overflow-x:hidden;-webkit-font-smoothing:antialiased;}
img{display:block;width:100%;height:100%;object-fit:cover;}

/* ── TOKENS ── */
.s-badge{display:inline-flex;align-items:center;padding:.3rem .9rem;border-radius:100px;background:rgba(242,191,34,.12);border:1px solid rgba(242,191,34,.3);color:#8a6a14;font-size:.72rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase;}
.s-badge--dim{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.15);color:rgba(255,255,255,.6);}
.s-orange{background:linear-gradient(135deg,#f2bf22,#b8841a);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.s-h2{font-family:var(--font-display);font-size:clamp(1.85rem,3.6vw,2.6rem);font-weight:400;line-height:1.18;letter-spacing:-.015em;margin:.9rem 0 1.2rem;}
.s-h2--white{color:#fff;}
.s-p--dim{font-size:1rem;line-height:1.7;color:rgba(255,255,255,.5);margin-bottom:1rem;}
.s-section-head{text-align:center;max-width:740px;margin:0 auto 3.5rem;}
.s-section-head__sub{font-size:1rem;line-height:1.7;color:#666;margin-top:.5rem;}

.s-btn{display:inline-flex;align-items:center;gap:.5rem;padding:.8rem 1.8rem;border-radius:100px;font-size:.9rem;font-weight:700;text-decoration:none;transition:all .25s;border:none;cursor:pointer;font-family:inherit;}
.s-btn--fill{background:#f2bf22;color:#fff;box-shadow:0 4px 20px rgba(242,191,34,.3);}
.s-btn--fill:hover{background:#da9e49;transform:translateY(-2px);}
.s-btn--line{background:transparent;color:#0f0f0f;border:1.5px solid rgba(0,0,0,.18);}
.s-btn--line:hover{border-color:#0f0f0f;}
.s-btn--outline-white{background:transparent;color:#fff;border:1.5px solid rgba(255,255,255,.3);}
.s-btn--outline-white:hover{border-color:#fff;}
.s-btn--lg{padding:1rem 2.5rem;font-size:1rem;}

/* ── PILL sections ── */
.s-pill{border-radius:40px;margin:2rem 1.5rem;overflow:hidden;}
@media(min-width:768px){.s-pill{border-radius:60px;margin:2rem 3rem;}}
.s-disc{background:#efe9dc;padding:clamp(4rem,8vh,6rem) 2rem;border:1px solid rgba(0,0,0,.04);}
@media(min-width:768px){.s-disc{padding:clamp(4rem,8vh,6rem) 4rem;}}

/* ── BLOBS ── */
.s-blob{position:absolute;border-radius:50%;filter:blur(90px);pointer-events:none;z-index:0;}
.s-blob--a{width:480px;height:480px;background:rgba(242,191,34,.1);top:-80px;right:-80px;}
.s-blob--b{width:360px;height:360px;background:rgba(200,168,75,.07);bottom:0;left:-80px;}

/* ── HERO ── */
.s-hero{position:relative;overflow:hidden;padding:clamp(4rem,9vh,7rem) 2rem clamp(3rem,6vh,5rem);}
.s-hero__inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center;}
@media(max-width:900px){.s-hero__inner{grid-template-columns:1fr;}.s-hero__visual{display:none;}}
.s-hero__copy{position:relative;z-index:1;}
.s-hero__h1{font-family:var(--font-display);font-size:clamp(2.1rem,4vw,3.2rem);font-weight:400;line-height:1.15;letter-spacing:-.015em;margin:.9rem 0 1.3rem;}
.s-hero__sub{font-size:1.05rem;line-height:1.7;color:#555;max-width:500px;margin-bottom:2rem;}
.s-hero__btns{display:flex;gap:.9rem;flex-wrap:wrap;margin-bottom:2.2rem;}
.s-hero__chips{display:flex;align-items:center;gap:1.2rem;list-style:none;padding:0;margin:0;flex-wrap:wrap;}
