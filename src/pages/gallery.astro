---
import Layout from "../layouts/Layout.astro";
import KotaverseCta from "../components/KotaverseCta.astro";

const items = [
  { title: "Foxglove Pay rebrand", tag: "Identity · Fintech", poster: "/images/Featured.png" },
  { title: "Quartz Protocol dev portal", tag: "Web3 · Docs", poster: "/images/ISI-Image.png" },
  { title: "Linden AI launch film", tag: "Motion · AI", poster: "/images/Pison-Image.png" },
  { title: "Ubuntu Tribe Token2049 booth", tag: "Event · Web3", poster: "/images/DKA-Image.png" },
  { title: "Metarix launch deck", tag: "Deck · Web3", poster: "/images/wogan-featured-2.jpg" },
  { title: "KuCoin PR package", tag: "Press · Exchange", poster: "/images/ig-featured-mobile.jpg" },
  { title: "Cashaa campaign creative", tag: "Campaign · Token", poster: "/images/Design-with-guts.png" },
  { title: "Sage Ventures portfolio kit", tag: "System · VC", poster: "/images/SteppingStone-Image.png" },
];
---
<Layout title="Gallery | Corum8">

<section class="Hero_hero__zbooM"><div class="container"><div class="Hero_top__UZ6SA"><h2><span class="LineByLine_headingOuter__JmusT"><span>The work, the decks, the motion, the shipped identity systems.</span></span></h2></div><div class="Hero_bottom__pLxrT"><h1><span class="MaskInUp_container__0AW5i" data-fill="false"><div><span><i></i>Gallery</span></div></span></h1><div class="Hero_arrow__WTdEi"><span class="FadeInRotate_container__QE9u9" data-fill="false" data-direction="counterclockwise"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 75.91 75.65"><path d="m13.65 67.65 61.93-62L69.92 0 8 61.99V.25H0v75.4h75.91v-8H13.65z" style="stroke-width:0"></path></svg></span></div></div></div></section>

<section class="c8-gallery">
  <div class="container">
    <p class="c8-gallery__lede">Selected visual work — identity systems, pitch decks, motion films, event collateral and shipped product surfaces. New work lands here monthly.</p>
    <div class="c8-gallery__grid">
      {items.map((item) => (
        <figure class="c8-gallery__item">
          <div class="c8-gallery__media">
            <img src={item.poster} alt={item.title} loading="lazy" />
          </div>
          <figcaption>
            <span class="c8-gallery__tag">{item.tag}</span>
            <span class="c8-gallery__title">{item.title}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<KotaverseCta
  light="Want your work"
  bold="in this gallery next?"
  subtitle="Start a project. We'll ship something worth photographing."
/>

<style>
  .c8-gallery {
    padding: clamp(4rem, 8vw, 8rem) 0;
    background: #fafafa;
  }
  .c8-gallery__lede {
    max-width: 44rem;
    margin: 0 auto 4rem;
    text-align: center;
    font-size: 1.05rem;
    line-height: 1.7;
    color: #444;
  }
  .c8-gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    max-width: 1400px;
    margin: 0 auto;
  }
  .c8-gallery__item {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .c8-gallery__media {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    border-radius: 1rem;
    background: #111;
  }
  .c8-gallery__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .c8-gallery__item:hover .c8-gallery__media img {
    transform: scale(1.04);
  }
  .c8-gallery__tag {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #888;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .c8-gallery__title {
    font-size: 1.05rem;
    color: #111;
    font-weight: 500;
  }
</style>

</Layout>
