<style>
  /* Force number, heading and description to be readable black */
  .EthosSection_number__MbFH_,
  .EthosSection_sectionHeading___kl5X h3,
  .EthosSection_sectionDescription__9BWQV {
    color: #111 !important;
  }

  /* Horizontal divider between each ethos row */
  .EthosSection_line___wkFr {
    display: block !important;
    width: 100% !important;
  }
  .EthosSection_lineInner__7mqkk {
    background-color: #111 !important;
    height: 1px !important;
    width: 100% !important;
    opacity: 1 !important;
  }

  /* Rows are fully visible by default; dim siblings when one is hovered */
  [data-ethos-row] {
    opacity: 1;
    transition: opacity 0.4s ease;
  }

  .Ethos_sections__tC3Xx:hover [data-ethos-row] {
    opacity: 0.25;
  }
  .Ethos_sections__tC3Xx [data-ethos-row]:hover {
    opacity: 1;
  }
</style>



<style is:global>
  /* Tighten the gap between "Our Services" (the pinned Full-Stack card
     unpins at the container's bottom) and Ethos. KOTA ships Services with
     `padding: 9.375rem 0 50vh` — way too much runway below the reels. */
  .Services_services__YnZAs {
    padding-bottom: 4vh !important;
  }
  .Ethos_ethos__vP_lg {
    padding-top: 2vh !important;
  }
  /* Let the Ethos scroll-in reveal take over opacity/transform before GSAP
     hydrates, so the section doesn't flash fully-visible for a frame. */
  .Ethos_ethos__vP_lg { will-change: transform, opacity; }

  /* 1. Retrieve the Numbers inline */
  .EthosSection_numberOuter__uo7oD {
    display: inline-block !important;
    opacity: 1 !important;
    visibility: visible !important;
    margin-right: 1.5rem !important;
    font-family: monospace;
    font-size: clamp(2rem, 4vw, 4rem) !important;
    color: #111 !important;
    font-weight: 300 !important;
  }
  .EthosSection_sectionHeading___kl5X {
    display: flex !important;
    align-items: center !important;
    order: 1 !important;
    z-index: 100 !important;
    position: relative !important;
  }

  /* 2. Configure Row and Image Hover Z-Index */
  .EthosSection_sectionTrigger__Dbhq8 {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    position: relative !important;
    padding: 3rem 0 !important;
  }
  .EthosSection_sectionImage__R8Wnf {
    position: absolute !important;
    left: 20% !important;
    z-index: 0 !important;
    pointer-events: none !important;
  }

  /* 3. Text formatting */
  .EthosSection_sectionDescription__9BWQV {
    order: 3 !important;
    flex-basis: 55% !important;
    max-width: 55% !important;
    font-size: 1.4rem !important;
    line-height: 1.6 !important;
    color: #111 !important;
    /* User request: 'one side border of column too' -> Left border only */
    border-left: 2px solid rgba(0,0,0,0.1) !important;
    padding-left: 2.5rem !important;
    margin: 0 !important;
    z-index: 100 !important;
    position: relative !important;
  }
  
  /* 4. Restore the master thick underline spanning both left and right */
  .EthosSection_line___wkFr {
    display: block !important;
    opacity: 1 !important;
    visibility: visible !important;
  }
  .EthosSection_lineInner__7mqkk {
    background: #111 !important;
    height: 3px !important; /* Made thicker */
    opacity: 0.15 !important;
    width: 100% !important;
  }
  
  /* 5. Popping speed */
  .EthosSection_sectionImageReveal__oz58_ {
    transition: opacity 0.15s ease-out, height 0.25s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }

  /* 6. Customer-facing lead-in beneath the big Ethos heading.
     Span the full 12-col grid track so the paragraph escapes the 88px
     single-column trap, then center the text inside a tight measure so
     it reads as a quiet supporting note — not a second headline. */
  .EthosHeading_intro__c8 {
    grid-column: 1 / -1 !important;
    max-width: 42rem !important;
    margin: 1rem auto 4rem !important;
    font-size: clamp(0.88rem, 0.95vw, 1rem) !important;
    line-height: 1.6 !important;
    color: #444 !important;
    font-weight: 400 !important;
    letter-spacing: -0.002em !important;
    text-align: center !important;
  }
  @media (max-width: 900px) {
    .EthosHeading_intro__c8 {
      margin: 0.75rem auto 2.5rem !important;
      font-size: 0.9rem !important;
      max-width: 32rem !important;
    }
  }
</style>
