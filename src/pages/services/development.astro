  <script is:inline>
    (function () {
      var root = document.getElementById('lp-testi-carousel');
      if (!root) return;
      var slides = root.querySelectorAll('.lp-testi__slide');
      var dots   = root.querySelectorAll('.lp-testi__dot');
      var prev   = root.querySelector('.lp-testi__nav--prev');
      var next   = root.querySelector('.lp-testi__nav--next');
      if (!slides.length) return;
      var idx = 0;
      var timer = null;
      var DUR = 6000;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function go(i) {
        idx = (i + slides.length) % slides.length;
        slides.forEach(function (s, n) { s.classList.toggle('is-active', n === idx); });
        dots.forEach(function (d, n) { d.classList.toggle('is-active', n === idx); });
      }
      function tick() { go(idx + 1); schedule(); }
      function schedule() {
        if (timer) clearTimeout(timer);
        if (!reduce) timer = setTimeout(tick, DUR);
      }
      function reset() { if (timer) clearTimeout(timer); schedule(); }
      prev && prev.addEventListener('click', function () { go(idx - 1); reset(); });
      next && next.addEventListener('click', function () { go(idx + 1); reset(); });
      dots.forEach(function (d) {
        d.addEventListener('click', function () { go(parseInt(d.dataset.go, 10) || 0); reset(); });
      });
      schedule();
    })();
  </script>

