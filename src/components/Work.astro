---
// Work — featured case studies as a Swiper carousel.
// 1 row, 3 items per view on desktop, 2 on tablet, 1 on mobile.
// Each card: media + result chip + outcome headline + description.
// Swiper init is handled by `src/scripts/site.ts`'s default `.swiper`
// initializer (slidesPerView: 'auto', uses .swiper-panel-prev / -next
// for navigation), so this component just provides the markup.

const projects = [
  {
    href: '/work/cashaa',
    name: 'Cashaa',
    year: '2022',
    category: 'Token Launch',
    heading: '$32M raised',
    description: 'End-to-end token launch — global press across 200+ publications, Tier-1 KOL seeding, and a community built from zero across Discord and Telegram.',
    tags: ['PR', 'Influencer', 'Community'],
    poster: '/images/cashaa.jpg',
  },
  {
    href: '/work/binance',
    name: 'Binance',
    year: '2024',
    category: 'Affiliate Network',
    heading: '$800M+ monthly',
    description: 'Built the affiliate network behind Binance India — drove $800M+ in monthly volume through curated KOL partnerships and programmatic referral growth.',
    tags: ['PR', 'Growth', 'Community'],
    poster: '/clients/binance.png',
    posterMode: 'logo',
  },
  {
    href: '/work/fanadise',
    name: 'Fanadise',
    year: '2024',
    category: 'Web3 Growth',
    heading: '$5M raised',
    description: 'Full-stack Web3 fan platform — smart contracts, NFT mechanics and a coordinated multi-channel growth campaign that drove raise momentum from day one.',
    tags: ['Development', 'Community', 'Influencer'],
    poster: '/images/fanadise.png',
  },
  {
    href: '/work/ubuntu-tribe',
    name: 'Ubuntu Tribe',
    year: '2024',
    category: 'Event Launch',
    heading: 'Token2049 — global stage',
    description: 'Compressed multi-channel launch around Token2049 Dubai. PR, KOL activation and live community moments synchronized into a single 72-hour burst.',
    tags: ['PR', 'KOL', 'Community'],
    poster: '/images/utribe.png',
  },
  {
    href: '/work/kucoin',
    name: 'KuCoin',
    year: '2024',
    category: 'Strategic PR',
    heading: 'Tier-1 reach, every market',
    description: 'Ongoing strategic PR retainer — tier-1 placement, editorial strategy and proactive narrative management across 30+ priority markets.',
    tags: ['PR', 'Exchange', 'Global'],
    poster: '/images/KuCoin.jpg',
  },
  {
    href: '/work/metarix',
    name: 'Metarix',
    year: '2023',
    category: 'Token Raise',
    heading: '$780K raised',
    description: 'Pre-launch community engineering, KOL seeding and PR — a full launch stack that turned a quiet pre-seed into a credible Web3 pre-token raise.',
    tags: ['Community', 'Influencer', 'PR'],
    poster: '/clients/metarix.png',
    posterMode: 'logo',
    darkLogo: true,
  },
];
---

<section class="c8-work" id="our-work">
  <div class="c8-work__inner">
    <header class="c8-work__head">
      <p class="c8-work__eyebrow" data-reveal="up">— Featured work</p>
      <h2 class="c8-work__heading" data-reveal="up">
        Featured work. <span class="c8-work__heading-accent">Outsized outcomes.</span>
      </h2>
      <div class="c8-work__nav" aria-hidden="true">
        <button type="button" class="c8-work__navBtn swiper-panel-prev" aria-label="Previous case studies">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button type="button" class="c8-work__navBtn swiper-panel-next" aria-label="Next case studies">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
    </header>

    <div class="c8-work__carousel swiper">
      <div class="swiper-wrapper">
        {projects.map((p) => (
          <a class="c8-work__card swiper-slide" href={p.href}>
            <div class={`c8-work__media${p.posterMode === 'logo' ? ' c8-work__media--logo' : ''}${p.darkLogo ? ' c8-work__media--invert' : ''}`}>
              <img src={p.poster} alt={`${p.name} case study`} loading="lazy" />
              <div class="c8-work__veil"></div>
              <span class="c8-work__cat">{p.category}</span>
            </div>
            <div class="c8-work__body">
              <div class="c8-work__meta">
                <span class="c8-work__name">{p.name}</span>
                <span class="c8-work__year">{p.year}</span>
              </div>
              <h3 class="c8-work__result">{p.heading}</h3>
              <p class="c8-work__desc">{p.description}</p>
              <ul class="c8-work__tags">
                {p.tags.map((t) => <li>{t}</li>)}
              </ul>
            </div>
          </a>
        ))}
      </div>
    </div>

    <div class="c8-work__cta-row">
      <a class="c8-work__cta" href="/work">
        <span>View all case studies</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<style is:global>
  .c8-work {
    background: var(--color-bg-dark);
    color: #fff;
    padding: clamp(4.5rem, 9vh, 7rem) 0 clamp(4rem, 8vh, 6rem);
    overflow: hidden;
  }
  .c8-work__inner {
    max-width: var(--c8-section-max, 1320px);
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 5vw, 5rem);
  }

  .c8-work__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin: 0 0 clamp(2.5rem, 4vh, 3.5rem);
  }
  .c8-work__eyebrow {
    margin: 0 0 1rem;
    font-family: var(--montreal);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c8-gold-dark);
  }
  .c8-work__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.2vw, 3.1rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #fff;
    flex: 1 1 28rem;
    max-width: 38rem;
  }
  .c8-work__heading-accent {
    color: var(--c8-gold-dark);
    font-weight: 400;
  }

  .c8-work__nav {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .c8-work__navBtn {
    width: 48px;
    height: 48px;
    border-radius: 999px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.18);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.25s ease, border-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
  }
  .c8-work__navBtn:hover:not(:disabled) {
    background: var(--c8-gold);
    border-color: var(--c8-gold);
    color: #111;
    transform: translateY(-2px);
  }
  .c8-work__navBtn.swiper-button-disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  /* ─── Carousel ─── */
  .c8-work__carousel {
    width: 100%;
    overflow: visible;
    padding-bottom: 0.5rem;
  }
  .c8-work__carousel .swiper-wrapper {
    align-items: stretch;
  }

  /* Slide width is driven by Swiper config (slidesPerView: 1/2/3 across
     breakpoints in site.ts). The card itself only owns its own visual
     treatment. */
  .c8-work__card {
    height: auto;
    display: flex;
    flex-direction: column;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 18px;
    overflow: hidden;
    text-decoration: none;
    color: #fff;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.4s ease, box-shadow 0.4s ease;
    box-shadow: 0 18px 40px -22px rgba(0,0,0,0.6);
  }
  .c8-work__card:hover {
    transform: translateY(-6px);
    border-color: var(--c8-gold-glow);
    box-shadow: 0 28px 60px -22px rgba(0,0,0,0.7), 0 0 50px -12px var(--c8-gold-soft);
  }

  /* Media tile */
  .c8-work__media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 11;
    overflow: hidden;
    background: #000;
  }
  .c8-work__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .c8-work__card:hover .c8-work__media img {
    transform: scale(1.04);
  }
  /* Logo-only treatment: when no proper case-study hero photo exists,
     center the brand mark with breathing room on a softer dark surface
     so it reads as an intentional title card instead of a cropped logo. */
  .c8-work__media--logo {
    background:
      radial-gradient(ellipse at center, rgba(242,191,34,0.06) 0%, transparent 65%),
      linear-gradient(135deg, #1a1a1a 0%, #0a0a0a 100%);
  }
  .c8-work__media--logo img {
    object-fit: contain;
    padding: clamp(2rem, 5vw, 3rem);
  }
  /* Some client logos ship as dark line-art on transparent backgrounds.
     On the dark card surface they vanish — invert to white so they read. */
  .c8-work__media--invert img {
    filter: brightness(0) invert(1);
    opacity: 0.92;
  }
  .c8-work__card:hover .c8-work__media--logo img {
    transform: scale(1.06);
  }
  .c8-work__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0) 60%, rgba(0,0,0,0.55) 100%);
    pointer-events: none;
  }
  .c8-work__cat {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    font-family: var(--montreal);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c8-gold-dark);
    padding: 0.28rem 0.7rem;
    border: 1px solid rgba(242,191,34,0.4);
    border-radius: 999px;
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  /* Body */
  .c8-work__body {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.4rem 1.4rem 1.5rem;
    flex: 1;
  }
  .c8-work__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--montreal);
    font-size: 0.8rem;
    color: rgba(255,255,255,0.55);
  }
  .c8-work__name {
    font-weight: 600;
    color: rgba(255,255,255,0.85);
    letter-spacing: 0.02em;
  }
  .c8-work__year {
    color: rgba(255,255,255,0.45);
  }
  .c8-work__result {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.8vw, 1.55rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .c8-work__desc {
    margin: 0;
    font-family: var(--montreal);
    font-size: 0.92rem;
    line-height: 1.55;
    color: rgba(255,255,255,0.72);
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .c8-work__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0.3rem 0 0;
    padding: 0;
  }
  .c8-work__tags li {
    font-family: var(--montreal);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 999px;
    color: rgba(255,255,255,0.7);
  }

  .c8-work__cta-row {
    display: flex;
    justify-content: center;
    margin: clamp(2.5rem, 4vh, 3.5rem) 0 0;
  }
  .c8-work__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.95rem 1.6rem;
    border-radius: 999px;
    border: 1.5px solid rgba(255,255,255,0.5);
    color: #fff;
    text-decoration: none;
    font-family: var(--montreal);
    font-size: 0.95rem;
    font-weight: 500;
    transition: background 0.25s ease, border-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
  }
  .c8-work__cta:hover {
    background: var(--c8-gold);
    border-color: var(--c8-gold);
    color: #111;
    transform: translateY(-2px);
  }
</style>
