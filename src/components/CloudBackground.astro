---
interface Props {
  /** 5 colors, RGB 0..1, blended across the cloud. Defaults lean warm/pastel. */
  palette?: Array<[number, number, number]>;
  /** Animation speed. 0 = frozen, 1 = default, >1 faster. */
  speed?: number;
  /** Extra classes on the host element. */
  class?: string;
}

const {
  palette = [
    [0.98, 0.87, 0.62],
    [0.96, 0.55, 0.72],
    [0.62, 0.51, 0.95],
    [0.42, 0.78, 0.96],
    [0.98, 0.94, 0.88],
  ],
  speed = 1,
  class: className,
} = Astro.props;

const paletteJson = JSON.stringify(palette);
---
<div class:list={['cloud-bg', className]} data-palette={paletteJson} data-speed={speed}>
  <canvas aria-hidden="true"></canvas>
</div>

<style>
  .cloud-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    isolation: isolate;
    background: #efefef;
  }
  .cloud-bg canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .cloud-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 80% at 50% 10%, transparent 0%, rgba(239, 239, 239, 0.25) 80%);
    pointer-events: none;
    mix-blend-mode: soft-light;
  }
  @media (prefers-reduced-motion: reduce) {
    .cloud-bg canvas { opacity: 0.9; }
  }
</style>

<script>
  import { initCloud } from '../scripts/cloudBackground';
  document.querySelectorAll<HTMLElement>('.cloud-bg').forEach((el) => initCloud(el));
</script>
