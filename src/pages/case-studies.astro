---
import Layout from "../layouts/Layout.astro";
import KotaverseCta from "../components/KotaverseCta.astro";

const arrowGrad = {
  id: 'cs',
  stops: [
    { offset: '0', color: '#7c41f3' },
    { offset: '1', color: '#ff6eff' },
  ],
};

const projects = [
  {
    href: '/case-studies/binance',
    name: 'Binance',
    year: '2023',
    heading: 'Performance affiliate network driving $800M+ monthly exchange volume.',
    tags: ['Performance Marketing', 'Affiliate Network', 'Exchange'],
    video: '/media/Company-Loop4-compressed-2.mp4',
    poster: '/images/upp-featured-mobile.jpg',
  },
  {
    href: '/case-studies/cashaa',
    name: 'Cashaa',
    year: '2022',
    heading: 'Token launch powered by influencer marketing, PR and community activation — $32M raised.',
    tags: ['Token Launch', 'Influencer Marketing', 'PR', 'Community'],
    video: '/media/Featured2-Compressed.mp4',
    poster: '/images/upp-featured-mobile.jpg',
  },
  {
    href: '/case-studies/kucoin',
    name: 'KuCoin',
    year: '2024',
    heading: 'Strategic PR programme for a major exchange — amplifying brand visibility in every priority market.',
    tags: ['Strategic PR', 'Exchange', 'Global Visibility'],
    video: '/media/Duplicated-Assets.mp4',
    poster: '/images/ig-featured-mobile.jpg',
  },
  {
    href: '/case-studies/fanadise',
    name: 'Fanadise',
    year: '2024',
    heading: 'Full-stack Web3 growth campaign that rallied the community behind a $5M raise.',
    tags: ['Full-stack Web3', 'Growth Campaign', 'Community'],
    video: '/media/GOAT-FeatureVideo.mp4',
    poster: '/images/GOAT-FeaturedImage.webp',
  },
  {
    href: '/case-studies/ubuntu-tribe',
    name: 'Ubuntu Tribe',
    year: '2024',
    heading: 'PR, community and influencer programme anchored around a Token2049 activation.',
    tags: ['PR', 'Community', 'Influencer', 'Token2049 Event'],
    video: '/media/isi-vid2-1.mp4',
    poster: '/images/hero.webp',
  },
  {
    href: '/case-studies/metarix',
    name: 'Metarix',
    year: '2023',
    heading: 'Full launch across influencers, PR and community that converted attention into a $780K raise.',
    tags: ['Influencers', 'PR', 'Community', 'Full Launch'],
    video: '/media/Featured-compressed.mp4',
    poster: '/images/wogan-featured-2.jpg',
  },
];
---
<Layout title="Case Studies | Corum8">
<div data-theme="light">
<section class="Hero_hero__Oyf4n"><div class="container"><div class="Hero_top__RRkYH"><h2><span class="LineByLine_headingOuter__JmusT"><span>Selected work. Real clients. Verifiable numbers.</span></span></h2><figure class="crosshair" aria-hidden="true"><span class="FadeInRotate_container__QE9u9" data-fill="true" data-direction="clockwise"><span class="inner"></span></span></figure><div class="Hero_video__rzcbe"><span class="ScaleFadeIn_container__cK78G" data-fill="true"><span class="ScaleFadeIn_inner__y4reT" data-fill="true"><video src="/media/bg2.mp4" class="Hero_video__rzcbe" autoplay muted loop playsinline></video></span></span></div></div><div class="Hero_bottom__ktiOH"><h1><span class="MaskInUp_container__0AW5i" data-fill="false"><div><span><i></i>Case studies</span></div></span></h1><h3 class="Hero_introText__oP34v"><span class="FadeIn_container__bjQVL" data-fill="false"><span>Six engagements across exchanges, token launches, community programmes and performance networks — with the numbers attached.</span></span></h3><div class="Hero_arrow__lxSeM"><span class="FadeInRotate_container__QE9u9" data-fill="false" data-direction="counterclockwise"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 75.91 75.65"><path d="m13.65 67.65 61.93-62L69.92 0 8 61.99V.25H0v75.4h75.91v-8H13.65z"></path></svg></span></div></div></div></section>

<div class="Work_work__rSI8c" id="case-studies-grid">
  <div class="DarkThemeSwitch_cover__hn_xc"></div>
  <div class="Work_projects__A5q77">
    <div class="AnimatedGrid_grid__otAMD">
      <div class="container">
        {projects.map((p) => (
          <a class="ProjectCard_project__d1wbY ProjectCard_small__xsL92" data-animation="grid-item" href={p.href}>
            <div class="ProjectCard_projectText__o770X">
              <h3>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14.78 14.78">
                  <defs>
                    <linearGradient id={arrowGrad.id} x1="3.54" x2="13.98" y1="3.54" y2="13.99" gradientUnits="userSpaceOnUse">
                      {arrowGrad.stops.map((s) => <stop offset={s.offset} stop-color={s.color}></stop>)}
                    </linearGradient>
                  </defs>
                  <path fill={`url(#${arrowGrad.id})`} stroke-width="0" d="M13.25 12.18L13.25 0.23 14.78 0.23 14.78 14.76 14.74 14.76 14.74 14.78 0.21 14.78 0.21 13.25 12.18 13.25 0 1.08 1.08 0 13.25 12.18z"></path>
                </svg>{p.name}
              </h3>
              <p>{p.year}</p>
            </div>
            <div class="ProjectCard_projectImage__Nfx9I">
              <div class="ProjectCard_imageOverlay__OCawr">
                <p class="ProjectCard_heading__1csIW">{p.heading}</p>
                <ul class="ProjectCard_tags__XdVcf">
                  {p.tags.map((t) => <li>{t}</li>)}
                </ul>
              </div>
              <span class="Image_image__RAAdZ Image_fill__EiIzS"><img src={p.poster} alt="" fetchpriority="low" loading="lazy" /></span>
              <video src={p.video} class="ProjectCard_video__AheFz" autoplay muted loop playsinline></video>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</div>

<KotaverseCta
  light="Want a"
  bold="case like these?"
  subtitle="Book a call. We'll tell you what we'd ship and measure first."
/>
</div>
</Layout>
