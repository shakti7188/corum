---
// Services — unpinned static grid. Previously GSAP-pinned each card with
// 50vh scroll-distance spacers (~150vh total scroll for a 60vh visual).
// Now three equal-footprint cards in a grid so the section reads in one
// viewport and the rest of the page gets closer to the fold.
const cards = [
  {
    title: 'Marketing & Growth',
    media: { type: 'gif', src: '/assets/video/marketing.gif' },
    tags: [
      { label: 'Performance marketing', href: '/services/marketing/performance-marketing' },
      { label: 'SEO, AEO & GEO',        href: '/services/marketing/seo-aeo-geo' },
      { label: 'Web3 growth',           href: '/services/marketing/web3-growth' },
      { label: 'B2B lead gen',          href: '/services/marketing/b2b-marketing' },
      { label: 'Social media',          href: '/services/marketing/social-media' },
    ],
    desc: 'Full-funnel paid media, SEO and onchain ads that compound month over month — built for Web3, AI and fintech brands that need scale, not vanity metrics.',
    ctaHref: 'service/web-design-development',
    goldTint: false,
  },
  {
    title: 'PR & Branding',
    media: { type: 'video', src: '/media/homepage-3.mp4' },
    tags: [
      { label: 'Crypto PR',          href: '/services/marketing/crypto-pr' },
      { label: 'Influencer & KOL',   href: '/services/marketing/influencer-marketing' },
      { label: 'Community',          href: '/services/marketing/community-building' },
      { label: 'Branding & design',  href: '/services/marketing/branding-design' },
    ],
    desc: 'Global press across 10,000+ publications, 25,000+ vetted influencers and end-to-end community building — the signal engine behind every tier-1 Web3 launch.',
    ctaHref: 'service/branding',
    goldTint: false,
  },
  {
    title: 'Full-Stack Development',
    media: { type: 'video', src: '/media/homepage.mp4' },
    tags: [
      { label: 'CEX & DEX',         href: '/services/development/exchange-development' },
      { label: 'RWA platforms',     href: '/services/development/rwa-marketplace' },
      { label: 'AI & automation',   href: '/services/development/ai-solutions' },
      { label: 'Wallet infra',      href: '/services/development/wallet-infrastructure' },
      { label: 'DeFi & staking',    href: '/services/development/defi-staking' },
    ],
    desc: 'Production-grade exchanges, wallets, RWA marketplaces, DeFi protocols and AI agents — engineered for security, speed and institutional compliance.',
    ctaHref: 'service/digital-marketing',
    goldTint: true,
  },
];
---

<section class="c8-services">
  <div class="c8-services__inner">
    <header class="c8-services__head" data-reveal-stagger="90">
      <p class="c8-services__eyebrow" data-reveal="left">
        <span class="c8-services__dot" aria-hidden="true"></span>
        What we do
      </p>
      <h2 class="c8-services__heading" data-reveal="up">
        Build, market and <em>scale.</em>
      </h2>
      <p class="c8-services__sub" data-reveal="up">
        Three disciplines, one team — engineered for Web3, AI and fintech brands that need outcomes, not activity.
      </p>
    </header>

    <div class="c8-services__grid" data-reveal-stagger="140">
      {cards.map((card, idx) => (
        <article class={`c8-services__card${card.goldTint ? ' c8-services__card--gold' : ''}`} data-reveal={idx === 1 ? 'up' : (idx === 0 ? 'left' : 'right')}>
          <div class="c8-services__media">
            {card.media.type === 'video' ? (
              <video autoplay muted loop playsinline preload="metadata" src={card.media.src}></video>
            ) : (
              <img src={card.media.src} alt="" loading="lazy" />
            )}
          </div>
          <div class="c8-services__body">
            <h3 class="c8-services__card-title">{card.title}</h3>
            <div class="c8-services__tags">
              {card.tags.map((t) => (
                <a class="c8-services__tag" href={t.href}>{t.label}</a>
              ))}
            </div>
            <p class="c8-services__desc">{card.desc}</p>
            <a class="c8-services__cta" href={card.ctaHref}>
              <span>Find out more</span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 17.1 15.17" aria-hidden="true">
                <path d="m17.1,7.58s-.01-.04-.01-.06c.01-.22-.06-.45-.24-.61L9.23.19c-.31-.27-.78-.24-1.06.07-.27.31-.24.78.07,1.06l6.26,5.52H.75c-.41,0-.75.34-.75.75s.34.75.75.75h13.74l-6.26,5.52c-.31.27-.34.75-.07,1.06.15.17.35.25.56.25.18,0,.35-.06.5-.19l7.62-6.72c.18-.16.25-.39.24-.61,0-.02.01-.04.01-.06Z" fill="currentColor"></path>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .c8-services {
    padding: clamp(4rem, 8vh, 7rem) clamp(1.5rem, 5vw, 5rem);
    background: var(--color-bg);
    color: #0a0a0a;
  }
  .c8-services__inner { max-width: 1440px; margin: 0 auto; }

  /* Title block (preserved from the previous Services design) */
  .c8-services__head {
    max-width: 48rem;
    margin: 0 0 clamp(2.5rem, 5vh, 3.5rem);
  }
  .c8-services__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--montreal, system-ui, sans-serif);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c8-gold, #d48e1a);
    margin: 0 0 1rem;
  }
  .c8-services__dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--c8-gold, #d48e1a);
    box-shadow: 0 0 10px rgba(212, 142, 26, 0.5);
  }
  .c8-services__heading {
    font-family: var(--montreal, system-ui, sans-serif);
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: #0a0a0a;
    margin: 0 0 1rem;
  }
  .c8-services__heading em {
    font-style: italic;
    font-family: var(--syne, var(--montreal));
    font-weight: 400;
  }
  .c8-services__sub {
    font-family: var(--montreal, system-ui, sans-serif);
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.55;
    color: #555;
    margin: 0;
  }

  /* Card grid — 3 desktop / 2 tablet / 1 mobile. */
  .c8-services__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 2vw, 1.75rem);
  }
  @media (max-width: 1100px) { .c8-services__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px)  { .c8-services__grid { grid-template-columns: 1fr; } }

  /* Card surface — same premium-quiet treatment as the old pinned cards. */
  .c8-services__card {
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, #ffffff 0%, #fafaf7 100%);
    border: 1px solid rgba(0, 0, 0, 0.05);
    border-radius: 18px;
    overflow: hidden;
    box-shadow:
      0 20px 44px -24px rgba(0, 0, 0, 0.12),
      0 0 30px -20px var(--c8-gold-soft),
      inset 0 1px 0 rgba(255, 255, 255, 0.5);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.4s ease, border-color 0.4s ease;
  }
  .c8-services__card:hover {
    transform: translateY(-5px);
    border-color: var(--c8-gold-glow);
    box-shadow:
      0 32px 64px -24px rgba(0, 0, 0, 0.18),
      0 0 50px -10px var(--c8-gold-soft),
      inset 0 1px 0 rgba(255, 255, 255, 0.5);
  }

  /* Media tile on top. 16:10 keeps it shorter than 16:9 so cards stay tight. */
  .c8-services__media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #000;
  }
  .c8-services__media video,
  .c8-services__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Gold tint on the Full-Stack card to warm the purple-graded source clip. */
  .c8-services__card--gold .c8-services__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(212, 142, 26, 0.28);
    mix-blend-mode: color;
    pointer-events: none;
  }

  /* Body stack */
  .c8-services__body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.25rem, 2vw, 1.75rem);
    flex: 1;
  }
  .c8-services__card-title {
    margin: 0;
    font-family: var(--montreal, system-ui, sans-serif);
    font-size: clamp(1.35rem, 1.7vw, 1.55rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    color: #0a0a0a;
    line-height: 1.2;
  }

  .c8-services__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
  }
  .c8-services__tag {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    padding: 0.3rem 0.7rem;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 999px;
    color: #3a3a3a;
    text-decoration: none;
    transition: border-color 0.3s ease, background-color 0.3s ease, color 0.3s ease;
  }
  .c8-services__tag:hover {
    border-color: var(--c8-gold);
    background-color: var(--c8-gold);
    color: #111;
  }

  .c8-services__desc {
    margin: 0;
    font-family: var(--montreal, system-ui, sans-serif);
    font-size: 0.95rem;
    line-height: 1.55;
    color: #555;
    flex: 1;
  }

  /* CTA — pill, mirrors the site-wide button treatment. */
  .c8-services__cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.75rem 1.2rem;
    background: transparent;
    color: #111;
    border: 1.5px solid #111;
    border-radius: 999px;
    font-family: var(--montreal, system-ui, sans-serif);
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    margin-top: 0.25rem;
    transition: background 0.35s ease, color 0.35s ease, transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.35s ease;
  }
  .c8-services__cta svg {
    width: 14px;
    height: 14px;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .c8-services__cta:hover {
    background: var(--c8-gold);
    border-color: var(--c8-gold);
    color: #111;
    transform: translateY(-1px);
  }
  .c8-services__cta:hover svg {
    transform: translate(2px, -2px);
  }
</style>
