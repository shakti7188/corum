---
import { cases } from "../data/content";
---

<section id="work" class="section-pad border-t border-[color:var(--color-rule)]">
  <div class="container-wide">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-8 mb-16" data-reveal-group>
      <div>
        <p data-reveal class="text-[12px] uppercase tracking-[0.2em] text-[color:var(--color-ink-mute)] mb-4">
          Our work
        </p>
        <h2 data-reveal class="headline" style="font-size: var(--fs-100); max-width: 12ch;">
          Brands built to{" "}
          <span class="font-serif-it">stand out.</span>
        </h2>
      </div>
      <a data-reveal href="#" class="cta-pill cta-ghost self-start md:self-end">
        View all projects
      </a>
    </div>

    <div class="grid grid-cols-12 gap-6 md:gap-8" data-reveal-group>
      {
        cases.map((c, i) => {
          // Asymmetric rhythm: 7/5, 5/7, 12, 6/6 for variety
          const spans = ["md:col-span-7", "md:col-span-5", "md:col-span-5", "md:col-span-7", "md:col-span-12"];
          return (
            <a
              href="#"
              class:list={["case-card col-span-12", spans[i]]}
              data-reveal
              aria-label={`${c.client} — ${c.label}`}
            >
              {c.isVideo ? (
                <video
                  src={c.media}
                  muted
                  loop
                  playsinline
                  preload="metadata"
                />
              ) : (
                <img src={c.media} alt="" loading="lazy" />
              )}
              <div class="overlay">
                <div class="flex items-end justify-between gap-6">
                  <div>
                    <p class="text-[12px] tracking-[0.18em] uppercase opacity-80">{c.label}</p>
                    <h3 class="headline mt-1" style="font-size: var(--fs-44);">{c.client}</h3>
                  </div>
                  <div class="text-[13px] uppercase tracking-[0.18em] opacity-80 pb-2">
                    {c.year}
                  </div>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
