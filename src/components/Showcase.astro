---
// Showcase.astro
// Sits between <Services /> and <Ethos />. Two blocks:
//   1. Pin-and-slide video: video pins to viewport, four narrative panels
//      travel across it right→left as the user scrolls. Panels live at the
//      BOTTOM of the video (caption-style) — not centered over it.
//      Content clubs the nine hero-stats into three themed groups so the
//      reader digests scale / reach / record in three beats, plus an opener.
//   2. Client-logo strip: flex-wrap, same visual language as the hero's
//      media-logos (c8-hero__press-logos) — just slightly bigger.

// Three tight slides. Each slide has the same shape — eyebrow, a single
// punchy tagline, and two proof numbers. Fixed-height overlay so the
// yellow band doesn't change size as slides advance.
const slides = [
  {
    eyebrow: 'What we do',
    tagline: 'We build, market and scale.',
    stats: [
      { value: '1,100+', label: 'Projects shipped' },
      { value: '10+',    label: 'Years in market' },
    ],
  },
  {
    eyebrow: 'The results',
    tagline: 'Revenue, not vanity metrics.',
    stats: [
      { value: '$120M+', label: 'Client revenue driven' },
      { value: '2.5B+',  label: 'Impressions generated' },
    ],
  },
  {
    eyebrow: 'The network',
    tagline: 'Reach that compounds.',
    stats: [
      { value: '25,000+', label: 'Vetted creators' },
      { value: '30+',     label: 'Countries served' },
    ],
  },
];

// Client logos shown below the pinned video — same visual language as the
// hero's media-logos strip (grayscale, hover reveal), just slightly larger.
const clients = [
  { src: '/clients/binance.png',       alt: 'Binance' },
  { src: '/clients/kucoin.png',        alt: 'KuCoin' },
  { src: '/clients/okx.png',           alt: 'OKX' },
  { src: '/clients/metamask.png',      alt: 'MetaMask' },
  { src: '/clients/tether.png',        alt: 'Tether' },
  { src: '/clients/tron.png',          alt: 'TRON' },
  { src: '/clients/etoro.png',         alt: 'eToro' },
  { src: '/clients/gate-io.png',       alt: 'Gate.io' },
  { src: '/clients/coinmarketcap.png', alt: 'CoinMarketCap' },
  { src: '/clients/fanadise.png',      alt: 'Fanadise' },
  { src: '/clients/metarix.png',       alt: 'Metarix' },
  { src: '/clients/ubuntu-tribe.png',  alt: 'Ubuntu Tribe' },
  { src: '/clients/dream11.png',       alt: 'Dream11' },
  { src: '/clients/kava.png',          alt: 'Kava' },
  { src: '/clients/iotex.png',         alt: 'IoTeX' },
  { src: '/clients/eos.png',           alt: 'EOS' },
  { src: '/clients/wazirx.png',        alt: 'WazirX' },
  { src: '/clients/Plasmapay.png',     alt: 'PlasmaPay' },
];
---

<section class="c8-showcase">

  <!-- Client logo strip — ABOVE the video showcase per latest direction. -->
  <div class="c8-showcase__clients">
    <p class="c8-showcase__clients-label">Trusted by Industry Leaders</p>
    <p class="c8-showcase__clients-sublabel">Served 1,100+ clients from early-stage startups to global enterprises</p>
    <div class="c8-showcase__clients-logos c8-marquee">
      <div class="c8-marquee__track">
        {clients.map((c) => (
          <img src={c.src} alt={c.alt} loading="lazy" class="c8-showcase__client-img" />
        ))}
        {clients.map((c) => (
          <img src={c.src} alt="" aria-hidden="true" loading="lazy" class="c8-showcase__client-img c8-marquee__clone" />
        ))}
      </div>
    </div>
  </div>

  <!-- Static slider — 3 slides, unified shape, fixed-height yellow overlay. -->
  <div class="c8-showcase__inner" data-c8-slider style={`--c8-slides: ${slides.length};`}>
    <div class="c8-showcase__frame">
      <video
        class="c8-showcase__video"
        src="/media/bg2.mp4"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
      ></video>

      <div class="c8-showcase__veil"></div>

      <div class="c8-showcase__ticks" data-c8-ticks>
        {slides.map((_, i) => (
          <button class="c8-showcase__tick" data-i={i} aria-label={`Go to slide ${i + 1}`}></button>
        ))}
      </div>

      <button class="c8-showcase__nav c8-showcase__nav--prev" data-c8-prev aria-label="Previous slide">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 18l-6-6 6-6" />
        </svg>
      </button>
      <button class="c8-showcase__nav c8-showcase__nav--next" data-c8-next aria-label="Next slide">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 18l6-6-6-6" />
        </svg>
      </button>

      <div class="c8-showcase__slides-track" data-c8-slides>
        {slides.map((s) => (
          <div class="c8-showcase__slide">
            <div class="c8-showcase__panel">
              <div class="c8-showcase__panel-left">
                <span class="c8-showcase__eyebrow">{s.eyebrow}</span>
                <p class="c8-showcase__tagline">{s.tagline}</p>
              </div>
              <div class="c8-showcase__stats">
                {s.stats.map((st) => (
                  <div class="c8-showcase__stat">
                    <span class="c8-showcase__stat-value">{st.value}</span>
                    <span class="c8-showcase__stat-label">{st.label}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

</section>

<style is:global>
  .c8-showcase {
    position: relative;
    padding: 0 0 clamp(5rem, 10vh, 9rem);
    color: #0a0a0a;
    overflow: visible;
  }

  /* ---------- Static slider ---------- */

  .c8-showcase__inner {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: clamp(2rem, 5vh, 4rem) clamp(1.5rem, 5vw, 5rem);
    box-sizing: border-box;
  }
  .c8-showcase__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 1.25rem;
    overflow: hidden;
    background: #000;
    box-shadow: 0 30px 80px -40px rgba(0, 0, 0, 0.25);
  }
  .c8-showcase__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Gradient veil — light so the video image stays the hero. The dark
     content panel itself carries the contrast for the text. */
  .c8-showcase__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 0.08) 55%,
      rgba(0, 0, 0, 0.28) 100%
    );
    pointer-events: none;
  }

  /* Prev / Next buttons — always visible, hover lifts and glows gold. */
  .c8-showcase__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    width: clamp(40px, 4vw, 52px);
    height: clamp(40px, 4vw, 52px);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    color: #111;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 10px 28px -12px rgba(0, 0, 0, 0.35);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
  }
  .c8-showcase__nav--prev { left: clamp(0.75rem, 1.5vw, 1.25rem); }
  .c8-showcase__nav--next { right: clamp(0.75rem, 1.5vw, 1.25rem); }
  .c8-showcase__nav:hover {
    background: var(--c8-gold);
    color: #111;
    transform: translateY(-50%) scale(1.06);
    box-shadow: 0 14px 34px -10px rgba(245, 166, 35, 0.55);
  }
  .c8-showcase__nav:focus-visible {
    outline: 2px solid var(--c8-gold);
    outline-offset: 3px;
  }

  /* Progress ticks — bottom-left, same row as the eyebrow baseline */
  .c8-showcase__ticks {
    position: absolute;
    top: clamp(1.25rem, 2.5vw, 2rem);
    right: clamp(1.25rem, 2.5vw, 2rem);
    z-index: 3;
    display: flex;
    gap: 0.5rem;
    pointer-events: none;
  }
  .c8-showcase__tick {
    width: clamp(1.5rem, 3vw, 2.25rem);
    height: 3px;
    padding: 0;
    border: none;
    background: rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    position: relative;
    overflow: hidden;
    cursor: pointer;
  }
  .c8-showcase__tick::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #fff;
    transform: scaleX(var(--fill, 0));
    transform-origin: left center;
    transition: transform 0.12s linear;
  }

  /* Horizontal track holding every slide. Snap behavior — transform is
     written in discrete steps (0%, -25%, -50%, -75%) by JS and the CSS
     transition eases between steps so each slide arrives as one full
     motion, not a hand-over-hand scroll response. */
  .c8-showcase__slides-track {
    position: absolute;
    inset: 0;
    display: flex;
    width: calc(var(--c8-slides, 4) * 100%);
    will-change: transform;
    transform: translate3d(0, 0, 0);
    transition: transform 0.7s cubic-bezier(0.6, 0, 0.2, 1);
  }
  .c8-showcase__slide {
    flex: 0 0 calc(100% / var(--c8-slides, 4));
    display: flex;
    align-items: flex-end;
    padding: 0;
    color: #111;
    box-sizing: border-box;
  }

  /* Full-width bottom strip with a translucent brand-gold wash. Fixed
     min-height so the yellow band stays the same size across all slides
     — stops the frame from "breathing" as copy changes length. */
  .c8-showcase__panel {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    width: 100%;
    min-height: clamp(140px, 18vh, 200px);
    padding: clamp(1.25rem, 2.6vh, 1.9rem) clamp(1.25rem, 4vw, 3.5rem);
    background: rgba(245, 166, 35, 0.78);
    -webkit-backdrop-filter: blur(6px) saturate(1.1);
    backdrop-filter: blur(6px) saturate(1.1);
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    color: #111;
    box-sizing: border-box;
  }
  .c8-showcase__panel-left {
    display: flex;
    flex-direction: column;
    gap: clamp(0.5rem, 1.2vh, 0.9rem);
    flex: 1 1 auto;
    min-width: 0;
  }
  .c8-showcase__eyebrow {
    font-family: var(--montreal, sans-serif);
    font-size: clamp(0.7rem, 0.82vw, 0.82rem);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.7);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .c8-showcase__eyebrow::before {
    content: '';
    width: 1.25rem;
    height: 1px;
    background: rgba(0, 0, 0, 0.4);
  }

  .c8-showcase__tagline {
    margin: 0;
    max-width: 28rem;
    font-family: var(--montreal, sans-serif);
    font-size: clamp(1.4rem, 2.4vw, 2.25rem);
    line-height: 1.1;
    font-weight: 500;
    letter-spacing: -0.025em;
    color: #111;
  }

  /* Stats sit right-aligned on the strip */
  .c8-showcase__stats {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-end;
    gap: clamp(1.5rem, 3.5vw, 3rem);
    flex: 0 0 auto;
  }
  .c8-showcase__stat {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 0 1 auto;
    min-width: 0;
  }
  .c8-showcase__stat-value {
    font-family: var(--montreal, sans-serif);
    font-size: clamp(1.65rem, 3.6vw, 3.2rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.95;
    color: #111;
    white-space: nowrap;
  }
  .c8-showcase__stat-label {
    font-family: var(--montreal, sans-serif);
    font-size: clamp(0.7rem, 0.82vw, 0.82rem);
    letter-spacing: 0.05em;
    color: rgba(0, 0, 0, 0.68);
    font-weight: 500;
    line-height: 1.3;
    max-width: 11rem;
  }

  /* ---------- Client logos (hero-press-logos style) ---------- */

  .c8-showcase__clients {
    width: 100%;
    padding: clamp(0.75rem, 1.5vh, 1.25rem) clamp(1.5rem, 5vw, 5rem)
             clamp(2rem, 4vh, 3rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
    box-sizing: border-box;
  }
  .c8-showcase__clients-label {
    margin: 0 0 0.5rem;
    font-family: var(--montreal, sans-serif);
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: #111;
  }
  .c8-showcase__clients-sublabel {
    margin: 0 0 1.75rem;
    font-family: var(--montreal, sans-serif);
    font-size: clamp(0.9rem, 1.1vw, 1.05rem);
    font-weight: 400;
    color: #6b7280;
    line-height: 1.5;
  }

  .c8-showcase__clients-logos {
    width: 100%;
    --c8-marquee-dur: 55s;
  }
  .c8-showcase__clients-logos .c8-marquee__track { gap: 1rem 2.25rem; }
  .c8-showcase__client-img {
    height: 42px;
    width: auto;
    max-width: 180px;
    object-fit: contain;
    filter: grayscale(1) brightness(0.25);
    opacity: 0.75;
    transition: opacity 0.25s ease, filter 0.25s ease;
  }
  .c8-showcase__client-img:hover {
    filter: none;
    opacity: 1;
  }

  @media (max-width: 900px) {
    .c8-showcase__frame       { aspect-ratio: 4 / 5; border-radius: 1rem; }
    .c8-showcase__nav         { width: 38px; height: 38px; }
    .c8-showcase__panel       {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      min-height: 0;
      padding: 1rem 1.1rem;
    }
    .c8-showcase__tagline     { font-size: 1.25rem; max-width: 100%; }
    .c8-showcase__stats       { gap: 1.25rem; width: 100%; }
    .c8-showcase__stat-value  { font-size: 1.5rem; }
    .c8-showcase__clients     { padding: 2rem 1.25rem 0.25rem; }
    .c8-showcase__client-img  { height: 32px; max-width: 140px; }
    .c8-showcase__clients-logos { gap: 1rem 1.75rem; }
    .c8-showcase__clients-label { font-size: 1.25rem; margin-bottom: 0.3rem; }
    .c8-showcase__clients-sublabel { font-size: 0.9rem; margin-bottom: 1.25rem; }
  }
</style>

<script is:inline>
  // Static slider — auto-advances every 5s; left/right buttons + tick dots
  // for manual stepping. No scroll coupling. Timer pauses on hover and is
  // fully disabled for users who prefer reduced motion.
  (() => {
    const sliders = document.querySelectorAll('[data-c8-slider]');
    if (!sliders.length) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const AUTO_MS = 5000;

    sliders.forEach((slider) => {
      const track = slider.querySelector('[data-c8-slides]');
      const ticksWrap = slider.querySelector('[data-c8-ticks]');
      const prevBtn = slider.querySelector('[data-c8-prev]');
      const nextBtn = slider.querySelector('[data-c8-next]');
      if (!track) return;

      const slideCount = Number(slider.style.getPropertyValue('--c8-slides')) || track.children.length;
      if (slideCount <= 1) return;

      const ticks = ticksWrap ? Array.from(ticksWrap.children) : [];
      const step = 100 / slideCount;
      let current = 0;
      let timer = null;

      const render = (idx) => {
        current = ((idx % slideCount) + slideCount) % slideCount;
        track.style.transform = `translate3d(${-current * step}%, 0, 0)`;
        for (let i = 0; i < ticks.length; i++) {
          ticks[i].style.setProperty('--fill', i <= current ? '1' : '0');
        }
      };

      const go = (idx) => { render(idx); restart(); };
      const next = () => go(current + 1);
      const prev = () => go(current - 1);

      const start = () => {
        if (reduce || timer) return;
        timer = setInterval(() => render(current + 1), AUTO_MS);
      };
      const stop = () => {
        if (!timer) return;
        clearInterval(timer);
        timer = null;
      };
      const restart = () => { stop(); start(); };

      prevBtn && prevBtn.addEventListener('click', prev);
      nextBtn && nextBtn.addEventListener('click', next);
      ticks.forEach((t, i) => t.addEventListener('click', () => go(i)));

      // Pause while the user is interacting with the frame so auto-advance
      // doesn't snatch the panel from under them.
      const frame = slider.querySelector('.c8-showcase__frame');
      frame && frame.addEventListener('mouseenter', stop);
      frame && frame.addEventListener('mouseleave', start);

      // Only run the timer when the slider is on-screen — stops it from
      // ticking forever in the background tab.
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => (e.isIntersecting ? start() : stop()));
        }, { threshold: 0.2 });
        io.observe(slider);
      } else {
        start();
      }

      render(0);
    });
  })();
</script>
