.b2-cta__inner{position:relative;z-index:1;max-width:680px;margin:0 auto;}
.b2-cta__h2{font-size:clamp(2.4rem,5vw,3.8rem);font-weight:800;line-height:1.1;letter-spacing:-.04em;color:#fff;margin:1rem 0;}
.b2-cta__inner p{font-size:1rem;line-height:1.7;color:rgba(255,255,255,.5);margin-bottom:2.5rem;}
.b2-cta__btns{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;}

@media(prefers-reduced-motion:reduce){.float-a,.float-b{animation:none;}}
