  { cls: 'plat-4', title: 'Instagram', bg: 'linear-gradient(45deg,#f09433 0%,#e6683c 25%,#dc2743 50%,#cc2366 75%,#bc1888 100%)', path: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z' },
  { cls: 'plat-5', title: 'Facebook', bg: '#1877F2', path: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z' },
  { cls: 'plat-6', title: 'Discord', bg: '#5865F2', path: 'M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z' },
  { cls: 'plat-7', title: 'TikTok', bg: '#000', path: 'M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z' },
];

const verticals = ['Web3', 'AI Tech', 'DeFi', 'Gaming', 'Fintech', 'Lifestyle', 'Enterprise', 'Crypto'];

const centerVideo = resolveMedia('video.ambient');
---

<section class="c8-reach">
  <div class="c8-reach__inner">

    <!-- LEFT — orbital visual -->
    <div class="c8-reach__visual">
      <div class="c8-reach__glow"></div>

      <div class="c8-reach__ring c8-reach__ring--1"></div>
      <div class="c8-reach__ring c8-reach__ring--2"></div>

      <div class="c8-reach__centre">
        {centerVideo && (
          <video autoplay muted loop playsinline preload="metadata">
            <source src={centerVideo.src} type="video/mp4" />
          </video>
        )}
      </div>

      {orbs.map((o) => (
        <div class={`c8-reach__orb ${o.cls}`}>
          <div class="c8-reach__orb-img">
            <img src={o.img} alt={o.alt} loading="lazy" />
          </div>
          <div class="c8-reach__orb-tag">
            <span class="c8-reach__orb-count">{o.count}</span>
            <span class="c8-reach__orb-vert">{o.vertical}</span>
          </div>
        </div>
      ))}

      {platforms.map((p) => (
        <div class={`c8-reach__plat ${p.cls}`} style={`background:${p.bg}`} title={p.title} aria-label={p.title}>
          <svg viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d={p.path} /></svg>
        </div>
      ))}
    </div>

    <!-- RIGHT — content, stats, tags, CTA -->
    <div class="c8-reach__body">
      <h2 class="c8-reach__heading">
        25,000+ Influencers.<br />
        <span class="c8-reach__heading-accent">Global Reach.</span>
      </h2>
      <p class="c8-reach__lede">
        Our vetted network spans every vertical that matters — crypto, finance,
        tech, gaming, lifestyle and beyond. Human connection paired with deep
        data analytics for full ROI attribution globally.
      </p>

      <div class="c8-reach__stats">
        <div class="c8-reach__stat">
          <div class="c8-reach__stat-num">25,000+</div>
          <div class="c8-reach__stat-lbl">Creators</div>
        </div>
        <div class="c8-reach__stat">
          <div class="c8-reach__stat-num">15+</div>
          <div class="c8-reach__stat-lbl">Verticals</div>
        </div>
        <div class="c8-reach__stat">
          <div class="c8-reach__stat-num">30+</div>
          <div class="c8-reach__stat-lbl">Regions</div>
        </div>
      </div>

      <div class="c8-reach__verticals">
        <p class="c8-reach__verticals-label">Top performing verticals</p>
        <div class="c8-reach__tags">
          {verticals.map((v) => (
            <span class="c8-reach__tag">{v}</span>
          ))}
        </div>
      </div>

      <a class="c8-reach__cta" href="/services/marketing/influencer-marketing">
        <span>Deploy A Campaign</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </a>
    </div>

  </div>
</section>

<style>
  .c8-reach {
    padding: clamp(5rem, 10vh, 9rem) 0;
    background: var(--color-bg);
    overflow: hidden;
  }

  .c8-reach__inner {
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: clamp(1.5rem, 5vw, 5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4rem;
  }

  /* ------------------------------------------------------------------
     LEFT — orbital visual
     A circular stage holding: an ambient glow, two orbit rings, a
     central video, four photo "orbs" with follower-count overlays, and
     seven platform-logo orbs scattered around the ring.
  ------------------------------------------------------------------ */
  .c8-reach__visual {
    position: relative;
    width: min(640px, 96vw);
    aspect-ratio: 1 / 1;
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1200px;
  }

  /* Pulsing radial halo behind everything. Breathes 4s — same cadence as
     the reference. */
  .c8-reach__glow {
    position: absolute;
    width: 80%;
    height: 80%;
    border-radius: 50%;
    background: radial-gradient(circle, var(--c8-gold-soft) 0%, transparent 70%);
    animation: c8-reach-pulse 4s ease-in-out infinite alternate;
    pointer-events: none;
    z-index: 1;
  }
  @keyframes c8-reach-pulse {
    0%, 100% { transform: scale(1); opacity: 0.5; box-shadow: 0 0 30px var(--c8-gold-soft); }
    50%      { transform: scale(1.15); opacity: 0.8; box-shadow: 0 0 70px var(--c8-gold-glow); }
  }

  /* Two orbital rings — one rotates clockwise, one counter-clockwise. */
  .c8-reach__ring {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 2;
  }
  .c8-reach__ring--1 {
    width: 70%;
    height: 70%;
    border: 1px dashed var(--c8-gold-glow);
    animation: c8-reach-spin 30s linear infinite;
  }
  .c8-reach__ring--2 {
    width: 95%;
    height: 95%;
    border: 2px dotted var(--c8-gold-glow);
    animation: c8-reach-spin-rev 40s linear infinite;
  }
  @keyframes c8-reach-spin {
    0%   { transform: translate(-50%, -50%) rotate(0deg); }
    100% { transform: translate(-50%, -50%) rotate(360deg); }
  }
  @keyframes c8-reach-spin-rev {
    0%   { transform: translate(-50%, -50%) rotate(0deg); }
    100% { transform: translate(-50%, -50%) rotate(-360deg); }
  }

  /* Central video portal — 45% of the stage, gold ring + glow. */
  .c8-reach__centre {
    position: absolute;
    width: 45%;
    height: 45%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    overflow: hidden;
    background: #111;
    border: 3px solid var(--c8-gold-glow);
    box-shadow: 0 0 60px var(--c8-gold-soft);
    z-index: 10;
  }
  .c8-reach__centre video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- Photo orbs ----------
     Each orb is anchored by top/left %, floats on its own keyframe, and
     parks a dark pill underneath showing follower count + vertical. */
  .c8-reach__orb {
    position: absolute;
    z-index: 15;
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
    transition: transform 0.5s cubic-bezier(0.18, 0.89, 0.32, 1.28);
  }
  .c8-reach__orb-img {
    border-radius: 50%;
    overflow: hidden;
    background: #000;
    border: 4px solid #fff;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
    transition: border-color 0.5s ease, box-shadow 0.5s ease;
  }
  .c8-reach__orb-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .c8-reach__orb:hover {
    transform: scale(1.12) translateY(-8px);
    z-index: 40;
  }
  .c8-reach__orb:hover .c8-reach__orb-img {
    border-color: var(--c8-gold);
    box-shadow: 0 25px 50px var(--c8-gold-glow);
  }
  .c8-reach__orb:hover .c8-reach__orb-img img {
    transform: scale(1.08);
  }

  /* Count + vertical pill parked underneath the photo. */
  .c8-reach__orb-tag {
    position: absolute;
    bottom: -18px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    padding: 5px 12px;
    background: rgba(15, 23, 42, 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 999px;
    white-space: nowrap;
    transition: background 0.3s ease, border-color 0.3s ease, bottom 0.3s ease;
    z-index: 20;
  }
  .c8-reach__orb:hover .c8-reach__orb-tag {
    background: var(--c8-gold);
    border-color: rgba(255, 255, 255, 0.4);
    bottom: -22px;
  }
  .c8-reach__orb-count {
    color: #fff;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.3px;
    line-height: 1.1;
  }
  .c8-reach__orb:hover .c8-reach__orb-count {
    color: #111;
  }
  .c8-reach__orb-vert {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    line-height: 1.1;
  }
  .c8-reach__orb:hover .c8-reach__orb-vert {
    color: rgba(0, 0, 0, 0.75);
  }

  /* Orb placements + per-orb float keyframes. Pushed closer to the corners
     and bumped up in size so the visual feels abundant, not crowded. */
  .orb-1 { top: 10%;   left: 10%;  animation: c8-reach-float-a 4.5s ease-in-out infinite; }
  .orb-1 .c8-reach__orb-img { width: 109px; height: 109px; }
  .orb-2 { top: 6%;    right: 10%; animation: c8-reach-float-b 5.5s ease-in-out infinite 1s; }
  .orb-2 .c8-reach__orb-img { width: 122px; height: 122px; }
  .orb-3 { bottom: 10%; right: 8%; animation: c8-reach-float-a 6.5s ease-in-out infinite 0.5s; }
  .orb-3 .c8-reach__orb-img { width: 136px; height: 136px; }
  .orb-4 { bottom: 12%; left: 8%;  animation: c8-reach-float-b 5s ease-in-out infinite 1.5s; }
  .orb-4 .c8-reach__orb-img { width: 102px; height: 102px; }

  @keyframes c8-reach-float-a {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-12px); }
  }
  @keyframes c8-reach-float-b {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(12px); }
  }

  /* ---------- Platform orbs ----------
     Bigger circles than before (50px), floating on their own paths. */
  .c8-reach__plat {
    position: absolute;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
    z-index: 30;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .c8-reach__plat:hover {
    transform: scale(1.2);
    box-shadow: 0 15px 30px var(--c8-gold-glow);
    z-index: 50;
  }
  .c8-reach__plat svg {
    width: 24px;
    height: 24px;
  }
  .plat-1 { top: 40%; left: 14%;   animation: c8-reach-float-c 3.5s ease-in-out infinite; }
  .plat-2 { top: 12%; right: 38%;  animation: c8-reach-float-d 4s   ease-in-out infinite 0.5s; }
  .plat-3 { top: 60%; right: 14%;  animation: c8-reach-float-c 4.5s ease-in-out infinite 1s; }
  .plat-4 { bottom: 12%; right: 38%; animation: c8-reach-float-d 3.8s ease-in-out infinite 1.5s; }
  .plat-5 { bottom: 35%; left: 16%;  animation: c8-reach-float-c 4.2s ease-in-out infinite 0.2s; }
  .plat-6 { top: 12%; left: 38%;   animation: c8-reach-float-d 4.8s ease-in-out infinite 0.8s; }
  .plat-7 { bottom: 8%; left: 40%;  animation: c8-reach-float-c 4.3s ease-in-out infinite 1.2s; }

  @keyframes c8-reach-float-c {
    0%, 100% { transform: translateY(0) scale(1); }
    50%      { transform: translateY(-8px) scale(1.05); }
  }
  @keyframes c8-reach-float-d {
    0%, 100% { transform: translateY(0) scale(1); }
    50%      { transform: translateY(8px) scale(0.95); }
  }

  /* ------------------------------------------------------------------
     RIGHT — content
  ------------------------------------------------------------------ */
  .c8-reach__body {
    max-width: 36rem;
    text-align: center;
  }

  .c8-reach__heading {
    margin: 0 0 1rem;
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 500;
    color: #111;
  }
  .c8-reach__heading-accent {
    background: linear-gradient(135deg, var(--c8-gold) 0%, var(--c8-gold-light) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  .c8-reach__lede {
    margin: 0 0 2rem;
    font-size: 1.1rem;
    line-height: 1.65;
    color: #474a52;
  }

  .c8-reach__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  .c8-reach__stat {
    padding: 1.25rem 0.75rem;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.04);
    border-radius: 1rem;
    box-shadow: 0 12px 28px -18px rgba(0, 0, 0, 0.18);
    text-align: center;
    transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
  }
  .c8-reach__stat:hover {
    transform: translateY(-3px);
    border-color: var(--c8-gold-glow);
    box-shadow: 0 16px 32px -16px rgba(0, 0, 0, 0.2), 0 0 28px -12px var(--c8-gold-soft);
  }
  .c8-reach__stat-num {
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #111;
  }
  .c8-reach__stat-lbl {
    margin-top: 0.25rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .c8-reach__verticals {
    margin-bottom: 2rem;
  }
