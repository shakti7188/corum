---
// Full-bleed hero: small eyebrow-sized lead + huge gold rotator as the
// visual anchor, stats band pinned to the bottom.
//
// Animations (all respect prefers-reduced-motion):
//   - Typewriter rotator (types → holds → backspaces → next word).
//   - Count-up on every stat (ease-out cubic, 180ms stagger).
//   - Cursor-tracking gold glow on the veil (pointer devices only).
//   - Stagger fade-up on load.
//   - CTA shimmer sweep every 6s.
//
// Typography: everything is straight Montreal. No italics anywhere.
---

<section class="c8-hero-section">

  <!-- Layer 1: video background + readability veil -->
  <div class="c8-hero__bg" aria-hidden="true">
    <video
      class="c8-hero__video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/images/hero.webp">
      <source src="/media/bg2.mp4" type="video/mp4" />
    </video>
    <div class="c8-hero__veil"></div>
  </div>

  <!-- Layer 2: narrative content -->
  <div class="c8-hero__inner">

    <!-- Full trust pill -->
    <div class="c8-hero__trust">
      <span class="c8-hero__stars" aria-label="4.9 out of 5 stars">
        {Array.from({length: 5}).map(() => (
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="#f2bf22" stroke="none">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
        ))}
      </span>
      <span class="c8-hero__trust-text"><strong>4.9</strong> Trustpilot</span>
      <span class="c8-hero__trust-sep" aria-hidden="true">/</span>
      <span class="c8-hero__trust-text"><strong>50+</strong> Awards</span>
      <span class="c8-hero__trust-sep" aria-hidden="true">/</span>
      <span class="c8-hero__trust-text"><strong>30+</strong> Countries</span>
    </div>

    <!-- Headline: single decisive statement, no rotator -->
    <h1 class="c8-hero__headline">
      <span class="c8-hero__title">Build brands that <span class="c8-hero__title-accent">dominate markets.</span></span>
    </h1>

    <!-- Subtitle -->
    <p class="c8-hero__sub">
      Marketing, PR, development and community growth &mdash; executed by one integrated global team.
    </p>

    <!-- Region row — global presence proof -->
    <div class="c8-hero__regions" aria-label="Global presence">
      <span>US</span>
      <span class="c8-hero__region-sep" aria-hidden="true">•</span>
      <span>EU</span>
      <span class="c8-hero__region-sep" aria-hidden="true">•</span>
      <span>UAE</span>
      <span class="c8-hero__region-sep" aria-hidden="true">•</span>
      <span>INDIA</span>
    </div>

    <!-- Dual CTA -->
    <div class="c8-hero__ctas">
      <a class="c8-hero__cta c8-hero__cta--primary" href="/contact">
        <span class="c8-hero__cta-text">Book Strategy Call</span>
        <span class="c8-hero__cta-arrow" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 17.1 15.17">
            <path d="m17.1,7.58s-.01-.04-.01-.06c.01-.22-.06-.45-.24-.61L9.23.19c-.31-.27-.78-.24-1.06.07-.27.31-.24.78.07,1.06l6.26,5.52H.75c-.41,0-.75.34-.75.75s.34.75.75.75h13.74l-6.26,5.52c-.31.27-.34.75-.07,1.06.15.17.35.25.56.25.18,0,.35-.06.5-.19l7.62-6.72c.18-.16.25-.39.24-.61,0-.02.01-.04.01-.06Z" fill="currentColor"></path>
          </svg>
        </span>
      </a>
      <a class="c8-hero__cta c8-hero__cta--secondary" href="/case-studies">
        <span class="c8-hero__cta-text">View Case Studies</span>
      </a>
    </div>

  </div>

  <!-- Layer 3: glass stats band, pinned to bottom -->
  <aside class="c8-hero__stats" aria-label="Corum8 by the numbers">
    <div class="c8-hero__stat">
      <span class="c8-hero__stat-num"
            data-end="1100"
            data-suffix="+"
            data-format="comma">0+</span>
      <span class="c8-hero__stat-label">Brands scaled</span>
    </div>
    <div class="c8-hero__stat">
      <span class="c8-hero__stat-num"
            data-end="120"
            data-prefix="$"
            data-suffix="M+">$0M+</span>
      <span class="c8-hero__stat-label">Revenue driven</span>
    </div>
    <div class="c8-hero__stat">
      <span class="c8-hero__stat-num"
            data-end="25000"
            data-suffix="+"
            data-format="comma">0+</span>
      <span class="c8-hero__stat-label">Creators in network</span>
    </div>
    <div class="c8-hero__stat">
      <span class="c8-hero__stat-num"
            data-end="10"
            data-suffix="+">0+</span>
      <span class="c8-hero__stat-label">Years building winners</span>
    </div>
  </aside>

</section>

<style is:global>
  /* ─── Section shell ─── */
  .c8-hero-section {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: #fff;
    isolation: isolate;
    --c8-hero-cx: 82%;
    --c8-hero-cy: 28%;
  }

  /* ─── Layer 1: video bg + veil ─── */
  .c8-hero__bg { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
  .c8-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    background: #0a0a0a;
  }
  .c8-hero__veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(420px circle at var(--c8-hero-cx) var(--c8-hero-cy),
        rgba(242,191,34,0.22) 0%,
        rgba(242,191,34,0.08) 38%,
        transparent 65%),
      linear-gradient(180deg,
        rgba(10,10,10,0.6) 0%,
        rgba(10,10,10,0.30) 38%,
        rgba(10,10,10,0.50) 72%,
        rgba(10,10,10,0.82) 100%);
  }

  /* ─── Layer 2: content ─── */
  .c8-hero__inner {
    position: relative;
    z-index: 2;
    flex: 1;
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: clamp(1.1rem, 2.4vh, 1.8rem);
    padding: clamp(5.5rem, 11vh, 7rem) clamp(1.5rem, 5vw, 5rem) clamp(2rem, 4vh, 3rem);
  }

  /* Staggered rise-in on load */
  .c8-hero__trust,
  .c8-hero__headline,
  .c8-hero__sub,
  .c8-hero__regions,
  .c8-hero__ctas,
  .c8-hero__stat {
    opacity: 0;
    transform: translateY(14px);
    animation: c8-hero-rise 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .c8-hero__trust    { animation-delay: 0.10s; }
  .c8-hero__headline { animation-delay: 0.25s; }
  .c8-hero__sub      { animation-delay: 0.55s; }
  .c8-hero__regions  { animation-delay: 0.70s; }
  .c8-hero__ctas     { animation-delay: 0.85s; }
  .c8-hero__stat:nth-child(1) { animation-delay: 1.05s; }
  .c8-hero__stat:nth-child(2) { animation-delay: 1.18s; }
  .c8-hero__stat:nth-child(3) { animation-delay: 1.31s; }
  .c8-hero__stat:nth-child(4) { animation-delay: 1.44s; }

  @keyframes c8-hero-rise {
    to { opacity: 1; transform: translateY(0); }
  }

  /* Screen-reader only utility */
  .c8-hero__sr {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  /* ─── Trust pill (full) ─── */
  .c8-hero__trust {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.85rem;
    padding: 0.5rem 1rem;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.16);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: 999px;
    width: fit-content;
    box-shadow: 0 6px 24px -10px rgba(0,0,0,0.4);
    transition: border-color 0.35s ease, box-shadow 0.35s ease, background 0.35s ease;
  }
  .c8-hero__trust:hover {
    border-color: rgba(242,191,34,0.45);
    background: rgba(255,255,255,0.12);
    box-shadow: 0 10px 30px -10px rgba(242,191,34,0.25), 0 6px 24px -10px rgba(0,0,0,0.4);
  }
  .c8-hero__stars { display: inline-flex; align-items: center; gap: 1px; }
  .c8-hero__trust-text {
    font-family: var(--montreal);
    font-size: 0.78rem;
    color: rgba(255,255,255,0.82);
    white-space: nowrap;
  }
  .c8-hero__trust-text strong {
    color: #fff;
    font-weight: 600;
    margin-right: 0.2rem;
  }
  .c8-hero__trust-sep {
    color: rgba(255,255,255,0.3);
    font-size: 0.78rem;
    user-select: none;
  }

  /* ─── Headline ─── */
  .c8-hero__headline {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    color: #fff;
    max-width: 22ch;
  }
  .c8-hero__title {
    display: block;
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    text-shadow: 0 2px 28px rgba(0,0,0,0.45);
  }
  .c8-hero__title-accent {
    color: var(--c8-gold);
    display: inline;
  }

  /* ─── Region row — global presence proof ─── */
  .c8-hero__regions {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem 0.75rem;
    font-family: var(--montreal);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.78);
  }
  .c8-hero__region-sep {
    color: var(--c8-gold);
    opacity: 0.7;
  }

  /* ─── Subtitle ─── */
  .c8-hero__sub {
    margin: 0;
    font-family: var(--montreal);
    font-size: clamp(1.05rem, 1.35vw, 1.3rem);
    font-weight: 400;
    line-height: 1.5;
    max-width: 42rem;
    color: rgba(255,255,255,0.82);
    letter-spacing: -0.005em;
    text-shadow: 0 1px 14px rgba(0,0,0,0.3);
  }

  /* ─── CTA ─── */
  .c8-hero__ctas { display: flex; gap: 0.85rem; flex-wrap: wrap; }
  .c8-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1.1rem 1.9rem;
    border-radius: 999px;
    text-decoration: none;
    font-family: var(--montreal);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    line-height: 1;
    position: relative;
    overflow: hidden;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
                background 0.35s ease,
                color 0.35s ease,
                box-shadow 0.35s ease,
                border-color 0.35s ease;
    white-space: nowrap;
  }
  .c8-hero__cta--primary {
    background: var(--c8-gold);
    color: #111;
    border: 1.5px solid var(--c8-gold);
    box-shadow: 0 14px 36px -12px rgba(242,191,34,0.55), 0 2px 6px rgba(0,0,0,0.25);
  }
  .c8-hero__cta--primary::before {
    content: "";
    position: absolute;
    top: 0;
    left: -120%;
    width: 60%;
    height: 100%;
    background: linear-gradient(90deg,
      transparent 0%,
      rgba(255,255,255,0.55) 50%,
      transparent 100%);
    animation: c8-hero-shimmer 6s ease-in-out infinite;
    pointer-events: none;
    z-index: 0;
  }
  .c8-hero__cta--secondary {
    background: rgba(255,255,255,0.06);
    color: #fff;
    border: 1.5px solid rgba(255,255,255,0.32);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .c8-hero__cta-text,
  .c8-hero__cta-arrow { position: relative; z-index: 1; }
  @keyframes c8-hero-shimmer {
    0%   { left: -120%; }
    22%  { left: 140%; }
    100% { left: 140%; }
  }
  .c8-hero__cta--primary:hover {
    transform: translateY(-2px);
    background: #0a0a0a;
    border-color: #0a0a0a;
    color: var(--c8-gold);
    box-shadow: 0 18px 40px -12px rgba(0,0,0,0.6);
  }
  .c8-hero__cta--secondary:hover {
    transform: translateY(-2px);
    background: rgba(255,255,255,0.14);
    border-color: rgba(255,255,255,0.6);
  }
  .c8-hero__cta-arrow {
    display: inline-flex;
    width: 18px;
    height: 18px;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .c8-hero__cta-arrow svg { width: 100%; height: 100%; fill: currentColor; }
  .c8-hero__cta:hover .c8-hero__cta-arrow { transform: translate(3px, -3px); }

  /* ─── Layer 3: glass stats band ─── */
  .c8-hero__stats {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    width: 100%;
    padding: 1.4rem clamp(1.5rem, 5vw, 5rem);
    background: rgba(10,10,10,0.42);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-top: 1px solid rgba(255,255,255,0.08);
  }
  .c8-hero__stat {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.2rem clamp(0.75rem, 1.5vw, 1.5rem);
    border-left: 1px solid rgba(255,255,255,0.1);
  }
  .c8-hero__stat:first-child {
    border-left: none;
    padding-left: 0;
  }
  /* Display font for stat digits — pulled into Cocogoose so the figures
     read with the same brand display weight as the headline. */
  .c8-hero__stat-num {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 500;
    font-size: clamp(1.5rem, 2.4vw, 2.1rem);
    color: var(--c8-gold);
    letter-spacing: -0.02em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .c8-hero__stat-label {
    font-family: var(--montreal);
    font-size: clamp(0.9rem, 1.1vw, 1.05rem);
    font-weight: 500;
    color: rgba(255,255,255,0.82);
    letter-spacing: -0.005em;
    text-transform: none;
  }

  /* ─── Reduced-motion: kill the show, keep legibility ─── */
  @media (prefers-reduced-motion: reduce) {
    .c8-hero__trust,
    .c8-hero__headline,
    .c8-hero__sub,
    .c8-hero__ctas,
    .c8-hero__stat {
      opacity: 1;
      transform: none;
      animation: none;
    }
    .c8-hero__cta--primary::before {
      animation: none !important;
      opacity: 0;
    }
  }

  /* ─── Responsive ─── */
  @media (max-width: 900px) {
    .c8-hero__inner {
      padding: clamp(5.5rem, 10vh, 7rem) 1.5rem clamp(2rem, 4vh, 2.5rem);
      gap: 1.25rem;
    }
    .c8-hero__title { font-size: clamp(2.4rem, 9vw, 4.4rem); }
    .c8-hero__sub  { font-size: 1.02rem; }
    .c8-hero__cta  { padding: 1rem 1.65rem; font-size: 1rem; }

    /* Stats fold to 2×2 */
    .c8-hero__stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem 0;
      padding: 1.1rem clamp(1.25rem, 5vw, 2rem);
    }
    .c8-hero__stat {
      padding: 0.2rem 0.85rem;
      border-left: 1px solid rgba(255,255,255,0.08);
    }
    .c8-hero__stat:nth-child(odd) {
      border-left: none;
      padding-left: 0;
    }
  }
  @media (max-width: 480px) {
    .c8-hero__title { font-size: 2.1rem; line-height: 1.05; }
    .c8-hero__trust-text { font-size: 0.72rem; }
    .c8-hero__stat-num { font-size: 1.4rem; }
    .c8-hero__stat-label { font-size: 0.8rem; }
    .c8-hero__regions { font-size: 0.72rem; letter-spacing: 0.14em; }
  }
</style>

<script is:inline>
  /* Hero bootstrap — runs only when Hero.astro is on the page.
       1. Flip navbar to its on-dark variant.
       2. Pause the bg video if prefers-reduced-motion.
       3. Typewriter rotator (types → holds → deletes → next word).
       4. Count-up every stat.
       5. Cursor-following gold glow (pointer devices only). */
  (function () {
    var navbar = document.getElementById('navbar');
    if (navbar) navbar.classList.add('navbar--on-dark');

    var section = document.querySelector('.c8-hero-section');
    var video   = document.querySelector('.c8-hero__video');
    var mq      = window.matchMedia('(prefers-reduced-motion: reduce)');

    function applyMotionPref() {
      if (mq.matches && video) {
        try { video.pause(); } catch (e) {}
        video.removeAttribute('autoplay');
      }
    }
    applyMotionPref();
    if (mq.addEventListener)  mq.addEventListener('change', applyMotionPref);
    else if (mq.addListener)  mq.addListener(applyMotionPref);

    /* ── Typewriter rotator ── */
    var rotator = document.querySelector('.c8-hero__rotator');
    if (rotator) {
      var words = [];
      try { words = JSON.parse(rotator.getAttribute('data-words') || '[]'); }
      catch (e) { words = []; }

      if (words.length) {
        if (mq.matches) {
          // Static fallback: show all words slash-separated
          rotator.textContent = words.join(' / ');
        } else {
          var idx = 0;
          var charIdx = 0;
          var deleting = false;
          var timer = null;
          var typeSpeed = 85;
          var deleteSpeed = 45;
          var holdAfterType = 1800;
          var holdAfterDelete = 320;

          function tick() {
            var word = words[idx];
            if (!deleting) {
              charIdx++;
              rotator.textContent = word.slice(0, charIdx);
              if (charIdx === word.length) {
                deleting = true;
                timer = setTimeout(tick, holdAfterType);
                return;
              }
              timer = setTimeout(tick, typeSpeed + Math.random() * 40);
            } else {
              charIdx--;
              rotator.textContent = word.slice(0, charIdx);
              if (charIdx === 0) {
                deleting = false;
                idx = (idx + 1) % words.length;
                timer = setTimeout(tick, holdAfterDelete);
                return;
              }
              timer = setTimeout(tick, deleteSpeed + Math.random() * 20);
            }
          }

          // Seed: clear placeholder and kick off after fade-in settles
          rotator.textContent = '';
          timer = setTimeout(tick, 900);

          // Pause when tab is hidden so cursor blink stays aligned with state
          document.addEventListener('visibilitychange', function () {
            if (document.hidden) {
              if (timer) { clearTimeout(timer); timer = null; }
            } else if (!timer) {
              timer = setTimeout(tick, 300);
            }
          });
        }
      }
    }

    /* ── Count-up stats ── */
    var stats = Array.prototype.slice.call(document.querySelectorAll('.c8-hero__stat-num'));
    function formatStat(value, el) {
      var prefix = el.dataset.prefix || '';
      var suffix = el.dataset.suffix || '';
      var format = el.dataset.format || '';
      var rounded = Math.round(value);
      var display = format === 'comma' ? rounded.toLocaleString('en-US') : String(rounded);
      return prefix + display + suffix;
    }
    function animateStat(el, delay) {
      var end = parseFloat(el.dataset.end);
      if (isNaN(end)) return;
      if (mq.matches) {
        el.textContent = formatStat(end, el);
        return;
      }
      var duration = 1700 + Math.random() * 300;
      var startTime = 0;
      function tick(now) {
        if (!startTime) startTime = now;
        var t = Math.min(1, (now - startTime) / duration);
        var eased = 1 - Math.pow(1 - t, 3);
        el.textContent = formatStat(eased * end, el);
        if (t < 1) requestAnimationFrame(tick);
      }
      setTimeout(function () { requestAnimationFrame(tick); }, delay);
    }
    stats.forEach(function (el, i) {
      animateStat(el, 1150 + i * 180);
    });

    /* ── Cursor-following gold glow (pointer devices only) ── */
    if (section && window.matchMedia('(pointer: fine)').matches && !mq.matches) {
      var targetX = 82, targetY = 28;
      var currentX = 82, currentY = 28;
      var rafId = null;

      function render() {
        currentX += (targetX - currentX) * 0.08;
        currentY += (targetY - currentY) * 0.08;
        section.style.setProperty('--c8-hero-cx', currentX.toFixed(2) + '%');
        section.style.setProperty('--c8-hero-cy', currentY.toFixed(2) + '%');
        if (Math.abs(targetX - currentX) > 0.1 || Math.abs(targetY - currentY) > 0.1) {
          rafId = requestAnimationFrame(render);
        } else {
          rafId = null;
        }
      }

      section.addEventListener('mousemove', function (e) {
        var rect = section.getBoundingClientRect();
        targetX = ((e.clientX - rect.left) / rect.width) * 100;
        targetY = ((e.clientY - rect.top)  / rect.height) * 100;
        if (!rafId) rafId = requestAnimationFrame(render);
      });

      section.addEventListener('mouseleave', function () {
        targetX = 82; targetY = 28;
        if (!rafId) rafId = requestAnimationFrame(render);
      });
    }
  })();
</script>
