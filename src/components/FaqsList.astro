---
// FAQ — clean accordion on a white slab. Two-column header (left:
// eyebrow + heading, right: support note + book-call CTA), then a
// vertical stack of questions with smooth height transitions on
// open/close. Plus icon rotates to minus on open.
//
// Multiple questions can be open at once — the user is comparing
// answers, not navigating a single thread.

import { faqs } from '../data/content';
---

<section class="c8-faq">
  <div class="c8-faq__inner">
    <header class="c8-faq__head" data-reveal-stagger="100">
      <div class="c8-faq__head-text">
        <p class="c8-faq__eyebrow" data-reveal="up">Frequently asked</p>
        <h2 class="c8-faq__heading" data-reveal="up">
          Answered honestly. <span class="c8-faq__heading-accent">No procurement-ese.</span>
        </h2>
      </div>
      <aside class="c8-faq__aside" data-reveal="up">
        <p class="c8-faq__aside-text">Have a question we haven't covered?</p>
        <a class="c8-faq__aside-cta" href="/contact">
          <span>Book a strategy call</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </aside>
    </header>

    <ol class="c8-faq__list" data-reveal-stagger="60">
      {faqs.map((f, i) => (
        <li class="c8-faq__item" data-reveal="up">
          <button
            type="button"
            class="c8-faq__q"
            aria-expanded={i === 0 ? 'true' : 'false'}
            aria-controls={`c8-faq-a-${i}`}
            data-faq-index={i}
          >
            <span class="c8-faq__q-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="c8-faq__q-text">{f.q}</span>
            <span class="c8-faq__q-icon" aria-hidden="true">
              <span class="c8-faq__q-bar c8-faq__q-bar--h"></span>
              <span class="c8-faq__q-bar c8-faq__q-bar--v"></span>
            </span>
          </button>
          <div
            class="c8-faq__a"
            id={`c8-faq-a-${i}`}
            role="region"
            aria-hidden={i === 0 ? 'false' : 'true'}
            data-open={i === 0 ? 'true' : 'false'}
          >
            <div class="c8-faq__a-inner">
              <p>{f.a}</p>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style is:global>
  .c8-faq {
    background: #ffffff;
    color: #0a0a0a;
    padding: clamp(4rem, 8vh, 6rem) clamp(1.5rem, 5vw, 5rem);
    border-top: 1px solid rgba(0,0,0,0.05);
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }
  .c8-faq__inner {
    max-width: var(--c8-section-max, 1320px);
    margin: 0 auto;
  }

  /* ─── Head: 2-col on desktop (text left, aside right) ─── */
  .c8-faq__head {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: end;
    margin: 0 0 clamp(2.5rem, 5vh, 3.5rem);
  }
  @media (max-width: 900px) {
    .c8-faq__head { grid-template-columns: 1fr; align-items: start; gap: 1rem; }
  }
  .c8-faq__head-text { max-width: 36rem; }
  .c8-faq__eyebrow {
    margin: 0 0 1rem;
    font-family: var(--montreal);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c8-gold-dark);
  }
  .c8-faq__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.2vw, 3.1rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .c8-faq__heading-accent {
    color: var(--c8-gold-dark);
    font-weight: 400;
  }

  .c8-faq__aside {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }
  .c8-faq__aside-text {
    margin: 0;
    font-family: var(--montreal);
    font-size: 0.92rem;
    color: #555;
  }
  .c8-faq__aside-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.2rem;
    background: var(--c8-gold);
    color: #111;
    text-decoration: none;
    border-radius: 999px;
    font-family: var(--montreal);
    font-size: 0.88rem;
    font-weight: 600;
    transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 10px 24px -10px rgba(242, 191, 34, 0.45);
  }
  .c8-faq__aside-cta:hover {
    background: #0a0a0a;
    color: var(--c8-gold);
    transform: translateY(-2px);
  }

  /* ─── Accordion list ─── */
  .c8-faq__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(0,0,0,0.08);
  }
  .c8-faq__item {
    border-bottom: 1px solid rgba(0,0,0,0.08);
  }

  /* Question row — clickable button. Three-column grid: number,
     question text, plus/minus icon. */
  .c8-faq__q {
    appearance: none;
    width: 100%;
    background: transparent;
    border: 0;
    text-align: left;
    cursor: pointer;
    color: #0a0a0a;
    padding: clamp(1.2rem, 2vw, 1.6rem) 0.25rem clamp(1.2rem, 2vw, 1.6rem) 0.25rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    column-gap: clamp(0.85rem, 1.4vw, 1.4rem);
    align-items: center;
    font-family: inherit;
    transition: padding-left 0.4s ease, color 0.3s ease;
  }
  .c8-faq__q:hover { padding-left: 0.85rem; }
  .c8-faq__q[aria-expanded="true"] { padding-left: 0.85rem; }

  .c8-faq__q-num {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--c8-gold-dark);
    opacity: 0.75;
    transition: opacity 0.3s ease;
  }
  .c8-faq__q[aria-expanded="true"] .c8-faq__q-num,
  .c8-faq__q:hover .c8-faq__q-num { opacity: 1; }

  .c8-faq__q-text {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: #0a0a0a;
  }

  /* Plus icon — two crossed bars. The vertical bar collapses to
     scaleY(0) when expanded, leaving a horizontal minus. */
  .c8-faq__q-icon {
    width: 22px;
    height: 22px;
    position: relative;
    display: inline-block;
    flex: 0 0 auto;
    color: var(--c8-gold-dark);
  }
  .c8-faq__q-bar {
    position: absolute;
    background: currentColor;
    border-radius: 1px;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
                background 0.3s ease;
  }
  .c8-faq__q-bar--h {
    left: 0; right: 0; top: 50%;
    height: 2px;
    transform: translateY(-50%);
  }
  .c8-faq__q-bar--v {
    top: 0; bottom: 0; left: 50%;
    width: 2px;
    transform: translateX(-50%) scaleY(1);
    transform-origin: center;
  }
  .c8-faq__q[aria-expanded="true"] .c8-faq__q-bar--v {
    transform: translateX(-50%) scaleY(0);
  }
  .c8-faq__q[aria-expanded="true"] .c8-faq__q-icon {
    color: var(--c8-gold);
  }

  /* Answer panel — uses the grid-template-rows 0fr → 1fr trick for
     a smooth auto-height transition. */
  .c8-faq__a {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .c8-faq__a[data-open="true"] { grid-template-rows: 1fr; }
  .c8-faq__a-inner {
    overflow: hidden;
    min-height: 0;
  }
  .c8-faq__a p {
    margin: 0;
    padding: 0 2.5rem 1.6rem 2.6rem;
    font-family: var(--montreal);
    font-size: 1rem;
    line-height: 1.65;
    color: #4a4a4a;
    max-width: 56rem;
  }
  @media (max-width: 600px) {
    .c8-faq__a p { padding-left: 0.25rem; padding-right: 0.5rem; }
  }
</style>

<script is:inline>
  function startFaqs() {
    var buttons = document.querySelectorAll('.c8-faq__q');
    if (!buttons.length) return;
    Array.prototype.forEach.call(buttons, function (btn) {
      btn.addEventListener('click', function () {
        var open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', open ? 'false' : 'true');
        var panelId = btn.getAttribute('aria-controls');
        var panel = panelId ? document.getElementById(panelId) : null;
        if (panel) {
          panel.setAttribute('data-open', open ? 'false' : 'true');
          panel.setAttribute('aria-hidden', open ? 'true' : 'false');
        }
      });
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startFaqs, { once: true });
  } else {
    startFaqs();
  }
</script>
