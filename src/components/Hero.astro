---
// Hero — matches the kota.co.uk typographic treatment (giant staircased
// display text + small intro paragraph + thin awards strip). No bg video.
const awards = [
  { src: '/awards/blockchain-life.png', alt: 'Blockchain Life' },
  { src: '/awards/dubai-expo.png', alt: 'Dubai Expo' },
  { src: '/awards/emmi-empire.png', alt: 'EMMI Empire' },
  { src: '/awards/finext.png', alt: 'Finext' },
  { src: '/awards/iisa.png', alt: 'IISA' },
];
---

<section class="Hero_hero__IrR3f" style="position:relative; overflow:hidden;">
  <div class="container" style="position: relative; z-index: 1;">
    <div class="Hero_splitText__diMTw">
      <span class="Hero_displayLine__c8 Hero_displayLine_top__c8" data-blur-reveal="true">Build.</span>
      <span class="Hero_displayLine__c8 Hero_displayLine_mid__c8" data-blur-reveal="true">Launch.</span>
      <span class="Hero_displayLine__c8 Hero_displayLine_bot__c8" data-blur-reveal="true">Scale.</span>
      <h1 class="Hero_introText__wboFn">
        <span class="HeroFadeIn_container___NgC6" data-fill="false"><span>Global marketing, PR &amp; full-stack development for Web3, AI and fintech brands that&nbsp;<strong>refuse to blend in.</strong> 1,100+ projects. 95+ specialists. 30+ countries.</span></span>
      </h1>
    </div>
  </div>
  <div class="Hero_logos__jC9k_" data-modal-hide="true">
    <span class="FadeIn_container__bjQVL" data-fill="false">
      <div class="Hero_logosInner__D4sWL Hero_awardsInner__c8">
        {awards.map((a) => (
          <img src={a.src} alt={a.alt} class="Hero_awardImg__c8" loading="lazy" />
        ))}
      </div>
    </span>
  </div>
</section>

<style>
  /* Staircased display text — rides on KOTA's .Hero_splitText__diMTw which
     already gives us `font-size: clamp(2rem, 16vw, 99rem); color:#000;
     line-height:.9` so this layer only controls weight, case and indent. */
  .Hero_splitText__diMTw {
    position: relative;
    font-family: var(--syne), "Syne", "Helvetica Neue", Arial, sans-serif;
  }

  .Hero_displayLine__c8 {
    display: block;
    font-weight: 700;
    font-style: normal;
    line-height: 0.88;
    letter-spacing: -0.035em;
    color: #000;
    text-transform: lowercase;
  }

  /* Match KOTA's staircase: each line steps further right */
  .Hero_displayLine_mid__c8 { padding-left: 0.14em; }
  .Hero_displayLine_bot__c8 { padding-left: 0.34em; }

  /* Award strip — keep it small, dark and uniform like the KOTA original */
  .Hero_awardsInner__c8 {
    align-items: center;
    gap: 2.5rem !important;
    flex-wrap: wrap;
  }

  .Hero_awardImg__c8 {
    height: 28px;
    width: auto;
    max-width: 140px;
    object-fit: contain;
    filter: brightness(0) invert(0);
    opacity: 0.7;
    transition: opacity 0.3s ease;
    padding-right: 0 !important;
  }

  .Hero_awardImg__c8:hover {
    opacity: 1;
  }

  @media (max-width: 900px) {
    .Hero_awardImg__c8 {
      height: 22px;
    }
  }
</style>
