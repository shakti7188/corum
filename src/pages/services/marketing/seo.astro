.s-case__metrics{display:flex;flex-wrap:wrap;gap:2rem;padding:2rem;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:18px;margin-bottom:2.5rem;}
.s-case__metrics div span{display:block;font-size:2rem;font-weight:800;color:#f2bf22;line-height:1;}
.s-case__metrics div small{font-size:.75rem;color:rgba(255,255,255,.4);}

/* ── TESTIMONIALS ── */
.s-testi{padding:clamp(4rem,8vh,6rem) 2rem;}
.s-testi-grid{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.5rem;}
.s-testi-card{background:#fff;border:1px solid rgba(0,0,0,.07);border-radius:24px;padding:2rem;box-shadow:0 10px 40px -12px rgba(0,0,0,.08);transition:transform .3s,box-shadow .3s;}
.s-testi-card:hover{transform:translateY(-4px);box-shadow:0 20px 60px -15px rgba(0,0,0,.12);}
.s-testi-img{width:56px;height:56px;border-radius:50%;overflow:hidden;margin-bottom:1rem;border:2px solid rgba(242,191,34,.3);}
.s-stars{color:#f59e0b;font-size:.9rem;letter-spacing:.05em;margin-bottom:1rem;}
.s-testi-card blockquote{font-size:.88rem;line-height:1.7;color:#444;font-style:italic;margin-bottom:1.2rem;}
.s-testi-name{font-size:.88rem;font-weight:700;}
.s-testi-role{font-size:.75rem;color:#999;margin-top:.15rem;}

/* ── IMAGE ROW ── */
.s-imgrow{max-width:1300px;margin:0 auto 2rem;padding:0 2rem;display:grid;grid-template-columns:1fr 1.3fr 1fr;gap:1rem;align-items:stretch;}
@media(max-width:768px){.s-imgrow{grid-template-columns:1fr;}}
.s-imgrow__item{position:relative;border-radius:20px;overflow:hidden;height:240px;}
.s-imgrow__item--tall{height:300px;align-self:center;}
.s-imgrow__item span{position:absolute;bottom:1rem;left:1rem;background:rgba(0,0,0,.5);backdrop-filter:blur(8px);color:#fff;font-size:.75rem;font-weight:700;padding:.3rem .8rem;border-radius:100px;}

/* ── FAQ ── */
.s-faq{padding:clamp(4rem,8vh,6rem) 2rem;background:#fff;border-top:1px solid rgba(0,0,0,.06);}
.s-faq-list{max-width:760px;margin:0 auto;}
.s-faq-item{border-bottom:1px solid rgba(0,0,0,.07);}
.s-faq-item:first-child{border-top:1px solid rgba(0,0,0,.07);}
.s-faq-q{width:100%;text-align:left;padding:1.3rem 0;background:none;border:none;cursor:pointer;font-size:.95rem;font-weight:700;color:#0f0f0f;display:flex;align-items:center;justify-content:space-between;gap:1rem;font-family:inherit;transition:color .2s;}
.s-faq-q:hover,.s-faq-q[aria-expanded="true"]{color:#f2bf22;}
.s-chevron{flex-shrink:0;width:22px;height:22px;border:1.5px solid currentColor;border-radius:50%;position:relative;transition:transform .3s;}
.s-chevron::before,.s-chevron::after{content:'';position:absolute;top:50%;left:50%;width:7px;height:1.5px;background:currentColor;border-radius:2px;}
.s-chevron::before{transform:translate(-50%,-50%) rotate(-45deg) translateX(2px);}
.s-chevron::after{transform:translate(-50%,-50%) rotate(45deg) translateX(-2px);}
.s-faq-q[aria-expanded="true"] .s-chevron{transform:rotate(180deg);}
.s-faq-a{max-height:0;overflow:hidden;opacity:0;font-size:.9rem;line-height:1.75;color:#555;transition:max-height .4s cubic-bezier(.16,1,.3,1),opacity .3s;}
.s-faq-item.open .s-faq-a{padding-bottom:1.4rem;}

/* ── FINAL CTA ── */
.s-cta{background:#0f0f0f;padding:clamp(5rem,10vh,8rem) 2rem;text-align:center;position:relative;overflow:hidden;}
.s-cta__bg{position:absolute;inset:0;z-index:0;}
.s-cta__bg img{width:100%;height:100%;object-fit:cover;opacity:.1;}
.s-cta__overlay{position:absolute;inset:0;background:radial-gradient(ellipse at center,rgba(15,15,15,.6) 0%,rgba(15,15,15,.98) 70%);}
.s-cta__inner{position:relative;z-index:1;max-width:680px;margin:0 auto;}
.s-cta__h2{font-size:clamp(2.5rem,5.5vw,4.2rem);font-weight:800;line-height:1.1;letter-spacing:-.04em;color:#fff;margin:1rem 0;}
.s-cta__inner p{font-size:1rem;line-height:1.7;color:rgba(255,255,255,.45);margin-bottom:2.5rem;}
.s-cta__btns{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;}

/* ── reduce motion ── */
@media(prefers-reduced-motion:reduce){.float-a,.float-b{animation:none;}}
</style>

</Layout>
