---
import Layout from "../layouts/Layout.astro";
import FinalCta from "../components/FinalCta.astro";

const arrowGrad = {
  id: 'ind',
  stops: [
    { offset: '0', color: '#d48e1a' },
    { offset: '1', color: '#ffc857' },
  ],
};

const projects = [
  {
    href: '/industries/web3',
    name: 'Web3 & Crypto',
    year: 'Core practice',
    heading: 'Exchanges, wallets, RWAs, DeFi, tokens — and the launch engine around them.',
    tags: ['Exchange', 'Wallet', 'RWA', 'DeFi', 'Token'],
    poster: '/images/bento1-1.jpg',
  },
  {
    href: '/industries/fintech',
    name: 'Fintech',
    year: 'Regulated',
    heading: 'Banks, neobanks, payment rails, lending, insurance — regulated engineering with marketing bolted on top.',
    tags: ['Payments', 'KYC/AML', 'Compliance', 'Institutional'],
    poster: '/images/bento2-1.jpg',
  },
  {
    href: '/industries/ai',
    name: 'AI',
    year: 'Emerging',
    heading: 'Agents, copilots, LLM pipelines — and the go-to-market that cuts through the me-too AI wall.',
    tags: ['Agents', 'LLM', 'RAG', 'Developer GTM'],
    poster: '/images/bento3-1.jpg',
  },
  {
    href: '/industries/saas',
    name: 'SaaS',
    year: 'PLG & ABM',
    heading: 'B2B and B2C SaaS — product-led growth, enterprise sales motions, and the stack under both.',
    tags: ['PLG', 'ABM', 'Content', 'Analytics'],
    poster: '/images/bento4-1.jpg',
  },
  {
    href: '/industries/startups',
    name: 'Startups',
    year: 'Early-stage',
    heading: 'Pre-seed to Series A — products built for investors, users and the markets you haven\'t reached yet.',
    tags: ['MVP', 'Pitch Decks', 'Launch PR', 'Growth'],
    poster: '/images/bento1.jpg',
  },
  {
    href: '/industries/enterprise',
    name: 'Enterprise',
    year: 'Procurement',
    heading: 'Fortune 500, financial institutions, government tech — delivery on the procurement clock.',
    tags: ['Enterprise Blockchain', 'AI Integration', 'ABM', 'Analyst PR'],
    poster: '/images/bento3.jpg',
  },
];
---
<Layout title="Industries | Corum8">
<div data-theme="light">
<section class="Hero_hero__Oyf4n"><div class="container"><div class="Hero_top__RRkYH"><h2><span class="LineByLine_headingOuter__JmusT"><span>Six industries. One team. Delivery from strategy to production.</span></span></h2><figure class="crosshair" aria-hidden="true"><span class="FadeInRotate_container__QE9u9" data-fill="true" data-direction="clockwise"><span class="inner"></span></span></figure><div class="Hero_video__rzcbe"><span class="ScaleFadeIn_container__cK78G" data-fill="true"><span class="ScaleFadeIn_inner__y4reT" data-fill="true"><video src="/media/bg2.mp4" class="Hero_video__rzcbe" autoplay muted loop playsinline></video></span></span></div></div><div class="Hero_bottom__ktiOH"><h1><span class="MaskInUp_container__0AW5i" data-fill="false"><div><span><i></i>Industries</span></div></span></h1><h3 class="Hero_introText__oP34v"><span class="FadeIn_container__bjQVL" data-fill="false"><span>We work across six industries that share one thing — they move fast, regulate hard and punish generic marketing.</span></span></h3><div class="Hero_arrow__lxSeM"><span class="FadeInRotate_container__QE9u9" data-fill="false" data-direction="counterclockwise"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 75.91 75.65"><path d="m13.65 67.65 61.93-62L69.92 0 8 61.99V.25H0v75.4h75.91v-8H13.65z"></path></svg></span></div></div></div></section>

<div class="Work_work__rSI8c">
  <div class="DarkThemeSwitch_cover__hn_xc"></div>
  <div class="Work_projects__A5q77">
    <div class="AnimatedGrid_grid__otAMD">
      <div class="container">
        {projects.map((p) => (
          <a class="ProjectCard_project__d1wbY ProjectCard_small__xsL92" data-animation="grid-item" href={p.href}>
            <div class="ProjectCard_projectText__o770X">
              <h3>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14.78 14.78">
                  <defs>
                    <linearGradient id={arrowGrad.id} x1="3.54" x2="13.98" y1="3.54" y2="13.99" gradientUnits="userSpaceOnUse">
                      {arrowGrad.stops.map((s) => <stop offset={s.offset} stop-color={s.color}></stop>)}
                    </linearGradient>
                  </defs>
                  <path fill={`url(#${arrowGrad.id})`} stroke-width="0" d="M13.25 12.18L13.25 0.23 14.78 0.23 14.78 14.76 14.74 14.76 14.74 14.78 0.21 14.78 0.21 13.25 12.18 13.25 0 1.08 1.08 0 13.25 12.18z"></path>
                </svg>{p.name}
              </h3>
              <p>{p.year}</p>
            </div>
            <div class="ProjectCard_projectImage__Nfx9I">
              <div class="ProjectCard_imageOverlay__OCawr">
                <p class="ProjectCard_heading__1csIW">{p.heading}</p>
                <ul class="ProjectCard_tags__XdVcf">
                  {p.tags.map((t) => <li>{t}</li>)}
                </ul>
              </div>
              <span class="Image_image__RAAdZ Image_fill__EiIzS"><img src={p.poster} alt="" fetchpriority="low" loading="lazy" /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</div>

<FinalCta
  light="One team."
  bold="Six industries."
  subtitle="Book a call. We'll tell you what we'd do first."
/>
</div>
</Layout>
