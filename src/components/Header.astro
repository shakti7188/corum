  .mega-menu-link:hover { background: rgba(var(--nb-brand-gold-rgb),0.05); }

  .mega-menu-link i {
    width: 15px; height: 15px;
    opacity: 0.35; flex-shrink: 0;
    margin-top: 0;
  }
  .mega-menu-link:hover i { opacity: 1; color: var(--nb-brand-gold); }

  .mega-menu-link-text {
    display: flex; flex-direction: column; gap: 1px; min-width: 0;
  }
  .mega-menu-link-name {
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--nb-text-primary);
    line-height: 1.25;
  }

  .mega-menu-cta {
    background: var(--nb-bg-dark);
    border-radius: var(--nb-radius-lg);
    padding: 18px;
    display: flex;
    flex-direction: column;
