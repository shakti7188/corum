    .lp-inputs__foot a:hover { color: #fff; border-color: var(--c8-gold); }
    
    /* Proof — LIGHT band so the white case cards drop-shadow off the page. */
    .lp-proof {
      padding: clamp(5rem, 10vh, 8rem) var(--lp-pad-x);
      background: #fff;
      color: #0a0a0a;
    }
    .lp-proof-grid {
      max-width: var(--lp-max); margin: 0 auto;
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: clamp(1rem, 1.6vw, 1.6rem);
    }
    @media (max-width: 1100px) { .lp-proof-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 600px)  { .lp-proof-grid { grid-template-columns: 1fr; } }
    .lp-case {
      display: flex; flex-direction: column;
      background: #fff;
      border-radius: 20px; overflow: hidden;
      box-shadow: 0 22px 44px -22px rgba(0,0,0,0.18);
      transition: transform 0.5s cubic-bezier(0.2,0.8,0.2,1), box-shadow 0.5s ease;
    }
    .lp-case:hover {
      transform: translateY(-6px);
      box-shadow: 0 36px 64px -24px rgba(0,0,0,0.28);
    }
    .lp-case__media { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: #111; }
    .lp-case__media img {
      width: 100%; height: 100%; object-fit: cover;
      transition: transform 0.7s cubic-bezier(0.2,0.8,0.2,1);
    }
    .lp-case:hover .lp-case__media img { transform: scale(1.05); }
    .lp-case__chip {
      position: absolute; top: 1rem; left: 1rem;
      padding: 0.4rem 0.85rem; background: rgba(0,0,0,0.65);
      backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
      border: 1px solid rgba(255,255,255,0.18); border-radius: 999px;
      color: #fff; font-family: var(--montreal); font-size: 0.7rem;
      font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase;
    }
    .lp-case__body { padding: clamp(1.2rem, 2vw, 1.7rem); }
    .lp-case__company {
      display: inline-block; margin: 0 0 0.7rem;
      font-family: var(--montreal); font-size: 0.72rem; font-weight: 600;
      letter-spacing: 0.18em; text-transform: uppercase; color: #888;
    }
    .lp-case__metrics { display: flex; flex-direction: column; gap: 0.15rem; margin: 0 0 0.85rem; }
    .lp-case__headline {
      font-family: var(--font-display); font-size: clamp(2rem, 3.6vw, 2.85rem);
      font-weight: 350; letter-spacing: -0.04em; line-height: 0.95;
      color: var(--c8-gold-dark);
    }
    .lp-case__subheadline {
      font-family: var(--montreal); font-size: 0.85rem; letter-spacing: 0.01em;
      color: #555;
    }
    .lp-case__desc {
      margin: 0;
      font-family: var(--montreal); font-size: 0.88rem; line-height: 1.55;
      color: #444;
    }
    
    /* TESTIMONIAL CAROUSEL — slides stack via grid; only active slide visible */
    .lp-testi {
      padding: clamp(5rem, 10vh, 8rem) var(--lp-pad-x);
      background:
        radial-gradient(circle at 30% 20%, rgba(242,191,34,0.08) 0%, transparent 55%),
        #0a0a0a;
      color: #fff;
