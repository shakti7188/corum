                <path fill="#fff" d="M780,330 q50,5 80,40 q25,40 5,75 q-30,30 -75,15 q-40,-20 -45,-65 q-5,-45 35,-65z"/>
              </mask>
            </defs>
            <rect width="1000" height="500" fill="url(#dots)" mask="url(#continents)"/>
          </svg>
          ${mapPins.map(p => `<span class="c8-globe__dot ${p.color === 'blue' ? 'c8-globe__dot--blue' : ''}" style="left:${p.x}%;top:${p.y}%"></span>`).join('')}
        </div>
        <div class="c8-cities">
          ${cities.map(c => `
            <div class="c8-city">
              <span class="c8-city__flag">${c.flag}</span>
              <span class="c8-city__name">${c.name}</span>
              <span class="c8-city__label">${c.label}</span>
            </div>
          `).join('')}
        </div>
      `;
    });
  }

  if (document.readyState !== 'loading') buildStatVisuals();
  else document.addEventListener('DOMContentLoaded', buildStatVisuals);
  document.addEventListener('astro:page-load', buildStatVisuals);
</script>
