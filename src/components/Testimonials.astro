    bg: '#a8e1ec',
    logo: '/clients/kava.png',
    alt: 'DeFiVault',
    quote: 'Their influencer network is unmatched. We went from 2,000 to 85,000 community members in 90 days with genuine engagement — not bot farms. The ROI on our KOL campaigns was 12x what we saw with our previous agency.',
    name: 'Sarah Al-Rashid',
    title: 'CMO, DeFiVault',
    href: '/work'
  },
  {
    bg: '#ffffff',
    logo: '/clients/kucoin.png',
    alt: 'KuCoin',
    quote: 'Corum8 rebuilt our entire tokenomics model from the ground up, ensuring deep liquidity mapping. Our token launch hit M in volume within the first 48 hours precisely due to their structural PR push.',
    name: 'David Z.',
    title: 'Founder',
    href: '/work'
  }
];

const { testimonials = defaultTestis } = Astro.props;
