  .mega-menu-cta .c8-btn { width: 100%; justify-content: center; margin-top: 4px; }

  /* ─── Simple Dropdown (Industries, Resources, About) ─── */
  .dropdown-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    background: rgba(255,255,255,0.97);
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    border: 1px solid var(--nb-border-subtle);
    border-radius: var(--nb-radius-lg);
    padding: 12px;
    min-width: 200px;
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s var(--nb-ease-expo);
    box-shadow: 0 20px 60px rgba(0,0,0,0.08);
    z-index: 100;
  }
  .nav-item:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }
  .dropdown-link {
    display: block;
    padding: 10px 16px;
    font-size: 0.88rem;
    color: var(--nb-text-secondary);
    border-radius: var(--nb-radius-sm);
    transition: all 0.25s;
    text-decoration: none;
  }
  .dropdown-link:hover {
    color: var(--nb-brand-gold);
    background: rgba(var(--nb-brand-gold-rgb),0.06);
  }

  /* Dark state dropdown */
  .navbar--on-dark .dropdown-menu {
    background: rgba(20,20,20,0.95);
    border-color: rgba(255,255,255,0.08);
  }
  .navbar--on-dark .dropdown-link { color: var(--nb-text-on-dark-muted); }
  .navbar--on-dark .dropdown-link:hover {
    color: var(--nb-brand-gold);
    background: rgba(var(--nb-brand-gold-rgb),0.1);
  }

  /* ─── Buttons (used only in this navbar context) ─── */
  .c8-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 32px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: var(--nb-radius-pill);
    transition: all 0.3s var(--nb-ease-expo);
    cursor: pointer;
    white-space: nowrap;
    text-decoration: none;
    border: none;
  }
  .c8-btn-gold {
    background: var(--nb-brand-gold);
